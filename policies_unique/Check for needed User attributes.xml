<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check for needed User attributes</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:dirXMLAssociation" op="not-available" />
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ADAliasName" op="not-available" />
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.formatted" op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								