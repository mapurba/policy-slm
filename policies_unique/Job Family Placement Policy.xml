<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Job Family Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDJobfamily</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="gvJobFamilyPlacementContainer" op="not-equal">Custom</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="gvJobFamilyPlacementContainer" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDJobfamily:wd-JobFamilyName" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							