<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set DirXML-BB-p-id</description>
									<conditions>
										<and>
											<if-op-property mode="nocase" name="BBObjectType" op="equal">DirXML-BB-Person</if-op-property>
											<if-op-attr name="DirXML-BB-p-id" op="not-available" />
											<if-global-variable mode="nocase" name="auto_set_ids" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="DirXML-BB-p-id">
											<arg-value type="string">
												<token-src-name />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								