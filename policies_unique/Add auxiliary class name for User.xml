<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add auxiliary class name for User</description>
									<comment xml:space="preserve">Add auxilary class name for User </comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="Object Class">
											<arg-value type="string">
												<token-text xml:space="preserve">scim-User</token-text>
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								