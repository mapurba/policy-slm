<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check User's UserGroup membership being granted or revoked</description>
									<comment xml:space="preserve">Provide PUM UserGroup membership to the user who requested the Entitlement. Also remove the temporary association added to the User.</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.UserGroup" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-entitlement name="UserGroup" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="UserGroup" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')&#10;" />
													</arg-string>
												</do-set-local-variable>
												<do-remove-dest-attr-value class-name="Group" name="Member">
													<arg-association>
														<token-local-variable name="assoc" />
													</arg-association>
													<arg-value type="string">
														<token-src-attr name="CN" />
													</arg-value>
												</do-remove-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/remove-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="UserGroup" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value class-name="Group" name="Member">
													<arg-association>
														<token-local-variable name="assoc" />
													</arg-association>
													<arg-value type="string">
														<token-src-attr name="CN" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/add-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
										<do-remove-association when="after">
											<arg-association>
												<token-text xml:space="preserve">pumEntitlementAssociation</token-text>
											</arg-association>
										</do-remove-association>
										<do-veto />
									</actions>
								</rule>
							