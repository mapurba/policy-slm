<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add 'read-attr' for groupMembers in the case of a 'member' query</description>
									<comment xml:space="preserve">Add a new XML element to the query node in order to query for groupMembers as well in the case of a 'member' query.</comment>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">query|query-ex</if-operation>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-xpath op="true">//operation-data/msgw-data-collection</if-xpath>
											<if-xpath op="true">boolean(./read-attr[@attr-name='member'])</if-xpath>
										</and>
										<and>
											<if-operation mode="regex" op="equal">query|query-ex</if-operation>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-xpath op="true">./operation-data/msgw-data-collection</if-xpath>
											<if-xpath op="true">boolean(./read-attr[@attr-name='member'])</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="read-attr" />
										<do-set-xml-attr expression="./read-attr[last()]" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">groupMember</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							