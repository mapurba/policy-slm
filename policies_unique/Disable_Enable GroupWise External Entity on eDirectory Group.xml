<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Disable/Enable GroupWise External Entity on eDirectory GroupWise External Entity Expire</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="driver.gw.GWExternalEntityExpire" op="equal">disable</if-global-variable>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
											<if-local-variable mode="nocase" name="combinationdone" op="not-equal">true</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">./modify-attr[@attr-name='Login Expiration Time']/remove-value/value</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-xpath expression="*[@attr-name='Login Expiration Time']" />
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">false</token-text>
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-local-variable name="entriedlogindisabled" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">./modify-attr[@attr-name='Login Expiration Time']/add-value/value</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-xpath expression="*[@attr-name='Login Expiration Time']" />
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-local-variable name="entriedlogindisabled" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								