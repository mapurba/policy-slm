<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Handle Return Code 2</description>
									<comment xml:space="preserve">Unable to process [modify] event from DCS driver; Object DN: &lt;dn&gt;, Structural class: &lt;class&gt;, Reason: Associated object not found in database with GUID: &lt;guid&gt;</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
											<if-xml-attr name="object-guid" op="available" />
											<if-xml-attr mode="nocase" name="level" op="equal">error</if-xml-attr>
											<if-xml-attr mode="nocase" name="return-code" op="equal">2</if-xml-attr>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="rc" scope="policy">
											<arg-string>
												<token-xpath expression="@return-code" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="guid" scope="policy">
											<arg-string>
												<token-xpath expression="@object-guid" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">contains(@event-id, '#retry-')</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="eventid" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after(substring-after(@event-id, '#retry-'), '#')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="retry" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before(substring-after(@event-id, '#retry-'), '#')" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="eventid" scope="policy">
													<arg-string>
														<token-xpath expression="@event-id" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="retry" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">0</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="obj" scope="policy">
											<arg-node-set>
												<token-query scope="entry">
													<arg-association>
														<token-local-variable name="guid" />
													</arg-association>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="dn" scope="policy">
											<arg-string>
												<token-xpath expression="$obj/@src-dn" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="class" scope="policy">
											<arg-string>
												<token-xpath expression="$obj/@class-name" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">DCS Ret Code Handler: </token-text>
												<token-text xml:space="preserve">Got a return code '2' for event with id '</token-text>
												<token-local-variable name="eventid" />
												<token-text xml:space="preserve">' on </token-text>
												<token-local-variable name="class" />
												<token-text xml:space="preserve"> '</token-text>
												<token-local-variable name="dn" />
												<token-text xml:space="preserve">' (</token-text>
												<token-local-variable name="guid" />
												<token-text xml:space="preserve">).</token-text>
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">number($retry)&lt;=number($drv.error.handling.maxRetries)</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">DCS Ret Code Handler: </token-text>
														<token-text xml:space="preserve">Retrying (attempt </token-text>
														<token-xpath expression="number($retry)+1" />
														<token-text xml:space="preserve"> of </token-text>
														<token-global-variable name="drv.error.handling.maxRetries" />
														<token-text xml:space="preserve">)...</token-text>
													</arg-string>
												</do-trace-message>
												<do-status level="warning">
													<arg-string>
														<token-text xml:space="preserve">Retrying (attempt </token-text>
														<token-xpath expression="number($retry)+1" />
														<token-text xml:space="preserve"> of </token-text>
														<token-global-variable name="drv.error.handling.maxRetries" />
														<token-text xml:space="preserve">)...</token-text>
													</arg-string>
												</do-status>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">DCS Ret Code Handler: </token-text>
														<token-text xml:space="preserve">Removing association....</token-text>
													</arg-string>
												</do-trace-message>
												<do-remove-dest-attr-value class-name="$class$" name="DirXML-Associations" when="after">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="structured">
														<arg-component name="nameSpace">
															<token-text xml:space="preserve">1</token-text>
														</arg-component>
														<arg-component name="volume">
															<token-global-variable name="dirxml.auto.driverdn" />
														</arg-component>
														<arg-component name="path">
															<token-local-variable name="guid" />
														</arg-component>
													</arg-value>
												</do-remove-dest-attr-value>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">DCS Ret Code Handler: </token-text>
														<token-text xml:space="preserve">Migrating object...</token-text>
													</arg-string>
												</do-trace-message>
												<do-add-dest-attr-value class-name="$class$" name="DirXML-Associations" when="after">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="structured">
														<arg-component name="nameSpace">
															<token-text xml:space="preserve">4</token-text>
														</arg-component>
														<arg-component name="volume">
															<token-global-variable name="dirxml.auto.driverdn" />
														</arg-component>
														<arg-component name="path" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-xml-attr expression="../modify" name="event-id">
													<arg-string>
														<token-text xml:space="preserve">#retry-</token-text>
														<token-xpath expression="number($retry)+1" />
														<token-text xml:space="preserve">#</token-text>
														<token-local-variable name="eventid" />
													</arg-string>
												</do-set-xml-attr>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable name="driverAssoc" op="not-available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="driverObj" scope="policy">
															<arg-node-set>
																<token-query scope="entry">
																	<arg-dn>
																		<token-global-variable name="dirxml.auto.driverdn" />
																	</arg-dn>
																	<arg-string>
																		<token-text xml:space="preserve">GUID</token-text>
																	</arg-string>
																</token-query>
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="driverAssoc" scope="policy">
															<arg-string>
																<token-xpath expression="es:guid2string($driverObj/attr[@attr-name='GUID']/value/text())" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-set-xml-attr expression="../modify[contains(@event-id, '#retry-')]/modify-attr[@attr-name='DirXML-Associations']//component[@name='volume']" name="association-ref">
													<arg-string>
														<token-local-variable name="driverAssoc" />
													</arg-string>
												</do-set-xml-attr>
												<do-break />
											</arg-actions>
											<arg-actions>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">DCS Ret Code Handler: </token-text>
														<token-text xml:space="preserve">Reached maximum number of retries: </token-text>
														<token-local-variable name="retry" />
														<token-text xml:space="preserve"> of </token-text>
														<token-global-variable name="drv.error.handling.maxRetries" />
														<token-text xml:space="preserve">.</token-text>
													</arg-string>
												</do-trace-message>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								