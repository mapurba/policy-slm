<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Group Match</description>
									<comment xml:space="preserve">Match Group with CN</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" />
										</do-find-matching-object>
									</actions>
								</rule>
							