<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Assign Subtemplates for Entitlement being granted or revoked</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Template" op="equal">basic</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation disabled="true" mode="regex" op="equal">modify</if-operation>
											<if-entitlement name="UserSubtemplate" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">modify</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-clear-dest-attr-value name="UserSubtemplateIDs" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-entitlement name="UserSubtemplate" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="lv-currentID" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value name="UserSubtemplateIDs">
													<arg-value type="string">
														<token-local-variable name="lv-currentID" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							