<?xml version="1.0" encoding="UTF-8"?>
<rule disabled="true">
									<description>Store wd-WorkerIDType in driver variable</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-class-name mode="nocase" op="equal">wd-Relation</if-class-name>
										</or>
										<or>
											<if-op-attr name="wd-WorkerIDType" op="available" />
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="DV-wd-WorkerIDType" scope="driver">
											<arg-string>
												<token-op-attr name="wd-WorkerIDType" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
							