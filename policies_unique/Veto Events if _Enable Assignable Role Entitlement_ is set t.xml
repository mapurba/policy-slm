<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto Events if "Enable Assignable Role Entitlement" is set to false</description>
									<comment xml:space="preserve">Veto Events if "Enable Assignable Role Entitlement" is set to false</comment>
									<conditions>
										<or>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-operation mode="nocase" op="equal">query-ex</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">wd-AssignableRole</if-class-name>
										</or>
										<or>
											<if-global-variable mode="nocase" name="drv.entitlement.AssignableRole" op="equal">false</if-global-variable>
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							