<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>On Group query response</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">instance</if-operation>
											<if-op-property name="QUERY_GROUP_USERS" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="_ASSOC" scope="policy">
											<arg-node-set>
												<token-split delimiter="/">
													<token-association />
												</token-split>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="REQUEST_ID" scope="policy">
											<arg-string>
												<token-xpath expression="number($_ASSOC[2])" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="TO_ADD" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;attr/&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-xml-attr expression="$TO_ADD/attr" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">Users</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-for-each>
											<arg-node-set>
												<token-query class-name="User" datastore="src">
													<arg-match-attr name="Group_List">
														<arg-value type="string">
															<token-text xml:space="preserve">%;</token-text>
															<token-local-variable name="REQUEST_ID" />
															<token-text xml:space="preserve">;%</token-text>
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">Login_Name</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
											<arg-actions>
												<do-append-xml-element expression="$TO_ADD/attr" name="value" />
												<do-set-xml-attr expression="$TO_ADD//value[last()]" name="type">
													<arg-string>
														<token-text xml:space="preserve">dn</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="$TO_ADD//value[last()]" name="association-ref">
													<arg-string>
														<token-xpath expression="$current-node/association" />
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-text expression="$TO_ADD//value[last()]">
													<arg-string>
														<token-xpath expression="$current-node/attr[@attr-name=&quot;Login_Name&quot;]/value" />
													</arg-string>
												</do-append-xml-text>
												<do-trace-message>
													<arg-string>
														<token-xml-serialize>
															<token-xpath expression="$current-node" />
														</token-xml-serialize>
													</arg-string>
												</do-trace-message>
												<do-trace-message>
													<arg-string>
														<token-xml-serialize>
															<token-xpath expression="$TO_ADD" />
														</token-xml-serialize>
													</arg-string>
												</do-trace-message>
												<do-trace-message>
													<arg-string>
														<token-xml-serialize>
															<token-xpath expression="$current-value" />
														</token-xml-serialize>
													</arg-string>
												</do-trace-message>
											</arg-actions>
										</do-for-each>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">count($TO_ADD//value)&gt;0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-clone-xpath dest-expression="$current-op" src-expression="$TO_ADD/attr" />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							