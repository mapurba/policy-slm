<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Format Login Expiration Time</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-attr name="Login Expiration Time" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="sapuser" name="validto">
											<arg-value>
												<token-convert-time dest-format="dd.MM.yyyy HH:mm:ss" src-format="!CTIME" src-tz="UTC">
													<token-attr name="Login Expiration Time" />
												</token-convert-time>
											</arg-value>
										</do-set-dest-attr-value>
										<do-strip-op-attr name="Login Expiration Time" />
									</actions>
								</rule>
							