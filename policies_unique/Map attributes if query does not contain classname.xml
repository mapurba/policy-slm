<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Map attributes if query does not contain classname</description>
									<comment xml:space="preserve">Maps the attributes if the query submitted does not contain classname</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-class-name op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="50310" src-name="company" />
										<do-rename-op-attr dest-name="50058" src-name="Login Disabled" />
										<do-rename-op-attr dest-name="50093" src-name="Surname" />
										<do-rename-op-attr dest-name="55003" src-name="L" />
										<do-rename-op-attr dest-name="50096" src-name="Title" />
										<do-rename-op-attr dest-name="50095" src-name="Telephone Number" />
										<do-rename-op-attr dest-name="50324" src-name="personalTitle" />
										<do-rename-op-attr dest-name="50138" src-name="Login Expiration Time" />
										<do-rename-op-attr dest-name="50323" src-name="Generational Qualifier" />
										<do-rename-op-attr dest-name="50145" src-name="Facsimile Telephone Number" />
										<do-rename-op-attr dest-name="50322" src-name="Initials" />
										<do-rename-op-attr dest-name="50091" src-name="Given Name" />
										<do-rename-op-attr dest-name="Member To" src-name="Member" />
										<do-rename-op-attr dest-name="CN" src-name="OU" />
									</actions>
								</rule>
								