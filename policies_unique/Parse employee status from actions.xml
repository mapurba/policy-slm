<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Parse employee status from actions</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="DirXML-sapPActions" op="available" />
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation op="equal">sync</if-operation>
											<if-src-attr name="DirXML-sapPActions" op="available" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-src-attr name="DirXML-sapPActions" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="employeeStatus" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after($current-node, '#STAT2=')" />
													</arg-string>
												</do-set-local-variable>
												<do-break />
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								