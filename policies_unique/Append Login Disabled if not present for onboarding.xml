<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Append Login Disabled if not present for onboarding</description>
									<comment xml:space="preserve">If Login Disabled is not present in the add event, append it</comment>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="drv.entitlement.Account.onboard" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="Login Disabled" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="Login Disabled">
											<arg-value type="string">
												<token-text xml:space="preserve">false</token-text>
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							