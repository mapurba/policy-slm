<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation-data for Remove-association operations</description>
									<comment xml:space="preserve">Add operation-data for Remove-association operations</comment>
									<conditions>
										<or>
											<if-operation mode="nocase" op="equal">remove-association</if-operation>
										</or>
										<or>
											<if-xpath op="not-true">operation-data</if-xpath>
										</or>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="operation-data" />
									</actions>
								</rule>
							