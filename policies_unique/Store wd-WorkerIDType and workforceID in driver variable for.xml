<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Store wd-WorkerIDType and workforceID in driver variable for user</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="gvWorkersMergeIDV" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-association op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="DV-wd-Association-user" scope="driver">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="DV-wd-WorkforceID-user" scope="driver">
													<arg-string>
														<token-xpath expression="substring-after($DV-wd-Association-user,'-')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="DV-wd-WorkerIDType-user" scope="driver">
													<arg-string>
														<token-xpath expression="substring-before($DV-wd-Association-user,'-')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-op-association>
													<arg-association>
														<token-local-variable name="DV-wd-WorkforceID-user" />
													</arg-association>
												</do-set-op-association>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								