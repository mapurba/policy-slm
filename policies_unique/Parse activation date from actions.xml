<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Parse activation date from actions</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.bl.activation.parsefromactions" op="equal">true</if-global-variable>
											<if-op-attr name="DirXML-sapPActions" op="available" />
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation op="equal">sync</if-operation>
											<if-global-variable mode="nocase" name="drv.bl.activation.parsefromactions" op="equal">true</if-global-variable>
											<if-src-attr name="DirXML-sapPActions" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Check for Activation Actions ...</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',10),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-op-attr name="DirXML-sapPActions" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="action" scope="policy">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="regex" name="drv.bl.activation.massn" op="equal">.+</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="massn" scope="policy">
															<arg-string>
																<token-xpath expression="substring-before(substring-after($action, '#MASSN='), '#')" />
															</arg-string>
														</do-set-local-variable>
														<do-for-each>
															<arg-node-set>
																<token-global-variable name="drv.bl.activation.massn" />
															</arg-node-set>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="current-node" op="equal">$massn$</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="activationDateStr" scope="policy">
																			<arg-string>
																				<token-xpath expression="substring-before(substring-after($action, '#BEGDA='), '#')" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
														</do-for-each>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="activationDateStr" scope="policy">
															<arg-string>
																<token-xpath expression="substring-before(substring-after($action, '#BEGDA='), '#')" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								