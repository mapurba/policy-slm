<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Relation: Create CN for Job relation</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDRelation</if-class-name>
											<if-global-variable mode="nocase" name="gvRelationNameMappingAttr" op="not-equal">Custom</if-global-variable>
											<if-attr name="~gvRelationNameMappingAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="WDRelation" name="CN">
											<arg-value type="string">
												<token-attr name="~gvRelationNameMappingAttr~" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								