<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Group Placement</description>
									<conditions>
										<and>
											<if-class-name op="equal">Group</if-class-name>
											<if-global-variable name="driver.gw.Groups" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="driver.gw.SubSyncDestLocation" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-break />
									</actions>
								</rule>
								