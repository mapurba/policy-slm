<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Get Audit Logging Type</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="auditLogEventType" scope="driver">
											<arg-string>
												<token-src-attr class-name="DirXML-DriverSet" name="DirXML-LogEventsType">
													<arg-dn>
														<token-replace-first regex="\\[^\\]+$" replace-with="">
															<token-global-variable name="dirxml.auto.driverdn" />
														</token-replace-first>
													</arg-dn>
												</token-src-attr>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
							