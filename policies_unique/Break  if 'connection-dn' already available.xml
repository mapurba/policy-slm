<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break  if 'connection-dn' already available</description>
									<conditions>
										<or>
											<if-xml-attr name="connection-dn" op="available" />
										</or>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">string-length(@connection-dn)&gt;0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-break />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								