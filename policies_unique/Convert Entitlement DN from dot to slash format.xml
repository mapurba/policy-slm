<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Convert Entitlement DN from dot to slash format</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-reformat-op-attr name="Distribution List DN">
											<arg-value type="dn">
												<token-parse-dn dest-dn-format="slash" src-dn-format="dot">
													<token-local-variable name="current-value" />
												</token-parse-dn>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							