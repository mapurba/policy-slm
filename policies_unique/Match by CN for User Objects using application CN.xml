<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match by CN for User Objects using application CN</description>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="app-query" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subordinates">
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
											</arg-dn>
											<arg-match-attr name="CN" />
										</do-find-matching-object>
										<do-break />
									</actions>
								</rule>
								