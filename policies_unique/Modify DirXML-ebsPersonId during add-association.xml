<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Modify DirXML-ebsPersonId during add-association</description>
									<comment xml:space="preserve">Update attribute DirXML-ebsPersonId with the value generated in Oracle EBS during employee creation.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="User" name="DirXML-ebsPersonId">
											<arg-value type="int">
												<token-xpath expression="." />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							