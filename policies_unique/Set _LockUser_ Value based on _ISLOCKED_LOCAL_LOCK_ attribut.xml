<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set "LockUser" Value based on "ISLOCKED:LOCAL_LOCK" attribute value.</description>
									<conditions>
										<or>
											<if-op-property mode="nocase" name="ig-account-collection-query" op="equal">true</if-op-property>
										</or>
										<or>
											<if-op-attr name="ISLOCKED:LOCAL_LOCK" op="available" />
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">US</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr mode="nocase" name="ISLOCKED:LOCAL_LOCK" op="equal">L</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-rename-op-attr dest-name="LOCKUSER" src-name="ISLOCKED:LOCAL_LOCK" />
												<do-reformat-op-attr name="LOCKUSER">
													<arg-value type="string">
														<token-text xml:space="preserve">1</token-text>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions>
												<do-rename-op-attr dest-name="LOCKUSER" src-name="ISLOCKED:LOCAL_LOCK" />
												<do-reformat-op-attr name="LOCKUSER">
													<arg-value type="string">
														<token-text xml:space="preserve">0</token-text>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							