<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set BBObjectType for class Group</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-op-attr name="BBObjectType" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-src-dn op="in-subtree">$bb-course-subtree$</if-src-dn>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="BBObjectType">
													<arg-string>
														<token-text xml:space="preserve">DirXML-BB-Course</token-text>
													</arg-string>
												</do-set-op-property>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-src-dn op="in-subtree">$bb-organization-subtree$</if-src-dn>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="BBObjectType">
													<arg-string>
														<token-text xml:space="preserve">DirXML-BB-Organization</token-text>
													</arg-string>
												</do-set-op-property>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								