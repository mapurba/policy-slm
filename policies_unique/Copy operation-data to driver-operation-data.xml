<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Copy operation-data to driver-operation-data</description>
									<conditions>
										<and>
											<if-xpath op="true">operation-data</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="driver-operation-data" />
										<do-clone-xpath dest-expression="driver-operation-data" src-expression="operation-data" />
									</actions>
								</rule>
							