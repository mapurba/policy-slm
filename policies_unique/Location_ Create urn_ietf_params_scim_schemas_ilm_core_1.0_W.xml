<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Location: Create urn:ietf:params:scim:schemas:ilm:core:1.0:WDLocation:wd-LocationName for Location</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDLocation</if-class-name>
											<if-global-variable mode="nocase" name="gvLocationNameMappingAttr" op="not-equal">Custom</if-global-variable>
											<if-attr name="~gvLocationNameMappingAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="WDLocation" name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDLocation:wd-LocationName">
											<arg-value type="string">
												<token-attr name="~gvLocationNameMappingAttr~" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								