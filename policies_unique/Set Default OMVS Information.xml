<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Default OMVS Information</description>
									<comment xml:space="preserve">When new users are created, this rule populates the OMVS segment with global values stored in the OVMS GCV's.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="DirXML-RACF-omvs-program">
											<arg-value type="string">
												<token-global-variable name="racf-default-omvs-program" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="DirXML-RACF-omvs-home">
											<arg-value type="string">
												<token-global-variable name="racf-default-omvs-home" />
												<token-attr name="CN" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
								