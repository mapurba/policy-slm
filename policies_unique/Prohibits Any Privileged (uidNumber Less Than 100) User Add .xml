<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Prohibits Any Privileged (uidNumber Less Than 100) User Add Events </description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="exclude-privileged" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">add</if-operation>
											<if-xpath op="true">add-attr[@attr-name='uidNumber']/value[number(.) &lt; 100]</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								