<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match on Groups EMail Address</description>
									<comment xml:space="preserve">Groups should be matched on their unique identifier. In Google, this is the group's email address. By default, the IDV attribute mapping for EmailAddress is DirXML-GAGroupEMailAddress.</comment>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="DirXML-GAGroupEMailAddress">
												<arg-value type="string">
													<token-local-variable name="lv-GroupEmailAddr" />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
									</actions>
								</rule>
							