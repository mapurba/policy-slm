<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove GUID attribute from User Events</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
										</or>
										<or>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</or>
										<or>
											<if-op-attr name="GUID" op="available" />
										</or>
									</conditions>
									<actions>
										<do-strip-op-attr name="GUID" />
									</actions>
								</rule>
							