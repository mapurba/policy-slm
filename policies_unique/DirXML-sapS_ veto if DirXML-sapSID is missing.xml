<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-sapS: veto if DirXML-sapSID is missing</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-sapS</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="DirXML-sapSID" />
									</actions>
								</rule>
								