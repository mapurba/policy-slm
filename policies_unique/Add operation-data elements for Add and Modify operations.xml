<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation-data elements for Add and Modify operations</description>
									<comment xml:space="preserve">Add dest-dn, tree-name, and user-id to operation data</comment>
									<conditions>
										<or>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-operation mode="case" op="equal">modify</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-append-xml-element expression="operation-data" name="dest-dn" />
										<do-append-xml-text expression="operation-data/dest-dn">
											<arg-string>
												<token-dest-dn />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="operation-data" name="tree-name" />
										<do-append-xml-text expression="operation-data/tree-name">
											<arg-string>
												<token-global-variable name="dirxml.auto.treename" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="operation-data" name="user-id" />
										<do-append-xml-text expression="operation-data/user-id">
											<arg-string>
												<token-src-dn />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
								