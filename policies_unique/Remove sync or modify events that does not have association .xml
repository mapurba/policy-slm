<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove sync or modify events that does not have association value</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Account" op="equal">true</if-global-variable>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="regex" op="equal">sync|modify</if-operation>
											<if-association op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="." />
									</actions>
								</rule>
								