<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>IDM Date to GroupWise Date Conversion for External Entity</description>
									<comment xml:space="preserve">IDM Date to GroupWise Date Conversion for 'NGW: Mailbox Expiration Time' attribute for External Entity Object types.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">GroupWise External Entity</if-class-name>
											<if-op-attr name="NGW: Mailbox Expiration Time" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="case" op="equal">modify</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="varLogExpTime" scope="policy">
													<arg-string>
														<token-xpath expression="./*[@attr-name=&quot;NGW: Mailbox Expiration Time&quot;]/add-value/value/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="numeric" name="varLogExpTime" op="gt">1</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="varLogExpTime" scope="policy">
															<arg-string>
																<token-xpath expression="int:new($varLogExpTime * 1000)" />
															</arg-string>
														</do-set-local-variable>
														<do-reformat-op-attr name="NGW: Mailbox Expiration Time">
															<arg-value type="time">
																<token-local-variable name="varLogExpTime" />
															</arg-value>
														</do-reformat-op-attr>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							