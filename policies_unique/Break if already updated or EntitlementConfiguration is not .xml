<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if already updated or EntitlementConfiguration is not initialized</description>
									<conditions>
										<or>
											<if-local-variable mode="nocase" name="FanOutMiscUpdated" op="equal">true</if-local-variable>
											<if-local-variable mode="nocase" name="entConfigInitialized" op="not-equal">true</if-local-variable>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								