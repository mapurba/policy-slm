<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>add-association: add prefix derived from DirXML-Accounts value.</description>
									<comment xml:space="preserve">For account add-association commands, modify the association returned from the shim with a prefix value that records the DirXML-Accounts value data from which the account was created.</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add-association</if-operation>
											<if-xpath op="true">starts-with(.,'account/')</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="shim-association" scope="policy">
											<arg-string>
												<token-xpath expression="./text()" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="association-prefix" scope="policy">
											<arg-string>
												<token-op-property name="association-prefix" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="./text()" />
										<do-append-xml-text before="operation-data" expression=".">
											<arg-string>
												<token-local-variable name="association-prefix" />
												<token-text xml:space="preserve">@</token-text>
												<token-local-variable name="shim-association" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
								