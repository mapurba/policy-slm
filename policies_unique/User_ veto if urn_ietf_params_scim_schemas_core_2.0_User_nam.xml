<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User: veto if urn:ietf:params:scim:schemas:core:2.0:User:name.familyName or urn:ietf:params:scim:schemas:core:2.0:User:name.givenName is missing</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
									</actions>
								</rule>
								