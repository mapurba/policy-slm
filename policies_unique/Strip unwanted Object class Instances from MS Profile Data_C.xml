<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip unwanted Object class Instances from MS Profile Data
Collection</description>
									<comment xml:space="preserve">When MSGW Driver Queries the Connected
System we will get Computer Objects if connected system is DSFW or AD - which
is invalid.Stripping off those classes here.</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">instance</if-operation>
											<if-xpath op="true">starts-with(operation-data/msgw-data-collection/@end-point-url,'/idvdata/profiles/ms/')</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-split csv="true" delimiter=",">
													<token-global-variable name="strip-objectClass" />
												</token-split>
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-xml-attr mode="nocase" name="class-name" op="equal">$current-node$</if-xml-attr>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">=== Strip MS Profile Data
Collection Query Result Computer Instance </token-text>
																<token-xpath expression="@src-dn" />
																<token-text xml:space="preserve"> ===</token-text>
															</arg-string>
														</do-trace-message>
														<do-strip-xpath expression="." />
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							