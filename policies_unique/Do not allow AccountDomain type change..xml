<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Do not allow AccountDomain type change.</description>
									<comment xml:space="preserve">Once an AccountDomain is created with a type do not allow type change.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">DirXML-PUMAccountDomain</if-class-name>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-op-attr name="DirXML-pumAccDomType" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-status level="warning">
											<arg-string>
												<token-text xml:space="preserve">Changing the type of the AccountDomain via the Driver is not allowed.</token-text>
											</arg-string>
										</do-status>
										<do-veto />
									</actions>
								</rule>
								