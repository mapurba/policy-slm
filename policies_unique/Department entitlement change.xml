<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Department entitlement change</description>
									<comment name="lastchanged" xml:space="preserve">Account entitlement change (Delete Option)</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Department" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="Department" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="Department" />
											</arg-node-set>
											<arg-actions>
												<do-add-dest-attr-value class-name="User" name="department">
													<arg-value type="string">
														<token-text xml:space="preserve">NULL</token-text>
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="Department" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="departmentId" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value class-name="User" name="department">
													<arg-value type="string">
														<token-local-variable name="departmentId" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							