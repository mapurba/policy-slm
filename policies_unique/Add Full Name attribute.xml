<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Full Name attribute</description>
									<comment xml:space="preserve">Generate a Full Name from the mandatory Given Name and Surname attributes</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="Full Name">
											<arg-value type="string">
												<token-op-attr name="Given Name" />
												<token-text xml:space="preserve"> </token-text>
												<token-op-attr name="Surname" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							