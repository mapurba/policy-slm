<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Required Surname for User Objects using Association</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-attr name="Surname" op="not-available" />
											<if-association op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="Surname">
											<arg-value type="string">
												<token-association />
											</arg-value>
										</do-add-dest-attr-value>
										<do-break />
									</actions>
								</rule>
							