<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check association</description>
									<conditions>
										<and>
											<if-class-name op="available" />
											<if-operation op="equal">instance</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="isInstance">
											<arg-string>
												<token-text xml:space="preserve">(</token-text>
												<token-association />
												<token-text xml:space="preserve">)</token-text>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								