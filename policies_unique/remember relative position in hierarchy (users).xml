<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>remember relative position in hierarchy (users)</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-src-dn op="in-subtree" xml:space="preserve">~idv.dit.data.users~</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="unmatched-src-dn">
											<arg-string>
												<token-unmatched-src-dn convert="true" />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
								