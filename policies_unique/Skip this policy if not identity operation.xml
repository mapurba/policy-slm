<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Skip this policy if not identity operation</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="not-equal">identity</if-class-name>
											<if-xpath op="not-true">./search-class[@class-name='identity']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								