<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Query and Store Driver Entry ID</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="driver-entry-id" scope="driver">
											<arg-string>
												<token-query class-name="Driver" datastore="src" scope="entry">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-dn>
													<arg-string>
														<token-text xml:space="preserve">urn:ietf:params:scim:schemas:ilm:core:1.0:Driver:id</token-text>
													</arg-string>
												</token-query>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
							