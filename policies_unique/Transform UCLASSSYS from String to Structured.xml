<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform UCLASSSYS from String to Structured</description>
									<conditions>
										<or />
									</conditions>
									<actions>
										<do-reformat-op-attr name="UCLASSSYS">
											<arg-value type="structured">
												<arg-component name="RCVSYSTEM">
													<token-xpath expression="substring-before($current-value, ':')" />
												</arg-component>
												<arg-component name="LIC_TYPE">
													<token-xpath expression="substring-after($current-value, ':')" />
												</arg-component>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							