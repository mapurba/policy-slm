<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Dummy Attribute for Group Entitlement</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.entitlement.Group" op="equal">true</if-global-variable>
											<if-entitlement name="Group" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="Group Membership">
											<arg-value />
										</do-set-dest-attr-value>
									</actions>
								</rule>
							