<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Location: Create CN for Location</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">wd-Location</if-class-name>
											<if-attr name="wd-LocationID" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="wd-Location" name="CN">
											<arg-value type="string">
												<token-attr name="wd-LocationID" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							