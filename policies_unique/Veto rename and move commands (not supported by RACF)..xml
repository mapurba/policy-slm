<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto rename and move commands (not supported by RACF).</description>
									<conditions>
										<or>
											<if-operation op="equal">rename</if-operation>
											<if-operation op="equal">move</if-operation>
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							