<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Change the Responsibility class name</description>
									<comment xml:space="preserve">Change the 'Responsibility' search class name for data collection related queries.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-op-property mode="nocase" name="data-collection-query" op="equal">true</if-op-property>
											<if-class-name mode="nocase" op="equal">ORACLEEBSRESP</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-op-class-name>
											<arg-string>
												<token-text xml:space="preserve">RESPDATAC</token-text>
											</arg-string>
										</do-set-op-class-name>
										<do-strip-xpath expression="search-class" />
									</actions>
								</rule>
							