<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip attempted modification of urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ADAliasName (SharePoint LoginName)</description>
									<comment xml:space="preserve">Modification of LoginName in sharepoint generates a separate rename event. So veto any modify event on LoginName (urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ADAliasName).</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">modify</if-operation>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ADAliasName" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ADAliasName" />
									</actions>
								</rule>
							