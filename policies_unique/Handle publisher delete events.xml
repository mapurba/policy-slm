<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Handle publisher delete events</description>
									<comment xml:space="preserve">Converts user delete operation to remove association and veto the delete event</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">delete</if-operation>
										</and>
									</conditions>
									<actions>
										<do-remove-association direct="true">
											<arg-association>
												<token-association />
											</arg-association>
										</do-remove-association>
										<do-veto />
									</actions>
								</rule>
							