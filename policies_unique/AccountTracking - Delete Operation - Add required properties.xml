<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Delete Operation - Add required properties to current doc for future use</description>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">delete|remove-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="AccountTracking-Operation">
											<arg-string>
												<token-operation />
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="AccountTracking-association">
											<arg-string>
												<token-src-dn />
											</arg-string>
										</do-set-op-property>
										<do-for-each>
											<arg-node-set>
												<token-query class-name="User" datastore="dest" scope="entry">
													<arg-association>
														<token-association />
													</arg-association>
													<arg-string>
														<token-text xml:space="preserve">dn</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="var-ObjectDN">
													<arg-string>
														<token-xpath expression="$current-node/@src-dn" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-for-each>
										<do-set-op-property name="AccountTracking-ObjectDN">
											<arg-string>
												<token-local-variable name="var-ObjectDN" />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
								