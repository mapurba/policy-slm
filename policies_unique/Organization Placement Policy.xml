<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Organization Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">wd-organization</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="dn" scope="policy">
											<arg-string>
												<token-global-variable name="gvOrganizationPlacementContainer" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="CN" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="association">
											<arg-string>
												<token-association />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								