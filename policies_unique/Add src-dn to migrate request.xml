<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add src-dn to migrate request</description>
									<conditions>
										<and>
											<if-op-attr name="migrate" op="available" />
										</and>
									</conditions>
									<actions>
										<do-remove-dest-attr-value class-name="DirXML-sapO" name="DirXML-Associations">
											<arg-value type="structured">
												<arg-component name="nameSpace">
													<token-text xml:space="preserve">1</token-text>
												</arg-component>
												<arg-component name="volume">
													<token-global-variable name="dirxml.auto.driverdn" />
												</arg-component>
												<arg-component name="path">
													<token-association />
												</arg-component>
											</arg-value>
										</do-remove-dest-attr-value>
										<do-add-dest-attr-value class-name="DirXML-sapO" name="DirXML-Associations">
											<arg-value type="structured">
												<arg-component name="nameSpace">
													<token-text xml:space="preserve">4</token-text>
												</arg-component>
												<arg-component name="volume">
													<token-global-variable name="dirxml.auto.driverdn" />
												</arg-component>
												<arg-component name="path">
													<token-association />
												</arg-component>
											</arg-value>
										</do-add-dest-attr-value>
										<do-strip-op-attr name="migrate" />
									</actions>
								</rule>
							