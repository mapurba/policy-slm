<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add class-name for query-ex</description>
									<conditions>
										<and>
											<if-operation op="equal">query-ex</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="." name="class-name">
											<arg-string>
												<token-text xml:space="preserve">team</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							