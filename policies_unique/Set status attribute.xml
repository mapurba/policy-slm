<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set status attribute</description>
									<comment xml:space="preserve">Set the Sentinel attribute in the current operation and remove the working eDir attributes.</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="account" name="status">
											<arg-value type="string">
												<token-local-variable name="account-status" />
											</arg-value>
										</do-add-dest-attr-value>
										<do-strip-xpath expression="*[@attr-name='App-Status']|*[@attr-name='Vault-Status']" />
									</actions>
								</rule>
							