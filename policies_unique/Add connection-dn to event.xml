<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add connection-dn to event</description>
									<conditions>
										<and>
											<if-op-property name="connection-dn" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="." name="connection-dn">
											<arg-string>
												<token-xpath expression="operation-data/@connection-dn" />
											</arg-string>
										</do-set-xml-attr>
										<do-strip-op-attr name="connection-dn" />
									</actions>
								</rule>
							