<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Destination DN for remove-association</description>
									<conditions>
										<and>
											<if-operation op="equal">remove-association</if-operation>
											<if-dest-dn op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-local-variable name="SourceDN" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							