<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Disable Users with Revoked Entitlements</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="UserAcctPolicy" op="equal">entitlements</if-global-variable>
											<if-global-variable name="on-account-remove" op="equal">disable</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="ACF2 Logonid" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="ACF2 Logonid" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text>true</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="ACF2 Logonid" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text>false</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							