<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Prepare for entitlement processing</description>
									<conditions>
										<and>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:dirXMLEntitlementRef" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-association op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lsname" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after(substring-before(association/text(), '\USd'),'\')" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="lsname" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before(substring-after(@dest-dn, '\'),'\')" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								