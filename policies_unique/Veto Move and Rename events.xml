<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto Move and Rename events</description>
									<comment xml:space="preserve">Ignore the unsupported events of AccountDomain and Credential classes.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">move</if-operation>
										</and>
										<and>
											<if-operation mode="nocase" op="equal">rename</if-operation>
											<if-class-name mode="nocase" op="equal">DirXML-PUMCredential</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-operation />
												<token-text xml:space="preserve"> operation is not supported.</token-text>
											</arg-string>
										</do-trace-message>
										<do-status level="warning">
											<arg-string>
												<token-operation />
												<token-text xml:space="preserve"> operation is not supported.</token-text>
											</arg-string>
										</do-status>
										<do-veto />
									</actions>
								</rule>
								