<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Create LLID Mapping table</description>
									<conditions />
									<actions>
										<do-set-local-variable name="llid-map-xml" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;mapping-table&gt;&lt;col-def name="entitlementName"/&gt;&lt;col-def name="LLID"/&gt;&lt;col-def name="resourceDN"/&gt;&lt;/mapping-table&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="connDnNS" scope="policy">
											<arg-node-set>
												<token-xpath expression="$shimConfigInfo1/driver-config/subscriber-options/configuration-values/definitions/group/subordinates/definition/value/instance/definition[@name='drv.connection.dn']/value" />
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="entitlements" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-Entitlement" datastore="src" scope="subordinates">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-dn>
													<arg-string>
														<token-text xml:space="preserve">CN</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="connDnNS" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="domainConnection" scope="policy">
													<arg-node-set>
														<token-query class-name="DirXML-Resource" datastore="src" scope="entry">
															<arg-dn>
																<token-local-variable name="current-node" />
															</arg-dn>
															<arg-string>
																<token-text xml:space="preserve">DirXML-Data</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="connXML" scope="driver">
													<arg-node-set>
														<token-xml-parse>
															<token-base64-decode>
																<token-xpath expression="$domainConnection/attr/value" />
															</token-base64-decode>
														</token-xml-parse>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="connName" scope="policy">
													<arg-string>
														<token-xpath expression="$connXML/connection/authentication-info/domain/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="domainDN" scope="policy">
													<arg-string>
														<token-local-variable name="connName" />
													</arg-string>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="entitlements" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="entName" scope="policy">
															<arg-node-set>
																<token-xpath expression="$current-node/attr[@attr-name='CN']/value[1]/text()" />
															</arg-node-set>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="entName" op="equal">ExchangeMailbox</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-xpath op="true">$connXML/connection/authentication-info/domain/@root='true'</if-xpath>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-append-xml-element expression="$llid-map-xml/mapping-table" name="row" />
																		<do-append-xml-element expression="$llid-map-xml/mapping-table/row[last()]" name="col" />
																		<do-append-xml-text expression="$llid-map-xml/mapping-table/row[last()]/col[last()]">
																			<arg-string>
																				<token-local-variable name="entName" />
																			</arg-string>
																		</do-append-xml-text>
																		<do-append-xml-element expression="$llid-map-xml/mapping-table/row[last()]" name="col" />
																		<do-append-xml-text expression="$llid-map-xml/mapping-table/row[last()]/col[last()]">
																			<arg-string>
																				<token-replace-first regex="dc=" replace-with="">
																					<token-parse-dn dest-dn-format="ldap" length="1" src-dn-format="ldap" start="-1">
																						<token-local-variable name="domainDN" />
																					</token-parse-dn>
																				</token-replace-first>
																			</arg-string>
																		</do-append-xml-text>
																		<do-append-xml-element expression="$llid-map-xml/mapping-table/row[last()]" name="col" />
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
															<arg-actions>
																<do-append-xml-element expression="$llid-map-xml/mapping-table" name="row" />
																<do-append-xml-element expression="$llid-map-xml/mapping-table/row[last()]" name="col" />
																<do-append-xml-text expression="$llid-map-xml/mapping-table/row[last()]/col[last()]">
																	<arg-string>
																		<token-local-variable name="entName" />
																	</arg-string>
																</do-append-xml-text>
																<do-append-xml-element expression="$llid-map-xml/mapping-table/row[last()]" name="col" />
																<do-append-xml-text expression="$llid-map-xml/mapping-table/row[last()]/col[last()]">
																	<arg-string>
																		<token-replace-first regex="dc=" replace-with="">
																			<token-parse-dn dest-dn-format="ldap" length="1" src-dn-format="ldap" start="-1">
																				<token-local-variable name="domainDN" />
																			</token-parse-dn>
																		</token-replace-first>
																	</arg-string>
																</do-append-xml-text>
																<do-append-xml-element expression="$llid-map-xml/mapping-table/row[last()]" name="col" />
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-for-each>
										<do-set-src-attr-value class-name="DirXML-Resource" name="DirXML-Data">
											<arg-dn>
												<token-global-variable name="dirxml.auto.driverdn" />
												<token-text xml:space="preserve">\EntitlementLLIDMapping</token-text>
											</arg-dn>
											<arg-value type="string">
												<token-xml-serialize>
													<token-local-variable name="llid-map-xml" />
												</token-xml-serialize>
											</arg-value>
										</do-set-src-attr-value>
										<do-set-src-attr-value class-name="DirXML-Resource" name="ACL">
											<arg-dn>
												<token-global-variable name="dirxml.auto.driverdn" />
												<token-text xml:space="preserve">\EntitlementLLIDMapping</token-text>
											</arg-dn>
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">[Entry Rights]</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-global-variable name="dirxml.auto.driverdn" />
													<token-text xml:space="preserve">\PermissionOnboarding</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">1</token-text>
												</arg-component>
											</arg-value>
										</do-set-src-attr-value>
										<do-add-src-attr-value class-name="DirXML-Resource" name="ACL">
											<arg-dn>
												<token-global-variable name="dirxml.auto.driverdn" />
												<token-text xml:space="preserve">\EntitlementLLIDMapping</token-text>
											</arg-dn>
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">[All Attributes Rights]</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-global-variable name="dirxml.auto.driverdn" />
													<token-text xml:space="preserve">\PermissionOnboarding</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">39</token-text>
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
									</actions>
								</rule>
							