<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat User's National ID as per GCV</description>
									<comment xml:space="preserve">Reformat user's National ID as per GCV</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="wd-NationalID" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="gvNIDPattern" op="equal">NIDLast4</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-reformat-op-attr name="wd-NationalID">
													<arg-value type="string">
														<token-substring length="-4" start="-4">
															<token-op-attr name="wd-NationalID" />
														</token-substring>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="gvNIDPattern" op="equal">NIDFull</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-reformat-op-attr name="wd-NationalID">
													<arg-value type="string">
														<token-substring length="-1" start="0">
															<token-op-attr name="wd-NationalID" />
														</token-substring>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								