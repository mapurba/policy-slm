<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Roaming User: Roam Server Sub-directory</description>
									<conditions>
										<and>
											<if-global-variable name="account.roamserversubdir" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="roaming-subdir">
											<arg-string>
												<token-global-variable name="account.roamserversubdir" />
												<token-attr name="Given Name" />
												<token-attr name="Surname" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								