<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Enable custom entitlement for RBPM</description>
									<conditions />
									<actions>
										<do-set-local-variable name="entiConfigurationResObj" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-Resource" datastore="src" scope="entry">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
														<token-text xml:space="preserve">\EntitlementConfiguration</token-text>
													</arg-dn>
													<arg-match-attr name="DirXML-ContentType">
														<arg-value type="string">
															<token-text xml:space="preserve">text/vnd.novell.idm.entitlementConfiguration+xml</token-text>
														</arg-value>
													</arg-match-attr>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="entiConfigDn">
											<arg-string>
												<token-parse-dn dest-dn-format="ldap" src-dn-format="qualified-slash">
													<token-xpath expression="$entiConfigurationResObj/@qualified-src-dn" />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="currentDriverDn">
											<arg-string>
												<token-xpath expression="substring-after($entiConfigDn,'CN=EntitlementConfiguration,')" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="currentXml" scope="policy">
											<arg-node-set>
												<token-document>
													<arg-string>
														<token-text xml:space="preserve">vnd.nds.stream:</token-text>
														<token-text xml:space="preserve">/</token-text>
														<token-parse-dn dest-dn-delims="00,/+=*\" dest-dn-format="custom" src-dn-format="slash">
															<token-xpath expression="$entiConfigurationResObj/@src-dn" />
														</token-parse-dn>
														<token-text xml:space="preserve">#</token-text>
														<token-text xml:space="preserve">DirXML-Data</token-text>
													</arg-string>
												</token-document>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="locTables" scope="policy">
											<arg-node-set>
												<token-query datastore="src">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-dn>
													<arg-match-attr name="CN">
														<arg-value type="string">
															<token-text xml:space="preserve">L10N*</token-text>
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">CN</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="drv.custom.entitlementNames" />
											</arg-node-set>
											<arg-actions>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">Processing entitlement configuration for custom entitlement $current-node$ </token-text>
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="currentCustomEntitlement">
													<arg-string>
														<token-text xml:space="preserve">CN=</token-text>
														<token-local-variable name="current-node" />
														<token-text xml:space="preserve">,</token-text>
														<token-local-variable name="currentDriverDn" />
													</arg-string>
												</do-set-local-variable>
												<do-strip-xpath expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]" />
												<do-append-xml-element expression="$currentXml/entitlement-configuration/entitlements" name="entitlement" />
												<do-set-xml-attr expression="$currentXml/entitlement-configuration/entitlements/entitlement[last()]" name="dn">
													<arg-string>
														<token-local-variable name="currentCustomEntitlement" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="entiDataCollection" scope="policy">
													<arg-string>
														<token-global-variable name="drv.datacollection.$current-node$" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="entiDataCollection" op="not-equal">true|false</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="entiDataCollection" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">false</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]" name="data-collection">
													<arg-string>
														<token-local-variable name="entiDataCollection" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="entiResourceMapping" scope="policy">
													<arg-string>
														<token-global-variable name="drv.resourcemapping.$current-node$" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="entiResourceMapping" op="not-equal">true|false</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="entiResourceMapping" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]" name="resource-mapping">
													<arg-string>
														<token-local-variable name="entiResourceMapping" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="entiRoleMapping" scope="policy">
													<arg-string>
														<token-global-variable name="drv.rolemapping.$current-node$" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="entiRoleMapping" op="not-equal">true|false</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="entiRoleMapping" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]" name="role-mapping">
													<arg-string>
														<token-local-variable name="entiRoleMapping" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="entiParameterFormat" scope="policy">
													<arg-string>
														<token-global-variable name="drv.entitlement.format.$current-node$" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="entiParameterFormat" op="not-equal">idm4|legacy</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="entiParameterFormat" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">idm4</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]" name="parameter-format">
													<arg-string>
														<token-local-variable name="entiParameterFormat" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="entiCprsSupported" scope="policy">
													<arg-string>
														<token-global-variable name="drv.cprssupported.$current-node$" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="entiCprsSupported" op="not-equal">true|false</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="entiCprsSupported" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-append-xml-element expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]" name="type" />
												<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]/type[last()]" name="id">
													<arg-string>
														<token-text xml:space="preserve">$current-node$</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]/type[last()]" name="name">
													<arg-string>
														<token-text xml:space="preserve">$current-node$</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]/type[last()]" name="category">
													<arg-string>
														<token-text xml:space="preserve">Custom Entitlement</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]/type[last()]" name="display-name" />
												<do-set-local-variable name="entiName" scope="policy">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="locTables" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="locTableDN" scope="policy">
															<arg-string>
																<token-xpath expression="$current-node/@src-dn" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="langCode" scope="policy">
															<arg-string>
																<token-xpath expression="substring-after($current-node/attr[@attr-name='CN']/value[1], 'L10N_')" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="value" scope="policy">
															<arg-string>
																<token-map dest="value" src="key" table="$locTableDN$">
																	<token-text xml:space="preserve">ent$entiName$DisplayName</token-text>
																</token-map>
															</arg-string>
														</do-set-local-variable>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">localizing $entName$ entitlement display name: $langCode$: $value$</token-text>
															</arg-string>
														</do-trace-message>
														<do-append-xml-element expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]/type[last()]/display-name[last()]" name="value" />
														<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]/type[last()]/display-name[last()]/value[last()]" name="langCode">
															<arg-string>
																<token-local-variable name="langCode" />
															</arg-string>
														</do-set-xml-attr>
														<do-append-xml-text expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]/type[last()]/display-name[last()]/value[last()]">
															<arg-string>
																<token-local-variable name="value" />
															</arg-string>
														</do-append-xml-text>
													</arg-actions>
												</do-for-each>
												<do-set-xml-attr expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]" name="cprs-supported">
													<arg-string>
														<token-local-variable name="entiCprsSupported" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="extensions" scope="policy">
													<arg-node-set>
														<token-xml-parse>
															<token-replace-all regex="&amp;lt;" replace-with="&lt;">
																<token-global-variable name="drv.entitlement.extensions.$current-node$" />
															</token-replace-all>
														</token-xml-parse>
													</arg-node-set>
												</do-set-local-variable>
												<do-clone-xpath dest-expression="$currentXml//entitlement[@dn=$currentCustomEntitlement]" src-expression="$extensions/entitlement-extensions/node()" />
												<do-add-src-attr-value class-name="DirXML-Resource" name="DirXML-Data">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
														<token-text xml:space="preserve">\EntitlementConfiguration</token-text>
													</arg-dn>
													<arg-value type="octet">
														<token-base64-encode>
															<token-xml-serialize>
																<token-local-variable name="currentXml" />
															</token-xml-serialize>
														</token-base64-encode>
													</arg-value>
												</do-add-src-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							