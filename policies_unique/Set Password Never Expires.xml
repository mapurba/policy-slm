<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Password Never Expires</description>
									<comment xml:space="preserve">Set Password Never Expires on newly created User accounts</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">MsolUser</if-class-name>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
											<if-global-variable mode="nocase" name="PasswordNeverExpires" op="equal">true</if-global-variable>
											<if-op-attr name="Password" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="PasswordNeverExpires">
											<arg-value type="state">
												<token-text xml:space="preserve">true</token-text>
											</arg-value>
										</do-add-dest-attr-value>
										<do-append-xml-element expression="../modify/modify-attr[@attr-name=&quot;PasswordNeverExpires&quot;] | ./add-attr[@attr-name=&quot;PasswordNeverExpires&quot;]" name="remove-all-values" />
									</actions>
								</rule>
							