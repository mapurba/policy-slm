<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match Users on Surname and Given Name</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-implement-entitlement>
											<arg-node-set>
												<token-entitlement name="notesAccount2" />
											</arg-node-set>
											<arg-actions>
												<do-find-matching-object scope="subtree">
													<arg-match-attr name="Surname" />
													<arg-match-attr name="Given Name" />
												</do-find-matching-object>
											</arg-actions>
										</do-implement-entitlement>
									</actions>
								</rule>
							