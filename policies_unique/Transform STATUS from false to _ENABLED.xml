<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform STATUS from false to *ENABLED</description>
									<conditions>
										<or>
											<if-op-attr name="STATUS" op="changing-to">false</if-op-attr>
											<if-op-attr name="STATUS" op="changing-from">true</if-op-attr>
										</or>
									</conditions>
									<actions>
										<do-strip-op-attr name="STATUS" />
										<do-set-dest-attr-value name="STATUS">
											<arg-value type="string">
												<token-text xml:space="preserve">*ENABLED</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							