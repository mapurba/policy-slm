<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account Tracking- store old association from modify-association</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">modify-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="oldAssociationValue" scope="driver">
											<arg-string>
												<token-xpath expression="./association" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								