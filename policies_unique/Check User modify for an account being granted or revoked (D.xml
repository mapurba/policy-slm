<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check User modify for an account being granted or revoked (Disable Option)</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.notesAccount2.use" op="equal">true</if-global-variable>
											<if-global-variable name="account.remove" op="equal">disable</if-global-variable>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="notesAccount2" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="notesAccount2" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="notesAccount2" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">false</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								