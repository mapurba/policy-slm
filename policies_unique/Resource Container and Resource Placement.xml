<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Resource Container and Resource Placement</description>
									<conditions>
										<or>
											<if-class-name op="equal">nrfResourceDefs</if-class-name>
											<if-class-name op="equal">nrfResource</if-class-name>
										</or>
										<or>
											<if-op-attr name="OU" op="available" />
										</or>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-op-attr name="OU" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-strip-op-attr name="OU" />
									</actions>
								</rule>
							