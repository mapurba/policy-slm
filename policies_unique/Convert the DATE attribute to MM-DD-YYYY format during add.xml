<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Convert the DATE attribute to MM-DD-YYYY format during add</description>
									<comment xml:space="preserve">Convert the unix time stamp to MM-DD-YYY format.</comment>
									<conditions />
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="add-attr" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="attributename" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/@attr-name" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="attributename" op="equal">.*_DATE.*|.*_DT|.*_UPDATED</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-reformat-op-attr name="$attributename$">
															<arg-value type="string">
																<token-convert-time dest-format="MM/dd/yyyy hh:mm:ss" src-format="!CTIME">
																	<token-op-attr name="$attributename$" />
																</token-convert-time>
															</arg-value>
														</do-reformat-op-attr>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								