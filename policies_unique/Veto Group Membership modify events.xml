<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto Group Membership modify events</description>
									<comment xml:space="preserve">This policy intercepts the modify events on Group Membership attribute and vetoes them,if the event resulted from Group Delete.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="case" op="equal">modify</if-operation>
											<if-global-variable mode="nocase" name="drv.entitlement.onboarding" op="equal">true</if-global-variable>
											<if-global-variable mode="case" name="drv.entitlement.Group.onboard" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">modify-attr[@attr-name='Group Membership']/remove-value</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="removeGroups" scope="policy">
													<arg-node-set>
														<token-xpath expression="modify-attr[@attr-name='Group Membership']/remove-value/value/text()" />
													</arg-node-set>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="removeGroups" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="removeGroup" scope="policy">
															<arg-string>
																<token-local-variable name="current-node" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="objectClass" scope="policy">
															<arg-string>
																<token-src-attr name="Object Class">
																	<arg-dn>
																		<token-local-variable name="removeGroup" />
																	</arg-dn>
																</token-src-attr>
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="case" name="objectClass" op="not-equal">Group</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-veto />
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							