<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Apply user delete deny group option on the user delete event</description>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="account.remove" op="equal">delete</if-global-variable>
											<if-global-variable mode="nocase" name="account.addToDenyAccessGrp" op="equal">true</if-global-variable>
											<if-global-variable name="DenyAccessGrpName" op="available" />
											<if-global-variable name="DenyAccessGrpName" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../delete[@class-name='User']" name="deny-access-group-name">
											<arg-string>
												<token-global-variable name="DenyAccessGrpName" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								