<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reset any chnage in EmployeeType</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-op-attr name="employeeType" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-src-attr mode="nocase" name="wd-WorkerIDType" op="equal">Employee_ID</if-src-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-src-attr-value class-name="User" name="employeeType">
													<arg-value type="string">
														<token-text xml:space="preserve">employee</token-text>
													</arg-value>
												</do-set-src-attr-value>
											</arg-actions>
											<arg-actions>
												<do-set-src-attr-value class-name="User" name="employeeType">
													<arg-value type="string">
														<token-text xml:space="preserve">nonEmployee</token-text>
													</arg-value>
												</do-set-src-attr-value>
											</arg-actions>
										</do-if>
										<do-strip-op-attr name="employeeType" />
									</actions>
								</rule>
							