<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>match users based on configured attribute value</description>
									<comment xml:space="preserve">Set the matching attribute and type in the driver GCVs</comment>
									<comment name="author" xml:space="preserve">Converge</comment>
									<comment name="version" xml:space="preserve">1.0</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="regex" name="pdsepicedcfg.epic.search.attr" op="equal">.+</if-global-variable>
											<if-src-attr mode="regex" name="~pdsepicedcfg.epic.search.attr~" op="equal">.+</if-src-attr>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="~pdsepicedcfg.epic.search.attr~" />
										</do-find-matching-object>
									</actions>
								</rule>
							