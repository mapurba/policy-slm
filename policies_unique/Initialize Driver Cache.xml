<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initialize Driver Cache</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="dvrs" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-Driver">
													<arg-string>
														<token-text xml:space="preserve">GUID</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="DRVR__CACHE" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;cache/&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$dvrs" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="driverGuid" scope="policy">
													<arg-string>
														<token-xpath expression="es:guid2string($current-node/attr[@attr-name='GUID']/value/text())" />
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">Found Driver: </token-text>
														<token-xpath expression="$current-node/@src-dn" />
														<token-text xml:space="preserve"> with GUID: </token-text>
														<token-local-variable name="driverGuid" />
														<token-text xml:space="preserve"> (</token-text>
														<token-xpath expression="$current-node/attr[@attr-name='GUID']/value/text()" />
														<token-text xml:space="preserve">)</token-text>
													</arg-string>
												</do-trace-message>
												<do-append-xml-element expression="$DRVR__CACHE/cache" name="instance" />
												<do-set-xml-attr expression="$DRVR__CACHE/cache/instance[last()]" name="class-name">
													<arg-string>
														<token-text xml:space="preserve">DRIVER_DN</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="dn" scope="policy">
													<arg-string>
														<token-lower-case>
															<token-xpath expression="$current-node/@qualified-src-dn" />
														</token-lower-case>
													</arg-string>
												</do-set-local-variable>
												<do-set-xml-attr expression="$DRVR__CACHE/cache/instance[last()]" name="src-dn">
													<arg-string>
														<token-local-variable name="dn" />
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$DRVR__CACHE/cache/instance[last()]" name="association" />
												<do-append-xml-text expression="$DRVR__CACHE/cache/instance[last()]/association">
													<arg-string>
														<token-local-variable name="driverGuid" />
													</arg-string>
												</do-append-xml-text>
											</arg-actions>
										</do-for-each>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">Initialized driver cache: </token-text>
												<token-xml-serialize>
													<token-local-variable name="DRVR__CACHE" />
												</token-xml-serialize>
											</arg-string>
										</do-trace-message>
									</actions>
								</rule>
								