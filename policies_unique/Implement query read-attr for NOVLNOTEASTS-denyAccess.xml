<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Implement query read-attr for NOVLNOTEASTS-denyAccess</description>
									<comment xml:space="preserve">This rule partially implements queries with a &lt;read-attr attr-name="NOVLNOTEASTS-denyAccess"/&gt;. The other part is done in the input transformation policy.</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">query</if-operation>
											<if-global-variable mode="nocase" name="drv.account.status.DenyAccessGroup.use" op="equal">true</if-global-variable>
											<if-xpath op="true">read-attr[@attr-name='NOVLNOTEASTS-denyAccess']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="NOVLNOTEASTS-handleDenyAccessReadAttr">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
								