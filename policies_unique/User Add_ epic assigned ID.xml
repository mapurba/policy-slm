<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Add: epic assigned ID</description>
									<comment xml:space="preserve">Create EMP and have Epic Assign the id</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="pdsempdcfg.use.epicid.create" op="not-equal">True</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="UserInternalID">
											<arg-value type="string">
												<token-text xml:space="preserve">*</token-text>
											</arg-value>
										</do-set-dest-attr-value>
										<do-break />
									</actions>
								</rule>
								