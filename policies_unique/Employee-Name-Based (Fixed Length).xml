<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Employee-Name-Based (Fixed Length)</description>
									<comment xml:space="preserve">First character of Given Name + up to (length-1) characters of Surname
First character of Given Name + first character of Initials + up to (length-2) characters of Surname
First two characters of Given Name + up to (length-2) characters of Surname
First three characters of Given Name + up to (length-3) characters of Surname
First character of Given Name + up to (length-4) characters of Surname + three digits padded with zeros if necessary starting with 001 and incremented until name is unique within eDirectory
</comment>
									<conditions>
										<and>
											<if-global-variable name="drv.new.user.naming.option" op="equal">2</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="surname" scope="policy">
											<arg-string>
												<token-attr name="Surname" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="obj-name" scope="policy">
											<arg-string>
												<token-unique-name counter-digits="3" counter-pad="true" name="CN" scope="subtree">
													<arg-string>
														<token-lower-case>
															<token-substring length="1">
																<token-attr name="Given Name" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-1)" />
														</token-lower-case>
													</arg-string>
													<arg-string>
														<token-lower-case>
															<token-substring length="1">
																<token-attr name="Given Name" />
															</token-substring>
															<token-substring length="1">
																<token-attr name="Initials" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-2)" />
														</token-lower-case>
													</arg-string>
													<arg-string>
														<token-lower-case>
															<token-substring length="2">
																<token-attr name="Given Name" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-2)" />
														</token-lower-case>
													</arg-string>
													<arg-string>
														<token-lower-case>
															<token-substring length="3">
																<token-attr name="Given Name" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-3)" />
														</token-lower-case>
													</arg-string>
													<arg-string>
														<token-lower-case>
															<token-substring length="1">
																<token-attr name="Given Name" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-4)" />
														</token-lower-case>
													</arg-string>
												</token-unique-name>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								