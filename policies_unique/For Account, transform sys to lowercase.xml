<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>For Account, transform sys to lowercase</description>
									<comment xml:space="preserve">This transforms the value of sys attribute in Account class to lowercase</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">account</if-class-name>
											<if-op-attr name="sys" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="sys">
											<arg-value type="string">
												<token-lower-case>
													<token-op-attr name="sys" />
												</token-lower-case>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							