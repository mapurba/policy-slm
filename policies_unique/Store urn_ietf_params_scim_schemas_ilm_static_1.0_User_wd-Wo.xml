<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Store urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-WorkerIDType and urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID in driver variable for user</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-association op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="DV-wd-FutureHire" scope="driver">
													<arg-string>
														<token-text xml:space="preserve">False</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="DV-wd-Association-user" scope="driver">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="DV-wd-WorkforceID-user" scope="driver">
													<arg-string>
														<token-xpath expression="substring-after($DV-wd-Association-user,'-')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="DV-wd-WorkerIDType-user" scope="driver">
													<arg-string>
														<token-xpath expression="substring-before($DV-wd-Association-user,'-')" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="DV-wd-WorkerIDType-user" op="equal">Employee_ID</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Hiredate" op="available" />
																	<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Hiredate" op="equal">.+</if-op-attr>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="DV-wd-effectiveDate" scope="driver">
																	<arg-string>
																		<token-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Hiredate" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-OriginalHiredate" op="available" />
																			<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-OriginalHiredate" op="equal">.+</if-op-attr>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="DV-wd-effectiveDate" scope="driver">
																			<arg-string>
																				<token-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-OriginalHiredate" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions>
																		<do-set-local-variable name="DV-wd-effectiveDate" scope="policy">
																			<arg-string>
																				<token-time format="yyyy-MM-dd" tz="UTC" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-C-Hiredate" op="available" />
																	<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-C-Hiredate" op="equal">.+</if-op-attr>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="DV-wd-effectiveDate" scope="driver">
																	<arg-string>
																		<token-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-C-Hiredate" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-C-OriginalHiredate" op="available" />
																			<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-C-OriginalHiredate" op="equal">.+</if-op-attr>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="DV-wd-effectiveDate" scope="driver">
																			<arg-string>
																				<token-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-C-OriginalHiredate" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions>
																		<do-set-local-variable name="DV-wd-effectiveDate" scope="policy">
																			<arg-string>
																				<token-time format="yyyy-MM-dd" tz="UTC" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
												<do-set-local-variable name="LV-effective-date" scope="policy">
													<arg-string>
														<token-convert-time dest-format="!CTIME" dest-tz="UTC" src-format="yyyy-MM-dd">
															<token-local-variable name="DV-wd-effectiveDate" />
														</token-convert-time>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="LV-current-date" scope="policy">
													<arg-string>
														<token-time format="!CTIME" tz="UTC" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="numeric" name="LV-effective-date" op="gt">$LV-current-date$</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="DV-wd-FutureHire" scope="driver">
															<arg-string>
																<token-text xml:space="preserve">True</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="DV-wd-FutureHire" scope="driver">
															<arg-string>
																<token-text xml:space="preserve">False</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="DV-wd-effectiveDate" scope="driver">
															<arg-string>
																<token-time format="yyyy-MM-dd" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								