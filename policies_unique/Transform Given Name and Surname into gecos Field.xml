<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Given Name and Surname into gecos Field</description>
									<conditions>
										<and>
											<if-global-variable name="generate-gecos" op="equal">true</if-global-variable>
											<if-operation op="equal">add</if-operation>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="gecos" op="not-available" />
										</and>
										<and>
											<if-global-variable mode="nocase" name="generate-gecos" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="gecos" op="not-available" />
											<if-op-attr name="Given Name" op="changing" />
										</and>
										<and>
											<if-global-variable mode="nocase" name="generate-gecos" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="gecos" op="not-available" />
											<if-op-attr name="Surname" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="gecos">
											<arg-value type="string">
												<token-attr name="Given Name" />
												<token-text xml:space="preserve"> </token-text>
												<token-attr name="Surname" />
											</arg-value>
										</do-add-dest-attr-value>
										<do-strip-op-attr name="Surname" />
										<do-strip-op-attr name="Given Name" />
									</actions>
								</rule>
								