<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>strip operational attributes without value</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.futurevent.enable" op="equal">true</if-global-variable>
											<if-class-name mode="nocase" op="not-equal">DirXML-WorkOrder</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="./modify-attr[count(./add-value/value)=0]" />
										<do-strip-xpath expression="./modify-attr/add-value/future-event" />
									</actions>
								</rule>
							