<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Strong Password Required</description>
									<comment xml:space="preserve">Set this to enforce strong password requirement on user passwords that sync to Office365.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">MsolUser</if-class-name>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
											<if-op-attr name="Password" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="StrongPasswordRequired" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-add-dest-attr-value name="StrongPasswordRequired">
													<arg-value type="state">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-add-dest-attr-value>
												<do-append-xml-element expression="../modify/modify-attr[@attr-name=&quot;StrongPasswordRequired&quot;] | ./add-attr[@attr-name=&quot;StrongPasswordRequired&quot;]" name="remove-all-values" />
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="StrongPasswordRequired" op="equal">false</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-add-dest-attr-value name="StrongPasswordRequired">
															<arg-value type="state">
																<token-text xml:space="preserve">false</token-text>
															</arg-value>
														</do-add-dest-attr-value>
														<do-append-xml-element expression="../modify/modify-attr[@attr-name=&quot;StrongPasswordRequired&quot;] | ./add-attr[@attr-name=&quot;StrongPasswordRequired&quot;]" name="remove-all-values" />
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							