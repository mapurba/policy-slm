<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>On User add,update default password</description>
									<comment xml:space="preserve">Oracle EBS accept only more than 5 chars length password.in case if the surname has lesser than 5 chars, add events will not be processed in EBS.</comment>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="password" />
										<do-set-dest-password>
											<arg-string>
												<token-global-variable name="default-password-subscribe" />
											</arg-string>
										</do-set-dest-password>
									</actions>
								</rule>
							