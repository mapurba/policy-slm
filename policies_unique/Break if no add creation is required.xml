<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if no add creation is required</description>
									<conditions>
										<or>
											<if-local-variable mode="nocase" name="create-add" op="not-equal">true</if-local-variable>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								