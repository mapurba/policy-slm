<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set loginShell</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-src-attr name="loginShell" op="not-available" />
											<if-global-variable name="ModifyUsers" op="equal">true</if-global-variable>
										</and>
										
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable name="ReplaceValues" op="equal">true</if-global-variable>
											<if-global-variable name="ModifyUsers" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-src-attr-value name="loginShell">
											<arg-value type="string">
												<token-global-variable name="LoginShell" />
											</arg-value>
										</do-set-src-attr-value>
									</actions>
								</rule>
							