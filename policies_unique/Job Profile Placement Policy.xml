<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Job Profile Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDJobProfile</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="gvJobProfilePlacementContainer" op="not-equal">Custom</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="gvJobProfilePlacementContainer" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDJobProfile:wd-JobProfileName" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							