<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform authPassword to Login Enabled</description>
									<comment xml:space="preserve">This rule transforms the authPassword attribute to Login Enabled</comment>
									<conditions>
										<and>
											<if-op-attr name="authPassword" op="changing" />
											<if-op-attr mode="regex" name="authPassword" op="not-equal">!.*</if-op-attr>
											<if-op-attr mode="case" name="authPassword" op="not-equal">*LK*</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="Login Disabled">
											<arg-value>
												<token-text xml:space="preserve">false</token-text>
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							