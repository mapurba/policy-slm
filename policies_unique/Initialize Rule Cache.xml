<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initialize Rule Cache</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="ms" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-GlobalConfigDef" datastore="dest">
													<arg-match-attr name="CN">
														<arg-value>
															<token-text xml:space="preserve">MSysInfo</token-text>
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ConfigValues</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="linkage" scope="policy">
											<arg-node-set>
												<token-dest-attr name="DirXML-Policies">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-dn>
												</token-dest-attr>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="smpDn" scope="policy">
											<arg-node-set>
												<token-xpath expression="$linkage[component[@name='interval']/text()='0']/component[@name='dn']/text()" />
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="smp" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-base64-decode>
														<token-dest-attr name="XmlData">
															<arg-dn>
																<token-local-variable name="smpDn" />
															</arg-dn>
														</token-dest-attr>
													</token-base64-decode>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="RULE__CACHE" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;cache/&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="ms" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="driverDn" scope="policy">
													<arg-string>
														<token-parse-dn dest-dn-format="dest-dn" length="-2" src-dn-format="dest-dn">
															<token-xpath expression="$current-node/@src-dn" />
														</token-parse-dn>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="driver" scope="policy">
													<arg-node-set>
														<token-query scope="entry">
															<arg-dn>
																<token-local-variable name="driverDn" />
															</arg-dn>
															<arg-string>
																<token-text xml:space="preserve">GUID</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">DirXML-DriverFilter</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">DirXML-Policies</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="driverGuid" scope="policy">
													<arg-string>
														<token-xpath expression="es:guid2string($driver/attr[@attr-name='GUID']/value/text())" />
													</arg-string>
												</do-set-local-variable>
												<do-trace-message disabled="true">
													<arg-string>
														<token-text xml:space="preserve">Found managed system: </token-text>
														<token-local-variable name="driverGuid" />
														<token-text xml:space="preserve"> (</token-text>
														<token-local-variable name="driverDn" />
														<token-text xml:space="preserve">).</token-text>
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="driverFilter" scope="policy">
													<arg-node-set>
														<token-xml-parse>
															<token-base64-decode>
																<token-xpath expression="$driver/attr[@attr-name='DirXML-DriverFilter']/value/text()" />
															</token-base64-decode>
														</token-xml-parse>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="accSubOption" scope="policy">
													<arg-string>
														<token-xpath expression="$driverFilter/filter/filter-class[@class-name='User']/@subscriber" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="accPubOption" scope="policy">
													<arg-string>
														<token-xpath expression="$driverFilter/filter/filter-class[@class-name='User']/@publisher" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="responseInstance" scope="policy">
													<arg-node-set>
														<token-xml-parse>
															<token-text xml:space="preserve">&lt;instance class-name="MANAGED_SYSTEM_MATCHING" src-dn="</token-text>
															<token-lower-case>
																<token-parse-dn dest-dn-format="ldap" src-dn-format="qualified-slash">
																	<token-xpath expression="$current-node/@qualified-src-dn" />
																</token-parse-dn>
															</token-lower-case>
															<token-text xml:space="preserve">"&gt;
	&lt;association&gt;</token-text>
															<token-local-variable name="driverGuid" />
															<token-text xml:space="preserve">&lt;/association&gt;
&lt;/instance&gt;</token-text>
														</token-xml-parse>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="addAttrNode" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="accSubOption" op="equal">sync</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-trace-message disabled="true">
															<arg-string>
																<token-text xml:space="preserve">Managed system is subscribing to IDV accounts.</token-text>
															</arg-string>
														</do-trace-message>
														<do-for-each>
															<arg-node-set>
																<token-xpath expression="$driver/attr[@attr-name='DirXML-Policies']/value[component[@name='interval']/text()='6']/component[@name='dn']/text()" />
															</arg-node-set>
															<arg-actions>
																<do-set-local-variable name="matchingPolicyDn" scope="policy">
																	<arg-string>
																		<token-local-variable name="current-node" />
																	</arg-string>
																</do-set-local-variable>
																<do-trace-message disabled="true">
																	<arg-string>
																		<token-text xml:space="preserve">Found matching policy: </token-text>
																		<token-local-variable name="matchingPolicyDn" />
																		<token-text xml:space="preserve">. Introspecting matching logic for account matching criteria...</token-text>
																	</arg-string>
																</do-trace-message>
																<do-set-local-variable name="matchingPolicyXML" scope="policy">
																	<arg-node-set>
																		<token-xml-parse>
																			<token-base64-decode>
																				<token-dest-attr name="XmlData">
																					<arg-dn>
																						<token-local-variable name="matchingPolicyDn" />
																					</arg-dn>
																				</token-dest-attr>
																			</token-base64-decode>
																		</token-xml-parse>
																	</arg-node-set>
																</do-set-local-variable>
																<do-for-each>
																	<arg-node-set>
																		<token-xpath expression="$matchingPolicyXML/policy/rule" />
																	</arg-node-set>
																	<arg-actions>
																		<do-set-local-variable name="ruleName" scope="policy">
																			<arg-string>
																				<token-xpath expression="$current-node/description/text()" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">Analyzing rule: </token-text>
																				<token-local-variable name="ruleName" />
																			</arg-string>
																		</do-trace-message>
																		<do-set-local-variable name="directlyReactingToNewAccounts" scope="policy">
																			<arg-string>
																				<token-xpath expression="(count($current-node/conditions/node()/if-class-name[@op='equal'][@mode='case' or @mode='nocase'][es:lowerString(text())='user']) + count($current-node/conditions/node()/if-class-name[@op='equal'][@mode='regex'][es:match('User', text())]))&gt;0" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">Directly reacting to new accounts: </token-text>
																				<token-local-variable name="directlyReactingToNewAccounts" />
																			</arg-string>
																		</do-trace-message>
																		<do-set-local-variable name="indirectlyReactingToNewAccounts" scope="policy">
																			<arg-string>
																				<token-xpath expression="count($current-node/conditions/node()/if-class-name[@op='equal'][@mode='case' or @mode='nocase' or @mode='regex'])=0" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">Indirectly reacting to new accounts: </token-text>
																				<token-local-variable name="indirectlyReactingToNewAccounts" />
																			</arg-string>
																		</do-trace-message>
																		<do-set-local-variable name="containsAttrBasedMatchingCriteria" scope="policy">
																			<arg-string>
																				<token-xpath expression="count($current-node/actions//do-find-matching-object/arg-match-attr)&gt;0" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">Contains attribute-based matching criteria: </token-text>
																				<token-local-variable name="containsAttrBasedMatchingCriteria" />
																			</arg-string>
																		</do-trace-message>
																		<do-if>
																			<arg-conditions>
																				<or>
																					<if-local-variable mode="nocase" name="directlyReactingToNewAccounts" op="equal">true</if-local-variable>
																					<if-local-variable mode="nocase" name="indirectlyReactingToNewAccounts" op="equal">true</if-local-variable>
																				</or>
																				<or>
																					<if-local-variable mode="nocase" name="containsAttrBasedMatchingCriteria" op="equal">true</if-local-variable>
																				</or>
																			</arg-conditions>
																			<arg-actions>
																				<do-trace-message disabled="true">
																					<arg-string>
																						<token-text xml:space="preserve">Found attribute-based account matching criteria:</token-text>
																					</arg-string>
																				</do-trace-message>
																				<do-if>
																					<arg-conditions>
																						<and>
																							<if-local-variable mode="nocase" name="addAttrNode" op="equal">true</if-local-variable>
																						</and>
																					</arg-conditions>
																					<arg-actions>
																						<do-set-local-variable name="addAttrNode" scope="policy">
																							<arg-string>
																								<token-text xml:space="preserve">false</token-text>
																							</arg-string>
																						</do-set-local-variable>
																						<do-append-xml-element expression="$responseInstance/instance" name="attr" />
																						<do-set-xml-attr expression="$responseInstance/instance/attr[last()]" name="attr-name">
																							<arg-string>
																								<token-text xml:space="preserve">rule</token-text>
																							</arg-string>
																						</do-set-xml-attr>
																					</arg-actions>
																					<arg-actions />
																				</do-if>
																				<do-append-xml-element expression="$responseInstance/instance/attr[@attr-name='rule']" name="value" />
																				<do-set-xml-attr expression="$responseInstance/instance/attr[@attr-name='rule']/value" name="type">
																					<arg-string>
																						<token-text xml:space="preserve">structured</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-for-each>
																					<arg-node-set>
																						<token-xpath expression="$current-node/actions//do-find-matching-object/arg-match-attr/@name" />
																					</arg-node-set>
																					<arg-actions>
																						<do-set-local-variable name="mappedAttrName" scope="policy">
																							<arg-string>
																								<token-xpath expression="$smp/attr-name-map/attr-name[nds-name/text()=$current-node][1]/app-name/text()" />
																							</arg-string>
																						</do-set-local-variable>
																						<do-if>
																							<arg-conditions>
																								<and>
																									<if-local-variable mode="regex" name="mappedAttrName" op="not-equal">.+</if-local-variable>
																								</and>
																							</arg-conditions>
																							<arg-actions>
																								<do-set-local-variable name="mappedAttrName" scope="policy">
																									<arg-string>
																										<token-local-variable name="current-node" />
																									</arg-string>
																								</do-set-local-variable>
																							</arg-actions>
																							<arg-actions />
																						</do-if>
																						<do-if>
																							<arg-conditions>
																								<and>
																									<if-xpath op="not-true">$responseInstance/instance/attr[@attr-name='rule']/value[last()]/component[@name=$mappedAttrName]</if-xpath>
																								</and>
																							</arg-conditions>
																							<arg-actions>
																								<do-trace-message>
																									<arg-string>
																										<token-text xml:space="preserve">Found subscriber matching attribute: </token-text>
																										<token-local-variable name="mappedAttrName" />
																										<token-text xml:space="preserve"> (</token-text>
																										<token-local-variable name="current-node" />
																										<token-text xml:space="preserve">)</token-text>
																									</arg-string>
																								</do-trace-message>
																								<do-append-xml-element expression="$responseInstance/instance/attr[@attr-name='rule']/value[last()]" name="component" />
																								<do-set-xml-attr expression="$responseInstance/instance/attr[@attr-name='rule']/value[last()]/component[last()]" name="name">
																									<arg-string>
																										<token-local-variable name="mappedAttrName" />
																									</arg-string>
																								</do-set-xml-attr>
																							</arg-actions>
																							<arg-actions />
																						</do-if>
																					</arg-actions>
																				</do-for-each>
																				<do-strip-xpath expression="$responseInstance/instance/attr[@attr-name='rule']/value[count(component)=0]" />
																			</arg-actions>
																			<arg-actions />
																		</do-if>
																	</arg-actions>
																</do-for-each>
															</arg-actions>
														</do-for-each>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="accPubOption" op="equal">sync</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-trace-message disabled="true">
															<arg-string>
																<token-text xml:space="preserve">Managed system is publishing accounts to IDV.</token-text>
															</arg-string>
														</do-trace-message>
														<do-for-each>
															<arg-node-set>
																<token-xpath expression="$driver/attr[@attr-name='DirXML-Policies']/value[component[@name='interval']/text()='7']/component[@name='dn']/text()" />
															</arg-node-set>
															<arg-actions>
																<do-set-local-variable name="matchingPolicyDn" scope="policy">
																	<arg-string>
																		<token-local-variable name="current-node" />
																	</arg-string>
																</do-set-local-variable>
																<do-trace-message disabled="true">
																	<arg-string>
																		<token-text xml:space="preserve">Found matching policy: </token-text>
																		<token-local-variable name="matchingPolicyDn" />
																		<token-text xml:space="preserve">. Introspecting matching logic for account matching criteria...</token-text>
																	</arg-string>
																</do-trace-message>
																<do-set-local-variable name="matchingPolicyXML" scope="policy">
																	<arg-node-set>
																		<token-xml-parse>
																			<token-base64-decode>
																				<token-dest-attr name="XmlData">
																					<arg-dn>
																						<token-local-variable name="matchingPolicyDn" />
																					</arg-dn>
																				</token-dest-attr>
																			</token-base64-decode>
																		</token-xml-parse>
																	</arg-node-set>
																</do-set-local-variable>
																<do-for-each>
																	<arg-node-set>
																		<token-xpath expression="$matchingPolicyXML/policy/rule" />
																	</arg-node-set>
																	<arg-actions>
																		<do-set-local-variable name="ruleName" scope="policy">
																			<arg-string>
																				<token-xpath expression="$current-node/description/text()" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">Analyzing rule: </token-text>
																				<token-local-variable name="ruleName" />
																			</arg-string>
																		</do-trace-message>
																		<do-set-local-variable name="directlyReactingToNewAccounts" scope="policy">
																			<arg-string>
																				<token-xpath expression="(count($current-node/conditions/node()/if-class-name[@op='equal'][@mode='case' or @mode='nocase'][es:lowerString(text())='user']) + count($current-node/conditions/node()/if-class-name[@op='equal'][@mode='regex'][es:match('User', text())]))&gt;0" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">Directly reacting to new accounts: </token-text>
																				<token-local-variable name="directlyReactingToNewAccounts" />
																			</arg-string>
																		</do-trace-message>
																		<do-set-local-variable name="indirectlyReactingToNewAccounts" scope="policy">
																			<arg-string>
																				<token-xpath expression="count($current-node/conditions/node()/if-class-name[@op='equal'][@mode='case' or @mode='nocase' or @mode='regex'])=0" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">Indirectly reacting to new accounts: </token-text>
																				<token-local-variable name="indirectlyReactingToNewAccounts" />
																			</arg-string>
																		</do-trace-message>
																		<do-set-local-variable name="containsAttrBasedMatchingCriteria" scope="policy">
																			<arg-string>
																				<token-xpath expression="count($current-node/actions//do-find-matching-object/arg-match-attr)&gt;0" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">Contains attribute-based matching criteria: </token-text>
																				<token-local-variable name="containsAttrBasedMatchingCriteria" />
																			</arg-string>
																		</do-trace-message>
																		<do-if>
																			<arg-conditions>
																				<or>
																					<if-local-variable mode="nocase" name="directlyReactingToNewAccounts" op="equal">true</if-local-variable>
																					<if-local-variable mode="nocase" name="indirectlyReactingToNewAccounts" op="equal">true</if-local-variable>
																				</or>
																				<or>
																					<if-local-variable mode="nocase" name="containsAttrBasedMatchingCriteria" op="equal">true</if-local-variable>
																				</or>
																			</arg-conditions>
																			<arg-actions>
																				<do-trace-message disabled="true">
																					<arg-string>
																						<token-text xml:space="preserve">Found attribute-based account matching criteria:</token-text>
																					</arg-string>
																				</do-trace-message>
																				<do-if>
																					<arg-conditions>
																						<and>
																							<if-local-variable mode="nocase" name="addAttrNode" op="equal">true</if-local-variable>
																						</and>
																					</arg-conditions>
																					<arg-actions>
																						<do-set-local-variable name="addAttrNode" scope="policy">
																							<arg-string>
																								<token-text xml:space="preserve">false</token-text>
																							</arg-string>
																						</do-set-local-variable>
																						<do-append-xml-element expression="$responseInstance/instance" name="attr" />
																						<do-set-xml-attr expression="$responseInstance/instance/attr[last()]" name="attr-name">
																							<arg-string>
																								<token-text xml:space="preserve">rule</token-text>
																							</arg-string>
																						</do-set-xml-attr>
																					</arg-actions>
																					<arg-actions />
																				</do-if>
																				<do-append-xml-element expression="$responseInstance/instance/attr[@attr-name='rule']" name="value" />
																				<do-set-xml-attr expression="$responseInstance/instance/attr[@attr-name='rule']/value" name="type">
																					<arg-string>
																						<token-text xml:space="preserve">structured</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-for-each>
																					<arg-node-set>
																						<token-xpath expression="$current-node/actions//do-find-matching-object/arg-match-attr/@name" />
																					</arg-node-set>
																					<arg-actions>
																						<do-set-local-variable name="mappedAttrName" scope="policy">
																							<arg-string>
																								<token-xpath expression="$smp/attr-name-map/attr-name[nds-name/text()=$current-node][1]/app-name/text()" />
																							</arg-string>
																						</do-set-local-variable>
																						<do-if>
																							<arg-conditions>
																								<and>
