<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>On Add Association set sync attribute for EMP linking</description>
									<comment xml:space="preserve">When a SER record has been added trigger the setting of LinkedProvider on the EMP record</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="pdsEpicUser" direct="true" name="~pdsepicsdcfg.SER.SerID.trigger~">
											<arg-value type="string">
												<token-text xml:space="preserve">TRUE</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							