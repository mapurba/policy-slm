<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Matching rules for workday-job profile</description>
									<comment xml:space="preserve">This rules will perform match on primary  key attribute values ofJob profiles</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDJobProfile</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-dn>
												<token-global-variable name="gvJobProfileContainer" />
											</arg-dn>
											<arg-match-attr name="~gvJobProfileMatchAttr~" />
										</do-find-matching-object>
									</actions>
								</rule>
							