<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Writeback DN during "from-merge" Modify events</description>
									<conditions>
										<and>
											<if-operation op="equal">modify</if-operation>
											<if-xpath op="true">@from-merge = 'true'</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="DISTINGUISHED_NAME">
											<arg-value type="string">
												<token-src-dn />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							