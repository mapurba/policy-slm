<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add the Association to "operation-data/peoplesoft-src-id" Property</description>
									<conditions>
										<and>
											<if-association op="available" />
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="operation-data" />
										<do-append-xml-element expression="operation-data" name="peoplesoft-src-id" />
										<do-append-xml-text expression="operation-data/peoplesoft-src-id">
											<arg-string>
												<token-association />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
								