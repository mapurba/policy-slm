<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>IDM Date to GroupWise Date Conversion</description>
									<comment xml:space="preserve">IDM Date to GroupWise Date Conversion for 'Login Expiratrion Time' attribute.</comment>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="Login Expiration Time" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="case" op="equal">add</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="varLogExpTime" scope="policy">
													<arg-string>
														<token-xpath expression="./*[@attr-name=&quot;Login Expiration Time&quot;]/value/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="numeric" name="varLogExpTime" op="gt">1</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="varLogExpTime" scope="policy">
															<arg-string>
																<token-xpath expression="int:new($varLogExpTime * 1000)" />
															</arg-string>
														</do-set-local-variable>
														<do-reformat-op-attr name="Login Expiration Time">
															<arg-value type="time">
																<token-local-variable name="varLogExpTime" />
															</arg-value>
														</do-reformat-op-attr>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-operation mode="case" op="equal">modify</if-operation>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="varLogExpTime" scope="policy">
															<arg-string>
																<token-xpath expression="./*[@attr-name=&quot;Login Expiration Time&quot;]/add-value/value/text()" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="numeric" name="varLogExpTime" op="gt">1</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="varLogExpTime" scope="policy">
																	<arg-string>
																		<token-xpath expression="int:new($varLogExpTime * 1000)" />
																	</arg-string>
																</do-set-local-variable>
																<do-reformat-op-attr name="Login Expiration Time">
																	<arg-value type="time">
																		<token-local-variable name="varLogExpTime" />
																	</arg-value>
																</do-reformat-op-attr>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							