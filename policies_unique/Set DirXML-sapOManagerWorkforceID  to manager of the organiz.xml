<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set DirXML-sapOManagerWorkforceID  to manager of the organization's workforceID</description>
									<conditions>
										<and>
											<if-local-variable name="orgMgrWfID" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="regex" name="orgMgrWfID" op="equal">.+</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvTmp" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">Setting organizational manager's workforceID </token-text>
														<token-local-variable name="orgMgrWfID" />
														<token-text xml:space="preserve"> on organization </token-text>
														<token-src-name />
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="lvTmp" />
													</arg-string>
												</do-trace-message>
												<do-set-dest-attr-value class-name="DirXML-sapO" name="DirXML-sapOManagerWorkforceID">
													<arg-association>
														<token-attr name="GUID" />
													</arg-association>
													<arg-value type="string">
														<token-local-variable name="orgMgrWfID" />
													</arg-value>
												</do-set-dest-attr-value>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvFile" scope="policy">
															<arg-string>
																<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="lvTmp" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">Clearing organizational manager's workforceID from organization </token-text>
														<token-src-name />
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="lvTmp" />
													</arg-string>
												</do-trace-message>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvFile" scope="policy">
															<arg-string>
																<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-clear-dest-attr-value class-name="DirXML-sapO" name="DirXML-sapOManagerWorkforceID">
													<arg-association>
														<token-attr name="GUID" />
													</arg-association>
												</do-clear-dest-attr-value>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							