<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Add: Use Epic assigned UserInternalID value</description>
									<comment xml:space="preserve">Create Epic record and have Epic assign the UserInternalID value</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="pdsepicedcfg.epic-generated-uiid" op="not-equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="UserInternalID">
											<arg-value type="string">
												<token-text xml:space="preserve">*</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								