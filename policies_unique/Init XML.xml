<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Init XML</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="xml" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;entitlement-configuration&gt;&lt;entitlements/&gt;&lt;/entitlement-configuration&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-xml-attr expression="$xml/entitlement-configuration" name="modified">
											<arg-string>
												<token-time format="yyyyMMddhhmmss" tz="UTC" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							