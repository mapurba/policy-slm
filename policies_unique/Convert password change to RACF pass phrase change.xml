<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Convert password change to RACF pass phrase change</description>
									<conditions>
										<and>
											<if-global-variable name="sub-pass-to-phrase" op="equal">true</if-global-variable>
											<if-op-attr name="nspmDistributionPassword" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="modify-attr[@attr-name='nspmDistributionPassword']" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">DirXML-RACF-password-phrase</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-strip-xpath expression="modify-attr[@attr-name='nspmDistributionPassword']/attr-name[text()='nspmDistributionPassword']" />
										<do-set-xml-attr expression="modify-attr[@attr-name='DirXML-RACF-password-phrase']/add-value/value" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								