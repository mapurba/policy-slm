<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Disable access for Notes Users when 'NOVLNOTEASTS-denyAccess' attribute is set to 'true'</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.account.status.DenyAccessGroup.use" op="equal">true</if-global-variable>
											<if-class-name mode="nocase" op="equal">Person</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-op-attr mode="nocase" name="NOVLNOTEASTS-denyAccess" op="changing-to">true</if-op-attr>
											<if-local-variable name="DenyAccessGrpUNID" op="available" />
											<if-local-variable name="DenyAccessGrpUNID" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-remove-dest-attr-value class-name="Group" name="Members" when="after">
											<arg-association>
												<token-local-variable name="DenyAccessGrpUNID" />
											</arg-association>
											<arg-value type="dn">
												<token-src-dn />
											</arg-value>
										</do-remove-dest-attr-value>
										<do-set-xml-attr expression="../modify[@class-name='Group' and last()]/modify-attr[@attr-name='Members' and last()]/remove-value[last()]/value[last()]" name="association-ref">
											<arg-string>
												<token-association />
											</arg-string>
										</do-set-xml-attr>
										<do-add-dest-attr-value class-name="Group" name="Members" when="after">
											<arg-association>
												<token-local-variable name="DenyAccessGrpUNID" />
											</arg-association>
											<arg-value type="dn">
												<token-src-dn />
											</arg-value>
										</do-add-dest-attr-value>
										<do-set-xml-attr expression="../modify[@class-name='Group' and last()]/modify-attr[@attr-name='Members' and last()]/add-value[last()]/value[last()]" name="association-ref">
											<arg-string>
												<token-association />
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="../modify[last()]" name="operation-data" />
										<do-set-xml-attr expression="../modify[last()]/operation-data" name="NOVLNOTEASTS-addToDenyAccessGroup">
											<arg-string>
												<token-association />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								