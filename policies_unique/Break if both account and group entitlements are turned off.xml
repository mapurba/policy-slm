<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if both account and group entitlements are turned off</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Account" op="not-equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.entitlement.Group" op="not-equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								