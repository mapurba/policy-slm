<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>On User add, change password element tag to user_password attribute</description>
									<comment xml:space="preserve">Transforming the the password element tag to user_password attribute before providing it to servicenow shim.</comment>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">add|modify-password</if-operation>
											<if-class-name mode="nocase" op="equal">sys_user</if-class-name>
											<if-password op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">add</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-dest-attr-value class-name="sys_user" name="user_password">
													<arg-value type="string">
														<token-password />
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-xml-attr expression="add-attr[@attr-name='user_password']//value" name="is-sensitive">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">modify-password</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-dest-attr-value class-name="sys_user" name="user_password">
													<arg-value type="string">
														<token-password />
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-xml-attr expression="../modify/modify-attr[@attr-name='user_password']/add-value/value" name="is-sensitive">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								