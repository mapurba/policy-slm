<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add User E-Mail: Inherit from Mail File Template</description>
									<conditions>
										<and>
											<if-global-variable name="account.email.inheritflag" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="mail-file-inherit-flag">
											<arg-string>
												<token-global-variable name="account.email.inheritflag" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								