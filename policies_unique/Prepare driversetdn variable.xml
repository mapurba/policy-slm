<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Prepare driversetdn variable</description>
									<comment xml:space="preserve">Only run once</comment>
									<conditions>
										<and>
											<if-local-variable name="driversetdn" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="driversetdn" scope="driver">
											<arg-string>
												<token-parse-dn dest-dn-format="src-dn" length="-2">
													<token-global-variable name="dirxml.auto.driverdn" />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								