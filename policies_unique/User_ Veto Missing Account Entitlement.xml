<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User: Veto Missing Account Entitlement</description>
									<comment xml:space="preserve">Veto user add when Account entitlement missing from operation.</comment>
									<comment name="author" xml:space="preserve">PDS</comment>
									<comment name="version" xml:space="preserve">1.0</comment>
									<comment name="lastchanged" xml:space="preserve">06-18-20</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.entitlement.Account" op="equal">true</if-global-variable>
											<if-entitlement name="SERRecord" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								