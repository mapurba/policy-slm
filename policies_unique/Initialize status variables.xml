<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initialize status variables</description>
									<comment xml:space="preserve">Initialize local variables for app and vault status to "-" (unset).</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="app-status" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="vault-status" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								