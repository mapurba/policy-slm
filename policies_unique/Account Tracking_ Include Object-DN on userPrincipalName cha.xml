<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account Tracking: Include Object-DN on userPrincipalName change</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">rename</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="AccountTracking-userPrincipalName">
											<arg-string>
												<token-xpath expression="$current-op/new-name/text()" />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							