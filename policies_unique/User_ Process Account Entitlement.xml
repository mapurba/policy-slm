<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User: Process Account Entitlement</description>
									<comment xml:space="preserve">Set SER Status on Entitlement change</comment>
									<comment name="author" xml:space="preserve">PDS</comment>
									<comment name="version" xml:space="preserve">1.0</comment>
									<comment name="lastchanged" xml:space="preserve">12-11-2023</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-entitlement name="SERRecord" op="changing" />
											<if-global-variable mode="nocase" name="drv.entitlement.Account" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="SERRecord" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="35">
													<arg-value type="string">
														<token-text xml:space="preserve">Active</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="SERRecord" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="35">
													<arg-value type="string">
														<token-text xml:space="preserve">Inactive</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								