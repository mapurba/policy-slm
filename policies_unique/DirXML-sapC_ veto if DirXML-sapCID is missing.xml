<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-sapC: veto if DirXML-sapCID is missing</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-sapC</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="DirXML-sapCID" />
									</actions>
								</rule>
								