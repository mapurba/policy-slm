<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Default Group</description>
									<comment xml:space="preserve">When new Users are created in RACF, assign a default group from the Default Group GCV.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable name="racf-default-group" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="DirXML-RACF-dfltgrp">
											<arg-value type="string">
												<token-global-variable name="racf-default-group" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
								