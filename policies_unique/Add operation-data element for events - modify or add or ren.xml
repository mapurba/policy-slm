<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation-data element for events - modify or add or rename</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-operation mode="nocase" op="equal">rename</if-operation>
										</or>
										<or>
											<if-xpath op="not-true">driver-operation-data</if-xpath>
										</or>
									</conditions>
									<actions>
										
										<do-append-xml-element expression="." name="driver-operation-data" />
										<do-append-xml-element expression="driver-operation-data" name="WD-WorkforceID" />
										<do-append-xml-text expression="driver-operation-data/WD-WorkforceID">
											<arg-string>
												<token-src-attr class-name="User" name="workforceID" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="driver-operation-data" name="WD-WorkerIDType" />
										<do-append-xml-text expression="driver-operation-data/WD-WorkerIDType">
											<arg-string>
												<token-src-attr class-name="User" name="wd-WorkerIDType" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="driver-operation-data" name="WD-effectiveDate" />
										<do-append-xml-text expression="driver-operation-data/WD-effectiveDate">
											<arg-string>
												<token-time format="yyyy-MM-dd" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="driver-operation-data" name="WD-ISOCode" />
										<do-append-xml-text expression="driver-operation-data/WD-ISOCode">
											<arg-string>
												<token-global-variable name="custom.default.country.ISOCode" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="driver-operation-data" name="WD-WorkPrimaryDeviceType" />
										<do-append-xml-text expression="driver-operation-data/WD-WorkPrimaryDeviceType">
											<arg-string>
												<token-src-attr class-name="User" name="wd-WorkPrimaryDeviceType" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="driver-operation-data" name="WD-HomePrimaryDeviceType" />
										<do-append-xml-text expression="driver-operation-data/WD-HomePrimaryDeviceType">
											<arg-string>
												<token-src-attr class-name="User" name="wd-HomePrimaryDeviceType" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="driver-operation-data" name="WD-InternetEMailAddressRefType" />
										<do-append-xml-text expression="driver-operation-data/WD-InternetEMailAddressRefType">
											<arg-string>
												<token-src-attr class-name="User" name="wd-InternetEMailAddressRefType" />
											</arg-string>
										</do-append-xml-text>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="wd-WorkPrimaryPhone" op="changing" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv-WD-ContactNumber" scope="driver">
													<arg-string>
														<token-op-attr name="wd-WorkPrimaryPhone&#13;&#10;" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="wd-HomePrimaryPhone" op="changing" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv-WD-ContactNumber" scope="driver">
													<arg-string>
														<token-op-attr name="wd-HomePrimaryPhone&#13;&#10;" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="regex" name="lv-WD-ContactNumber" op="equal">.+</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv-WD-ContactNumber-ISOCodeTemp" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after($lv-WD-ContactNumber, '+')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-WD-ContactNumber-ISOCode" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before($lv-WD-ContactNumber-ISOCodeTemp,' (')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="varISOCodeMap" scope="policy">
													<arg-string>
														<token-map dest="ISOCode" src="CountryPrefix" table="..\lib-ISO3166_CountryPrefix">
															<token-local-variable name="lv-WD-ContactNumber-ISDCode" />
														</token-map>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">$varISOCodeMap != ''</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-strip-xpath expression="driver-operation-data/WD-ISOCode/text()" />
														<do-append-xml-text expression="driver-operation-data/WD-ISOCode">
															<arg-string>
																<token-local-variable name="varISOCodeMap" />
															</arg-string>
														</do-append-xml-text>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							