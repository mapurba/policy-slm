<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>set epic id on add association</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add-association</if-operation>
											<if-global-variable mode="regex" name="pdsempdcfg.epicid.attr" op="equal">.+</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="~pdsempdcfg.epicid.attr~">
											<arg-value type="string">
												<token-xpath expression="." />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							