<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Diable password change at first login</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">MsolUser</if-class-name>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
											<if-global-variable mode="nocase" name="ForceChangePassword" op="equal">true</if-global-variable>
											<if-op-attr name="Password" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="ForceChangePassword">
											<arg-value type="string">
												<token-text xml:space="preserve">false</token-text>
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								