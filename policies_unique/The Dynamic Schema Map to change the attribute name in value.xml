<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>The Dynamic Schema Map to change the attribute name in value based entitlement XML.</description>
									<comment xml:space="preserve">App to IDV, Entitlement Schema Map Element Attribute Name Change.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">instance</if-operation>
											<if-op-property mode="nocase" name="Entitlement-Query" op="equal">true</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="$current-node" name="class-name">
											<arg-string>
												<token-text xml:space="preserve">Group</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="./attr" />
											</arg-node-set>
											<arg-actions>
												<do-set-xml-attr expression="$current-node" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">GID</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
										<do-clear-op-property name="Entitlement-Query" />
									</actions>
								</rule>
								