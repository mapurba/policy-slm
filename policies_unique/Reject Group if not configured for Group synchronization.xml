<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reject Group if not configured for Group synchronization</description>
									<conditions>
										<and>
											<if-class-name op="equal">Group</if-class-name>
											<if-global-variable name="driver.gw.Groups" op="equal">false</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								