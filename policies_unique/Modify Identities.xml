<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Modify Identities</description>
									<comment xml:space="preserve">Any update to identities replaces the entire collection in Azure, so this rule queries all identites from IDM and send as &lt;add-value&gt;</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable name="b2c-identities" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable disabled="true" name="b2cIdentitiesGCV" scope="policy">
													<arg-string>
														<token-global-variable name="b2c-identities" />
													</arg-string>
												</do-set-local-variable>
												<do-append-xml-element expression="../modify" name="modify-attr" />
												<do-set-xml-attr expression="../modify/modify-attr[last()]" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">identities</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="../modify/modify-attr[@attr-name='identities']" name="add-value" />
												<do-set-local-variable name="b2cIdentitiesNS" scope="policy">
													<arg-node-set>
														<token-split delimiter=";">
															<token-global-variable name="b2c-identities" />
														</token-split>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="attrChanging" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="b2cIdentitiesNS" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="identityNS" scope="policy">
															<arg-node-set>
																<token-split delimiter=":">
																	<token-local-variable name="current-node" />
																</token-split>
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="edirAttr" scope="policy">
															<arg-string>
																<token-xpath expression="$identityNS[2]" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-op-attr name="$edirAttr$" op="changing" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="attrChanging" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">true</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="attrChanging" op="equal">true</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-for-each>
															<arg-node-set>
																<token-local-variable name="b2cIdentitiesNS" />
															</arg-node-set>
															<arg-actions>
																<do-set-local-variable name="identityNS" scope="policy">
																	<arg-node-set>
																		<token-split delimiter=":">
																			<token-local-variable name="current-node" />
																		</token-split>
																	</arg-node-set>
																</do-set-local-variable>
																<do-set-local-variable name="signInType" scope="policy">
																	<arg-string>
																		<token-xpath expression="$identityNS[1]" />
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="edirAttr" scope="policy">
																	<arg-string>
																		<token-xpath expression="$identityNS[2]" />
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="edirAttrValues" scope="policy">
																	<arg-node-set>
																		<token-src-attr name="$edirAttr$" />
																	</arg-node-set>
																</do-set-local-variable>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable name="edirAttrValues" op="available" />
																			<if-local-variable mode="nocase" name="edirAttrValues" op="not-equal" />
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-for-each>
																			<arg-node-set>
																				<token-local-variable name="edirAttrValues" />
																			</arg-node-set>
																			<arg-actions>
																				<do-append-xml-element expression="../modify/modify-attr[@attr-name='identities']/add-value" name="value" />
																				<do-set-xml-attr expression="../modify/modify-attr[@attr-name='identities']/add-value/value[last()]" name="type">
																					<arg-string>
																						<token-text xml:space="preserve">structured</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-append-xml-element expression="../modify/modify-attr[@attr-name='identities']/add-value/value[last()]" name="component" />
																				<do-set-xml-attr expression="../modify/modify-attr[@attr-name='identities']/add-value/value[last()]/component[last()]" name="name">
																					<arg-string>
																						<token-text xml:space="preserve">signInType</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-append-xml-text expression="../modify/modify-attr[@attr-name='identities']/add-value/value[last()]/component[@name='signInType']">
																					<arg-string>
																						<token-local-variable name="signInType" />
																					</arg-string>
																				</do-append-xml-text>
																				<do-append-xml-element expression="../modify/modify-attr[@attr-name='identities']/add-value/value[last()]" name="component" />
																				<do-set-xml-attr expression="../modify/modify-attr[@attr-name='identities']/add-value/value[last()]/component[last()]" name="name">
																					<arg-string>
																						<token-text xml:space="preserve">issuerAssignedId</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-append-xml-text expression="../modify/modify-attr[@attr-name='identities']/add-value/value[last()]/component[@name='issuerAssignedId']">
																					<arg-string>
																						<token-local-variable name="current-node" />
																					</arg-string>
																				</do-append-xml-text>
																			</arg-actions>
																		</do-for-each>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
														</do-for-each>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<or>
													<if-local-variable mode="nocase" name="attrChanging" op="equal">false</if-local-variable>
												</or>
												<or>
													<if-op-attr name="identities" op="not-available" />
													<if-op-attr mode="nocase" name="identities" op="equal" />
												</or>
											</arg-conditions>
											<arg-actions>
												<do-strip-op-attr name="identities" />
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="attrChanging" op="equal">true</if-local-variable>
															<if-xpath op="true">../modify/modify-attr[@attr-name='identities']/add-value[count(*) = 0]</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-append-xml-element expression="../modify/modify-attr[@attr-name='identities']" name="remove-all-values" />
														<do-strip-xpath expression="../modify/modify-attr[@attr-name='identities']/add-value" />
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							