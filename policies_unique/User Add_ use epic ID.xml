<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Add: use epic ID</description>
									<comment xml:space="preserve">Create EMP with specified epicID</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="pdsempdcfg.use.epicid.create" op="equal">True</if-global-variable>
											<if-attr mode="regex" name="~pdsempdcfg.epicid.attr~" op="equal">.+</if-attr>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="UserInternalID">
											<arg-value type="string">
												<token-attr name="~pdsempdcfg.epicid.attr~" />
											</arg-value>
										</do-set-dest-attr-value>
										<do-break />
									</actions>
								</rule>
								