<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match found - Set LinkedProviderID Trigger</description>
									<comment xml:space="preserve">If a match is found set the trigger attribute in the IDV to link the SER and EMP accounts</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-op-property name="success.do-find-matching-object" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-src-attr-value name="~pdsepicsdcfg.SER.SerID.trigger~">
											<arg-value type="string">
												<token-text xml:space="preserve">true</token-text>
											</arg-value>
										</do-set-src-attr-value>
									</actions>
								</rule>
							