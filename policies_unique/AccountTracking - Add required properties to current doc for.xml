<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Add required properties to current doc for future use</description>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">add</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="AccountTracking-Operation">
													<arg-string>
														<token-operation />
													</arg-string>
												</do-set-op-property>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="drv.acctTrk.identifiers" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="not-true">$current-node = 'association'</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-op-attr name="$current-node$" op="available" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-op-property name="AccountTracking-$current-node$">
																	<arg-string>
																		<token-op-attr name="$current-node$" />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
															<arg-actions>
																<do-set-op-property name="AccountTracking-$current-node$">
																	<arg-string>
																		<token-src-attr name="$current-node$" />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-set-op-property name="AccountTracking-$current-node$">
															<arg-string>
																<token-association />
															</arg-string>
														</do-set-op-property>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								