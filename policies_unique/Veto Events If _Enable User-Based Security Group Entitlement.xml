<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto Events If "Enable User-Based Security Group Entitlement" is set to false</description>
									<comment xml:space="preserve">Veto Events If "Enable User-Based Security Group Entitlement" is set to false</comment>
									<conditions>
										<or>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-operation mode="nocase" op="equal">query-ex</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">wd-UserBasedSecurityGroup</if-class-name>
										</or>
										<or>
											<if-global-variable mode="nocase" name="drv.entitlement.UserBasedSecurityGroup" op="equal">false</if-global-variable>
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								