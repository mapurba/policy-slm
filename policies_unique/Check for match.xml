<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check for match</description>
									<comment xml:space="preserve">Check for a match from one of the preceding rules, and if we have a single match, set the ID of the matched Identity in our driver-scoped map for use by accounts that may be added after this operation.</comment>
									<conditions>
										<and>
											<if-xpath op="true">count(association) = 1</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="identity-guid" scope="policy">
											<arg-string>
												<token-xpath expression="substring-after(association,'identity/')" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="op-entry-id" scope="policy">
											<arg-string>
												<token-xpath expression="@src-entry-id" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="throwaway" scope="policy">
											<arg-string>
												<token-xpath expression="jmap:put($drv.identity.map,jstring:new($op-entry-id),jstring:new($identity-guid))" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
							