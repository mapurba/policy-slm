<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>MatchUserRule5-Search User on First, Last and BirthDate</description>
									<comment xml:space="preserve">This rule will match user on on First, Last and BirthDate</comment>
									<conditions>
										<and>
											<if-global-variable mode="regex" name="gvUserMatchAttr" op="equal">worker-pub-match-name-bd|worker-pub-match-all</if-global-variable>
											<if-local-variable mode="nocase" name="lvUserStopSearch" op="equal">false</if-local-variable>
											<if-operation op="equal">add</if-operation>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="~gvBirthdayAttr~" op="available" />
											<if-op-attr name="~gvLegalFirstNameAttr~" op="available" />
											<if-op-attr name="~gvLegalLastNameAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvUserNodeSetMatchOnFirstLastBirthDate" scope="policy">
											<arg-node-set>
												<token-query class-name="User" max-result-count="100">
													<arg-dn>
														<token-global-variable name="gvUserContainer" />
													</arg-dn>
													<arg-match-attr name="~gvLegalFirstNameAttr~" />
													<arg-match-attr name="~gvLegalLastNameAttr~" />
													<arg-match-attr name="~gvBirthdayAttr~">
														<arg-value type="string">
															<token-local-variable name="lvBirthdate" />
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">CN</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-trace-message level="1">
											<arg-string>
												<token-text xml:space="preserve">User Count Match On First, Last, BirthDate:</token-text>
												<token-xpath expression="count($lvUserNodeSetMatchOnFirstLastBirthDate)" />
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="lvCountUnAssociatedUserMatch" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">0</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="lvIDVUserIDListWithMultipleMatch" scope="policy">
											<arg-string />
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$lvUserNodeSetMatchOnFirstLastBirthDate//attr[@attr-name='CN']/value/." />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="not-true">starts-with($current-node/../../association,'EMPLID=')</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvCountUnAssociatedUserMatch" scope="policy">
															<arg-string>
																<token-xpath expression="$lvCountUnAssociatedUserMatch + 1" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="lvIDVUserIDListWithMultipleMatch" scope="policy">
															<arg-string>
																<token-local-variable name="lvIDVUserIDListWithMultipleMatch" />
																<token-local-variable name="current-node" />
																<token-text xml:space="preserve">; </token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-trace-message level="1">
											<arg-string>
												<token-text xml:space="preserve">Count of Unassociated User Match: </token-text>
												<token-local-variable name="lvCountUnAssociatedUserMatch" />
											</arg-string>
										</do-trace-message>
										<do-trace-message level="1">
											<arg-string>
												<token-text xml:space="preserve">lvIDVUserIDListWithMultipleMatch: </token-text>
												<token-local-variable name="lvIDVUserIDListWithMultipleMatch" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">$lvCountUnAssociatedUserMatch = 1</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="$lvUserNodeSetMatchOnFirstLastBirthDate//attr[@attr-name='CN']/value/." />
													</arg-node-set>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="not-true">starts-with($current-node/../../association,'WorkforceID=')</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="lvUserCN" scope="driver">
																	<arg-string>
																		<token-xpath expression="$lvUserNodeSetMatchOnFirstLastBirthMMDD//attr[@attr-name='CN']/value/." />
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="lvUserStopSearch" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">true</token-text>
																	</arg-string>
																</do-set-local-variable>
																<do-find-matching-object scope="subtree">
																	<arg-dn>
																		<token-global-variable name="gvUserContainer" />
																	</arg-dn>
																	<arg-match-attr name="CN">
																		<arg-value type="string">
																			<token-local-variable name="lvUserCN" />
																		</arg-value>
																	</arg-match-attr>
																</do-find-matching-object>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">$lvCountUnAssociatedUserMatch &gt; 1</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvUserStopSearch" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvMultipleUserSearchCountOnFirstLastBirthDate" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvUserStopSearchIDMAdminNotify" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvMatchingCritera" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">FirstName,LastName,BirthDateDate</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-trace-message level="1">
													<arg-string>
														<token-text xml:space="preserve">User Count NOT ASSOCIATED with Match On First, Last, BirthMMDD:</token-text>
														<token-local-variable name="lvCountUnAssociatedUserMatch" />
													</arg-string>
												</do-trace-message>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								