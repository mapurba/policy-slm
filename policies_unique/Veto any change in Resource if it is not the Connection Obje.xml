<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto any change in Resource if it is not the Connection Object in this driver</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Resource</if-class-name>
											<if-src-dn op="not-in-subtree">~dirxml.auto.driverdn~</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								