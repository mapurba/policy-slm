<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>UserAccount entitlement: if account entitlement is granted, set the status</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.resourcemapping.UserAccount" op="equal">true</if-global-variable>
											<if-entitlement name="UserAccount" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="arsStatus">
											<arg-value type="string">
												<token-text xml:space="preserve">Current</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							