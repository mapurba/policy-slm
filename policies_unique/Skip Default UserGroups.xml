<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Skip Default UserGroups</description>
									<comment xml:space="preserve">Privileged Account Manager has some default UserGroups which should not to be made available as Entitlements to end users, so removing those instances from the query result.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">instance</if-operation>
											<if-class-name mode="nocase" op="equal">UserGroup</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-attr name="name" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<or>
															<if-attr mode="nocase" name="name" op="equal">Everyone</if-attr>
															<if-attr mode="nocase" name="name" op="equal">Submit User</if-attr>
															<if-attr mode="nocase" name="name" op="equal">BLOCKEDUSERS</if-attr>
														</or>
													</arg-conditions>
													<arg-actions>
														<do-strip-xpath expression="." />
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							