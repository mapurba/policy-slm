<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update manager of the organization's workforceID</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">DirXML-sapS</if-class-name>
											<if-op-attr name="DirXML-sapS-R-A-P-008" op="changing" />
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">DirXML-sapS</if-class-name>
											<if-operation mode="case" op="equal">sync</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Position "</token-text>
												<token-attr name="DirXML-sapSShortName" />
												<token-text xml:space="preserve">" (</token-text>
												<token-src-name />
												<token-text xml:space="preserve">) re-assigned to person "</token-text>
												<token-attr name="DirXML-sapS-R-A-P-008" />
												<token-text xml:space="preserve">".</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Updating organizations managed by this position</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="managedOrganizations" scope="policy">
											<arg-node-set>
												<token-query datastore="src">
													<arg-dn>
														<token-global-variable name="dvr.saphr.driverdn" />
														<token-text xml:space="preserve">\sap\om\o</token-text>
													</arg-dn>
													<arg-match-attr name="DirXML-sapO-R-B-S-012">
														<arg-value type="string">
															<token-src-name />
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">DirXML-sapOID</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">DirXML-sapOShortName</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">DirXML-sapO-R-B-O-002</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">GUID</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="managedOrganizations" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="managedOrganization" scope="policy">
													<arg-node-set>
														<token-local-variable name="current-node" />
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="managedOrganizationID" scope="policy">
													<arg-node-set>
														<token-xpath expression="$managedOrganization[1]/attr[@attr-name='DirXML-sapOID']/value[1]" />
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="lvTmp" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">- Updating organization "</token-text>
														<token-local-variable name="managedOrganizationID" />
														<token-text xml:space="preserve">"...</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="lvTmp" />
													</arg-string>
												</do-trace-message>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvFile" scope="policy">
															<arg-string>
																<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-if>
													<arg-conditions>
														<and>
															<if-attr mode="regex" name="DirXML-sapS-R-A-P-008" op="equal">.+</if-attr>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-dest-attr-value class-name="DirXML-sapO" name="DirXML-sapOManagerWorkforceID">
															<arg-association>
																<token-xpath expression="$managedOrganization/attr[@attr-name='GUID']/value" />
															</arg-association>
															<arg-value type="string">
																<token-attr name="DirXML-sapS-R-A-P-008" />
															</arg-value>
														</do-set-dest-attr-value>
													</arg-actions>
													<arg-actions>
														<do-clear-dest-attr-value class-name="DirXML-sapO" name="DirXML-sapOManagerWorkforceID">
															<arg-association>
																<token-xpath expression="$managedOrganization/attr[@attr-name='GUID']/value" />
															</arg-association>
														</do-clear-dest-attr-value>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							