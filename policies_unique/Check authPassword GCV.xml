<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check authPassword GCV</description>
									<comment xml:space="preserve">Checks the GCV for mapping authPassword to Login Disabled.</comment>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="map-authpassword-logindisabled" op="not-equal">true</if-global-variable>
											<if-class-name op="not-equal">User</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								