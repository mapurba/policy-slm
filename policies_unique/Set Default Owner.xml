<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Default Owner</description>
									<comment xml:space="preserve">When a new User is created in RACF, assign a default owner from the Default Owner GCV.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable name="racf-default-owner" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="DirXML-RACF-owner">
											<arg-value type="string">
												<token-global-variable name="racf-default-owner" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
								