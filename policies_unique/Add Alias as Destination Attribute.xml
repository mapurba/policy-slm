<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Alias as Destination Attribute</description>
									<conditions>
										<or>
											<if-operation mode="nocase" op="not-equal">delete</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="User" name="2">
											<arg-value type="string">
												<token-src-attr name="Surname" />
												<token-text xml:space="preserve">, </token-text>
												<token-src-attr name="Given Name" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							