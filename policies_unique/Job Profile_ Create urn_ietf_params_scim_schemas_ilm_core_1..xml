<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Job Profile: Create urn:ietf:params:scim:schemas:ilm:core:1.0:WDJobProfile:wd-JobProfileName for Job Profile</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDJobProfile</if-class-name>
											<if-global-variable mode="nocase" name="gvJobProfileNameMappingAttr" op="not-equal">Custom</if-global-variable>
											<if-attr name="~gvJobProfileNameMappingAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="WDJobProfile" name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDJobProfile:wd-JobProfileName">
											<arg-value type="string">
												<token-attr name="~gvJobProfileNameMappingAttr~" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								