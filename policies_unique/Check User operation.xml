<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check User operation</description>
									<comment xml:space="preserve">Skip this rule if the operation is not for a User object.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="not-equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								