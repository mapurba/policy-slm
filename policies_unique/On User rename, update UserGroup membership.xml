<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>On User rename, update UserGroup membership</description>
									<comment xml:space="preserve">On renaming of a user object, update the UserGroup membership which the user would have got through Entitlement request.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">rename</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="newName" scope="policy">
											<arg-string>
												<token-src-name />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="oldName" scope="policy">
											<arg-string>
												<token-parse-dn dest-dn-format="slash" length="1" src-dn-format="slash" start="-1">
													<token-xpath expression="@old-src-dn" />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="groupList" scope="policy">
											<arg-node-set>
												<token-query class-name="Group">
													<arg-match-attr name="Member">
														<arg-value type="string">
															<token-local-variable name="oldName" />
														</arg-value>
													</arg-match-attr>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="groupList" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="groupAssoc" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/association" />
													</arg-string>
												</do-set-local-variable>
												<do-remove-dest-attr-value class-name="Group" direct="true" name="Member">
													<arg-association>
														<token-local-variable name="groupAssoc" />
													</arg-association>
													<arg-value type="string">
														<token-local-variable name="oldName" />
													</arg-value>
												</do-remove-dest-attr-value>
												<do-add-dest-attr-value class-name="Group" direct="true" name="Member">
													<arg-association>
														<token-xpath expression="$current-node" />
													</arg-association>
													<arg-value type="string">
														<token-local-variable name="newName" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-veto />
									</actions>
								</rule>
							