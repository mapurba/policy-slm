<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Move User Based on Entitlement Changes</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.googlePlacementOption" op="equal">entitlement</if-global-variable>
											<if-entitlement name="NOVLGGLEORGU-UserPlacementEntitlement" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-entitlement name="NOVLGGLEORGU-UserPlacementEntitlement" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-move-dest-object>
													<arg-dn>
														<token-added-entitlement name="NOVLGGLEORGU-UserPlacementEntitlement" />
													</arg-dn>
												</do-move-dest-object>
											</arg-actions>
											<arg-actions>
												<do-move-dest-object>
													<arg-dn>
														<token-text xml:space="preserve" />
													</arg-dn>
												</do-move-dest-object>
											</arg-actions>
										</do-if>
										<do-break />
									</actions>
								</rule>
							