<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GroupWise External Post Office Placement</description>
									<conditions>
										<and>
											<if-class-name op="equal">Organizational Unit</if-class-name>
											<if-global-variable name="driver.gw.SyncOUToGWPO" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add" name="gw:classification">
											<arg-string>
												<token-text xml:space="preserve">external</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-add-dest-attr-value class-name="Organizational Unit" name="50035">
											<arg-value type="string">
												<token-global-variable name="driver.gw.SyncOU2GWEPODomainName" />
											</arg-value>
										</do-add-dest-attr-value>
										<do-break />
									</actions>
								</rule>
							