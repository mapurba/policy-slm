<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Name and place object</description>
									<conditions>
										<and>
											<if-local-variable name="obj-name" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
												<token-text xml:space="preserve">\</token-text>
												<token-local-variable name="obj-name" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-break />
									</actions>
								</rule>
							