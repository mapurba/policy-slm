<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Job family: Create urn:ietf:params:scim:schemas:ilm:core:1.0:WDJobfamily:wd-JobFamilyName for Job Family</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDJobfamily</if-class-name>
											<if-global-variable mode="nocase" name="gvJobFamilyNameMappingAttr" op="not-equal">Custom</if-global-variable>
											<if-attr name="~gvJobFamilyNameMappingAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="WDJobfamily" name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDJobfamily:wd-JobFamilyName">
											<arg-value type="string">
												<token-attr name="~gvJobFamilyNameMappingAttr~" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								