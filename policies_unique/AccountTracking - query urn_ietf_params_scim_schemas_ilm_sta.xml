<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - query urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXMLAccounts Attribute</description>
									<conditions>
										<and>
											<if-op-property name="AccountTracking-ObjectDN" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="AccountIdentifiers" scope="policy">
											<arg-node-set>
												<token-dest-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXMLAccounts">
													<arg-dn>
														<token-op-property name="AccountTracking-ObjectDN" />
													</arg-dn>
												</token-dest-attr>
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
								