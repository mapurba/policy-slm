<?xml version="1.0" encoding="UTF-8"?>
<rule disabled="true">
									<description>Populate User's attribute EmployeeType from wd-WorkerIDType</description>
									<comment xml:space="preserve">Populate user's attribute  as per IDV attribute format : EmployeeType from wd-WorkerIDType</comment>
									<conditions>
										<and>
											<if-op-attr name="wd-WorkerIDType" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr mode="nocase" name="wd-WorkerIDType" op="equal">Employee_ID</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-dest-attr-value name="employeeType">
													<arg-value type="string">
														<token-text xml:space="preserve">employee</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-set-dest-attr-value name="employeeType">
													<arg-value type="string">
														<token-text xml:space="preserve">nonEmployee</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							