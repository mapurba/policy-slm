<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: User ID Expiration Date</description>
									<conditions>
										<and>
											<if-global-variable name="account.cert.expiredate" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="cert-expire-date">
											<arg-string>
												<token-global-variable name="account.cert.expiredate" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								