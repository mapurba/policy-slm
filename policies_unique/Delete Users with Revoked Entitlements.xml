<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Delete Users with Revoked Entitlements</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="UserAcctPolicy" op="equal">entitlements</if-global-variable>
											<if-global-variable name="on-account-remove" op="equal">delete</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="ACF2 Logonid" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="ACF2Account" />
											</arg-node-set>
											<arg-actions>
												<do-delete-dest-object />
												<do-remove-association when="before">
													<arg-association>
														<token-association />
													</arg-association>
												</do-remove-association>
												<do-veto />
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								