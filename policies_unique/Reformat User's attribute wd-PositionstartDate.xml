<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat User's attribute wd-PositionstartDate</description>
									<comment xml:space="preserve">Reformat user's attribute  as per IDV attribute format :wd-PositionstartDate</comment>
									<conditions>
										<and>
											<if-op-attr name="wd-PositionstartDate" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvOPAttribute" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">wd-PositionstartDate</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-reformat-op-attr name="$lvOPAttribute$">
											<arg-value type="string">
												<token-replace-all regex="-" replace-with="">
													<token-replace-all regex=":" replace-with="00">
														<token-op-attr name="$lvOPAttribute$" />
													</token-replace-all>
												</token-replace-all>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								