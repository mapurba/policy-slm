<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Apply user delete mailfile deletion option on the user delete event</description>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable name="account.mailfileDeleteAction" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../delete[@class-name='User']" name="mail-file-action">
											<arg-string>
												<token-global-variable name="account.mailfileDeleteAction" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								