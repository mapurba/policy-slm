<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Increment urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLOther2 (revision counter) by 1 for each modification of urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLnwoContent or DirXML-DueDate</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">DirXMLWorkOrder</if-class-name>
										</or>
										<or>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLnwoContent" op="changing" />
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLDueDate" op="changing" />
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="revision" scope="policy">
											<arg-string>
												<token-dest-attr class-name="DirXMLWorkOrder" name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLOther2" />
											</arg-string>
										</do-set-local-variable>
										<do-set-dest-attr-value class-name="DirXMLWorkOrder" name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLOther2">
											<arg-value type="string">
												<token-xpath expression="number( concat( '0', $revision ) ) + 1" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							