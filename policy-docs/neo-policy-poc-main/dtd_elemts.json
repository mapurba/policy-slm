        "Argument_Elements": {
          "description": "Elements defining dynamic input data for Actions.",
          "children": [
            {
              "arg-actions": "Specifies actions associated with the enclosing action (e.g., do-if, do-while). Contains <do-*> elements.",
              "parent_elements": [
                "do-for-each",
                "do-if",
                "do-implement-entitlement",
                "do-while"
              ]
            },
            {
              "arg-conditions": "Specifies conditions associated with the enclosing action (e.g., do-if, do-while). Contains <and> or <or> elements.",
              "parent_elements": ["do-if", "do-while"]
            },
            {
