{
  "DirXMLScript_DTD_Elements": {
    "description": "Defines the structure for policies, rules, conditions, actions, arguments, and tokens used in processing XDS documents.",
    "children": [
      {
        "policy": {
          "description": "Top-level container for an ordered set of rules, used to examine and modify an XDS document.",
          "parent_elements": [],
          "content": "description?, (rule | include)*",
          "children": [
            {
              "description": {
                "description": "Description of a <policy> or a <rule>",
                "parent_elements": ["policy", "rule"]
              }
            },
            {
              "include": {
                "description": "Include rules from another policy",
                "parent_elements": ["policy"]
              }
            },
            {
              "rule": {
                "description": "A fundamental building block specifying a set of conditions and actions.",
                "parent_elements": ["policy"],
                "content": "description?, comment*, conditions, actions",
                "children": [
                  {
                    "comment": {
                      "description": "Long description of a <rule>",
                      "parent_elements": ["rule"]
                    }
                  },
                  {
                    "conditions": "Defines criteria (CNF or DNF) that must be met for actions to be performed.",
                    "parent_elements": ["rule"],
                    "content": "(and* | or*)",
                    "children": [
                      {
                        "and": "Logical conjunction (AND) of tests.",
                        "parent_elements": ["conditions", "arg-conditions"],
                        "content": "(if-association | if-attr | ... | if-xpath)*",
                        "children": [
                          {
                            "if-association": {
                              "description": "Test association value.",
                              "parent_elements": ["and", "or"],
                              "attributes": {
                                "op": "(associated | available | equal | lt | gt | not-associated | not-available | not-equal | not-lt | not-gt)",
                                "mode": "(%SCALARMODES;) case",
                                "disabled": "(%BOOLEAN;) false",
                                "notrace": "(%BOOLEAN;) false"
                              }
                            }
                          },
                          {
                            "if-attr": {
                              "description": "Test attribute in operation or source datastore (two-phase check).",
                              "parent_elements": ["and", "or"],
                              "children": ["component"],
                              "attributes": {
                                "op": "(available | equal | lt | gt | not-available | not-equal | not-lt | not-gt)",
                                "mode": "(%MODES;) nocase",
                                "name": "CDATA",
                                "disabled": "(%BOOLEAN;) false",
                                "notrace": "(%BOOLEAN;) false"
                              }
                            }
                          },
                          {
                            "if-class-name": {
                              "description": "Test the object class of the current operation.",
                              "parent_elements": ["and", "or"],
                              "attributes": {
                                "op": "(available | equal | lt | gt | not-available | not-equal | not-lt | not-gt)",
                                "mode": "(%SCALARMODES;) nocase",
                                "disabled": "(%BOOLEAN;) false",
                                "notrace": "(%BOOLEAN;) false"
                              }
                            }
                          },
                          {
                            "if-dest-attr": {
                              "description": "Test attribute in the destination datastore.",
                              "parent_elements": ["and", "or"],
                              "children": [
                                "component",
                                "arg-dn",
                                "arg-association",
                                "value"
                              ],
                              "attributes": {
                                "op": "(available | equal | lt | gt | not-available | not-equal | not-lt | not-gt)",
                                "mode": "(%MODES;) nocase",
                                "name": "CDATA",
                                "disabled": "(%BOOLEAN;) false",
                                "notrace": "(%BOOLEAN;) false",
                                "class-name": "CDATA"
                              }
                            }
                          },
                          {
                            "if-dest-dn": {
                              "description": "Test the destination DN.",
                              "parent_elements": ["and", "or"],
                              "attributes": {
                                "op": "(available | equal | in-container | in-subtree | not-available | not-equal | not-in-container | not-in-subtree)",
