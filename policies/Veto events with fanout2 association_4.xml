<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto events with fanout2 association</description>
									<comment xml:space="preserve">strip fanout2 elements</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
											<if-association mode="regex" op="equal">fanout2-.+</if-association>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Filter events which have 'fanout2' associations</token-text>
												<token-local-variable name="lsname" />
												<token-text xml:space="preserve"> </token-text>
												<token-local-variable name="lstype" />
												<token-text xml:space="preserve">] ...</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression=".[starts-with(association/text(), 'fanout2')]" />
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								