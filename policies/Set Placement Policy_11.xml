<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-local-variable name="dn" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-set-op-association>
											<arg-association>
												<token-local-variable name="association" />
											</arg-association>
										</do-set-op-association>
									</actions>
								</rule>
								