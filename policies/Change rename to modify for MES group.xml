<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Change rename to modify for MES group</description>
									<comment xml:space="preserve">Creates modify document instead of rename for mail-enabled security group with attribute psexecute containing powershell command to rename this group</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">rename</if-operation>
											<if-class-name mode="nocase" op="equal">group</if-class-name>
											<if-dest-attr mode="nocase" name="mailEnabled" op="equal">true</if-dest-attr>
											<if-dest-attr mode="nocase" name="securityEnabled" op="equal">true</if-dest-attr>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="psexecute" when="after">
											<arg-value type="string">
												<token-text xml:space="preserve">Set-Group -Identity </token-text>
												<token-association />
												<token-text xml:space="preserve"> -DisplayName "</token-text>
												<token-xpath expression="new-name/text()" />
												<token-text xml:space="preserve">"</token-text>
											</arg-value>
										</do-add-dest-attr-value>
										<do-strip-xpath expression="." />
									</actions>
								</rule>
							