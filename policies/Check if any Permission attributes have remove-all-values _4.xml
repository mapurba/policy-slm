<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check if any Permission attributes have remove-all-values so that full reconciliation is done</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-xpath op="not-true">$current-op/modify-attr[@attr-name="DirXML-EntitlementRef"]</if-xpath>
											<if-global-variable mode="nocase" name="drv.entitlement.onboarding" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="perm-attrs" scope="policy">
											<arg-node-set>
												<token-xpath expression="$perm-map-xml/mapping-table/row/col[last()]/text()" />
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="perm-attrs" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<or>
															<if-xpath disabled="true" op="true">../modify[@from-merge='true']</if-xpath>
															<if-xpath op="true">../modify/modify-attr[@attr-name=$current-node]/remove-all-values</if-xpath>
														</or>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="reconcileAllForUser">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								