<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>remove dest-dn from add operation to enable matching rule</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.futurevent.enable" op="equal">true</if-global-variable>
											<if-class-name mode="nocase" op="equal">DirXMLWorkOrder</if-class-name>
											<if-operation op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="@dest-dn[../@class-name='DirXMLWorkOrder']" />
									</actions>
								</rule>
								