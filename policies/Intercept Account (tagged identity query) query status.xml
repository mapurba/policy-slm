<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Intercept Account (tagged identity query) query status</description>
									<conditions>
										<and>
											<if-xpath op="true">../status[@event-id='query-driver-ident']/operation-data/@UserAccountEntitlementQuery</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression=".." name="instance" />
										<do-set-xml-attr expression="../instance[last()]" name="class-name">
											<arg-string>
												<token-text xml:space="preserve">Account</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-set-xml-attr expression="../instance[last()]" name="src-dn">
											<arg-string>
												<token-text xml:space="preserve">Epic Interconnects</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="../instance[last()]" name="attr" />
										<do-set-xml-attr expression="../instance[last()]/attr[last()]" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">EMPRecord</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="../instance[last()]/attr[last()]" name="value" />
										<do-append-xml-text expression="../instance[last()]/attr[last()]/value[last()]">
											<arg-string>
												<token-text xml:space="preserve">User Emp Record in Epic</token-text>
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="../instance[last()]" name="attr" />
										<do-set-xml-attr expression="../instance[last()]/attr[last()]" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">EMPDescription</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="../instance[last()]/attr[last()]" name="value" />
										<do-append-xml-text expression="../instance[last()]/attr[last()]/value[last()]">
											<arg-string>
												<token-text xml:space="preserve">User EMP Record in EPIC</token-text>
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="../instance[last()]" name="attr" />
										<do-set-xml-attr expression="../instance[last()]/attr[last()]" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">EMPValue</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="../instance[last()]/attr[last()]" name="value" />
										<do-append-xml-text expression="../instance[last()]/attr[last()]/value[last()]">
											<arg-string>
												<token-local-variable name="domainName" />
												<token-text xml:space="preserve">EMP Record</token-text>
											</arg-string>
										</do-append-xml-text>
										<do-strip-xpath expression=".[count(attr)=0]" />
									</actions>
								</rule>
								