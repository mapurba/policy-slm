<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Facsimile Telephone Number</description>
									<comment xml:space="preserve">Facsimile Telephone Number is a structure attribute in eDirectory.  This policy reformats the value to work with Epic.</comment>
									<conditions>
										<and>
											<if-op-attr name="Facsimile Telephone Number" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="Facsimile Telephone Number">
											<arg-value type="string">
												<token-xpath expression="$current-value/component[@name=&quot;faxNumber&quot;]/text()" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							