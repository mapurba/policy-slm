<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip operation attribute of Employee if wd-workeridType is contingent worker</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-WorkerIDType" op="equal">Contingent_Worker_ID</if-op-attr>
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-local-variable mode="nocase" name="DV-wd-WorkerIDType-user" op="equal">Contingent_Worker_ID</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-OriginalHiredate" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Rehire" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Retired" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Terminated" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-TerminationDate" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Active" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-ActivePositionIDs" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Hiredate" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-International_Assignment" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Host_Countries" />
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-E-Home_Countries" />
									</actions>
								</rule>
								