<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Save the driver start time</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="currentTime">
											<arg-string>
												<token-time format="yyyyMMddHHmmss.SSS" tz="UTC" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="driverStartTime" scope="driver">
											<arg-string>
												<token-xpath expression="es:getSeconds($currentTime,'yyyyMMddHHmmss.SSS')" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
							