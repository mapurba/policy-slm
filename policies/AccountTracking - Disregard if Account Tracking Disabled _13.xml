<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Disregard if Account Tracking Disabled or Wrong Object Class</description>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="jfoactrk.Enabled" op="equal">false</if-global-variable>
											<if-xpath op="not-true">@connection-dn</if-xpath>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								