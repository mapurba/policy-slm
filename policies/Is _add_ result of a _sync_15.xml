<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Is &lt;add&gt; result of a &lt;sync&gt;</description>
									<conditions>
										<and>
											<if-xpath op="true">self::add/operation-data/from-sync</if-xpath>
											<if-global-variable name="driver.gw.createOnMigrate" op="equal">false</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								