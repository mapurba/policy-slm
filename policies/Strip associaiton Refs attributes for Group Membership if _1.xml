<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip associaiton Refs attributes for Group Membership if Group entitlement is ON</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Group" op="equal">true</if-global-variable>
											<if-op-property mode="nocase" name="Entitlement-Group-Query" op="not-equal">true</if-op-property>
											<if-operation mode="nocase" op="equal">instance</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-class-name mode="nocase" op="equal">indirect.usr</if-class-name>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="grpMembership" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">usr_mbr_of.idg</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-class-name mode="nocase" op="equal">direct.view_usr</if-class-name>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="grpMembership" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">fk_mbr_of</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="$grpMembership$" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="attr[@attr-name=$grpMembership]/value" />
													</arg-node-set>
													<arg-actions>
														<do-strip-xpath expression="$current-node/@association-ref" />
														<do-strip-xpath expression="$current-node/@type" />
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							