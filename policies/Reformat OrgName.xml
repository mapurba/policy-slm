<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat OrgName</description>
									<comment xml:space="preserve">OrgName is single valued within Google. This policy ensures that only one value is sent and it is preceeded with a "Remove all values" token to ensure proper update. By default, the last value present in the event is sent.</comment>
									<conditions>
										<and>
											<if-op-attr name="OrgName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lv-values" scope="policy">
											<arg-node-set>
												<token-op-attr name="OrgName" />
											</arg-node-set>
										</do-set-local-variable>
										<do-strip-op-attr name="OrgName" />
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="case" op="equal">add</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-add-dest-attr-value name="OrgName">
													<arg-value type="string">
														<token-xpath expression="$lv-values[last()]" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-set-dest-attr-value name="OrgName">
													<arg-value type="string">
														<token-xpath expression="$lv-values[last()]" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								