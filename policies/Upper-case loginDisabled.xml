<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Upper-case loginDisabled</description>
									<conditions>
										<and>
											<if-op-attr name="loginDisabled" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="loginDisabled">
											<arg-value>
												<token-upper-case>
													<token-local-variable name="current-value" />
												</token-upper-case>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							