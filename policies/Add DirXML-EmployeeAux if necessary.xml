<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add DirXML-EmployeeAux if necessary</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-src-attr mode="nocase" name="Object Class" op="not-equal">DirXML-EmployeeAux</if-src-attr>
										</and>
									</conditions>
									<actions>
										<do-add-src-attr-value name="Object Class">
											<arg-value type="string">
												<token-text xml:space="preserve">DirXML-EmployeeAux</token-text>
											</arg-value>
										</do-add-src-attr-value>
									</actions>
								</rule>
							