<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Roaming User: Roam Server Name</description>
									<conditions>
										<and>
											<if-global-variable name="account.roamserver" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="roaming-server">
											<arg-string>
												<token-global-variable name="account.roamserver" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								