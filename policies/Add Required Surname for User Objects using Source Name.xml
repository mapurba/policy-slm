<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Required Surname for User Objects using Source Name</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-attr name="Surname" op="not-available" />
											<if-src-dn op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="Surname">
											<arg-value type="string">
												<token-src-name />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								