<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Appending &lt;association-ref&gt; for Member in Group Migration</description>
									<conditions>
										<and>
											<if-class-name op="equal">urn:ietf:params:scim:schemas:core:2.0:Group</if-class-name>
											<if-xpath op="true">./attr[@attr-name='members:value']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="ValueNode" scope="policy">
											<arg-node-set>
												<token-xpath expression="./attr[@attr-name='members:value']/value" />
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="ValueNode" />
											</arg-node-set>
											<arg-actions>
												<do-set-xml-attr expression="$current-node" name="association-ref">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="$current-node" name="type">
													<arg-string>
														<token-text xml:space="preserve">dn</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							