<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add nspmDistributionAttribute attribute to add operation</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="publish-password-to-dp" op="equal">true</if-global-variable>
											<if-operation op="equal">add</if-operation>
											<if-password op="available" />
											<if-password mode="regex" op="equal">.+</if-password>
										</and>
									</conditions>
									<actions>
										
										<do-add-dest-attr-value name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword">
											<arg-value>
												<token-password />
											</arg-value>
										</do-add-dest-attr-value>
										
										<do-set-xml-attr expression="add-attr[@attr-name = 'urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword'][last()]" name="enforce-password-policy">
											<arg-string>
												<token-global-variable name="enforce-password-policy" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								