<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Append RACF Command add-attr</description>
									<comment xml:space="preserve">This rule will modify the outgoing command document to include RACF TSO command(s) necessary for the command action.</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="racfcmd" scope="policy">
											<arg-node-set>
												<token-xpath expression="racf:xdsToRACFCMDAddAttr(.)" />
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
							