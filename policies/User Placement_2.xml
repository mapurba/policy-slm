<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Placement</description>
									<conditions>
										<or>
											<if-class-name op="equal">User</if-class-name>
										</or>
										<or>
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName" op="available" />
										</or>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
												<token-text xml:space="preserve">\</token-text>
												<token-escape-for-dest-dn>
													<token-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName" />
												</token-escape-for-dest-dn>
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							