<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove directory synced groups from entitlement response</description>
									<comment xml:space="preserve">Removes group instances which have 'dirSyncEnabled' attributes set to true</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">instance</if-operation>
											<if-xpath op="true">//operation-data/@filter-group-entitlement='true'</if-xpath>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-op-attr mode="nocase" name="dirSyncEnabled" op="equal">true</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="." />
									</actions>
								</rule>
							