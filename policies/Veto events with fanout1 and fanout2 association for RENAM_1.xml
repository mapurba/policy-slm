<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto events with fanout1 and fanout2 association for RENAME</description>
									<conditions>
										<or>
											<if-operation mode="case" op="equal">rename</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-association mode="regex" op="equal">fanout2-.+</if-association>
											<if-association mode="regex" op="equal">fanout1-.+</if-association>
										</or>
									</conditions>
									<actions>
										<do-strip-xpath expression="." />
									</actions>
								</rule>
							