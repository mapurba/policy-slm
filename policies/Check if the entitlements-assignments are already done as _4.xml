<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check if the entitlements-assignments are already done as part of sync in etp</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
											<if-global-variable mode="nocase" name="drv.entitlement.onboarding" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.entitlement.Group.onboard" op="equal">true</if-global-variable>
											<if-xpath op="true">operation-data/entitlement-assignments</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="reconcileDone">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="./operation-data/entitlement-assignments[last()]" />
									</actions>
								</rule>
								