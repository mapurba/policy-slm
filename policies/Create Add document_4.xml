<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Create Add document</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="addDoc" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;add&gt;&lt;/add&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-clone-xpath dest-expression="$addDoc/add" src-expression="@*" />
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">$addDoc/add/operation-data</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-element expression="$addDoc/add" name="operation-data" />
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">$addDoc/add/operation-data/existing-associations</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-element expression="$addDoc/add/operation-data" name="existing-associations" />
											</arg-actions>
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="lv-associations" />
											</arg-node-set>
											<arg-actions>
												<do-clone-xpath dest-expression="$addDoc//add/operation-data/existing-associations" src-expression="$current-node" />
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$instance//attr" />
											</arg-node-set>
											<arg-actions>
												<do-append-xml-element expression="$addDoc/add" name="add-attr" />
												<do-set-xml-attr expression="$addDoc//add-attr[last()]" name="attr-name">
													<arg-string>
														<token-xpath expression="$current-node/@attr-name" />
													</arg-string>
												</do-set-xml-attr>
												<do-clone-xpath dest-expression="$addDoc//add-attr[last()]" src-expression="$current-node/value" />
											</arg-actions>
										</do-for-each>
										<do-clone-xpath dest-expression="//input" src-expression="$addDoc/node()" />
									</actions>
								</rule>
							