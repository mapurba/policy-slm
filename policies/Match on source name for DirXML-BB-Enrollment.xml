<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match on source name for DirXML-BB-Enrollment</description>
									<comment xml:space="preserve">Match DirXML-BB-enr-p-ext-key to DirXML-BB-p-ext-key and DirXML-BB-c-ext-key to DirXML-BB-c-ext-key</comment>
									<conditions>
										<and>
											<if-op-property name="BBObjectType" op="equal">DirXML-BB-Enrollment</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-op-class-name>
											<arg-string>
												<token-text xml:space="preserve">DirXML-BB-Enrollment</token-text>
											</arg-string>
										</do-set-op-class-name>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="DirXML-BB-enr-p-ext-key">
												<arg-value>
													<token-attr name="DirXML-BB-enr-p-ext-key" />
												</arg-value>
											</arg-match-attr>
											<arg-match-attr name="DirXML-BB-enr-c-ext-key">
												<arg-value>
													<token-attr name="DirXML-BB-enr-c-ext-key" />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
									</actions>
								</rule>
								