<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account Entitlement remove: Delete account</description>
									<conditions>
										<and>
											<if-global-variable name="driver.gw.ent.account.remove" op="equal">delete</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="gwAccount" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-delete-dest-object />
										<do-set-xml-attr expression="../delete" name="gw:original-event">
											<arg-string>
												<token-text>modify</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							