<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check for needed User attributes</description>
									<conditions>
										<and>
											<if-op-attr name="CN" op="not-available" />
										</and>
										<and>
											<if-op-attr name="Full Name" op="not-available" />
										</and>
										<and>
											<if-op-attr name="DirXML-Associations" op="not-available" />
											<if-global-variable mode="nocase" name="drv-ldap-driver-dn" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-class-name mode="nocase" op="equal">User</if-class-name>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-veto />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								