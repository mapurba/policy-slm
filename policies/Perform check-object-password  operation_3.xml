<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Perform check-object-password  operation</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">modify-password</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-src-dn op="equal">$prevAddSrcdn$</if-src-dn>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="destDN">
													<arg-node-set>
														<token-query class-name="User" scope="entry">
															<arg-association>
																<token-association />
															</arg-association>
															<arg-string>
																<token-global-variable name="column.username" />
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="username">
													<arg-string>
														<token-global-variable name="column.username" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-destdn" scope="policy">
													<arg-string>
														<token-xpath expression="$destDN/attr[@attr-name=$username]/value/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="lv-destdn" op="equal" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-break />
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="lv-chkpwd" scope="policy">
															<arg-node-set>
																<token-xml-parse>
																	<token-text xml:space="preserve">&lt;input&gt;&lt;check-object-password event-id="check-password-for-modify-password" dest-dn="</token-text>
																	<token-local-variable name="lv-destdn" />
																	<token-text xml:space="preserve">"&gt;&lt;association&gt;</token-text>
																	<token-association />
																	<token-text xml:space="preserve">&lt;/association&gt;&lt;password&gt;</token-text>
																	<token-password />
																	<token-text xml:space="preserve">&lt;/password&gt;&lt;/check-object-password&gt;&lt;/input&gt;</token-text>
																</token-xml-parse>
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="lv-chkpwdstatus">
															<arg-node-set>
																<token-xpath expression="cmd:execute($destCommandProcessor, $lv-chkpwd)" />
															</arg-node-set>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">$lv-chkpwdstatus//status[@level="success"]</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-veto />
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-break />
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							