<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if not a User object or urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword available</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="not-equal">User</if-class-name>
											<if-operation mode="case" op="not-equal">modify</if-operation>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword" op="available" />
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								