<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Generate Random Password if no Distribution Password available and GCV is set to random</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.ILMSFPWDGEN.trigger.account.enable" op="equal">true</if-global-variable>
											<if-op-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled" op="changing-to">false</if-op-attr>
											<if-global-variable mode="nocase" name="drv.ILMSFPWDGEN.method" op="equal">random</if-global-variable>
										</and>
										<and>
											<if-global-variable mode="nocase" name="drv.ILMSFPWDGEN.trigger.account.disable" op="equal">true</if-global-variable>
											<if-op-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled" op="changing-to">true</if-op-attr>
											<if-global-variable mode="nocase" name="drv.ILMSFPWDGEN.method" op="equal">random</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword">
											<arg-value type="string">
												<token-generate-password policy-dn="\[root]\Security\Password Policies\Salesforce Password Policy" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								