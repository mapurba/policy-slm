<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set application status variable</description>
									<comment xml:space="preserve">Set local variable app-status if there is a valid value for App-Status in the operation.</comment>
									<conditions>
										<and>
											<if-op-attr name="App-Status" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="app-status" scope="policy">
											<arg-string>
												<token-op-attr name="App-Status" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								