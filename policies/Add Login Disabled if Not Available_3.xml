<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Login Disabled if Not Available</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
										</and>
										<and>
											<if-operation op="equal">add</if-operation>
										</and>
										<and>
											<if-attr name="Login Disabled" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-src-attr-value class-name="User" name="Login Disabled">
											<arg-value type="string">
												<token-text xml:space="preserve">FALSE</token-text>
											</arg-value>
										</do-set-src-attr-value>
									</actions>
								</rule>
							