<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GET idvdata/ms</description>
									<conditions />
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">MSys Cache: </token-text>
												<token-text xml:space="preserve">Dispatching managed systems query...</token-text>
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="api-name" scope="policy">
											<arg-string>
												<token-class-name />
											</arg-string>
										</do-set-local-variable>
										<do-set-op-property name="api-name">
											<arg-string>
												<token-local-variable name="api-name" />
											</arg-string>
										</do-set-op-property>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">MSys Cache: </token-text>
												<token-xpath expression="count($MSYS__CACHE/cache/instance[@class-name=$api-name])" />
												<token-text xml:space="preserve"> results retrieved from managed system cache.</token-text>
											</arg-string>
										</do-trace-message>
										<do-clone-xpath dest-expression="operation-data" src-expression="$MSYS__CACHE/cache/instance[@class-name=$api-name]" />
									</actions>
								</rule>
								