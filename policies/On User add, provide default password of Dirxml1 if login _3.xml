<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>On User add, provide default password of Dirxml1 if login password is not available</description>
									<comment xml:space="preserve">npsmDistributionPassword is the login password</comment>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-password>
											<arg-string>
												<token-text xml:space="preserve">Dirxml1</token-text>
											</arg-string>
										</do-set-dest-password>
									</actions>
								</rule>
							