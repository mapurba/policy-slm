<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Extension Placement</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-pbxExtension</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="Avaya.ExtensionsDN" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="DirXML-nwoExtension" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-break />
									</actions>
								</rule>
								