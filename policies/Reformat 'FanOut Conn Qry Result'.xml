<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat 'FanOut Conn Qry Result'</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
											<if-op-property mode="nocase" name="FO_CONN_QRY_RES" op="equal">true</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-clone-xpath dest-expression=".." src-expression="operation-data/instance" />
										<do-strip-xpath expression="operation-data" />
									</actions>
								</rule>
								