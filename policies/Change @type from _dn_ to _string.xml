<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Change @type from "dn" to "string"</description>
									<conditions>
										<and>
											<if-operation op="equal">instance</if-operation>
										</and>
										<and>
											<if-op-property name="ig-collection-query" op="equal">true</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="./attr/value[@association]" />
											</arg-node-set>
											<arg-actions>
												<do-set-xml-attr expression="$current-node" name="type">
													<arg-string>
														<token-text xml:space="preserve">string</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							