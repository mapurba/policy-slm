<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto out of scope events on Group</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-src-dn op="not-in-subtree">~idv.dit.data.groups~</if-src-dn>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">Scoping: </token-text>
														<token-text xml:space="preserve">Vetoing event on group '</token-text>
														<token-src-dn />
														<token-text xml:space="preserve">' (out of scope).</token-text>
													</arg-string>
												</do-trace-message>
												<do-veto />
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							