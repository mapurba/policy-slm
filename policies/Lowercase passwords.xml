<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Lowercase passwords</description>
									<comment xml:space="preserve">When passwords are published from RACF, they are usually not case-preserved.  This rule will convert all passwords into lowercase.</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="enable-password-publish-lower" op="equal">true</if-global-variable>
											<if-password op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="password" notrace="true" scope="policy">
											<arg-string>
												<token-lower-case>
													<token-password />
												</token-lower-case>
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="password/text()" notrace="true" />
										<do-append-xml-text expression="password" notrace="true">
											<arg-string>
												<token-local-variable name="password" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
							