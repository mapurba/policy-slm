<?xml version="1.0" encoding="UTF-8"?>
<rule notrace="true">
									<description>Reformat postalAddress</description>
									<conditions />
									<actions>
										<do-reformat-op-attr name="postalAddress">
											<arg-value type="structured">
												<arg-component name="string">
													<token-replace-first regex="([^\$]*).*" replace-with="$1">
														<token-local-variable name="current-value" />
													</token-replace-first>
												</arg-component>
												<arg-component name="string">
													<token-replace-first regex="[^\$]*\$([^\$]*).*" replace-with="$1">
														<token-local-variable name="current-value" />
													</token-replace-first>
												</arg-component>
												<arg-component name="string">
													<token-replace-first regex="[^\$]*\$[^\$]*\$([^\$]*).*" replace-with="$1">
														<token-local-variable name="current-value" />
													</token-replace-first>
												</arg-component>
												<arg-component name="string">
													<token-replace-first regex="[^\$]*\$[^\$]*\$[^\$]*\$([^\$]*).*" replace-with="$1">
														<token-local-variable name="current-value" />
													</token-replace-first>
												</arg-component>
												<arg-component name="string">
													<token-replace-first regex="[^\$]*\$[^\$]*\$[^\$]*\$[^\$]*\$([^\$]*).*" replace-with="$1">
														<token-local-variable name="current-value" />
													</token-replace-first>
												</arg-component>
												<arg-component name="string">
													<token-replace-first regex="[^\$]*\$[^\$]*\$[^\$]*\$[^\$]*\$[^\$]*\$([^\$]*)" replace-with="$1">
														<token-local-variable name="current-value" />
													</token-replace-first>
												</arg-component>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								