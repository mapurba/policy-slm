<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Login Disabled from *DISABLED to true</description>
									<conditions>
										<and>
											<if-op-attr name="Login Disabled" op="changing-to">*DISABLED</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="Login Disabled" />
										<do-set-dest-attr-value class-name="User" name="Login Disabled">
											<arg-value type="string">
												<token-text xml:space="preserve">true</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								