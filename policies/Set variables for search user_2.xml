<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set variables for search user</description>
									<comment xml:space="preserve">This rule will set variable for search user</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="gvUserMatchAttr" op="not-equal">worker-pub-match-custom</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvUserStopSearch" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvUserStopSearchIDMAdminNotify" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvUserFirstName" scope="policy">
													<arg-string>
														<token-op-attr name="Given Name" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvUserLastName" scope="policy">
													<arg-string>
														<token-op-attr name="Surname" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvWorkforceID" scope="policy">
													<arg-string>
														<token-op-attr name="workforceID" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvWorkerIDType" scope="policy">
													<arg-string>
														<token-op-attr name="wd-WorkerIDType" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvAssocaition" scope="policy">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvUserMatchErrorMessage" scope="policy">
													<arg-string />
												</do-set-local-variable>
												<do-set-local-variable name="lvMatchingCritera" scope="policy">
													<arg-string>
														<token-text xml:space="preserve" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="lvUserStopSearch" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-break />
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								