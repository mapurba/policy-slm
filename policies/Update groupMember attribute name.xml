<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update groupMember attribute name</description>
									<comment xml:space="preserve">change groupMember attribute name to Member</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-operation mode="regex" op="not-equal">query|query-ex</if-operation>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="$current-op/modify-attr[@attr-name='urn:ietf:params:scim:schemas:ilm:static:1.0:User:groupMember']/remove-all-values" />
										<do-rename-op-attr dest-name="urn:ietf:params:scim:schemas:core:2.0:Group:members.$ref" src-name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:groupMember" />
									</actions>
								</rule>
								