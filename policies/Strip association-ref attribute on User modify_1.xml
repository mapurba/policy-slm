<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip association-ref attribute on User modify</description>
									<comment xml:space="preserve">Thi rule strips association-ref attribute from all User object 'Group Membership' values on User modify in publisher channel.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-op-attr name="Group Membership" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="$current-op/modify-attr[@attr-name='Group Membership']//@association-ref" />
										<do-strip-xpath expression="$current-op/modify-attr[@attr-name='Group Membership']//@type" />
									</actions>
								</rule>
								