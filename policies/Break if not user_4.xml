<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if not user</description>
									<comment xml:space="preserve">Break if not user  class</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="not-equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								