<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Organization: Create CN for Organization</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">wd-organization</if-class-name>
											<if-attr name="wd-OrganizationID" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="wd-organization" name="CN">
											<arg-value type="string">
												<token-attr name="wd-OrganizationID" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							