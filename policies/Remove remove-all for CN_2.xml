<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove remove-all for CN</description>
									<comment xml:space="preserve">Remove remove-all from CN attribute if it is available in the modify operation for Group</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-xpath op="true">modify-attr[@attr-name='CN']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="modify-attr[@attr-name='CN']/remove-all-values" />
									</actions>
								</rule>
								