<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation data to create an add-association element.</description>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="op-type">
											<arg-string>
												<token-text xml:space="preserve">add</token-text>
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="dn">
											<arg-string>
												<token-src-dn />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							