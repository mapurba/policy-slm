<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add User E-Mail: ACL Manager</description>
									<conditions>
										<and>
											<if-global-variable name="account.email.aclmanager" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="mail-acl-manager-name">
											<arg-string>
												<token-global-variable name="account.email.aclmanager" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								