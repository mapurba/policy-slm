<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match Users</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ADAliasName">
												<arg-value type="string">
													<token-global-variable name="drv-ad-domain-name" />
													<token-text xml:space="preserve">\</token-text>
													<token-src-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName" />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
									</actions>
								</rule>
							