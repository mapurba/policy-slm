<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Fanout match using urn:ietf:params:scim:schemas:core:2.0:User:name.givenName and Surname</description>
									<conditions>
										<or>
											<if-class-name op="equal">User</if-class-name>
											<if-op-property name="lsname" op="available" />
										</or>
										<or>
											<if-op-property name="renNew" op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-dn>
												<token-text xml:space="preserve">\</token-text>
												<token-op-property name="lsname" />
											</arg-dn>
											<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
											<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
										</do-find-matching-object>
									</actions>
								</rule>
							