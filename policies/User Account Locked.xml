<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Account Locked</description>
									<comment xml:space="preserve">If the user account is locked in the IDV due to failed login attempts set the Epic account status to blocked.</comment>
									<conditions>
										<and>
											<if-op-attr name="Locked By Intruder" op="available" />
											<if-global-variable mode="nocase" name="pdsepicedcfg.lockout.sync" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr mode="nocase" name="Locked By Intruder" op="equal">true</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv-BlockStatus" scope="policy">
													<arg-object>
														<token-xpath expression="es:BlockStatus(&quot;True&quot;, &quot;0&quot;, &quot;0&quot;, $pdsempentl.block.comment)" />
													</arg-object>
												</do-set-local-variable>
												<do-set-dest-attr-value name="BlockStatus" when="after">
													<arg-value type="string">
														<token-xpath expression="es:BlockStatus_jsonify($lv-BlockStatus)" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="lv-BlockStatus" scope="policy">
													<arg-object>
														<token-xpath expression="es:BlockStatus(&quot;False&quot;, &quot;0&quot;, &quot;0&quot;, &quot;&quot;)" />
													</arg-object>
												</do-set-local-variable>
												<do-set-dest-attr-value name="BlockStatus" when="after">
													<arg-value type="string">
														<token-xpath expression="es:BlockStatus_jsonify($lv-BlockStatus)" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								