<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Parse Account Slash DN</description>
									<comment xml:space="preserve">Parse Slash format DNs to get the App-Name (Authority) and Identifier (Name) attribute values for an account.</comment>
									<conditions>
										<or>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-operation mode="case" op="equal">modify</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">Sentinel-Account</if-class-name>
										</or>
										<or>
											<if-op-attr mode="nocase" name="Identifier-Type" op="equal">SLASHDN</if-op-attr>
										</or>
									</conditions>
									<actions>
										<do-reformat-op-attr name="Identifier">
											<arg-value type="string">
												<token-parse-dn dest-dn-format="slash" length="1" src-dn-format="slash" start="-1">
													<token-local-variable name="current-value" />
												</token-parse-dn>
											</arg-value>
										</do-reformat-op-attr>
										<do-reformat-op-attr name="App-Name">
											<arg-value type="string">
												<token-text xml:space="preserve">\</token-text>
												<token-parse-dn dest-dn-format="slash" length="-3" src-dn-format="slash" start="1">
													<token-local-variable name="current-value" />
												</token-parse-dn>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								