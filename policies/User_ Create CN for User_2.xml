<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User: Create CN for User</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="gvUserNameMappingAttr" op="not-equal">Custom</if-global-variable>
											<if-attr name="~gvUserNameMappingAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="User" name="CN">
											<arg-value type="string">
												<token-attr name="~gvUserNameMappingAttr~" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								