<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Match</description>
									<comment xml:space="preserve">Match User with urn:ietf:params:scim:schemas:core:2.0:User:name.givenName and Surname</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName" />
										</do-find-matching-object>
									</actions>
								</rule>
								