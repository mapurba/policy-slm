<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set initial password value from attribute if no Distribution Password available and GCV is set to attribute</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEPSWD.InitialPassword" op="equal">attribute</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lv_defaultPWDAttributeValue" scope="policy">
											<arg-string>
												<token-attr name="$gcv.NOVLGGLEPSWD.initialPasswordAttributeName$" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="regex" name="lv_defaultPWDAttributeValue" op="equal">......</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-default-attr-value name="nspmDistributionPassword" write-back="false">
													<arg-value type="string">
														<token-local-variable name="lv_defaultPWDAttributeValue" />
													</arg-value>
												</do-set-default-attr-value>
											</arg-actions>
											<arg-actions>
												<do-set-default-attr-value name="nspmDistributionPassword" write-back="false">
													<arg-value type="string">
														<token-substring length="6">
															<token-local-variable name="lv_defaultPWDAttributeValue" />
															<token-global-variable name="gcv.NOVLGGLEPSWD.initialPasswordPadCharacter" />
															<token-global-variable name="gcv.NOVLGGLEPSWD.initialPasswordPadCharacter" />
															<token-global-variable name="gcv.NOVLGGLEPSWD.initialPasswordPadCharacter" />
															<token-global-variable name="gcv.NOVLGGLEPSWD.initialPasswordPadCharacter" />
															<token-global-variable name="gcv.NOVLGGLEPSWD.initialPasswordPadCharacter" />
															<token-global-variable name="gcv.NOVLGGLEPSWD.initialPasswordPadCharacter" />
															<token-global-variable name="gcv.NOVLGGLEPSWD.initialPasswordPadCharacter" />
														</token-substring>
													</arg-value>
												</do-set-default-attr-value>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							