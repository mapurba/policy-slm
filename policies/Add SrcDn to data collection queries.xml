<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add SrcDn to data collection queries</description>
									<comment xml:space="preserve">Data Collection queries does not have SrnDn in the response. This is required for proper mapping</comment>
									<conditions>
										<and>
											<if-op-property mode="nocase" name="data-collection-query" op="equal">true</if-op-property>
											<if-class-name mode="nocase" op="equal">group</if-class-name>
											<if-xpath op="not-true">@src-dn</if-xpath>
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">group</if-class-name>
											<if-xpath op="not-true">@src-dn</if-xpath>
											<if-xpath op="true">./attr[@attr-name='Name']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="username" scope="policy">
											<arg-string>
												<token-xpath expression="./attr[@attr-name='Name']/value" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="srcDn" scope="policy">
											<arg-string>
												<token-global-variable name="ConnectedSystemName" />
											</arg-string>
										</do-set-local-variable>
										<do-set-xml-attr expression="." name="src-dn">
											<arg-string>
												<token-local-variable name="username" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								