<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set initial password value from attribute if no Distribution Password available and GCV is set to attribute</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.ILMSFPWDGEN.method" op="equal">attribute</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword" write-back="false">
											<arg-value type="string">
												<token-attr name="$drv.ILMSFPWDGEN.method.attr.name$" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
							