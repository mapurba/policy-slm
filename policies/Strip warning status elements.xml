<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip warning status elements</description>
									<conditions>
										<and>
											<if-operation op="equal">status</if-operation>
											<if-xml-attr name="level" op="not-equal">success</if-xml-attr>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="self::status[@level='warning']" />
									</actions>
								</rule>
								