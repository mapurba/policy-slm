<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto user modify operation when entitlement is revoked.</description>
									<comment xml:space="preserve">If the modify operation has an attribute named ignore set to true then veto the user modify with entitlement revoke.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xml-attr mode="nocase" name="ignore" op="equal">true</if-xml-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-veto />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								