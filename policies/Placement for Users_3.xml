<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Placement for Users</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="attrNS" scope="policy">
											<arg-node-set>
												<token-xpath expression="add-attr[@attr-name='urn:ietf:params:scim:schemas:core:2.0:User:userName']/value" />
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="attrNS" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="nodeVal" scope="policy">
													<arg-string>
														<token-split delimiter="@">
															<token-xpath expression="$current-node/text()" />
														</token-split>
													</arg-string>
												</do-set-local-variable>
												<do-strip-xpath expression="$current-node/text()" />
												<do-append-xml-text expression="$current-node">
													<arg-string>
														<token-xpath expression="$nodeVal" />
													</arg-string>
												</do-append-xml-text>
											</arg-actions>
										</do-for-each>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
								