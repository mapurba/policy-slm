<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Roaming User: Cleanup Period (in days)</description>
									<conditions>
										<and>
											<if-global-variable name="account.roamcleanupperiod" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="roaming-cleanup-period">
											<arg-string>
												<token-global-variable name="account.roamcleanupperiod" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								