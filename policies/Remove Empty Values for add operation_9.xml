<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove Empty Values for add operation</description>
									<comment xml:space="preserve">Remove Empty Values for add operation</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="add-attr/value[.='']" />
									</actions>
								</rule>
								