<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check if operation is add-association or modify-association</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.GWAccount" op="equal">true</if-global-variable>
											<if-operation mode="regex" op="equal">add-association|modify-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="IsAddAssoc" scope="driver">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								