<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Getting group type details</description>
									<comment xml:space="preserve">This rule would fetch the group type and recipientType.</comment>
									<conditions>
										<or>
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">group</if-class-name>
										</or>
										<or>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:Group:owner" op="changing" />
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:members.value" op="changing" />
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="queryResponse" scope="policy">
											<arg-node-set>
												<token-query class-name="group" scope="entry">
													<arg-association>
														<token-association />
													</arg-association>
													<arg-string>
														<token-text xml:space="preserve">DirXML-AADObjectType</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">RecipientTypeDetails</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="GroupType" scope="policy">
											<arg-string>
												<token-xpath expression="$queryResponse//attr[@attr-name=&quot;urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-AADObjectType&quot;]/value[1]/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="GroupRecipientTypeDetails" scope="policy">
											<arg-string>
												<token-xpath expression="$queryResponse//attr[@attr-name=&quot;RecipientTypeDetails&quot;]/value[1]/text()" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								