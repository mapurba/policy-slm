<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking-Disregard if account tracking is disabled or wrong ObjectClass</description>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="jfoactrk.Enabled" op="equal">false</if-global-variable>
											<if-class-name mode="nocase" op="not-equal">~jfoactrk.ObjectClass~</if-class-name>
											<if-src-dn op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								