<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat Login Disabled</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">urn:ietf:params:scim:schemas:core:2.0:User</if-class-name>
											<if-op-attr name="active" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr mode="nocase" name="active" op="equal">true</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="loginDisabled">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="loginDisabled">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-strip-op-attr name="active" />
										<do-add-dest-attr-value name="active">
											<arg-value type="state">
												<token-local-variable name="loginDisabled" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							