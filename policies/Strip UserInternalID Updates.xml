<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip UserInternalID Updates</description>
									<comment xml:space="preserve">UserInternalID is required for Epic record creates, but the value cannot be changed after that. 
So, stripping any updates to it that occur after the initial create.</comment>
									<conditions>
										<and />
										<and>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-op-attr name="UserInternalID" op="available" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="UserInternalID" />
									</actions>
								</rule>
							