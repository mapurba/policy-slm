<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>nspmDistributionPassword: Do not match accounts  </description>
									<comment xml:space="preserve"> Do not match accounts  without passwords as this prevents an unnecessary match operation for accounts that would be vetoed by the driver.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="attempt-to-match">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							