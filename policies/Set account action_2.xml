<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set account action</description>
									<conditions>
										<and>
											<if-local-variable name="acctAction" op="available" />
											<if-local-variable mode="nocase" name="acctAction" op="equal">accountDisableByEntitlementRevoke</if-local-variable>
											<if-operation mode="case" op="equal">status</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="accountAction">
											<arg-string>
												<token-text xml:space="preserve">accountDisableByEntitlementRevoke</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							