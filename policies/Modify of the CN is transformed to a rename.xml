<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Modify of the CN is transformed to a rename</description>
									<comment xml:space="preserve">This rule transforms a modification of the CN to a rename.</comment>
									<conditions>
										<and>
											<if-operation op="equal">modify</if-operation>
											<if-op-attr name="CN" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="CN" />
										<do-rename-dest-object>
											<arg-string>
												<token-src-attr name="CN" />
											</arg-string>
										</do-rename-dest-object>
									</actions>
								</rule>
							