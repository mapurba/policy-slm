<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check account operation</description>
									<comment xml:space="preserve">Skip this policy if the operation is not an account operation, or not add or modify</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="not-equal">account</if-class-name>
										</and>
										<and>
											<if-operation mode="case" op="not-equal">add</if-operation>
											<if-operation mode="case" op="not-equal">modify</if-operation>
										</and>
										<and>
											<if-op-attr name="App-Status" op="not-available" />
											<if-op-attr name="Vault-Status" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								