<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>For Identity, transform dn to lowercase</description>
									<comment xml:space="preserve">This transforms the value of dn attribute in Identity class to lowercase</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">identity</if-class-name>
											<if-op-attr name="dn" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="dn">
											<arg-value type="string">
												<token-lower-case>
													<token-op-attr name="dn" />
												</token-lower-case>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								