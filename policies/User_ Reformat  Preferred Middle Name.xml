<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User: Reformat  Preferred Middle Name</description>
									<comment xml:space="preserve">Store Preferred middle name as middle initial.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-PreferredMiddleName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-PreferredMiddleName" op="not-equal" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-reformat-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-PreferredMiddleName">
													<arg-value type="string">
														<token-upper-case>
															<token-substring length="1">
																<token-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-PreferredMiddleName" />
															</token-substring>
														</token-upper-case>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions>
												<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-PreferredMiddleName" />
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								