<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation attribute costCenter</description>
									<comment xml:space="preserve">Add operation attribute costCenter</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="COST_CENTER_Code" op="available" />
										</and>
									</conditions>
									<actions>
										<do-clone-op-attr dest-name="costCenter" src-name="COST_CENTER_Code" />
										<do-set-local-variable name="lvcostCenter" scope="policy">
											<arg-string>
												<token-op-attr name="COST_CENTER_Code" />
											</arg-string>
										</do-set-local-variable>
										<do-reformat-op-attr name="costCenter">
											<arg-value type="string">
												<token-xpath expression="substring-after($lvcostCenter,'_')" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								