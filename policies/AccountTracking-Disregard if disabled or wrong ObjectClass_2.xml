<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking-Disregard if disabled or wrong ObjectClass</description>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="jfoactrk.Enabled" op="equal">false</if-global-variable>
											<if-operation mode="nocase" op="equal">add-association</if-operation>
											<if-op-property name="AccountTracking-ObjectDN" op="not-available" />
											<if-xpath op="not-true">@connection-dn</if-xpath>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								