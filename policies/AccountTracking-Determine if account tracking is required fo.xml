<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking-Determine if account tracking is required for the event</description>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">add|modify|delete|rename|move</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="idvAccStatus" scope="policy">
											<arg-string>
												<token-global-variable name="jfoactrk.IdvDefaultStatus" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="~jfoactrk.StatusAttr~" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="requireAccUpdate" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-attr mode="nocase" name="~jfoactrk.StatusAttr~" op="equal">false</if-op-attr>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="idvAccStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">A</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-op-attr mode="nocase" name="~jfoactrk.StatusAttr~" op="equal">true</if-op-attr>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="idvAccStatus" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">I</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-set-local-variable name="idvAccStatus" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">U</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">AccountTracking-Tracking IDV account status as "$idvAccStatus$" for </token-text>
														<token-src-name />
													</arg-string>
												</do-trace-message>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-operation mode="case" op="equal">add</if-operation>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="requireAccUpdate" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">AccountTracking-Tracking IDV account status as "$idvAccStatus$" for </token-text>
																<token-src-name />
															</arg-string>
														</do-trace-message>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">@from-merge='true'</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="requireAccUpdate" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">true</token-text>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="idvAccStatus" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">-</token-text>
																	</arg-string>
																</do-set-local-variable>
																<do-set-op-property name="AccountTracking-association">
																	<arg-string>
																		<token-association />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-operation mode="case" op="not-equal">modify</if-operation>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="requireAccUpdate" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">true</token-text>
																			</arg-string>
																		</do-set-local-variable>
																		<do-set-local-variable name="idvAccStatus" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">-</token-text>
																			</arg-string>
																		</do-set-local-variable>
																		<do-set-op-property name="AccountTracking-association">
																			<arg-string>
																				<token-association />
																			</arg-string>
																		</do-set-op-property>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								