<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>WRONG_PASSWORD on associated user</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
											<if-xpath disabled="true" op="true">contains('operation-date/errorMessage/*[local-name()='errorMessage']/text()','locked')</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="../status/text()" />
											</arg-node-set>
											<arg-actions>
												<do-trace-message notrace="true">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-trace-message>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">contains($current-node,'WRONG_PASSWORD')</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-trace-message disabled="true">
															<arg-string>
																<token-text xml:space="preserve">WRONG_PASSWORD ACTION</token-text>
																<token-text xml:space="preserve">  NSPM is </token-text>
																<token-local-variable name="nspmfinal" />
															</arg-string>
														</do-trace-message>
														<do-set-src-attr-value name="password">
															<arg-association>
																<token-xpath expression="operation-data/@src-dn" />
															</arg-association>
															<arg-value>
																<token-named-password name="resetPass" />
															</arg-value>
														</do-set-src-attr-value>
														<do-set-src-attr-value name="nspmPassword" notrace="true">
															<arg-association>
																<token-xpath expression="operation-data/@src-dn" />
															</arg-association>
															<arg-value>
																<token-local-variable name="nspmfinal" notrace="true" />
															</arg-value>
														</do-set-src-attr-value>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							