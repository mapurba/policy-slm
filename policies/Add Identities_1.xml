<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Identities</description>
									<comment xml:space="preserve">Add identites to User on user creation for Azure B2C</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">user</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable name="b2c-identities" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable disabled="true" name="b2cIdentitiesGCV" scope="policy">
													<arg-string>
														<token-global-variable name="b2c-identities" />
													</arg-string>
												</do-set-local-variable>
												<do-append-xml-element expression="../add" name="add-attr" />
												<do-set-xml-attr expression="../add/add-attr[last()]" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">identities</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="b2cIdentitiesNS" scope="policy">
													<arg-node-set>
														<token-split delimiter=";">
															<token-global-variable name="b2c-identities" />
														</token-split>
													</arg-node-set>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="b2cIdentitiesNS" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="identityNS" scope="policy">
															<arg-node-set>
																<token-split delimiter=":">
																	<token-local-variable name="current-node" />
																</token-split>
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="signInType" scope="policy">
															<arg-string>
																<token-xpath expression="$identityNS[1]" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="edirAttr" scope="policy">
															<arg-string>
																<token-xpath expression="$identityNS[2]" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="edirAttrValues" scope="policy">
															<arg-node-set>
																<token-src-attr name="$edirAttr$" />
															</arg-node-set>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable name="edirAttrValues" op="available" />
																	<if-local-variable mode="nocase" name="edirAttrValues" op="not-equal" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-for-each>
																	<arg-node-set>
																		<token-local-variable name="edirAttrValues" />
																	</arg-node-set>
																	<arg-actions>
																		<do-append-xml-element expression="../add/add-attr[@attr-name='identities']" name="value" />
																		<do-set-xml-attr expression="../add/add-attr[@attr-name='identities']/value[last()]" name="type">
																			<arg-string>
																				<token-text xml:space="preserve">structured</token-text>
																			</arg-string>
																		</do-set-xml-attr>
																		<do-append-xml-element expression="../add/add-attr[@attr-name='identities']/value[last()]" name="component" />
																		<do-set-xml-attr expression="../add/add-attr[@attr-name='identities']/value[last()]/component[last()]" name="name">
																			<arg-string>
																				<token-text xml:space="preserve">signInType</token-text>
																			</arg-string>
																		</do-set-xml-attr>
																		<do-append-xml-text expression="../add/add-attr[@attr-name='identities']/value[last()]/component[@name='signInType']">
																			<arg-string>
																				<token-local-variable name="signInType" />
																			</arg-string>
																		</do-append-xml-text>
																		<do-append-xml-element expression="../add/add-attr[@attr-name='identities']/value[last()]" name="component" />
																		<do-set-xml-attr expression="../add/add-attr[@attr-name='identities']/value[last()]/component[last()]" name="name">
																			<arg-string>
																				<token-text xml:space="preserve">issuerAssignedId</token-text>
																			</arg-string>
																		</do-set-xml-attr>
																		<do-append-xml-text expression="../add/add-attr[@attr-name='identities']/value[last()]/component[@name='issuerAssignedId']">
																			<arg-string>
																				<token-local-variable name="current-node" />
																			</arg-string>
																		</do-append-xml-text>
																	</arg-actions>
																</do-for-each>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<or>
													<if-op-attr name="identities" op="not-available" />
													<if-op-attr mode="nocase" name="identities" op="equal" />
												</or>
											</arg-conditions>
											<arg-actions>
												<do-strip-op-attr name="identities" />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								