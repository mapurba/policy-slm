<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Record whether to update Email Address on Rename</description>
									<comment xml:space="preserve">To Update Email address on modify association response from the application.</comment>
									<conditions>
										<and>
											<if-class-name mode="case" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="case" op="equal">rename</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="updateEmailOnRename" scope="driver">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="updateEmailOnRename" scope="driver">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							