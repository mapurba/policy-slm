<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check for needed Group attributes</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
										</or>
										<or>
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" op="not-available" />
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:Group:owner" op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							