<rule>
									<description>Add DN value to Add events</description>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="DISTINGUISHED_NAME">
