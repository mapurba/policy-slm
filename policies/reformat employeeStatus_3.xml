<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>reformat employeeStatus</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:employeeStatus" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:employeeStatus" op="equal">A</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-reformat-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:employeeStatus">
													<arg-value type="string">
														<token-text xml:space="preserve">active</token-text>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:employeeStatus" op="not-equal">active</if-op-attr>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-reformat-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:employeeStatus">
															<arg-value type="string">
																<token-text xml:space="preserve">inactive</token-text>
															</arg-value>
														</do-reformat-op-attr>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							