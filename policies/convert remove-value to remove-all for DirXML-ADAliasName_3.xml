<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>convert remove-value to remove-all for DirXML-ADAliasName</description>
									<conditions>
										<and>
											<if-operation op="equal">modify</if-operation>
											<if-op-attr name="DirXML-ADAliasName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="attrValue" scope="policy">
											<arg-node-set>
												<token-op-attr name="DirXML-ADAliasName" />
											</arg-node-set>
										</do-set-local-variable>
										<do-strip-op-attr name="DirXML-ADAliasName" />
										<do-set-dest-attr-value name="DirXML-ADAliasName">
											<arg-value>
												<token-xpath expression="$attrValue[1]" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								