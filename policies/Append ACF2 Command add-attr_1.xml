<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Append ACF2 Command add-attr</description>
									<comment xml:space="preserve">This rule will modify the outgoing command document to include ACF2 TSO command(s) necessary for the command action.</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="ACF2cmd" scope="policy">
											<arg-node-set>
												<token-xpath expression="ACF2:xdsToACF2AddAttr(., 'ACF2CMD')" />
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
							