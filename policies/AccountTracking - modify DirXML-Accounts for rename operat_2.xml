<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - modify DirXML-Accounts for rename operation</description>
									<comment xml:space="preserve">modify-association part</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">modify-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="oldAssociationValue" scope="driver">
											<arg-string>
												<token-xpath expression="./association/text()" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								