<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Get Encrypted Attributes From Filter</description>
									<comment xml:space="preserve">Get encrypted attributes from filter</comment>
									<conditions>
										<and>
											<if-class-name op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="class-name" scope="policy">
											<arg-string>
												<token-class-name />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="encryptedclass" scope="driver">
											<arg-node-set>
												<token-xpath expression="(($intSubencryptedAttrs)//attr[@attr-name=$class-name])" />
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="encryptedAttrs" scope="driver">
											<arg-string>
												<token-xpath expression="(($encryptedclass)//value)" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
							