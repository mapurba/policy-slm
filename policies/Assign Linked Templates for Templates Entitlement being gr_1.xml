<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Assign Linked Templates for Templates Entitlement being granted or revoked</description>
									<comment xml:space="preserve">Build linkedtemplatesconfig</comment>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="drv.entitlement.externalid" op="equal">true</if-global-variable>
										</or>
										<or>
											<if-class-name op="equal">User</if-class-name>
										</or>
										<or disabled="true">
											<if-operation disabled="true" mode="regex" op="equal">modify</if-operation>
										</or>
										<or>
											<if-entitlement name="ExternalIdentifier" op="changing" />
										</or>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">modify</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-clear-dest-attr-value name="ExternalIdentifiers" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-entitlement name="ExternalIdentifier" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="lv-IDType" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-AttrName" scope="policy">
													<arg-string>
														<token-map dest="Assignment" src="Title" table="..\PDSEMPENTL-ExternalIdentifiers-MAP">
															<token-local-variable name="lv-IDType" />
														</token-map>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-IDValue" scope="policy">
													<arg-string>
														<token-src-attr name="$lv-AttrName$" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value name="ExternalIdentifiers">
													<arg-value type="string">
														<token-xpath expression="es:createExternalIDJSON($lv-IDValue, $lv-IDType, &quot;True&quot;)" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="lv-IDType" />
														<token-text xml:space="preserve"> </token-text>
														<token-local-variable name="lv-IDValue" />
														<token-text xml:space="preserve"> </token-text>
														<token-local-variable name="lv-AttrName" />
													</arg-string>
												</do-trace-message>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							