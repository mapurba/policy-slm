<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set driver-scoped MSSP customer ID if local-scoped value was set above</description>
									<conditions>
										<and>
											<if-local-variable name="local.tenant.number" op="available" />
											<if-local-variable mode="nocase" name="local.tenant.number" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="drv.customer.key" scope="driver">
											<arg-string>
												<token-local-variable name="local.tenant.number" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								