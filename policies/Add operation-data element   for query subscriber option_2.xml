<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation-data element   for query subscriber option</description>
									<comment xml:space="preserve">Add operation-data element   for query subscriber option on basis of driver level local variable from publisher channel</comment>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-operation mode="nocase" op="equal">query</if-operation>
										</or>
										<or>
											<if-xpath op="not-true">workday-data</if-xpath>
										</or>
										<or>
											<if-global-variable mode="nocase" name="gvWorkersMergeIDV" op="equal">true</if-global-variable>
										</or>
									</conditions>
									<actions>
										
										<do-append-xml-element expression="." name="workday-data" />
										<do-append-xml-element expression="workday-data" name="WD-WorkforceID" />
										<do-append-xml-text expression="workday-data/WD-WorkforceID">
											<arg-string>
												<token-local-variable name="DV-wd-WorkforceID-user" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="workday-data" name="WD-WorkerIDType" />
										<do-append-xml-text expression="workday-data/WD-WorkerIDType">
											<arg-string>
												<token-local-variable name="DV-wd-WorkerIDType-user" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="workday-data" name="WD-effectiveDate" />
										<do-append-xml-text expression="workday-data/WD-effectiveDate">
											<arg-string>
												<token-time format="yyyy-MM-dd-hh:mm" />
											</arg-string>
										</do-append-xml-text>
										<do-set-op-association>
											<arg-association>
												<token-local-variable name="DV-wd-Association-user" />
											</arg-association>
										</do-set-op-association>
									</actions>
								</rule>
								