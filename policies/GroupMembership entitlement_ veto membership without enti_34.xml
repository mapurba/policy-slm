<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GroupMembership entitlement: veto membership without entitlement</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.notesGroup2.use" op="equal">true</if-global-variable>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="./add-attr[@attr-name=&quot;Member&quot;] | ./modify-attr[@attr-name=&quot;Member&quot;]" />
									</actions>
								</rule>
							