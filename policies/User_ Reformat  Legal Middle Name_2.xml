<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User: Reformat  Legal Middle Name</description>
									<comment xml:space="preserve">Store Legal middle name as middle initial.</comment>
									<conditions>
										<and>
											<if-op-attr name="wd-LegalMiddleName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr mode="nocase" name="wd-LegalMiddleName" op="not-equal" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-reformat-op-attr name="wd-LegalMiddleName">
													<arg-value type="string">
														<token-upper-case>
															<token-substring length="1">
																<token-op-attr name="wd-LegalMiddleName" />
															</token-substring>
														</token-upper-case>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions>
												<do-strip-op-attr name="wd-LegalMiddleName" />
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								