<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Convert dest DN to LDAP format</description>
									<conditions>
										<and>
											<if-operation op="not-equal">query</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-parse-dn dest-dn-format="ldap" src-dn-format="qualified-slash">
													<token-xpath expression="@qualified-src-dn" />
												</token-parse-dn>
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							