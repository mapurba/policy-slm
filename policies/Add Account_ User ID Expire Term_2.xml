<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: User ID Expire Term</description>
									<conditions>
										<and>
											<if-global-variable name="account.cert.expireterm" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="expire-term">
											<arg-string>
												<token-global-variable name="account.cert.expireterm" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								