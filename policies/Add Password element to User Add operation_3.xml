<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Password element to User Add operation</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-dest-password>
											<arg-string>
												<token-op-attr name="Surname" />
											</arg-string>
										</do-set-dest-password>
									</actions>
								</rule>
							