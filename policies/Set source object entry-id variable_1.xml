<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set source object entry-id variable</description>
									<comment xml:space="preserve">Set a local variable we can use to easily access the entry-id of the eDir User object.</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="op-entry-id" scope="policy">
											<arg-string>
												<token-xpath expression="@src-entry-id" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								