<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match on source name for DirXML-BB-Organization</description>
									<comment xml:space="preserve">Match source name to DirXML-BB-o-id</comment>
									<conditions>
										<and>
											<if-op-property name="BBObjectType" op="equal">DirXML-BB-Organization</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-op-class-name>
											<arg-string>
												<token-text xml:space="preserve">DirXML-BB-Organization</token-text>
											</arg-string>
										</do-set-op-class-name>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="DirXML-BB-o-id">
												<arg-value>
													<token-src-name />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
									</actions>
								</rule>
								