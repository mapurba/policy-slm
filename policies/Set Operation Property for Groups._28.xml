<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Operation Property for Groups.</description>
									<comment xml:space="preserve">The rule will check whether a match should be performed for Groups.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-global-variable mode="nocase" name="drv.pubPlacementType" op="equal">flat</if-global-variable>
											<if-src-dn op="in-subtree">~idv.dit.data.groups~</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="unmatched-src-dn">
											<arg-string>
												<token-unmatched-src-dn convert="true" />
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="attempt-to-match">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							