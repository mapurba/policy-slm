<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match PAM Objects for Credentials</description>
									<comment xml:space="preserve">Match objects in PAM based on the object name. Add the domain name to the Credential search query as it is mandatory attribute.</comment>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">DirXML-PUMCredential</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-trace-message level="3">
											<arg-string>
												<token-text xml:space="preserve">Credential object Source DN is </token-text>
												<token-src-dn />
												<token-text xml:space="preserve"> of class type </token-text>
												<token-class-name />
											</arg-string>
										</do-trace-message>
										<do-find-matching-object scope="entry">
											<arg-dn>
												<token-src-dn start="-1" />
											</arg-dn>
											<arg-match-attr name="DirXML-pumAccDomName">
												<arg-value type="string">
													<token-src-dn length="1" start="-2" />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
									</actions>
								</rule>
								