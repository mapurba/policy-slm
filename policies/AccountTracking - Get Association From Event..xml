<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Get Association From Event.</description>
									<comment xml:space="preserve">The policy will set the user association value from the add association event.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add-association</if-operation>
											<if-global-variable mode="nocase" name="drv.acctTrk.enable" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.acctTrk.mode" op="not-equal">fanout</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="usr-assoc" scope="policy">
											<arg-string>
												<token-xpath expression="./text()" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								