<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User:  Require Surname</description>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
									</actions>
								</rule>
							