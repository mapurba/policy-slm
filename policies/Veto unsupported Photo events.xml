<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto unsupported Photo events</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDPhoto</if-class-name>
											<if-operation op="not-equal">modify</if-operation>
											<if-operation disabled="true" op="not-equal">sync</if-operation>
											<if-operation mode="case" op="not-equal">query</if-operation>
											<if-operation mode="case" op="not-equal">query-ex</if-operation>
											<if-operation mode="case" op="not-equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							