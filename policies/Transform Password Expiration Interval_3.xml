<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Password Expiration Interval</description>
									<comment xml:space="preserve">Transforms RACF interval (days) into Password Expiration Interval (seconds).</comment>
									<conditions>
										<and>
											<if-op-attr name="DirXML-RACF-password-interval" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="interval" scope="policy">
											<arg-string>
												<token-attr name="DirXML-RACF-password-interval" />
											</arg-string>
										</do-set-local-variable>
										<do-reformat-op-attr name="DirXML-RACF-password-interval">
											<arg-value type="string">
												<token-xpath expression="$interval * 86400" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							