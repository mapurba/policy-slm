<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Convert Password Expiration Interval</description>
									<comment xml:space="preserve">Convert urn:ietf:params:scim:schemas:ilm:static:1.0:User:passwordExpirationInterval from days to seconds</comment>
									<conditions>
										<and>
											<if-xpath op="true">@from-merge</if-xpath>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:passwordExpirationInterval" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:passwordExpirationInterval">
											<arg-value type="string">
												<token-xpath expression="number($current-value)*86400" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							