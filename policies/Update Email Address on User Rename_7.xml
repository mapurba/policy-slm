<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update Email Address on User Rename</description>
									<comment xml:space="preserve">Update EMail Address and Internet EMail Address on User Rename.</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">modify-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable name="updateEmailOnRename" op="available" />
													<if-local-variable mode="nocase" name="updateEmailOnRename" op="equal">true</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="updateEmailOnRename" scope="driver">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="newAssociationValue" scope="policy">
													<arg-string>
														<token-xpath expression="./association[last()]/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">string-length($newAssociationValue)&gt;0</if-xpath>
															<if-xpath op="true">contains($newAssociationValue, "106")</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="VarUsrObj" scope="policy">
															<arg-node-set>
																<token-query class-name="User" datastore="src" scope="entry">
																	<arg-association>
																		<token-text xml:space="preserve">$newAssociationValue$</token-text>
																	</arg-association>
																	<arg-string>
																		<token-text xml:space="preserve">EMail Address</token-text>
																	</arg-string>
																</token-query>
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="VarUsrEmailAddr" scope="policy">
															<arg-string>
																<token-xpath expression="$VarUsrObj/*[@attr-name=&quot;Internet EMail Address&quot;]/value/text()" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">string-length($VarUsrEmailAddr)&gt;0</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-dest-attr-value class-name="User" name="Internet EMail Address" when="after">
																	<arg-association>
																		<token-text xml:space="preserve">$newAssociationValue$</token-text>
																	</arg-association>
																	<arg-value type="string">
																		<token-text xml:space="preserve">$VarUsrEmailAddr$</token-text>
																	</arg-value>
																</do-set-dest-attr-value>
																<do-set-dest-attr-value class-name="User" name="EMail Address" when="after">
																	<arg-association>
																		<token-text xml:space="preserve">$newAssociationValue$</token-text>
																	</arg-association>
																	<arg-value type="structured">
																		<arg-component name="eMailType">
																			<token-text xml:space="preserve">7</token-text>
																		</arg-component>
																		<arg-component name="eMailAddr">
																			<token-local-variable name="VarUsrEmailAddr" />
																		</arg-component>
																	</arg-value>
																</do-set-dest-attr-value>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							