<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set initial password value from attribute if no Distribution Password available and GCV is set to attribute</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLBNNRPSWD.InitialPassword" op="equal">attribute</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-password>
											<arg-string>
												<token-attr name="$gcv.NOVLBNNRPSWD.initialPasswordAttributeName$" />
											</arg-string>
										</do-set-dest-password>
									</actions>
								</rule>
								