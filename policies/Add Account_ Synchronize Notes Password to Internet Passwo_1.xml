<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Synchronize Notes Password to Internet Password</description>
									<conditions>
										<and>
											<if-global-variable name="account.cert.syncinternetpwd" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="sync-internet-password">
											<arg-string>
												<token-global-variable name="account.cert.syncinternetpwd" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								