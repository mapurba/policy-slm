<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Employee entitlement change (Delete Option)</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Employee" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.entitlement.remove" op="equal">delete</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="UserAccount" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="UserAccount" />
											</arg-node-set>
											<arg-actions>
												<do-delete-dest-object />
												<do-remove-association when="before">
													<arg-association>
														<token-association />
													</arg-association>
												</do-remove-association>
												<do-break />
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="UserAccount" />
											</arg-node-set>
											<arg-actions>
												<do-add-dest-object class-name="User">
													<arg-dn>
														<token-src-dn />
													</arg-dn>
												</do-add-dest-object>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							