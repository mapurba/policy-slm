<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account Entitlement: Expire or Unexpire account</description>
									<conditions>
										<and>
											<if-global-variable name="driver.gw.ent.account.remove" op="equal">expire</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="gwAccount" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="gwAccount" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-op-property name="accountDisableByEntitlementRevoke">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-op-property>
												<do-set-dest-attr-value name="NGW: Mailbox Expiration Time">
													<arg-value>
														
														<token-xpath expression="int:new(date:getTime(date:new()) div 1000)" />
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-op-property name="expire-account">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-op-property>
												<do-remove-association when="after">
													<arg-association>
														<token-association />
													</arg-association>
												</do-remove-association>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="gwAccount" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">false</token-text>
													</arg-value>
												</do-set-dest-attr-value>
												<do-clear-dest-attr-value class-name="User" name="NGW: Mailbox Expiration Time" />
												<do-set-op-property name="expire-account">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-op-property>
											</arg-actions>
										</do-for-each>
										<do-break />
									</actions>
								</rule>
								