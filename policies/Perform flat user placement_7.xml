<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Perform flat user placement</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.pubPlacementType" op="equal">flat</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-local-variable name="idmBaseContainer" />
												<token-src-name />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
								