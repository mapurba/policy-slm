<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User:  Match on Surname, Given Name</description>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-property name="connection-dn" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-find-matching-object scope="subtree">
													<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
													<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
													<arg-match-attr name="connection-dn">
														<arg-value type="string">
															<token-op-property name="connection-dn" />
														</arg-value>
													</arg-match-attr>
												</do-find-matching-object>
											</arg-actions>
											<arg-actions>
												<do-find-matching-object scope="subtree">
													<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
													<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
												</do-find-matching-object>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							