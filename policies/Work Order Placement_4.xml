<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Work Order Placement</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-nwoWorkOrder</if-class-name>
											<if-src-dn op="in-subtree" xml:space="preserve">\AvayaPBX\</if-src-dn>
											<if-src-dn op="not-equal" xml:space="preserve">\AvayaPBX\</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="workorder-dn" />
												<token-text xml:space="preserve">\</token-text>
												<token-src-name />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-break />
									</actions>
								</rule>
								