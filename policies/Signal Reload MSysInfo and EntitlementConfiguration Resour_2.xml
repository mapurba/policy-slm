<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Signal Reload MSysInfo and EntitlementConfiguration Resource with changes to fanout connection objects</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Resource</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:contentType" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="FanOutMiscUpdated" scope="driver">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="mSysInsInfoUpdated" scope="driver">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:data" op="available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="mSysInsInfoUpdated" scope="driver">
															<arg-string>
																<token-text xml:space="preserve">false</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">delete</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="FanOutMiscUpdated" scope="driver">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="mSysInsInfoUpdated" scope="driver">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								