<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Epic Attributes</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$current-op//@attr-name" />
											</arg-node-set>
											<arg-actions>
												
												
												
												<do-set-local-variable name="lv_current_complex_attr_name" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">PrimaryManager</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">$ln-epic-schema-mapping//attr-name-map/attr-name[nds-name/text()=$current-node]/app-name/text()=$lv_current_complex_attr_name</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lv_current_complex_attr_value" scope="policy">
															<arg-string>
																<token-xpath expression="$current-op//*[@attr-name=$current-node]//value/text()" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="regex" name="lv_current_complex_attr_value" op="equal">.+</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-trace-message level="3">
																	<arg-string>
																		<token-text xml:space="preserve">Processing complex attribute '</token-text>
																		<token-local-variable name="lv_current_complex_attr_name" />
																		<token-text xml:space="preserve">'</token-text>
																	</arg-string>
																</do-trace-message>
																<do-set-local-variable name="lv_manager_association_value" scope="policy">
																	<arg-string>
																		<token-resolve datastore="src">
																			<arg-dn>
																				<token-local-variable name="lv_current_complex_attr_value" />
																			</arg-dn>
																		</token-resolve>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="ln_split_manager_association_value" scope="policy">
																	<arg-node-set>
																		<token-split delimiter="\|">
																			<token-local-variable name="lv_manager_association_value" />
																		</token-split>
																	</arg-node-set>
																</do-set-local-variable>
																<do-set-local-variable name="lv_CID_value" scope="policy">
																	<arg-string>
																		<token-xpath expression="$ln_split_manager_association_value[2]" />
																	</arg-string>
																</do-set-local-variable>
																<do-strip-op-attr name="$current-node$" />
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="regex" name="lv_CID_value" op="equal">.+</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-dest-attr-value name="$current-node$">
																			<arg-value type="string">
																				<token-json-object>
																					<arg-string name="ID">
																						<token-text xml:space="preserve">"</token-text>
																						<token-xpath expression="$lv_CID_value" />
																						<token-text xml:space="preserve">"</token-text>
																					</arg-string>
																					<arg-string name="Type">
																						<token-text xml:space="preserve">"CID"</token-text>
																					</arg-string>
																				</token-json-object>
																			</arg-value>
																		</do-set-dest-attr-value>
																		<do-add-dest-attr-value name="UsersManagers">
																			<arg-value type="string">
																				<token-json-object>
																					<arg-string name="ID">
																						<token-text xml:space="preserve">"</token-text>
																						<token-local-variable name="lv_CID_value" />
																						<token-text xml:space="preserve">"</token-text>
																					</arg-string>
																					<arg-string name="Type">
																						<token-text xml:space="preserve">"CID"</token-text>
																					</arg-string>
																				</token-json-object>
																			</arg-value>
																		</do-add-dest-attr-value>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							