<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Store the target container</description>
									<conditions>
										<and>
											<if-global-variable name="drv.edir.base.container" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="edirBaseContainer">
											<arg-string>
												<token-text xml:space="preserve">,</token-text>
												<token-global-variable name="drv.edir.base.container" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								