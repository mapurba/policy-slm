<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update Entitlement Resource</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="entConfigResObj" scope="policy">
											<arg-node-set>
												<token-query class-name="Resource" datastore="src" scope="entry">
													<arg-dn>
														<token-text xml:space="preserve">cn=EntitlementConfiguration,</token-text>
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-dn>
													<arg-match-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:contentType">
														<arg-value type="string">
															<token-text xml:space="preserve">text/vnd.novell.idm.entitlementConfiguration+xml</token-text>
														</arg-value>
													</arg-match-attr>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="currentXml" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-base64-decode charset="UTF-8">
														<token-query class-name="Resource" datastore="src" scope="entry">
															<arg-dn>
																<token-text xml:space="preserve">cn=EntitlementConfiguration,</token-text>
																<token-global-variable name="dirxml.auto.driverdn" />
															</arg-dn>
															<arg-string>
																<token-text xml:space="preserve">urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:data</token-text>
															</arg-string>
														</token-query>
													</token-base64-decode>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-clone-xpath dest-expression="$currentXml/entitlement-configuration/entitlements" src-expression="$xml/entitlement-configuration/entitlements/node()" />
										<do-set-src-attr-value class-name="Resource" name="urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:data">
											<arg-dn>
												<token-xpath expression="$entConfigResObj/@src-dn" />
											</arg-dn>
											<arg-value type="xml">
												<token-base64-encode>
													<token-xml-serialize>
														<token-local-variable name="currentXml" />
													</token-xml-serialize>
												</token-base64-encode>
											</arg-value>
										</do-set-src-attr-value>
									</actions>
								</rule>
							