<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation-data element to password subscribe operations (if needed)</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-operation mode="nocase" op="equal">rename</if-operation>
										</or>
										<or>
											<if-xpath op="not-true">workday-data</if-xpath>
										</or>
									</conditions>
									<actions>
										
										<do-append-xml-element expression="." name="workday-data" />
										<do-append-xml-element expression="workday-data" name="WD-WorkforceID" />
										<do-append-xml-text expression="workday-data/WD-WorkforceID">
											<arg-string>
												<token-src-attr class-name="User" name="workforceID" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="workday-data" name="WD-WorkerIDType" />
										<do-append-xml-text expression="workday-data/WD-WorkerIDType">
											<arg-string>
												<token-src-attr class-name="User" name="wd-WorkerIDType" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="workday-data" name="WD-effectiveDate" />
										<do-append-xml-text expression="workday-data/WD-effectiveDate">
											<arg-string>
												<token-time format="yyyy-MM-dd-hh:mm" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
							