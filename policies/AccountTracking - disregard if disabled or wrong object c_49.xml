<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - disregard if disabled or wrong object class</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.acctTrk.enable" op="not-equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-break />
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-class-name op="available" />
															<if-class-name mode="nocase" op="not-equal">Unknown</if-class-name>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-for-each>
															<arg-node-set>
																<token-global-variable name="drv.acctTrk.objectClass" />
															</arg-node-set>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-class-name mode="nocase" op="equal">$current-node$</if-class-name>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="pass" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">true</token-text>
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
														</do-for-each>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable name="pass" op="not-available" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-break />
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-class-name mode="nocase" op="equal">Unknown</if-class-name>
																	<if-operation mode="case" op="equal">delete</if-operation>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="className" scope="policy">
																	<arg-node-set>
																		<token-query>
																			<arg-association>
																				<token-association />
																			</arg-association>
																		</token-query>
																	</arg-node-set>
																</do-set-local-variable>
																<do-set-op-class-name>
																	<arg-string>
																		<token-xpath expression="$className/@class-name" />
																	</arg-string>
																</do-set-op-class-name>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								