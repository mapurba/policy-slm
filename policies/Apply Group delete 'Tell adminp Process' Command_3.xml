<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Apply Group delete 'Tell adminp Process' Command</description>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-global-variable mode="nocase" name="account.remove" op="equal">delete</if-global-variable>
											<if-global-variable name="account.DelAdminPCmd" op="available" />
											<if-global-variable name="account.DelAdminPCmd" op="not-equal">default</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../delete[@class-name='Group']" name="tell-adminp-process">
											<arg-string>
												<token-global-variable name="account.DelAdminPCmd" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								