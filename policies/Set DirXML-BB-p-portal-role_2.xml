<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set DirXML-BB-p-portal-role</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-op-property mode="nocase" name="BBObjectType" op="equal">DirXML-BB-Person</if-op-property>
											<if-global-variable mode="nocase" name="auto_set_roles" op="equal">true</if-global-variable>
											<if-op-attr name="DirXML-BB-p-portal-role" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="DirXML-BB-p-portal-role">
											<arg-value type="string">
												<token-global-variable name="default_portal_role" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								