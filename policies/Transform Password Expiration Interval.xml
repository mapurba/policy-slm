<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Password Expiration Interval</description>
									<conditions>
										<and>
											<if-op-attr name="Password Expiration Interval" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="passwordExpirationInterval">
											<arg-string>
												<token-op-attr name="Password Expiration Interval" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="interval">
											<arg-string>
												<token-xpath expression="math:min($passwordExpirationInterval div 86400, 255)" />
											</arg-string>
										</do-set-local-variable>
										<do-reformat-op-attr name="Password Expiration Interval">
											<arg-value type="string">
												<token-local-variable name="interval" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								