<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Organization: Required Attributes</description>
									<comment xml:space="preserve">This rule ensures all required attributes are present when creating a new Organization.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDOrganization</if-class-name>
											<if-global-variable mode="regex" name="gvOrganizationRequiredAttr" op="equal">.+</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="gvOrganizationRequiredAttr" />
											</arg-node-set>
											<arg-actions>
												<do-veto-if-op-attr-not-available name="$current-node$" />
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							