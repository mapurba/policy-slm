<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Require posixAccount Before Provisioning</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="require-posix-sub" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="uidNumber" />
										<do-veto-if-op-attr-not-available name="gidNumber" />
										<do-veto-if-op-attr-not-available name="homeDirectory" />
									</actions>
								</rule>
								