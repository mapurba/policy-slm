<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Supported operations</description>
									<conditions>
										<or>
											<if-operation op="equal">modify</if-operation>
											<if-operation op="equal">query</if-operation>
											<if-operation op="equal">add</if-operation>
											<if-operation op="equal">delete</if-operation>
											<if-operation mode="case" op="equal">sync</if-operation>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								