<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Prevent Users without a Google Account Entitlement</description>
									<comment xml:space="preserve">If Account Creation is tied to Entitlements and the setting is made to prevent matching then this keeps users without an entitlement to match existing Google accounts.</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEUSER.RequireUserAccountEntitlement" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEUSER.MatchUserWithoutAccountEntitlement" op="not-equal">true</if-global-variable>
											<if-entitlement name="NOVLGGLEUSER-Account" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								