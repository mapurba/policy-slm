<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User:  Pad Password</description>
									<conditions>
										<and>
											<if-class-name op="equal">indirect.usr</if-class-name>
											<if-password op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-password>
											<arg-string>
												<token-xpath expression="syb:PadPassword(password, 'p')" />
											</arg-string>
										</do-set-dest-password>
									</actions>
								</rule>
							