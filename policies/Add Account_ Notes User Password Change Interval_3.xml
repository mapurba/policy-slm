<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Notes User Password Change Interval</description>
									<conditions>
										<and>
											<if-global-variable name="account.cert.pwdchginterval" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="notes-password-change-interval">
											<arg-string>
												<token-global-variable name="account.cert.pwdchginterval" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								