<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Account Entitlement change (Disable option) </description>
									<comment xml:space="preserve">User gwAccount Entitlement grants/ revokes the user account in GroupWise System. This rule executes when the entitlement is changing and you have selected the disable option.</comment>
									<conditions>
										<and>
											<if-global-variable name="driver.gw.ent.account.remove" op="equal">disable</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="gwAccount" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="gwAccount" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-op-property name="accountDisableByEntitlementRevoke">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-op-property>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.entitlement.gwGroup" op="equal">true</if-global-variable>
															<if-entitlement name="gwGroup" op="changing" />
														</and>
														<and>
															<if-global-variable mode="nocase" name="drv.entitlement.gwDistLists" op="equal">true</if-global-variable>
															<if-entitlement name="gwDistLists" op="changing" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-break />
													</arg-actions>
													<arg-actions>
														<do-remove-association when="after">
															<arg-association>
																<token-association />
															</arg-association>
														</do-remove-association>
														<do-clear-src-attr-value class-name="User" name="NGW: GroupWise ID" />
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="gwAccount" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="driver.gw.ent.account.add" op="equal">disable</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-dest-attr-value name="Login Disabled">
															<arg-value type="state">
																<token-text xml:space="preserve">true</token-text>
															</arg-value>
														</do-set-dest-attr-value>
													</arg-actions>
													<arg-actions>
														<do-set-dest-attr-value name="Login Disabled">
															<arg-value type="state">
																<token-text xml:space="preserve">false</token-text>
															</arg-value>
														</do-set-dest-attr-value>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-break />
									</actions>
								</rule>
								