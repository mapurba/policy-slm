<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>remember relative position in hierarchy</description>
									<comment xml:space="preserve">This rule marks events in the given containers for processing by adding the unmached-src-dn and attempt-to-match operation properties. You can add subtrees in the Identity Vault for inclusion by adding if-src-dn conditionals here. If you are using mirrored placement, the unmatched-src-dn is used later in the placement rule. The attempt-to-match property determines whether the matching policies following this initializing policy should try to match the object or whether its out of scope.</comment>
									<conditions>
										<and>
											<if-src-dn op="in-subtree">~idv.dit.data.users~</if-src-dn>
											<if-op-property name="attempt-to-match" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="unmatched-src-dn">
											<arg-string>
												<token-unmatched-src-dn convert="true" />
											</arg-string>
										</do-set-op-property>
										<do-set-local-variable name="resDomain" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="drv.domains" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="domain_container" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/definition[@name=&quot;drv.domain.container.name&quot;]/value/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-src-dn op="in-subtree">$domain_container$</if-src-dn>
															<if-local-variable mode="nocase" name="resDomain" op="equal">false</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-property name="drv.domain.container.name">
															<arg-string>
																<token-xpath expression="$current-node/definition[@name=&quot;drv.domain.container.name&quot;]/value/text()" />
															</arg-string>
														</do-set-op-property>
														<do-set-op-property name="drv.domain.dns.name">
															<arg-string>
																<token-xpath expression="$current-node/definition[@name=&quot;drv.domain.dns.name&quot;]/value/text()" />
															</arg-string>
														</do-set-op-property>
														<do-set-op-property name="drv.user.container">
															<arg-string>
																<token-xpath expression="$current-node/definition[@name=&quot;drv.user.container&quot;]/value/text()" />
															</arg-string>
														</do-set-op-property>
														<do-set-op-property name="drv.subPlacementType">
															<arg-string>
																<token-xpath expression="$current-node/definition[@name=&quot;drv.subPlacementType&quot;]/value/text()" />
															</arg-string>
														</do-set-op-property>
														<do-set-op-property name="drv.pubPlacementType">
															<arg-string>
																<token-xpath expression="$current-node/definition[@name=&quot;drv.pubPlacementType&quot;]/value/text()" />
															</arg-string>
														</do-set-op-property>
														<do-set-local-variable name="resDomain" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="resDomain" op="equal">false</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="attempt-to-match">
													<arg-string>
														<token-text xml:space="preserve">false</token-text>
													</arg-string>
												</do-set-op-property>
											</arg-actions>
											<arg-actions>
												<do-set-op-property name="attempt-to-match">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-op-property>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							