<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>re-format CN</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="attrNS" scope="policy">
											<arg-node-set>
												<token-xpath expression="modify-attr[@attr-name='CN']//value | add-attr[@attr-name='CN']/value" />
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="attrNS" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="nodeVal" scope="policy">
													<arg-string>
														<token-split delimiter="@">
															<token-xpath expression="$current-node/text()" />
														</token-split>
													</arg-string>
												</do-set-local-variable>
												<do-strip-xpath expression="$current-node/text()" />
												<do-append-xml-text expression="$current-node">
													<arg-string>
														<token-xpath expression="$nodeVal" />
													</arg-string>
												</do-append-xml-text>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								