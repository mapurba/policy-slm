<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>If non-add, non-delete event subject does not have an association add GUID as association.</description>
									<conditions>
										<and>
											<if-association op="not-associated" />
											<if-operation op="not-equal">add</if-operation>
											<if-operation op="not-equal">delete</if-operation>
										</and>
									</conditions>
									<actions>
										<do-add-association>
											<arg-association>
												<token-src-attr name="GUID" />
											</arg-association>
										</do-add-association>
										<do-set-op-association>
											<arg-association>
												<token-src-attr name="GUID" />
											</arg-association>
										</do-set-op-association>
									</actions>
								</rule>
								