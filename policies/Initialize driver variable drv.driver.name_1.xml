<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initialize driver variable drv.driver.name</description>
									<comment xml:space="preserve">Check if the driver variable drv.driver.name has already been defined and if not, initialize it with the driver's name and if yes, skip the rule.</comment>
									<conditions>
										<or>
											<if-local-variable name="drv.driver.name" op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="drv.driver.name" scope="driver">
											<arg-string>
												<token-parse-dn dest-dn-format="slash" length="1" src-dn-format="slash" start="-1">
													<token-global-variable name="dirxml.auto.driverdn" />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								