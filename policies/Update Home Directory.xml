<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update Home Directory</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="case" op="equal">rename</if-operation>
											<if-global-variable mode="nocase" name="UpdateHomeDir" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-src-attr-value class-name="User" name="homeDirectory">
											<arg-value>
												<token-global-variable name="HomeDirectory" />
												<token-xpath expression="new-name/text()" />
											</arg-value>
										</do-set-src-attr-value>
									</actions>
								</rule>
							