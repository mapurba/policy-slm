<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check for Sentinel-Account add</description>
									<comment xml:space="preserve">Skip this policy if not an add operation for a synthetic Sentinel-Account object.</comment>
									<conditions>
										<or>
											<if-operation mode="case" op="not-equal">add</if-operation>
											<if-class-name mode="nocase" op="not-equal">Sentinel-Account</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								