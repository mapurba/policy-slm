<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Notes User Password Check Setting</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="account.cert.pwdchksetting" op="not-equal">default</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="notes-password-check-setting">
											<arg-string>
												<token-global-variable name="account.cert.pwdchksetting" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								