<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Disable and Expire GroupWise External Entity on eDirectory GroupWise External Entity Delete</description>
									<conditions>
										<and>
											<if-global-variable name="driver.gw.GWExternalEntityDelete" op="equal">dispire</if-global-variable>
											<if-operation op="equal">delete</if-operation>
											<if-class-name op="equal">Groupwise External Entity</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="Login Disabled">
											<arg-value type="state">
												<token-text>true</token-text>
											</arg-value>
										</do-set-dest-attr-value>
										<do-set-dest-attr-value name="NGW: Mailbox Expiration Time">
											<arg-value>
												
												<token-xpath expression="int:new(date:getTime(date:new()) div 1000)" />
											</arg-value>
										</do-set-dest-attr-value>
										<do-set-xml-attr expression="../modify" name="gw:original-event">
											<arg-string>
												<token-text>delete</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-veto />
									</actions>
								</rule>
								
								
								