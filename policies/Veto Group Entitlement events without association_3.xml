<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto Group Entitlement events without association</description>
									<conditions>
										<and>
											<if-global-variable name="drv.entitlement.Account" op="equal">true</if-global-variable>
											<if-global-variable name="drv.entitlement.Group" op="equal">true</if-global-variable>
											<if-entitlement name="Account" op="not-changing" />
											<if-entitlement name="Group" op="changing" />
											<if-association op="not-associated" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								