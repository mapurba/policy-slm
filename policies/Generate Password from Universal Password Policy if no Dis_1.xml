<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Generate Password from Universal Password Policy if no Distribution Password available and GCV is set to universal</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLBNNRPSWD.InitialPassword" op="equal">universal</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-password>
											<arg-string>
												<token-generate-password policy-dn="$gcv.NOVLBNNRPSWD.initialPasswordPolicy$" />
											</arg-string>
										</do-set-dest-password>
									</actions>
								</rule>
							