<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check for account operation</description>
									<comment xml:space="preserve">Skip this policy if not an account operation.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="not-equal">account</if-class-name>
											<if-xpath op="not-true">search-class[@class-name='account']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								