<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto events if account entitlement not granted</description>
									<conditions>
										<and>
											<if-op-property name="attempt-to-match" op="available" />
											<if-op-property mode="nocase" name="attempt-to-match" op="equal">false</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								