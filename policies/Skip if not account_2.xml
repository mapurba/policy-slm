<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Skip if not account</description>
									<comment xml:space="preserve">Skip this policy if the operation is not for a Sentinel Account object.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="not-equal">account</if-class-name>
											<if-xpath op="not-true">./search-class[@attr-name='account']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								