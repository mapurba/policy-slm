<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>set PS employeeStatus to 'A'</description>
									<conditions>
										<and>
											<if-op-attr mode="nocase" name="STATUS" op="equal">active</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="User" name="STATUS">
											<arg-value>
												<token-text xml:space="preserve">A</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								