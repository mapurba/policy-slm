<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Rename User: 2 - remove association</description>
									<comment xml:space="preserve">only when in fanout mode</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="case" op="equal">rename</if-operation>
											<if-xpath op="true">contains(association/text(),'USd')</if-xpath>
											<if-global-variable mode="nocase" name="drv.role.rename.option" op="equal">2</if-global-variable>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-remove-association direct="true">
											<arg-association>
												<token-association />
											</arg-association>
										</do-remove-association>
									</actions>
								</rule>
								