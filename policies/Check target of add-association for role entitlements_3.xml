<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check target of add-association for role entitlements</description>
									<comment xml:space="preserve">Role entitlements assigned to users being created in Oracle EBS cannot be processed until the user is successfully created. The add-association signals that an object has been created by the driver in Oracle EBS. If the object is also tagged for role entitlement processing, do the work now.</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Role" op="equal">true</if-global-variable>
											<if-operation op="equal">add-association</if-operation>
											<if-op-property mode="nocase" name="check-role-entitlements" op="equal">true</if-op-property>
											<if-entitlement name="Role" op="available" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-entitlement name="Role" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="role-assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')&#10;" />
													</arg-string>
												</do-set-local-variable>
												<do-add-src-attr-value class-name="inetOrgPerson" name="ebsRoles">
													<arg-association>
														<token-xpath expression="./text()" />
													</arg-association>
													<arg-value type="string">
														<token-local-variable name="role-assoc" />
													</arg-value>
												</do-add-src-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								