<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip operation attribute of Contingent worker  if wd-workeridType is Employee</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr mode="nocase" name="wd-WorkerIDType" op="equal">Employee_ID</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="wd-C-OriginalHiredate" />
										<do-strip-op-attr name="wd-C-Rehire" />
										<do-strip-op-attr name="wd-C-Retired" />
										<do-strip-op-attr name="wd-C-Terminated" />
										<do-strip-op-attr name="wd-C-TerminationDate" />
										<do-strip-op-attr name="wd-C-Active" />
										<do-strip-op-attr name="wd-C-ActivePositionIDs" />
										<do-strip-op-attr name="wd-C-Hiredate" />
										<do-strip-op-attr name="wd-C-International_Assignment" />
										<do-strip-op-attr name="wd-C-Host_Countries" />
										<do-strip-op-attr name="wd-C-Home_Countries" />
									</actions>
								</rule>
								