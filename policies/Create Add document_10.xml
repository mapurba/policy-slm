<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Create Add document</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="ent-value" scope="policy">
											<arg-string>
												<token-xpath expression="modify-attr[@attr-name='DirXML-EntitlementRef']//param/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="ent-LIID1" scope="policy">
											<arg-string>
												<token-xpath expression="es:getEntParamFieldBackwardsCompatible($ent-value, 'LIID', 'LSNAME')" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="addDoc" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;add&gt;&lt;/add&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-clone-xpath dest-expression="$addDoc/add" src-expression="@*" />
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$instance//attr" />
											</arg-node-set>
											<arg-actions>
												<do-append-xml-element expression="$addDoc/add" name="add-attr" />
												<do-set-xml-attr expression="$addDoc//add-attr[last()]" name="attr-name">
													<arg-string>
														<token-xpath expression="$current-node/@attr-name" />
													</arg-string>
												</do-set-xml-attr>
												<do-clone-xpath dest-expression="$addDoc//add-attr[last()]" src-expression="$current-node/value" />
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$addDoc//add-attr[@attr-name='DirXML-EntitlementRef']//value" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="ent-LIID2" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamFieldBackwardsCompatible($current-node//param/text(), 'LIID', 'LSNAME')" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="ent-LIID1" op="not-equal">$ent-LIID2$</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-strip-xpath expression="$current-node" />
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-clone-xpath dest-expression=".." src-expression="$addDoc/node()" />
										<do-strip-xpath expression="." />
									</actions>
								</rule>
							