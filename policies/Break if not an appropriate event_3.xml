<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if not an appropriate event</description>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEGRPS.RequireCreateGroupEntitlement" op="not-equal">true</if-global-variable>
											<if-class-name mode="nocase" op="not-equal">Group</if-class-name>
											<if-op-attr name="DirXML-EntitlementRef" op="not-changing" />
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								