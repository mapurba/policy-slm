<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Fanout by placement</description>
									<comment xml:space="preserve">Fanout of add events is done by setting the @dest-dn to /&lt;lsname&gt;/&lt;username&gt;.</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-text xml:space="preserve">\</token-text>
												<token-op-property name="lsname" />
												<token-text xml:space="preserve">\</token-text>
												<token-upper-case>
													<token-src-name />
												</token-upper-case>
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							