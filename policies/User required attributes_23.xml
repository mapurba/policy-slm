<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User required attributes</description>
									<conditions>
										<or>
											<if-class-name op="equal">User</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:employeeStatus" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:departmentNumber" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:jobCode" />
									</actions>
								</rule>
							