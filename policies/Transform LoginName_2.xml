<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform LoginName</description>
									<conditions>
										<and>
											<if-op-attr name="DirXML-ADAliasName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="DirXML-ADAliasName">
											<arg-value type="string">
												<token-global-variable name="drv-ad-domain-name" />
												<token-text xml:space="preserve">\</token-text>
												<token-src-attr name="CN" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							