<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove Group Membership changes if using Group Entitlement</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.UserGroup" op="equal">true</if-global-variable>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
											<if-op-attr name="Group Membership" op="available" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="Group Membership" />
									</actions>
								</rule>
								