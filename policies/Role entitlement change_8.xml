<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Role entitlement change</description>
									<comment name="lastchanged" xml:space="preserve">Account entitlement change (Delete Option)</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Role" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="Role" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="Role" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="roleId" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="userId" scope="policy">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="roleMemberObj" scope="policy">
													<arg-node-set>
														<token-query class-name="sys_user_has_role">
															<arg-match-attr name="role">
																<arg-value type="string">
																	<token-local-variable name="roleId" />
																</arg-value>
															</arg-match-attr>
															<arg-match-attr name="user">
																<arg-value type="string">
																	<token-local-variable name="userId" />
																</arg-value>
															</arg-match-attr>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="roleMemberObj" />
													</arg-node-set>
													<arg-actions>
														<do-delete-dest-object class-name="sys_user_has_role">
															<arg-association>
																<token-xpath expression="$current-node/association/text()" />
															</arg-association>
														</do-delete-dest-object>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="Role" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="roleId" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="userId" scope="policy">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="dest-dn" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">/</token-text>
														<token-local-variable name="roleId" />
														<token-text xml:space="preserve">$</token-text>
														<token-local-variable name="userId" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-object class-name="sys_user_has_role" when="after">
													<arg-dn>
														<token-local-variable name="dest-dn" />
													</arg-dn>
												</do-add-dest-object>
												<do-add-dest-attr-value class-name="sys_user_has_role" name="role" when="after">
													<arg-dn>
														<token-local-variable name="dest-dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="roleId" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="sys_user_has_role" name="user" when="after">
													<arg-dn>
														<token-local-variable name="dest-dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="userId" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								