<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Perform mirrored placement in user subtree</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.pubPlacementType" op="equal">mirrored</if-global-variable>
											<if-src-dn op="in-subtree">~drv.edir.base.container~</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
												<token-text xml:space="preserve">\</token-text>
												<token-unmatched-src-dn convert="true" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
								