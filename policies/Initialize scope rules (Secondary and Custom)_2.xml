<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initialize scope rules (Secondary and Custom)</description>
									<comment xml:space="preserve">Parse scope rules string (example: '\O\OU\OU1=sub+\O\OU\OU2=one+\O\OU\Leaf=base') into 3 scope rules variables.</comment>
									<conditions>
										<or>
											<if-global-variable mode="regex" name="NOVLDCSSCPNG.drv.scoping.driverRole" op="equal">secondary|custom</if-global-variable>
										</or>
										<or>
											<if-local-variable name="NOVLDCSSCPNG__BASE" op="not-available" />
											<if-local-variable name="NOVLDCSSCPNG__ONE" op="not-available" />
											<if-local-variable name="NOVLDCSSCPNG__SUB" op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">Scoping: </token-text>
												<token-text xml:space="preserve">(Re-)Initializing rules for driver role '</token-text>
												<token-global-variable name="NOVLDCSSCPNG.drv.scoping.driverRole" />
												<token-text xml:space="preserve">'...</token-text>
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="NOVLDCSSCPNG__BASE" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;singles/&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="NOVLDCSSCPNG__ONE" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;parents/&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="NOVLDCSSCPNG__SUB" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;roots/&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="driverSetDN" scope="policy">
											<arg-string>
												<token-parse-dn dest-dn-format="src-dn" length="-2">
													<token-global-variable name="dirxml.auto.driverdn" />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<or>
													<if-global-variable mode="nocase" name="NOVLDCSSCPNG.drv.scoping.driverRole" op="equal">secondary</if-global-variable>
													<if-global-variable mode="nocase" name="NOVLDCSSCPNG.drv.scoping.driverRole" op="equal">custom</if-global-variable>
												</or>
											</arg-conditions>
											<arg-actions>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">Scoping: </token-text>
														<token-text xml:space="preserve">Including '</token-text>
														<token-local-variable name="driverSetDN" />
														<token-text xml:space="preserve">' and subtree (local driver set).</token-text>
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="root" scope="policy">
													<arg-node-set>
														<token-xml-parse>
															<token-text xml:space="preserve">&lt;root&gt;</token-text>
															<token-local-variable name="driverSetDN" />
															<token-text xml:space="preserve">&lt;/root&gt;</token-text>
														</token-xml-parse>
													</arg-node-set>
												</do-set-local-variable>
												<do-clone-xpath dest-expression="$NOVLDCSSCPNG__SUB/roots" src-expression="$root" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="NOVLDCSSCPNG.drv.scoping.driverRole" op="equal">custom</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-split delimiter="\+">
															<token-global-variable name="NOVLDCSSCPNG.drv.scoping.customScopeRules" />
														</token-split>
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="objectDN" scope="policy">
															<arg-string>
																<token-xpath expression="substring-before($current-node, '=')" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="scope" scope="policy">
															<arg-string>
																<token-xpath expression="substring-after($current-node, '=')" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="scope" op="equal">base</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-trace-message>
																	<arg-string>
																		<token-text xml:space="preserve">Scoping: </token-text>
																		<token-text xml:space="preserve">Including '</token-text>
																		<token-local-variable name="objectDN" />
																		<token-text xml:space="preserve">' (custom scope rule).</token-text>
																	</arg-string>
																</do-trace-message>
																<do-set-local-variable name="single" scope="policy">
																	<arg-node-set>
																		<token-xml-parse>
																			<token-text xml:space="preserve">&lt;single&gt;</token-text>
																			<token-local-variable name="objectDN" />
																			<token-text xml:space="preserve">&lt;/single&gt;</token-text>
																		</token-xml-parse>
																	</arg-node-set>
																</do-set-local-variable>
																<do-clone-xpath dest-expression="$NOVLDCSSCPNG__BASE/singles" src-expression="$single" />
															</arg-actions>
															<arg-actions />
														</do-if>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="scope" op="equal">one</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-trace-message>
																	<arg-string>
																		<token-text xml:space="preserve">Scoping: </token-text>
																		<token-text xml:space="preserve">Including '</token-text>
																		<token-local-variable name="objectDN" />
																		<token-text xml:space="preserve">' and subordinates (custom scope rule).</token-text>
																	</arg-string>
																</do-trace-message>
																<do-set-local-variable name="parent" scope="policy">
																	<arg-node-set>
																		<token-xml-parse>
																			<token-text xml:space="preserve">&lt;parent&gt;</token-text>
																			<token-local-variable name="objectDN" />
																			<token-text xml:space="preserve">&lt;/parent&gt;</token-text>
																		</token-xml-parse>
																	</arg-node-set>
																</do-set-local-variable>
																<do-clone-xpath dest-expression="$NOVLDCSSCPNG__ONE/parents" src-expression="$parent" />
															</arg-actions>
															<arg-actions />
														</do-if>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="scope" op="equal">sub</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-trace-message>
																	<arg-string>
																		<token-text xml:space="preserve">Scoping: </token-text>
																		<token-text xml:space="preserve">Including '</token-text>
																		<token-local-variable name="objectDN" />
																		<token-text xml:space="preserve">' and subtree (custom scope rule).</token-text>
																	</arg-string>
																</do-trace-message>
																<do-set-local-variable name="root" scope="policy">
																	<arg-node-set>
																		<token-xml-parse>
																			<token-text xml:space="preserve">&lt;root&gt;</token-text>
																			<token-local-variable name="objectDN" />
																			<token-text xml:space="preserve">&lt;/root&gt;</token-text>
																		</token-xml-parse>
																	</arg-node-set>
																</do-set-local-variable>
																<do-clone-xpath dest-expression="$NOVLDCSSCPNG__SUB/roots" src-expression="$root" />
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">Scoping: </token-text>
												<token-text xml:space="preserve">Done (re-)initializing rules.</token-text>
											</arg-string>
										</do-trace-message>
									</actions>
								</rule>
								