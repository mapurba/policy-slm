<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>update status for wrong password</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="../status/text()" />
											</arg-node-set>
											<arg-actions>
												<do-trace-message notrace="true">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-trace-message>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">contains($current-node,'WRONG_PASSWORD')</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-status level="success">
															<arg-string>
																<token-text xml:space="preserve">WRONG_PASSWORD error: User's SAP Portal password should now be set to nspmDistributionPassword</token-text>
															</arg-string>
														</do-status>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							