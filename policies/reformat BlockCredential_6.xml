<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>reformat BlockCredential</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">modify</if-operation>
											<if-op-attr name="BlockCredential" op="available" />
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="./modify-attr[@attr-name=&quot;BlockCredential&quot;]/remove-value" />
										<do-append-xml-element expression="./modify-attr[@attr-name=&quot;BlockCredential&quot;]" name="remove-all-values" />
									</actions>
								</rule>
								