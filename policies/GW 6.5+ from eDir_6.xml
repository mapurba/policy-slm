<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GW 6.5+ from eDir</description>
									<conditions>
										<and>
											<if-global-variable name="driver.gw.domainVersion" op="not-equal">550</if-global-variable>
											<if-global-variable name="driver.gw.domainVersion" op="not-equal">600</if-global-variable>
											<if-local-variable name="fromNds" op="equal">true</if-local-variable>
											<if-class-name op="equal">User</if-class-name>
										</and>
										<and>
											<if-global-variable name="driver.gw.domainVersion" op="not-equal">550</if-global-variable>
											<if-global-variable name="driver.gw.domainVersion" op="not-equal">600</if-global-variable>
											<if-local-variable name="fromNds" op="equal">true</if-local-variable>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="50310" src-name="company" />
										<do-rename-op-attr dest-name="50323" src-name="Generational Qualifier" />
										<do-rename-op-attr dest-name="50322" src-name="Initials" />
										<do-rename-op-attr dest-name="50324" src-name="personalTitle" />
										<do-break />
									</actions>
								</rule>
								