<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Login Enable into modify-password</description>
									<conditions>
										<and>
											<if-global-variable name="send-password-on-enable" op="equal">true</if-global-variable>
											<if-op-attr name="Login Disabled" op="changing-to">false</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-set-dest-password>
											<arg-string>
												<token-attr name="nspmDistributionPassword" />
											</arg-string>
										</do-set-dest-password>
										<do-strip-op-attr name="Login Disabled" />
									</actions>
								</rule>
								