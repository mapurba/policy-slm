<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if using LUM</description>
									<comment xml:space="preserve">If we're using LUM for gidNumber management, skip these rules.</comment>
									<conditions>
										<and>
											<if-global-variable mode="case" name="UseLUMForUIDGID" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								