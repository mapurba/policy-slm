<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-WorkOrder (Future Events): veto if DirXML-Other1 or DirXML-DueDate is missing or empty</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">DirXML-WorkOrder</if-class-name>
										</or>
										<or>
											<if-op-attr mode="regex" name="DirXML-Other1" op="not-equal">.+</if-op-attr>
											<if-op-attr mode="regex" name="DirXML-DueDate" op="not-equal">.+</if-op-attr>
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							