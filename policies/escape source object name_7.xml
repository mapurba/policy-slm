<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>escape source object name</description>
									<comment xml:space="preserve">Logon name policy: Remove characters unsuitable for Office365 name from source object name.</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">rename</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="object-name" scope="policy">
											<arg-string>
												<token-replace-all regex="[^a-zA-Z0-9\x21\x23-\x29\x2d\x2e\x40\x5e-\x60\x7b\x7d\x7e\xc0-\xf6\xf8-\xff\u0410-\u044f\x20]" replace-with="">
													<token-src-name />
												</token-replace-all>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-class-name mode="nocase" op="equal">User</if-class-name>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="object-name" scope="policy">
													<arg-string>
														<token-local-variable name="object-name" />
														<token-text xml:space="preserve">@</token-text>
														<token-global-variable name="drv.domain.name" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-strip-xpath expression="$current-op/new-name/text()" />
										<do-append-xml-text expression="$current-op/new-name">
											<arg-string>
												<token-local-variable name="object-name" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
							