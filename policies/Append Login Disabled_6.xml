<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Append Login Disabled</description>
									<comment xml:space="preserve">During user creation, if the 'urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled' is not set, add this attribute in the add event with its current value in Identity Lifecycle Manager. 'urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled' is inversely related to 'active' attribute</comment>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">add</if-operation>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled">
											<arg-value type="state">
												<token-text xml:space="preserve">false</token-text>
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							