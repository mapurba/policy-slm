<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Job profile : Required Attributes</description>
									<comment xml:space="preserve">This rule ensures all required attributes are present when creating a new Job Profile.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">wd-Jobprofile</if-class-name>
											<if-global-variable mode="regex" name="gvJobProfileRequiredAttr" op="equal">.+</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="gvJobProfileRequiredAttr" />
											</arg-node-set>
											<arg-actions>
												<do-veto-if-op-attr-not-available name="$current-node$" />
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								