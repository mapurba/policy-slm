<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Epic Schema Mapping Driver Variable</description>
									<comment xml:space="preserve">This is used to handle transformation of idv &lt;-&gt; app attribute names for policies in the Output Transformation policy set</comment>
									<conditions />
									<actions>
										<do-set-local-variable name="ln-epic-schema-mapping" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-base64-decode charset="UTF-8">
														<token-src-attr name="XmlData">
															<arg-dn>
																<token-global-variable name="dirxml.auto.driverdn" />
																<token-text xml:space="preserve">\PDSEPICEDCFG-smp</token-text>
															</arg-dn>
														</token-src-attr>
													</token-base64-decode>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
							