<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>add loginDisabled</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.acctTrk.enable" op="equal">true</if-global-variable>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled">
											<arg-value>
												<token-text xml:space="preserve">false</token-text>
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							