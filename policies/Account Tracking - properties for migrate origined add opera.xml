<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account Tracking - properties for migrate origined add operation</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-xml-attr mode="regex" name="event-id" op="equal">^migrate.*</if-xml-attr>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="drv.acctTrk.identifiers" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="current-node" op="equal">LDAPDN</if-local-variable>
															<if-op-property name="AccountTracking-$current-node$" op="not-available" />
															<if-src-dn op="available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-property name="AccountTracking-$current-node$">
															<arg-string>
																<token-src-dn />
															</arg-string>
														</do-set-op-property>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="current-node" op="equal">association</if-local-variable>
																	<if-op-property name="AccountTracking-$current-node$" op="not-available" />
																	<if-association op="available" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-op-property name="AccountTracking-$current-node$">
																	<arg-string>
																		<token-association />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="current-node" op="equal">userPrincipalName</if-local-variable>
																			<if-op-property name="AccountTracking-$current-node$" op="not-available" />
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="upnValue" scope="policy">
																			<arg-string>
																				<token-xpath expression="add-attr[@attr-name=&quot;DirXML-MDADAliasName&quot;]/value/component[@name=&quot;path&quot;]/text()" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-set-op-property name="AccountTracking-$current-node$">
																			<arg-string>
																				<token-local-variable name="upnValue" />
																			</arg-string>
																		</do-set-op-property>
																	</arg-actions>
																	<arg-actions>
																		<do-set-local-variable name="mappedATRKattr" scope="policy">
																			<arg-string>
																				<token-map dest="IDVAttribute" src="IdentifierAttribute" table="..\ATRKIdentifierAttributeMap">
																					<token-local-variable name="current-node" />
																				</token-map>
																			</arg-string>
																		</do-set-local-variable>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-op-property name="AccountTracking-$current-node$" op="not-available" />
																					<if-op-attr name="$mappedATRKattr$" op="available" />
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-set-op-property name="AccountTracking-$current-node$">
																					<arg-string>
																						<token-op-attr name="$mappedATRKattr$" />
																					</arg-string>
																				</do-set-op-property>
																			</arg-actions>
																			<arg-actions />
																		</do-if>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-set-local-variable name="var-idvAccountStatus" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="var-appAccountStatus" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="mappedATRKStatusAttr" scope="policy">
											<arg-string>
												<token-map dest="IDVAttribute" src="IdentifierAttribute" table="..\ATRKIdentifierAttributeMap">
													<token-global-variable name="drv.acctTrk.statusAttr" />
												</token-map>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="$mappedATRKStatusAttr$" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="AccountTracking-AccountStatusChanged">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-op-property>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-attr mode="nocase" name="$mappedATRKStatusAttr$" op="equal">~drv.acctTrk.activeStatus~</if-op-attr>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="var-appAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">A</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-op-attr mode="nocase" name="$mappedATRKStatusAttr$" op="equal">~drv.acctTrk.inactiveStatus~</if-op-attr>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="var-appAccountStatus" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">I</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-set-local-variable name="var-appAccountStatus" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">U</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-operation mode="case" op="equal">add</if-operation>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="var-appAccountStatus" scope="policy">
															<arg-string>
																<token-global-variable name="drv.acctTrk.idvDefaultStatus" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
										<do-set-op-property name="AccountTracking-IdvAccountStatus">
											<arg-string>
												<token-local-variable name="var-idvAccountStatus" />
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="AccountTracking-AppAccountStatus">
											<arg-string>
												<token-local-variable name="var-appAccountStatus" />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
								