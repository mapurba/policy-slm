<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if not a User object or NSPM distribution password available</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="not-equal">User</if-class-name>
											<if-op-attr name="nspmDistributionPassword" op="available" />
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								