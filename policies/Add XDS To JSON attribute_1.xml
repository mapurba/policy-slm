<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add XDS To JSON attribute</description>
									<conditions>
										<and>
											<if-operation op="equal">init-params</if-operation>
											<if-xpath op="true">./driver-filter/allow-class</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression="./driver-filter/allow-class" name="allow-attr" />
										<do-set-xml-attr expression="./driver-filter/allow-class/allow-attr[not(@attr-name)]" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">XDSDocument</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-set-xml-attr expression="./driver-filter/allow-class/allow-attr[@attr-name='XDSDocument']" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							