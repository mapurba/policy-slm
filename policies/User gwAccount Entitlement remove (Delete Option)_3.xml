<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User gwAccount Entitlement remove (Delete Option)</description>
									<comment xml:space="preserve">The User gwAccount Entitlement grants the user an enabled account in GroupWise. Revoking the entitlement will disable, expire, disable and expire, or delete the user account depending on the value you select for the 'When account entitlement revoked' global variable. This rule executes when the entitlement is changing and you have selected the delete option.</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.GWAccount" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="driver.gw.ent.account.remove" op="equal">delete</if-global-variable>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="regex" op="equal">delete</if-operation>
											<if-xpath op="true">operation-data/entitlement-impl/@name="gwAccount"</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="accountAction">
											<arg-string>
												<token-text xml:space="preserve">accountDeleteByEntitlementRevoke</token-text>
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="sourceDN">
											<arg-string>
												<token-src-dn />
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="association">
											<arg-string>
												<token-association />
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="guid">
											<arg-string>
												<token-src-attr name="GUID" />
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="objectClass">
											<arg-string>
												<token-text xml:space="preserve">User</token-text>
											</arg-string>
										</do-set-op-property>
										<do-break />
									</actions>
								</rule>
							