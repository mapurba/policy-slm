<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>If delete does not have an association add a placeholder value as the association.</description>
									<conditions>
										<and>
											<if-association op="not-associated" />
											<if-operation op="equal">delete</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-association>
											<arg-association>
												<token-text xml:space="preserve">__DELETE__</token-text>
											</arg-association>
										</do-set-op-association>
									</actions>
								</rule>
							