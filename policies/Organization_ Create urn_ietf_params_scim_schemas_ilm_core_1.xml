<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Organization: Create urn:ietf:params:scim:schemas:ilm:core:1.0:WDOrganization:wd-OrganizationName for Organization</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDOrganization</if-class-name>
											<if-global-variable mode="nocase" name="gvOrgNameMappingAttr" op="not-equal">Custom</if-global-variable>
											<if-attr name="~gvOrgNameMappingAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="WDOrganization" name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDOrganization:wd-OrganizationName">
											<arg-value type="string">
												<token-attr name="~gvOrgNameMappingAttr~" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								