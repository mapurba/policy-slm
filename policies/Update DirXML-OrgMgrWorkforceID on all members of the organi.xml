<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update DirXML-OrgMgrWorkforceID on all members of the organization and on all managers of all child organizations</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-sapO</if-class-name>
											<if-op-attr name="DirXML-sapOManagerWorkforceID" op="changing" />
										</and>
										<and>
											<if-class-name op="equal">DirXML-sapO</if-class-name>
											<if-operation op="equal">sync</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="orgMgrWFID" scope="policy">
											<arg-string>
												<token-attr name="DirXML-sapOManagerWorkforceID" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Organization </token-text>
												<token-src-name />
												<token-text xml:space="preserve"> has manager </token-text>
												<token-local-variable name="orgMgrWFID" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Updating members of the organization...</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="orgMembers" scope="policy">
											<arg-node-set>
												<token-query datastore="src">
													<arg-dn>
														<token-global-variable name="idv.dit.data.users" />
													</arg-dn>
													<arg-match-attr name="DirXML-sapP-A-O">
														<arg-value type="string">
															<token-attr name="DirXML-sapOID" />
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">DirXML-sapPID</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">Full Name</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">workforceID</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$orgMembers[attr[@attr-name='workforceID']/value/text()!=$orgMgrWFID]" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="lvTmp" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">- </token-text>
														<token-xpath expression="$current-node/attr[@attr-name='Full Name']/value[1]" />
														<token-text xml:space="preserve"> (</token-text>
														<token-xpath expression="$current-node/attr[@attr-name='DirXML-sapPID']/value" />
														<token-text xml:space="preserve">)</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="lvTmp" />
													</arg-string>
												</do-trace-message>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvFile" scope="policy">
															<arg-string>
																<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="orgMgrWFID" op="equal">.+</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-src-attr-value name="DirXML-OrgMgrWorkforceID">
															<arg-dn>
																<token-xpath expression="$current-node/@src-dn" />
															</arg-dn>
															<arg-value>
																<token-attr name="DirXML-sapOManagerWorkforceID" />
															</arg-value>
														</do-set-src-attr-value>
													</arg-actions>
													<arg-actions>
														<do-clear-src-attr-value name="DirXML-OrgMgrWorkforceID">
															<arg-dn>
																<token-xpath expression="$current-node/@src-dn" />
															</arg-dn>
														</do-clear-src-attr-value>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Updating managers of child organizations...</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-attr name="DirXML-sapO-R-B-O-002" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="childOrgID" scope="policy">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvTmp" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">- Child organization </token-text>
														<token-local-variable name="childOrgID" />
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="lvTmp" />
													</arg-string>
												</do-trace-message>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvFile" scope="policy">
															<arg-string>
																<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-set-local-variable name="childOrgMgrPosID" scope="policy">
													<arg-node-set>
														<token-src-attr name="DirXML-sapO-R-B-S-012">
															<arg-dn>
																<token-global-variable name="dvr.saphr.driverdn" />
																<token-text xml:space="preserve">\sap\om\o\</token-text>
																<token-local-variable name="childOrgID" />
															</arg-dn>
														</token-src-attr>
													</arg-node-set>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-src-attr name="DirXML-sapS-R-A-P-008">
															<arg-dn>
																<token-global-variable name="dvr.saphr.driverdn" />
																<token-text xml:space="preserve">\sap\om\s\</token-text>
																<token-local-variable name="childOrgMgrPosID" />
															</arg-dn>
														</token-src-attr>
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="childOrgMgrPerID" scope="policy">
															<arg-node-set>
																<token-local-variable name="current-node" />
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="childOrgMgrPer" scope="policy">
															<arg-node-set>
																<token-query datastore="src" scope="subtree">
																	<arg-dn>
																		<token-global-variable name="idv.dit.data.users" />
																	</arg-dn>
																	<arg-match-attr name="DirXML-sapPID">
																		<arg-value type="string">
																			<token-local-variable name="childOrgMgrPerID" />
																		</arg-value>
																	</arg-match-attr>
																	<arg-string>
																		<token-text xml:space="preserve">Full Name</token-text>
																	</arg-string>
																</token-query>
															</arg-node-set>
														</do-set-local-variable>
														<do-for-each>
															<arg-node-set>
																<token-local-variable name="childOrgMgrPer" />
															</arg-node-set>
															<arg-actions>
																<do-set-local-variable name="lvTmp" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">-- </token-text>
																		<token-xpath expression="$childOrgMgrPer/attr[@attr-name='Full Name']/value[1]" />
																		<token-text xml:space="preserve"> (</token-text>
																		<token-local-variable name="childOrgMgrPerID" />
																		<token-text xml:space="preserve">)</token-text>
																	</arg-string>
																</do-set-local-variable>
																<do-trace-message>
																	<arg-string>
																		<token-local-variable name="lvTmp" />
																	</arg-string>
																</do-trace-message>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="lvFile" scope="policy">
																			<arg-string>
																				<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions />
																</do-if>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-attr mode="regex" name="DirXML-sapOManagerWorkforceID" op="equal">.+</if-attr>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-src-attr-value name="DirXML-OrgMgrWorkforceID">
																			<arg-dn>
																				<token-xpath expression="$current-node/@src-dn" />
																			</arg-dn>
																			<arg-value>
																				<token-attr name="DirXML-sapOManagerWorkforceID" />
																			</arg-value>
																		</do-set-src-attr-value>
																	</arg-actions>
																	<arg-actions>
																		<do-clear-src-attr-value name="DirXML-OrgMgrWorkforceID">
																			<arg-dn>
																				<token-xpath expression="$current-node/@src-dn" />
																			</arg-dn>
																		</do-clear-src-attr-value>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-for-each>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-for-each>
										<do-set-local-variable name="orgManager" scope="policy">
											<arg-node-set>
												<token-query class-name="User" datastore="src">
													<arg-dn>
														<token-global-variable name="idv.dit.data.users" />
													</arg-dn>
													<arg-match-attr name="workforceID">
														<arg-value type="string">
															<token-local-variable name="orgMgrWFID" />
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">GUID</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="orgManager" />
											</arg-node-set>
											<arg-actions>
												<do-add-dest-attr-value class-name="User" name="migrate" when="after">
													<arg-association>
														<token-xpath expression="$current-node/attr[@attr-name='GUID']/value/text()" />
													</arg-association>
													<arg-value type="string">
														<token-xpath expression="$current-node/@src-dn" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							