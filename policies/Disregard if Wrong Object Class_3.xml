<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Disregard if Wrong Object Class</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="not-equal">indirect.usr</if-class-name>
											<if-class-name mode="nocase" op="not-equal">direct.view_usr</if-class-name>
											<if-class-name op="not-equal">indirect.grp</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								