<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match on sapUsername</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-op-property name="lsname" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="sapUsername">
												<arg-value type="string">
													<token-src-name />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
									</actions>
								</rule>
								