<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Store Account Action</description>
									<comment xml:space="preserve">Entitlements policies omit the account action. Store it for later use</comment>
									<conditions>
										<and>
											<if-op-property name="accountAction" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="acctAction" scope="driver">
											<arg-string>
												<token-op-property name="accountAction" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								