<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Intercept outbound queries for Login Disabled</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">inetOrgPerson</if-class-name>
											<if-operation mode="case" op="equal">query</if-operation>
											<if-xpath op="true">read-attr[@attr-name='~drv.acctTrk.statusAttr~']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="LoginDisabledQuery" scope="driver">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
							