<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reject eDirectory Organization Unit if not configured for GroupWise External Post Office synchronization</description>
									<conditions>
										<and>
											<if-class-name op="equal">Organizational Unit</if-class-name>
											<if-global-variable name="driver.gw.SyncOUToGWPO" op="equal">false</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								