<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>match Users by CN</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.subPlacementType" op="equal">flat</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-implement-entitlement>
													<arg-node-set>
														<token-entitlement name="Account" />
													</arg-node-set>
													<arg-actions>
														<do-find-matching-object scope="subordinates">
															<arg-dn>
																<token-global-variable name="driver.ldap.base.container" />
															</arg-dn>
															<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
															<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
														</do-find-matching-object>
													</arg-actions>
												</do-implement-entitlement>
											</arg-actions>
											<arg-actions>
												<do-implement-entitlement>
													<arg-node-set>
														<token-entitlement name="Account" />
													</arg-node-set>
													<arg-actions>
														<do-find-matching-object scope="entry">
															<arg-dn>
																<token-text xml:space="preserve">cn=</token-text>
																<token-substring start="3">
																	<token-op-property name="unmatched-src-dn" />
																</token-substring>
																<token-text xml:space="preserve">,</token-text>
																<token-global-variable name="driver.ldap.base.container" />
															</arg-dn>
														</do-find-matching-object>
													</arg-actions>
												</do-implement-entitlement>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								