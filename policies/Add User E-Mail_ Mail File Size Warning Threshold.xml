<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add User E-Mail: Mail File Size Warning Threshold</description>
									<conditions>
										<and>
											<if-global-variable name="account.email.sizewarning" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="mail-quota-warning-threshold">
											<arg-string>
												<token-global-variable name="account.email.sizewarning" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								