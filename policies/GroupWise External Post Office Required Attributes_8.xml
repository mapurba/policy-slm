<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GroupWise External Post Office Required Attributes</description>
									<conditions>
										<and>
											<if-class-name op="equal">Organizational Unit</if-class-name>
											<if-global-variable name="driver.gw.SyncOUToGWPO" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="OU" />
									</actions>
								</rule>
							