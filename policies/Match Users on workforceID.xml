<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match Users on workforceID</description>
									<comment xml:space="preserve">Match new users on workforceID attribute</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="workforceID" op="available" />
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
											</arg-dn>
											<arg-match-attr name="workforceID" />
										</do-find-matching-object>
									</actions>
								</rule>
								