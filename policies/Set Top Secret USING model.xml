<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Top Secret USING model</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable name="topsecret-create-using" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="USING">
											<arg-value type="string">
												<token-global-variable name="topsecret-create-using" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
								