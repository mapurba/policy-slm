<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Increment DirXML-Other2 (revision counter) by 1 for each modification of DirXML-nwoContent or DirXML-DueDate</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">DirXML-WorkOrder</if-class-name>
										</or>
										<or>
											<if-op-attr name="DirXML-nwoContent" op="changing" />
											<if-op-attr name="DirXML-DueDate" op="changing" />
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="revision" scope="policy">
											<arg-string>
												<token-dest-attr class-name="DirXML_WorkOrder" name="DirXML-Other2" />
											</arg-string>
										</do-set-local-variable>
										<do-set-dest-attr-value class-name="DirXML-WorkOrder" name="DirXML-Other2">
											<arg-value type="string">
												<token-xpath expression="number( concat( '0', $revision ) ) + 1" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							