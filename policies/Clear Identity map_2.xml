<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Clear Identity map</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="throwaway" scope="policy">
											<arg-string>
												<token-xpath expression="jmap:clear($drv.identity.map)" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
							