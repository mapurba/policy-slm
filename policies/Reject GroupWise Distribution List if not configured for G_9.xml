<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reject GroupWise Distribution List if not configured for GroupWise Distribution Lists synchronization</description>
									<conditions>
										<and>
											<if-class-name op="equal">GroupWise Distribution List</if-class-name>
											<if-global-variable name="driver.driver.gw.DistributionLists" op="equal">false</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								