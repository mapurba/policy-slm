<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add User E-Mail: ACL Setting</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="account.email.aclsetting" op="not-equal">default</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="mailfile-acl-level">
											<arg-string>
												<token-global-variable name="account.email.aclsetting" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								