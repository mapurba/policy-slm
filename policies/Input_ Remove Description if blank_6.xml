<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Input: Remove Description if blank</description>
									<comment xml:space="preserve">After removing HTML formatting tags, description might be blank, which will result in a syntax violation if allowed to pass through.</comment>
									<conditions>
										<and>
											<if-op-attr mode="nocase" name="Description" op="equal" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="Description" />
									</actions>
								</rule>
								