<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>add Dest dn group</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-text xml:space="preserve">SPML.SAPGROUP.</token-text>
												<token-lower-case>
													<token-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" />
												</token-lower-case>
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
								