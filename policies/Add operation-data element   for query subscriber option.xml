<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation-data element   for query subscriber option</description>
									<comment xml:space="preserve">Add operation-data element   for query subscriber option on basis of driver level local variable from publisher channel</comment>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-operation mode="nocase" op="equal">query</if-operation>
										</or>
										<or>
											<if-xpath op="not-true">driver-operation-data</if-xpath>
										</or>
										<or>
											<if-association op="available" />
										</or>
									</conditions>
									<actions>
										
										<do-if>
											<arg-conditions>
												<and>
													<if-association mode="regex" op="equal">.*Employee_ID.*|.*Contingent_Worker_ID.*</if-association>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="LV-Association-user" scope="policy">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="LV-WorkforceID-user" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after($LV-Association-user,'-')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="LV-WorkerIDType-user" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before($LV-Association-user,'-')" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="DV-wd-WorkforceID-user" op="equal">$LV-WorkforceID-user$</if-local-variable>
															<if-local-variable mode="nocase" name="DV-wd-FutureHire" op="equal">True</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="LV-effectiveDate-user" scope="policy">
															<arg-string>
																<token-local-variable name="DV-wd-effectiveDate" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="LV-effectiveDate-user" scope="policy">
															<arg-string>
																<token-time format="yyyy-MM-dd" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="gvWorkersMergeIDV" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-association>
															<arg-association>
																<token-local-variable name="LV-WorkforceID-user" />
															</arg-association>
														</do-set-op-association>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-association mode="nocase" op="equal">$DV-wd-WorkforceID-user$</if-association>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="LV-Association-user" scope="policy">
															<arg-string>
																<token-local-variable name="DV-wd-Association-user" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-WorkerIDType-user" scope="policy">
															<arg-string>
																<token-local-variable name="DV-wd-WorkerIDType-user" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-WorkforceID-user" scope="policy">
															<arg-string>
																<token-local-variable name="DV-wd-WorkforceID-user" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="DV-wd-FutureHire" op="equal">True</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="LV-effectiveDate-user" scope="policy">
																	<arg-string>
																		<token-local-variable name="DV-wd-effectiveDate" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-set-local-variable name="LV-effectiveDate-user" scope="policy">
																	<arg-string>
																		<token-time format="yyyy-MM-dd" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="LV-Association-user" scope="policy">
															<arg-string>
																<token-src-attr class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-WorkerIDType" />
																<token-text xml:space="preserve">-</token-text>
																<token-src-attr class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-WorkerIDType-user" scope="policy">
															<arg-string>
																<token-src-attr class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-WorkerIDType" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-WorkforceID-user" scope="policy">
															<arg-string>
																<token-src-attr class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-effectiveDate-user" scope="policy">
															<arg-string>
																<token-time format="yyyy-MM-dd" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-src-attr name="wd-Merge-effectiveDate" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="LV-Merge-Effective-date" scope="policy">
													<arg-string>
														<token-convert-time dest-format="!CTIME" dest-tz="UTC" src-format="yyyyMMdd">
															<token-src-attr class-name="User" name="wd-Merge-effectiveDate" />
														</token-convert-time>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="LV-current-date" scope="policy">
													<arg-string>
														<token-time format="!CTIME" tz="UTC" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="numeric" name="LV-Merge-Effective-date" op="gt">$LV-current-date$</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="LV-effectiveDate-user" scope="policy">
															<arg-string>
																<token-convert-time dest-format="yyyy-MM-dd" src-format="yyyyMMdd">
																	<token-src-attr class-name="User" name="wd-Merge-effectiveDate" />
																</token-convert-time>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-append-xml-element expression="." name="driver-operation-data" />
										<do-append-xml-element expression="driver-operation-data" name="WD-WorkforceID" />
										<do-append-xml-text expression="driver-operation-data/WD-WorkforceID">
											<arg-string>
												<token-local-variable name="LV-WorkforceID-user" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="driver-operation-data" name="WD-WorkerIDType" />
										<do-append-xml-text expression="driver-operation-data/WD-WorkerIDType">
											<arg-string>
												<token-local-variable name="LV-WorkerIDType-user" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="driver-operation-data" name="WD-effectiveDate" />
										<do-append-xml-text expression="driver-operation-data/WD-effectiveDate">
											<arg-string>
												<token-local-variable name="LV-effectiveDate-user" />
											</arg-string>
										</do-append-xml-text>
										<do-set-op-association>
											<arg-association>
												<token-local-variable name="LV-Association-user" />
											</arg-association>
										</do-set-op-association>
									</actions>
								</rule>
								