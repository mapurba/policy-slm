<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add User E-Mail: Mail File Replication Settings</description>
									<conditions>
										<and>
											<if-global-variable name="account.email.replication" op="equal">true</if-global-variable>
											<if-global-variable name="account.email.rep.destsvr" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="mailfile-rep-new-server">
											<arg-string>
												<token-global-variable name="account.email.rep.destsvr" />
											</arg-string>
										</do-set-xml-attr>
										<do-set-xml-attr expression="../add[@class-name='User']" name="mailfile-rep-priority">
											<arg-string>
												<token-global-variable name="account.email.rep.priority" />
											</arg-string>
										</do-set-xml-attr>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable name="account.email.repinbackground" op="equal">false</if-global-variable>
													<if-global-variable name="account.email.createinbackground" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												
												
												
												<do-set-xml-attr expression="../add[@class-name='User']" name="mailfile-rep-background">
													<arg-string>
														<token-text>true</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="../add[@class-name='User']" name="allow-adminp-support">
													<arg-string>
														<token-text>true</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions>
												
												
												<do-set-xml-attr expression="../add[@class-name='User']" name="mailfile-rep-background">
													<arg-string>
														<token-global-variable name="account.email.repinbackground" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="../add[@class-name='User']" name="allow-adminp-support">
													<arg-string>
														<token-text>true</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								