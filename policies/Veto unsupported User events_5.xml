<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto unsupported User events</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="not-equal">modify</if-operation>
											<if-operation op="not-equal">add</if-operation>
											<if-operation op="not-equal">delete</if-operation>
											<if-operation op="not-equal">sync</if-operation>
											<if-operation mode="case" op="not-equal">query</if-operation>
											<if-operation mode="case" op="not-equal">modify-password</if-operation>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							