<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Prevent Org Units if using Placement Entitlement and Not Synching OU's</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.googlePlacementOption" op="equal">entitlement</if-global-variable>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.AllowOrgUnitsSyncToGoogle" op="not-equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								