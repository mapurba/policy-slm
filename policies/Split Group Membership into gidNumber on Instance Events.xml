<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Split Group Membership into gidNumber on Instance Events</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="Group Membership" op="available" />
										</and>
									</conditions>
									<actions>
										<do-clone-op-attr dest-name="gidNumber" src-name="Group Membership" />
										<do-reformat-op-attr name="gidNumber">
											<arg-value type="string">
												<token-xpath expression="./attr[@attr-name=&quot;Group Membership&quot;]/value/@nxdrv:gidNumber" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							