<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Delete User: Break for non-fanout associations</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="case" op="equal">delete</if-operation>
											<if-association mode="regex" op="not-equal">fanout1-.+|fanout2-.+</if-association>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								