<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Available Attributes on Modify and Add</description>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lv_UserQuery" scope="policy">
											<arg-node-set>
												<token-query datastore="src" scope="entry">
													<arg-dn>
														<token-src-dn />
													</arg-dn>
													<arg-string>
														<token-replace-all regex="[~]" replace-with=",">
															<token-global-variable name="gcv.NOVLBNNRUSER.RequiredSubscriberAttrList" />
														</token-replace-all>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
								