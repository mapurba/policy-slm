<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GroupWise External Entity Placement</description>
									<conditions>
										<and>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
											<if-global-variable name="driver.gw.syncExternalEntity" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add" name="gw:classification">
											<arg-string>
												<token-text xml:space="preserve">external</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-add-dest-attr-value class-name="GroupWise External Entity" name="50035">
											<arg-value type="string">
												<token-global-variable name="driver.gw.SyncGWEEDomainName" />
											</arg-value>
										</do-add-dest-attr-value>
										<do-add-dest-attr-value class-name="GroupWise External Entity" name="50062">
											<arg-value type="string">
												<token-global-variable name="driver.gw.SyncGWEEPOName" />
											</arg-value>
										</do-add-dest-attr-value>
										<do-break />
									</actions>
								</rule>
								