<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformating Login Disabled </description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-src-attr class-name="User" name="scim-active" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-src-attr class-name="User" mode="nocase" name="scim-active" op="equal">true</if-src-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-add-dest-attr-value class-name="User" name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">false</token-text>
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-add-dest-attr-value class-name="User" name="Login Disabled">
													<arg-value type="state">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							