<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Do match for mirrored placement</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.pubPlacementType" op="equal">mirrored</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="entry">
											<arg-dn>
												<token-local-variable name="idmBaseContainer" />
												<token-op-property name="unmatched-src-dn" />
											</arg-dn>
										</do-find-matching-object>
									</actions>
								</rule>
							