<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto objects other than User/Group for flat placement</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.pubPlacementType" op="equal">flat</if-global-variable>
											<if-class-name mode="nocase" op="not-equal">User</if-class-name>
											<if-class-name mode="nocase" op="not-equal">Group</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							