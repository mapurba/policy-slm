<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>break if not a Delete event Or not an appropriate object</description>
									<conditions>
										<or>
											<if-operation mode="case" op="not-equal">delete</if-operation>
											<if-class-name mode="nocase" op="not-equal">UserEntry</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								