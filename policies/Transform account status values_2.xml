<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform account status values</description>
									<comment xml:space="preserve">Transform Sentinel account status values "Active", "Inactive", etc. to the values used in the DirXML-Accounts attribute ("A", "I", etc.)</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-reformat-op-attr name="status">
											<arg-value type="string">
												<token-map default-value="-" dest="edir" src="sentinel" table="NIQSENIDTRK-AccountStatusValuesMap">
													<token-local-variable name="current-value" />
												</token-map>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							