<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Append Remove-Association event to Delete events</description>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
										</and>
									</conditions>
									<actions>
										<do-remove-association when="after">
											<arg-association>
												<token-association />
											</arg-association>
										</do-remove-association>
									</actions>
								</rule>
							