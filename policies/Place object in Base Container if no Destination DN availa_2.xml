<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Place object in Base Container if no Destination DN available</description>
									<conditions>
										<and>
											<if-dest-dn op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-src-name />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							