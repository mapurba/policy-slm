<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>0-0: Fanout associated objects by existing UserAccount Entitlement (error recovery)</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
											<if-association op="available" />
											<if-entitlement name="UserAccount" op="not-changing" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lsname" scope="policy">
											<arg-string>
												<token-xpath expression="substring-after(substring-before(association/text(), '\USd'),'\')" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="fanout" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-entitlement name="UserAccount" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="this.lsname" scope="policy">
													<arg-string>
														
														<token-xpath expression="es:getEntParamFieldBackwardsCompatible($current-node, 'LIID','LSNAME')" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">$this.lsname!=$lsname</if-xpath>
															<if-xpath op="true">count($event//node()[@lsname=$this.lsname])=0</if-xpath>
															<if-xpath op="true">count(node()[@lsname=$this.lsname])=0</if-xpath>
															<if-xpath op="true">count($event//association[starts-with(text(), concat('\', $this.lsname))])=0</if-xpath>
															<if-xpath op="true">count(association[starts-with(text(), concat('\', $this.lsname))])=0</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvTmp" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">0-0: Detected potentially previously failed fanout condition. Preparing to re-fanout event for associated object: </token-text>
																<token-src-name />
																<token-text xml:space="preserve"> to system: </token-text>
																<token-xpath expression="$this.lsname" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="lvFile" scope="policy">
																	<arg-string>
																		<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',18),$lvTmp))" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions />
														</do-if>
														<do-set-local-variable name="fanout" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="fanout" op="equal">true</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="filter" scope="policy">
													<arg-node-set>
														<token-document>
															<arg-string>
																<token-text xml:space="preserve">vnd.nds.stream:</token-text>
																<token-text xml:space="preserve">/</token-text>
																<token-parse-dn dest-dn-delims="00,/+=*\" dest-dn-format="custom" src-dn-format="slash">
																	<token-global-variable name="dirxml.auto.driverdn" />
																</token-parse-dn>
																<token-text xml:space="preserve">#</token-text>
																<token-text xml:space="preserve">DirXML-DriverFilter</token-text>
															</arg-string>
														</token-document>
													</arg-node-set>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-entitlement name="UserAccount" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="granted-lsname" scope="policy">
															<arg-string>
																
																<token-xpath expression="es:getEntParamFieldBackwardsCompatible($current-node, 'LIID','LSNAME')" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="dvn" scope="policy">
															<arg-string>
																<token-local-variable name="granted-lsname" />
																<token-text xml:space="preserve">-clsname</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="granted-clsname" scope="policy">
															<arg-string>
																<token-local-variable name="$dvn$" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="dvn" scope="policy">
															<arg-string>
																<token-local-variable name="granted-lsname" />
																<token-text xml:space="preserve">-ctype</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="granted-ctype" scope="policy">
															<arg-string>
																<token-local-variable name="$dvn$" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="granted-ctype" op="not-equal">cua-child</if-local-variable>
																	<if-local-variable mode="nocase" name="granted-lsname" op="not-equal">$lsname$</if-local-variable>
																	<if-xpath op="true">count(node()[@lsname=$granted-lsname])=0</if-xpath>
																	<if-xpath op="true">count(association[starts-with(text(), concat('\', $granted-lsname))])=0</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="lvTmp" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">0-0: Re-attempting to fanout to system: $granted-lsname$</token-text>
																	</arg-string>
																</do-set-local-variable>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="lvFile" scope="policy">
																			<arg-string>
																				<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',18),$lvTmp))" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions />
																</do-if>
																<do-set-local-variable name="class-name" scope="policy">
																	<arg-string>
																		<token-class-name />
																	</arg-string>
																</do-set-local-variable>
																<do-add-dest-object class-name="$class-name$" when="after">
																	<arg-dn>
																		<token-text xml:space="preserve">fanout</token-text>
																	</arg-dn>
																</do-add-dest-object>
																<do-set-xml-attr expression="../add[last()]/operation-data" name="lsname">
																	<arg-string>
																		<token-local-variable name="granted-lsname" />
																	</arg-string>
																</do-set-xml-attr>
																<do-for-each>
																	<arg-node-set>
																		<token-xpath expression="$filter/filter/filter-class[@class-name=@class-name]/filter-attr[@subscriber='sync' or @subscriber='notify']/@attr-name" />
																	</arg-node-set>
																	<arg-actions>
																		<do-set-local-variable name="value" scope="policy">
																			<arg-node-set>
																				<token-attr name="$current-node$" />
																			</arg-node-set>
																		</do-set-local-variable>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-xpath op="true">count($value)&gt;0</if-xpath>
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-add-dest-attr-value class-name="$class-name$" name="$current-node$" when="after">
																					<arg-dn>
																						<token-text xml:space="preserve">fanout</token-text>
																					</arg-dn>
																					<arg-value />
																				</do-add-dest-attr-value>
																				<do-strip-xpath expression="../add[last()]/add-attr[@attr-name=$current-node]/value" />
																				<do-clone-xpath dest-expression="../add[last()]/add-attr[@attr-name=$current-node]" src-expression="$value" />
																			</arg-actions>
																			<arg-actions />
																		</do-if>
																	</arg-actions>
																</do-for-each>
																<do-for-each>
																	<arg-node-set>
																		<token-xpath expression="../add[last()]/add-attr[@attr-name='DirXML-EntitlementRef']/value" />
																	</arg-node-set>
																	<arg-actions>
																		<do-set-local-variable name="edn" scope="policy">
																			<arg-string>
																				<token-xpath expression="$current-node/component[@name='volume']/text()" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-local-variable mode="nocase" name="edn" op="equal">$dirxml.auto.driverdn$</if-local-variable>
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-set-local-variable name="entref-lsname" scope="policy">
																					<arg-string>
																						
																						<token-xpath expression="es:getEntParamFieldBackwardsCompatible($current-node/component[@name='path.xml']/ref/param, 'LIID','LSNAME')" />
																					</arg-string>
																				</do-set-local-variable>
																				<do-if>
																					<arg-conditions>
																						<and>
																							<if-local-variable mode="regex" name="entref-lsname" op="equal">.+</if-local-variable>
																						</and>
																					</arg-conditions>
																					<arg-actions>
																						<do-set-local-variable name="dvn" scope="policy">
																							<arg-string>
																								<token-local-variable name="entref-lsname" />
																								<token-text xml:space="preserve">-clsname</token-text>
																							</arg-string>
																						</do-set-local-variable>
																						<do-set-local-variable name="entref-clsname" scope="policy">
																							<arg-string>
																								<token-local-variable name="$dvn$" />
																							</arg-string>
																						</do-set-local-variable>
																						<do-if>
																							<arg-conditions>
																								<and>
																									<if-local-variable mode="nocase" name="entref-lsname" op="not-equal">$granted-lsname$</if-local-variable>
																									<if-local-variable mode="nocase" name="entref-clsname" op="not-equal">$granted-lsname$</if-local-variable>
																								</and>
																							</arg-conditions>
																							<arg-actions>
																								
																								<do-strip-xpath expression="../add[last()]/add-attr[@attr-name='DirXML-EntitlementRef']/value[es:getEntParamFieldBackwardsCompatible(component[@name='path.xml']/ref/param/text(), 'LIID','LSNAME')=$entref-lsname]" />
																							</arg-actions>
																							<arg-actions />
																						</do-if>
																					</arg-actions>
																					<arg-actions />
																				</do-if>
																			</arg-actions>
																			<arg-actions />
																		</do-if>
																	</arg-actions>
																</do-for-each>
																<do-set-xml-attr expression="../add[last()]" name="src-dn">
																	<arg-string>
																		<token-src-dn />
																	</arg-string>
																</do-set-xml-attr>
																<do-strip-xpath expression="../add[last()]/@dest-dn" />
															</arg-actions>
															<arg-actions />
														</do-if>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="granted-ctype" op="equal">cua-child</if-local-variable>
																	<if-local-variable mode="nocase" name="granted-clsname" op="equal">$lsname$</if-local-variable>
																	<if-local-variable mode="nocase" name="granted-lsname" op="not-equal">$lsname$</if-local-variable>
																	<if-xpath op="true">count(node()[@lsname=$granted-lsname])=0</if-xpath>
																	<if-xpath op="true">count(association[starts-with(text(), concat('\', $granted-lsname))])=0</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="lvTmp" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">0-0: Re-attempting to fanout to CUA child system: $granted-lsname$</token-text>
																	</arg-string>
																</do-set-local-variable>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="lvFile" scope="policy">
																			<arg-string>
																				<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',18),$lvTmp))" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions />
																</do-if>
																<do-set-local-variable name="entitlements" scope="policy">
																	<arg-node-set>
																		<token-src-attr name="DirXML-EntitlementRef" />
																	</arg-node-set>
																</do-set-local-variable>
																<do-add-dest-attr-value name="DirXML-EntitlementRef">
																	<arg-value type="string">
																		<token-text xml:space="preserve">temp</token-text>
																	</arg-value>
																</do-add-dest-attr-value>
																<do-strip-xpath expression="../modify-attr[@attr-name='DirXML-EntitlementRef']/add-value/value" />
																<do-clone-xpath dest-expression="../modify-attr[@attr-name='DirXML-EntitlementRef']/add-value" src-expression="$entitlements[component[@name='path.xml']/ref/param/text()=$current-node and component[@name='nameSpace']='1']" />
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="lv.rename" op="equal">true</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="lvAss" scope="policy">
																			<arg-string>
																				<token-association />
																			</arg-string>
																		</do-set-local-variable>
																		<do-strip-xpath expression="../modify/association/text()" />
																		<do-append-xml-text expression="../modify/association">
																			<arg-string>
																				<token-parse-dn dest-dn-format="slash" length="1" src-dn-format="slash">
																					<token-local-variable name="lvAss" />
																				</token-parse-dn>
																				<token-text xml:space="preserve">\USd</token-text>
																				<token-upper-case>
																					<token-xpath expression="new-name" />
																				</token-upper-case>
																			</arg-string>
																		</do-append-xml-text>
																		<do-set-xml-attr expression="../modfy[last()]/operation-data" name="renOld">
																			<arg-string>
																				<token-local-variable name="lv.renOld" />
																			</arg-string>
																		</do-set-xml-attr>
																		<do-set-xml-attr expression="../modify[last()]/operation-data" name="renNew">
																			<arg-string>
																				<token-local-variable name="lv.renNew" />
																			</arg-string>
																		</do-set-xml-attr>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
															<arg-actions />
														</do-if>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="lv.rename" op="equal">true</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-xml-attr expression="../add[last()]/operation-data" name="renOld">
																	<arg-string>
																		<token-local-variable name="lv.renOld" />
																	</arg-string>
																</do-set-xml-attr>
																<do-set-xml-attr expression="../add[last()]/operation-data" name="renNew">
																	<arg-string>
																		<token-local-variable name="lv.renNew" />
																	</arg-string>
																</do-set-xml-attr>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
												<do-strip-xpath expression="../add/operation-data/entitlement-impl" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-src-attr name="DirXML-EntitlementRef" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="edn" scope="policy">
													<arg-string>
														<token-parse-dn dest-dn-format="src-dn" length="-2">
															<token-xpath expression="$current-node/component[@name='volume']/text()" />
														</token-parse-dn>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="edn" op="equal">$dirxml.auto.driverdn$</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="entref-lsname" scope="policy">
															<arg-string>
																
																<token-xpath expression="es:getEntParamFieldBackwardsCompatible($current-node/component[@name='path.xml']/ref/param, 'LIID','LSNAME')" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="regex" name="entref-lsname" op="equal">.+</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="dvn" scope="policy">
																	<arg-string>
																		<token-local-variable name="entref-lsname" />
																		<token-text xml:space="preserve">-clsname</token-text>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="entref-clsname" scope="policy">
																	<arg-string>
																		<token-local-variable name="$dvn$" />
																	</arg-string>
																</do-set-local-variable>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="entref-lsname" op="not-equal">$lsname$</if-local-variable>
																			<if-local-variable mode="nocase" name="entref-clsname" op="not-equal">$lsname$</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		
																		<do-strip-xpath expression="./add-attr[@attr-name='DirXML-EntitlementRef']/value[es:getEntParamFieldBackwardsCompatible(component[@name='path.xml']/ref/param/text(), 'LIID', 'LSNAME')=$entref-lsname]" />
																		
																		<do-strip-xpath expression="./modify-attr[@attr-name='DirXML-EntitlementRef']/node()[es:getEntParamFieldBackwardsCompatible(value/component[@name='path.xml']/ref/param/text(), 'LIID', 'LSNAME')=$entref-lsname]" />
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-strip-xpath expression="./node()[@attr-name='DirXML-EntitlementRef'][count(node())=0]" />
										<do-strip-xpath expression=".[count(modify-attr)=0 and count(add-attr)=0]" />
										<do-strip-xpath expression="../add/operation-data/entitlement-impl" />
									</actions>
								</rule>
								