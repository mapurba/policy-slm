<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Have a copy of filter attributes of class "User" and  "Group"</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="filter">
											<arg-node-set>
												<token-xml-parse>
													<token-base64-decode charset="UTF-8">
														<token-query class-name="DirXML-Driver" datastore="src">
															<arg-dn>
																<token-global-variable name="dirxml.auto.driverdn" />
															</arg-dn>
															<arg-string>
																<token-text xml:space="preserve">urn:ietf:params:scim:schemas:ilm:core:1.0:Driver:filters</token-text>
															</arg-string>
														</token-query>
													</token-base64-decode>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="filterAttrUser" scope="driver">
											<arg-node-set>
												<token-xpath expression="$filter//filter-class[@class-name='User']/filter-attr[@subscriber='sync' or @subscriber='notify']/@attr-name" />
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="filterAttrGroup" scope="driver">
											<arg-node-set>
												<token-xpath expression="$filter//filter-class[@class-name='Group']/filter-attr[@subscriber='sync' or @subscriber='notify']/@attr-name" />
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
							