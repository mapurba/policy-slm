<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Restore account action</description>
									<conditions>
										<and>
											<if-local-variable name="accountAction" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="accountAction">
											<arg-string>
												<token-local-variable name="acctAction" />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							