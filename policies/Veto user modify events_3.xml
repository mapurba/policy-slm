<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto user modify events</description>
									<conditions>
										<and>
											<if-class-name mode="case" op="equal">User</if-class-name>
											<if-operation mode="case" op="equal">modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								