<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>MDADAliasName: Disallow non driver specific modifies</description>
									<conditions>
										<and>
											<if-op-attr name="DirXML-MDADAliasName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="*[@attr-name='DirXML-MDADAliasName']//value[component[@name='volume']!='~dirxml.auto.driverdn~']" />
										<do-strip-xpath expression="*[@attr-name='DirXML-MDADAliasName']/remove-all-values" />
									</actions>
								</rule>
							