<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip association-ref attribute on User Migration</description>
									<comment xml:space="preserve">Thi rule strips association-ref attribute from all User object 'Group Membership' values on User migration into IDV.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="Group Membership" op="changing" />
											<if-operation mode="nocase" op="equal">instance</if-operation>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="$current-op/attr[@attr-name=&quot;Group Membership&quot;]//@association-ref" />
										<do-strip-xpath expression="$current-op/attr[@attr-name=&quot;Group Membership&quot;]//@type" />
									</actions>
								</rule>
							