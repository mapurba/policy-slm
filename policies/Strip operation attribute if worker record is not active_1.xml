<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip operation attribute if worker record is not active </description>
									<comment xml:space="preserve">Strip position attributes if the worker record is not active. at the time of  conversion from  contingent worker to Employee</comment>
									<conditions>
										<and>
											<if-local-variable mode="nocase" name="LV-strip-employement-data" op="equal">True</if-local-variable>
											<if-op-attr name="wd-WorkerIDType" op="changing" />
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="wd-WorkerIDType" />
										<do-strip-op-attr name="Title" />
										<do-strip-op-attr name="wd-PositionID" />
										<do-strip-op-attr name="wd-PositionTitle" />
										<do-strip-op-attr name="wd-BusinessTitle" />
										<do-strip-op-attr name="wd-PositionEffectiveDate" />
										<do-strip-op-attr name="wd-PositionStartDate" />
										<do-strip-op-attr name="wd-PositionEndDate" />
										<do-strip-op-attr name="wd-WorkerType" />
										<do-strip-op-attr name="wd-PositionTimeType" />
										<do-strip-op-attr name="wd-PayRateType" />
										<do-strip-op-attr name="wd-JobClassificationType" />
										<do-strip-op-attr name="wd-JobGroupReference" />
										<do-strip-op-attr name="wd-JobProfileID" />
										<do-strip-op-attr name="wd-JobProfileName" />
										<do-strip-op-attr name="wd-LocationID" />
										<do-strip-op-attr name="wd-LocationName" />
										<do-strip-op-attr name="wd-BusinessCountry" />
										<do-strip-op-attr name="wd-BusinessAddressLine1" />
										<do-strip-op-attr name="wd-BusinessCity" />
										<do-strip-op-attr name="wd-BusinessState" />
										<do-strip-op-attr name="wd-BusinessPostalcode" />
										<do-strip-op-attr name="wd-ManagerWorkforceID" />
									</actions>
								</rule>
								