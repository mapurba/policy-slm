<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>304B2 - Account Disable By Entitlement Revoke</description>
									<comment name="lastchanged" xml:space="preserve">00031202,Account Disable By Entitlement Revoke</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
											<if-op-property mode="nocase" name="accountAction" op="equal">accountDisableByEntitlementRevoke</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="auditEventID" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">1202</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="eventMessage" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Account {duser} disabled in driver {deviceProcessName}; Status:{outcome}</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="eventName" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Account Disable By Entitlement Revoke</token-text>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								