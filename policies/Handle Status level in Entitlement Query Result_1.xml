<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Handle Status level in Entitlement Query Result</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">status</if-operation>
											<if-xml-attr mode="nocase" name="level" op="equal">error</if-xml-attr>
											<if-op-property mode="nocase" name="Entitlement-Account-Query" op="equal">true</if-op-property>
										</and>
										<and>
											<if-operation mode="nocase" op="equal">status</if-operation>
											<if-xml-attr mode="nocase" name="level" op="equal">error</if-xml-attr>
											<if-op-property mode="nocase" name="Entitlement-Group-Query" op="equal">true</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="." name="level">
											<arg-string>
												<token-text xml:space="preserve">success</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								