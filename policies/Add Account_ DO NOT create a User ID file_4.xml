<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: DO NOT create a User ID file</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="account.cert.noidfile" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="no-id-file">
											<arg-string>
												<token-global-variable name="account.cert.noidfile" />
											</arg-string>
										</do-set-xml-attr>
										<do-set-xml-attr expression="../add[@class-name='User']" name="store-useridfile-in-ab">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								