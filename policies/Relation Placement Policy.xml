<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Relation Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">wd-relation</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="dn" scope="policy">
											<arg-string>
												<token-global-variable name="gvRelationPlacementContainer" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="CN" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="association" scope="policy">
											<arg-string>
												<token-op-attr name="workforceID" />
												<token-text xml:space="preserve">-</token-text>
												<token-op-attr name="wd-WorkerIDType" />
												<token-text xml:space="preserve">:</token-text>
												<token-attr name="wd-PositionID" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								