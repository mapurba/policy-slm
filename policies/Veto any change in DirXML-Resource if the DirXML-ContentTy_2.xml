<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto any change in DirXML-Resource if the DirXML-ContentType is invalid</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-Resource</if-class-name>
											<if-src-dn op="in-subtree">~dirxml.auto.driverdn~</if-src-dn>
											<if-attr name="DirXML-ContentType" op="available" />
											<if-attr mode="nocase" name="DirXML-ContentType" op="not-equal">application/vnd.novell.dirxml.fanout-enabled+xml</if-attr>
											<if-attr mode="nocase" name="DirXML-ContentType" op="not-equal">application/vnd.novell.dirxml.fanout+xml</if-attr>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								