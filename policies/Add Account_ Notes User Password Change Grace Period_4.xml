<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Notes User Password Change Grace Period</description>
									<conditions>
										<and>
											<if-global-variable name="account.cert.pwdgraceperiod" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="notes-password-grace-period">
											<arg-string>
												<token-global-variable name="account.cert.pwdgraceperiod" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								