<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Roaming User: Cleanup Setting</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="account.roamcleanupsetting" op="not-equal">default</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="roaming-cleanup-setting">
											<arg-string>
												<token-global-variable name="account.roamcleanupsetting" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								