<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Group</description>
									<conditions>
										<or>
											<if-class-name op="equal">Group</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="GID" />
										<do-veto-if-op-attr-not-available name="Full Name" />
										<do-set-default-attr-value name="creatorsName">
											<arg-value>
												<token-global-variable name="ARSObjectCreator" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="arsGroupType" write-back="false">
											<arg-value type="string">
												<token-global-variable name="ARSGroupType" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="arsGroupCategory" write-back="false">
											<arg-value type="string">
												<token-global-variable name="ARSGroupCategory" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="arsStatus" write-back="false">
											<arg-value type="string">
												<token-global-variable name="ARSGroupStatus" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
							