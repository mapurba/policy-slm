<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Unexpire GroupWise External Entity on eDirectory GroupWise External Entity Enable</description>
									<conditions>
										<and>
											<if-global-variable name="driver.gw.GWExternalEntityDisable" op="equal">expire</if-global-variable>
											<if-attr mode="nocase" name="Login Disabled" op="not-equal">true</if-attr>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="Login Disabled" />
										<do-clear-dest-attr-value class-name="User" name="NGW: Mailbox Expiration Time" />
										<do-break />
									</actions>
								</rule>
								