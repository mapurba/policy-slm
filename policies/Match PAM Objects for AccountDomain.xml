<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match PAM Objects for AccountDomain</description>
									<comment xml:space="preserve">Match AccountDomain objects in PAM based on the object name.</comment>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">DirXML-PUMAccountDomain</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-trace-message level="3">
											<arg-string>
												<token-text xml:space="preserve">AccountDomain Source DN is </token-text>
												<token-src-dn />
												<token-text xml:space="preserve"> of class type </token-text>
												<token-class-name />
											</arg-string>
										</do-trace-message>
										<do-find-matching-object scope="entry">
											<arg-dn>
												<token-src-dn start="-1" />
											</arg-dn>
										</do-find-matching-object>
									</actions>
								</rule>
							