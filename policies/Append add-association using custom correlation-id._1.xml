<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Append add-association using custom correlation-id.</description>
									<conditions>
										<and>
											<if-local-variable name="customAssociation" op="available" />
											<if-local-variable name="customAssociation" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-add-association direct="true">
											<arg-dn>
												<token-local-variable name="dn" />
											</arg-dn>
											<arg-association>
												<token-local-variable name="customAssociation" />
											</arg-association>
										</do-add-association>
									</actions>
								</rule>
							