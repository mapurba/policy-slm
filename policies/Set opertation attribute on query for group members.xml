<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set opertation attribute on query for group members</description>
									<comment xml:space="preserve">Set opertation attribute on query for group members</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">query</if-operation>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-xpath op="true">$current-op//read-attr[@attr-name='Users']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="QUERY_GROUP_USERS">
											<arg-string />
										</do-set-op-property>
									</actions>
								</rule>
							