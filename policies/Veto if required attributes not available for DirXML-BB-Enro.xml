<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto if required attributes not available for DirXML-BB-Enrollment</description>
									<conditions>
										<or>
											<if-class-name op="equal">DirXML-BB-Enrollment</if-class-name>
										</or>
										<or>
											<if-operation op="equal">add</if-operation>
										</or>
										<or>
											<if-op-attr name="DirXML-BB-enr-p-ext-key" op="not-available" />
											<if-op-attr name="DirXML-BB-enr-c-ext-key" op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-trace-message color="red">
											<arg-string>
												<token-text xml:space="preserve">Error: missing mandatory attribute</token-text>
											</arg-string>
										</do-trace-message>
										<do-veto />
									</actions>
								</rule>
							