<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Notes User Password Force Internet Password Change</description>
									<conditions>
										<and>
											<if-global-variable name="account.cert.forceinternetpwdchange" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="internet-password-force-change">
											<arg-string>
												<token-global-variable name="account.cert.forceinternetpwdchange" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								