<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if account entitlement is disabled</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.GWAccount" op="equal">false</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								