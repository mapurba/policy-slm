<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat User's Birthdate</description>
									<comment xml:space="preserve">Reformat user's birthdate as per GCV</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="wd-BirthDate" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="gvBirthdayPattern" op="equal">BirthYear</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-reformat-op-attr name="wd-BirthDate">
													<arg-value type="string">
														<token-substring length="4" start="0">
															<token-op-attr name="wd-BirthDate" />
														</token-substring>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="gvBirthdayPattern" op="equal">BirthMonthDay</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-reformat-op-attr name="wd-BirthDate">
													<arg-value type="string">
														<token-substring length="2" start="5">
															<token-op-attr name="wd-BirthDate" />
														</token-substring>
														<token-substring length="2" start="8">
															<token-op-attr name="wd-BirthDate" />
														</token-substring>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="gvBirthdayPattern" op="equal">BirthDateFull</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-reformat-op-attr name="wd-BirthDate">
													<arg-value type="string">
														<token-substring length="4" start="0">
															<token-op-attr name="wd-BirthDate" />
														</token-substring>
														<token-substring length="2" start="5">
															<token-op-attr name="wd-BirthDate" />
														</token-substring>
														<token-substring length="2" start="8">
															<token-op-attr name="wd-BirthDate" />
														</token-substring>
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								