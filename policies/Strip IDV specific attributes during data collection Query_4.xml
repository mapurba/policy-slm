<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip IDV specific attributes during data collection Query </description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">query</if-operation>
											<if-class-name op="available" />
											<if-op-property disabled="true" name="data-collection-query" notrace="true" op="available" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="DirXML-EntitlementRef" />
										<do-strip-op-attr name="nspmDistributionPassword" />
									</actions>
								</rule>
							