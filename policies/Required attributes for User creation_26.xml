<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Required attributes for User creation</description>
									<comment xml:space="preserve">The policy lists basic set of mandatory attributes required for user creation in ILM vault. Unavailabiliy of these attibutes will result in operation getting vetoed.
</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:userName" />
									</actions>
								</rule>
								