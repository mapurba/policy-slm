<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GroupWise External Entity Required Attributes</description>
									<conditions>
										<and>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
											<if-global-variable name="driver.gw.syncExternalEntity" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="Surname" />
										<do-veto-if-op-attr-not-available name="CN" />
										<do-veto-if-op-attr-not-available name="NGW: External Net ID" />
										<do-veto-if-op-attr-not-available name="NGW: Post Office" />
									</actions>
								</rule>
								