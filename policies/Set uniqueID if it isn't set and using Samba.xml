<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set uniqueID if it isn't set and using Samba</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-src-attr name="uniqueID" op="not-available" />
											<if-global-variable name="ModifyUsers" op="equal">true</if-global-variable>
										</and>
										
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable name="ModifyUsers" op="equal">true</if-global-variable>
											<if-global-variable name="ReplaceValues" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-src-attr-value name="uniqueID">
											<arg-value type="string">
												<token-src-name />
											</arg-value>
										</do-set-src-attr-value>
									</actions>
								</rule>
							