<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>304B3 - Account Enable By Entitlement Grant</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
											<if-op-property mode="nocase" name="accountAction" op="equal">accountEnableByEntitlementGrant</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="auditEventID" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">1203</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="eventName" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Account Enable By Entitlement Grant</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="eventMessage" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Account {duser} enabled in driver {deviceProcessName}; Status:{outcome}</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-property name="association" op="available" />
													<if-op-property mode="nocase" name="association" op="not-equal" />
													<if-op-property name="dest-dn" op="not-available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="appUserQueryResponse" scope="policy">
													<arg-node-set>
														<token-query class-name="User" datastore="src">
															<arg-association>
																<token-op-property name="association" />
															</arg-association>
															<arg-string>
																<token-text xml:space="preserve">CN</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-op-property name="dest-dn">
													<arg-string>
														<token-xpath expression="$appUserQueryResponse/@src-dn" />
													</arg-string>
												</do-set-op-property>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								