<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Create Sentinel Identity map</description>
									<comment xml:space="preserve">Create the Java map that this driver's Subscriber policies use for keeping track of Identity IDs for use in assigning created account objects to the appropriate identity.</comment>
									<conditions>
										<and>
											<if-local-variable name="drv.identity.map" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="drv.identity.map" scope="driver">
											<arg-object>
												<token-xpath expression="jmap:new()" />
											</arg-object>
										</do-set-local-variable>
									</actions>
								</rule>
								