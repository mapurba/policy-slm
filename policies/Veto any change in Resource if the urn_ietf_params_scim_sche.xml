<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto any change in Resource if the urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:contentType is invalid</description>
									<conditions>
										<and>
											<if-class-name op="equal">Resource</if-class-name>
											<if-src-dn op="in-subtree">~dirxml.auto.driverdn~</if-src-dn>
											<if-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:contentType" op="available" />
											<if-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:contentType" op="not-equal">application/vnd.novell.dirxml.fanout-enabled+xml</if-attr>
											<if-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:core:1.0:Resource:contentType" op="not-equal">application/vnd.novell.dirxml.fanout+xml</if-attr>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								