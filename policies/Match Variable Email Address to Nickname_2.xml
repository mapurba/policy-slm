<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match Variable Email Address to Nickname</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="preferredName">
												<arg-value type="string">
													<token-local-variable name="lv_EmailAddress" />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
									</actions>
								</rule>
							