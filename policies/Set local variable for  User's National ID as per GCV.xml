<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set local variable for  User's National ID as per GCV</description>
									<comment xml:space="preserve">Set local variable for user's National ID as per GCV</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="~gvNIDAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvNationalID" scope="policy">
											<arg-string>
												<token-substring length="-1" start="0">
													<token-op-attr name="~gvNIDAttr~" />
												</token-substring>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								