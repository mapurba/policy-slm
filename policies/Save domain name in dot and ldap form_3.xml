<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Save domain name in dot and ldap form</description>
									<comment xml:space="preserve">Set domain name</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">user</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">delete</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="ldap.domain.dns.name" scope="policy">
													<arg-string>
														<token-src-dn />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="drv.domain.dns.name" scope="policy">
													<arg-string>
														<token-join delimiter=".">
															<token-split delimiter="DC=">
																<token-replace-all regex="," replace-with="">
																	<token-src-dn />
																</token-replace-all>
															</token-split>
														</token-join>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-global-variable name="drv.domains" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="domain_container" scope="policy">
															<arg-string>
																<token-xpath expression="$current-node/definition[@name=&quot;drv.user.container&quot;]/value/text()" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-src-dn op="in-subtree">$domain_container$</if-src-dn>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="drv.domain.dns.name" scope="policy">
																	<arg-string>
																		<token-xpath expression="$current-node/definition[@name=&quot;drv.domain.dns.name&quot;]/value/text()" />
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="ldap.domain.dns.name" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">DC=</token-text>
																		<token-replace-all regex="\." replace-with=",DC=">
																			<token-local-variable name="drv.domain.dns.name" />
																		</token-replace-all>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							