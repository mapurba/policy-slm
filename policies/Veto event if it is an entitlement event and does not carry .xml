<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto event if it is an entitlement event and does not carry a connection-dn</description>
									<conditions>
										<and>
											<if-op-property mode="nocase" name="entitlement-event" op="equal">true</if-op-property>
											<if-op-property name="connection-dn" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								