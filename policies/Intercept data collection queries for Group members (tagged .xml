<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Intercept data collection queries for Group members (tagged identity query) response</description>
									<conditions>
										<and>
											<if-local-variable name="GroupEntitlementMemberAssignmentQuery" op="equal">true</if-local-variable>
											<if-operation mode="case" op="equal">instance</if-operation>
											<if-class-name mode="nocase" op="equal">__driver_identification_class__</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="GroupEntitlementMemberAssignmentQuery" scope="driver">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="attr" />
										<do-set-local-variable name="GroupQuery">
											<arg-node-set>
												<token-query class-name="Group" datastore="src">
													<arg-string>
														<token-text xml:space="preserve">Name</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="GroupQuery" />
											</arg-node-set>
											<arg-actions>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">Found a Group id  and GroupName</token-text>
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="groupId">
													<arg-string>
														<token-xpath expression="$current-node/association/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="GroupName">
													<arg-string>
														<token-xpath expression="$current-node/attr[@attr-name='Name']/value" />
													</arg-string>
												</do-set-local-variable>
												<do-clone-xpath dest-expression=".." src-expression="$current-node" />
												<do-set-local-variable name="UserorGroupIdsQuery">
													<arg-node-set>
														<token-query class-name="GroupMember" datastore="src">
															<arg-match-attr name="GroupId">
																<arg-value>
																	<token-local-variable name="groupId" />
																</arg-value>
															</arg-match-attr>
															<arg-string>
																<token-text xml:space="preserve">UserOrGroupId</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-append-xml-element expression="../instance[last()]" name="attr" />
												<do-set-xml-attr expression="../instance[last()]/attr[last()]" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">Members</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="../instance[last()]" name="operation-data" />
												<do-set-xml-attr expression="../instance[last()]/operation-data[last()]" name="data-collection-query">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="UserorGroupIdsQuery" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="UserName">
															<arg-string>
																<token-xpath expression="$current-node/attr/value/text()" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="UserNameQuery" scope="policy">
															<arg-node-set>
																<token-query class-name="User" datastore="src">
																	<arg-match-attr name="Id">
																		<arg-value>
																			<token-local-variable name="UserName" />
																		</arg-value>
																	</arg-match-attr>
																	<arg-string>
																		<token-text xml:space="preserve">Username</token-text>
																	</arg-string>
																</token-query>
																<token-query class-name="Group" datastore="src">
																	<arg-match-attr name="Id">
																		<arg-value type="string">
																			<token-local-variable name="UserName" />
																		</arg-value>
																	</arg-match-attr>
																	<arg-string>
																		<token-text xml:space="preserve">Name</token-text>
																	</arg-string>
																</token-query>
															</arg-node-set>
														</do-set-local-variable>
														<do-for-each>
															<arg-node-set>
																<token-local-variable name="UserNameQuery" />
															</arg-node-set>
															<arg-actions>
																<do-set-local-variable name="User">
																	<arg-string>
																		<token-xpath expression="$current-node/attr[@attr-name='Username']/value" />
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="Group" scope="policy">
																	<arg-string>
																		<token-xpath expression="$current-node/attr[@attr-name='Name']/value" />
																	</arg-string>
																</do-set-local-variable>
																<do-append-xml-element expression="../instance[last()]/attr[@attr-name='Members']" name="value" />
																<do-append-xml-text expression="../instance[last()]/attr[@attr-name='Members']/value[last()]">
																	<arg-string>
																		<token-local-variable name="User" />
																	</arg-string>
																</do-append-xml-text>
																<do-append-xml-text expression="../instance[last()]/attr[@attr-name='Members']/value[last()]">
																	<arg-string>
																		<token-local-variable name="Group" />
																	</arg-string>
																</do-append-xml-text>
																<do-set-xml-attr expression="../instance[last()]/attr[@attr-name='Members']/value[last()]" name="association">
																	<arg-string>
																		<token-local-variable name="UserName" />
																	</arg-string>
																</do-set-xml-attr>
															</arg-actions>
														</do-for-each>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-for-each>
										<do-strip-xpath expression="../instance[count(attr)=0]" />
									</actions>
								</rule>
							