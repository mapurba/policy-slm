<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>check for drv.proc.log enabled</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string />
										</do-set-local-variable>
										<do-set-local-variable name="lvFile" scope="policy">
											<arg-string>
												<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',10),$lvTmp))" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve"> &gt;&gt; PUB-CTP for object [</token-text>
												<token-class-name />
												<token-text xml:space="preserve"> : </token-text>
												<token-src-dn />
												<token-text xml:space="preserve">] -- Filter Future and Historic Values</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="lvFile" scope="policy">
											<arg-string>
												<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',10),$lvTmp))" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								