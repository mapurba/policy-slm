<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set DirXML-BB-o-ext-key</description>
									<conditions>
										<and>
											<if-op-property mode="nocase" name="BBObjectType" op="equal">DirXML-BB-Organization</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="DirXML-BB-o-ext-key">
											<arg-value type="string">
												<token-lower-case>
													<token-replace-all regex=" " replace-with="_">
														<token-src-name />
													</token-replace-all>
												</token-lower-case>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							