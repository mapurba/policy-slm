<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Identity Vault accounts are enabled if urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled does not exist</description>
									<conditions>
										<and>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:loginDisabled">
											<arg-value type="string">
												<token-text xml:space="preserve">false</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							