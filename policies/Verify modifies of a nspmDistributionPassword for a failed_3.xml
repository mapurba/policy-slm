<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Verify modifies of a nspmDistributionPassword for a failed Sync</description>
									<conditions>
										<and>
											<if-operation op="equal">modify</if-operation>
											<if-password op="available" />
										</and>
									</conditions>
									<actions>
										
										
										
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="failed-Sync" op="equal">true</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-xml-attr expression="../modify-password" name="failed-sync">
													<arg-string>
														<token-local-variable name="failed-Sync" />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							