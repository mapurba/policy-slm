<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Notes Policy Name to be Applied</description>
									<conditions>
										<and>
											<if-global-variable name="account.policyname" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="notes-policy-name">
											<arg-string>
												<token-global-variable name="account.policyname" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								