<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>set PS urn:ietf:params:scim:schemas:ilm:static:1.0:User:employeeStatus to 'I'</description>
									<conditions>
										<and>
											<if-op-attr mode="nocase" name="STATUS" op="equal">inactive</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="User" name="STATUS">
											<arg-value>
												<token-text xml:space="preserve">I</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							