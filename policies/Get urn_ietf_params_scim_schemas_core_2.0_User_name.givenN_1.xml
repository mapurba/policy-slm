<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Get urn:ietf:params:scim:schemas:core:2.0:User:name.givenName from urn:ietf:params:scim:schemas:core:2.0:User:name.formatted if available</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" op="not-available" />
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.formatted" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="fullNameNodeSet" scope="policy">
											<arg-node-set>
												<token-split delimiter=" ">
													<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.formatted" />
												</token-split>
											</arg-node-set>
										</do-set-local-variable>
										<do-add-dest-attr-value name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName">
											<arg-value>
												<token-xpath expression="$fullNameNodeSet[1]" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							