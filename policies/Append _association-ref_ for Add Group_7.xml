<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Append &lt;association-ref&gt; for Add Group</description>
									<conditions>
										<or>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">urn:ietf:params:scim:schemas:core:2.0:Group</if-class-name>
										</or>
										<or>
											<if-xpath op="true">./add-attr[@attr-name='members:value']</if-xpath>
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="ValueNode" scope="policy">
											<arg-node-set>
												<token-xpath expression="./add-attr[@attr-name='members:value']/value" />
											</arg-node-set>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable name="ValueNode" op="not-equal" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="ValueNode" />
													</arg-node-set>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-op-property name="publisher-type" op="available" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="queryResponse">
																	<arg-node-set>
																		<token-query class-name="User">
																			<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:id">
																				<arg-value>
																					<token-xpath expression="$current-node/text()" />
																				</arg-value>
																			</arg-match-attr>
																		</token-query>
																	</arg-node-set>
																</do-set-local-variable>
																<do-set-local-variable name="userId">
																	<arg-string>
																		<token-xpath expression="$queryResponse/association/text()" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-set-local-variable name="userId">
																	<arg-string>
																		<token-local-variable name="current-node" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
														</do-if>
														<do-set-xml-attr expression="$current-node" name="association-ref">
															<arg-string>
																<token-local-variable name="userId" />
															</arg-string>
														</do-set-xml-attr>
														<do-set-xml-attr expression="$current-node" name="type">
															<arg-string>
																<token-text xml:space="preserve">dn</token-text>
															</arg-string>
														</do-set-xml-attr>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								