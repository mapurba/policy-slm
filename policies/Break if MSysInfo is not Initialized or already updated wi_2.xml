<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if MSysInfo is not Initialized or already updated with instance-info</description>
									<conditions>
										<or>
											<if-local-variable mode="nocase" name="mSysInsInfoUpdated" op="equal">true</if-local-variable>
											<if-local-variable mode="nocase" name="mSysInfoInitialized" op="not-equal">true</if-local-variable>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								