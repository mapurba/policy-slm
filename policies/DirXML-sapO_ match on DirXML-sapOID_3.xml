<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-sapO: match on DirXML-sapOID</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXMLsapO</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subordinates">
											<arg-dn>
												<token-global-variable name="dirxml.auto.driverdn" />
												<token-text xml:space="preserve">\sap\om\o</token-text>
											</arg-dn>
											<arg-match-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLsapO:DirXML-sapOID" />
										</do-find-matching-object>
									</actions>
								</rule>
								