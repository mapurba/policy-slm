<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Managed System Information</description>
									<conditions />
									<actions>
										<do-set-local-variable name="msysinfo" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-GlobalConfigDef" scope="entry">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
														<token-text xml:space="preserve">\MSysInfo</token-text>
													</arg-dn>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ConfigValues</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="xml" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-base64-decode>
														<token-xpath expression="$msysinfo//attr[@attr-name='DirXML-ConfigValues']/value/text()" />
													</token-base64-decode>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="driver" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-Driver" scope="entry">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-dn>
													<arg-string>
														<token-text xml:space="preserve">GUID</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ShimConfigInfo</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ShimAuthID</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ShimAuthServer</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="driverGuid" scope="policy">
											<arg-string>
												<token-xpath expression="es:guid2string($driver//attr[@attr-name='GUID']/value/text())" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.id']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.id']/value">
											<arg-string>
												<token-local-variable name="driverGuid" />
											</arg-string>
										</do-append-xml-text>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.type']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.type']/value">
											<arg-string>
												<token-text xml:space="preserve">JDBC</token-text>
											</arg-string>
										</do-append-xml-text>
										<do-set-local-variable name="authServer" scope="policy">
											<arg-string>
												<token-xpath expression="$driver//attr[@attr-name='DirXML-ShimAuthServer']/value/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">starts-with($authServer, 'REMOTE(')</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">string-length(substring-after($authServer, ')'))&gt;0</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="ipstr" scope="policy">
															<arg-string>
																<token-xpath expression="substring-after($authServer, ')')" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="ipstr" scope="policy">
													<arg-string>
														<token-xpath expression="$authServer" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="tempStr" scope="policy">
											<arg-node-set>
												<token-split delimiter=":">
													<token-local-variable name="ipstr" />
												</token-split>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="ip-extracted-ind" scope="policy">
											<arg-string>
												<token-text>not-initialized</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="tempStr" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="ipItem" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="ip-extracted-ind" op="equal">initialized</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">contains($ipItem,'/')</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="ms-port" scope="policy">
																	<arg-string>
																		<token-xpath expression="substring-before($ipItem,'/')" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-set-local-variable name="ms-port" scope="policy">
																	<arg-string>
																		<token-xpath expression="$current-node" />
																	</arg-string>
																</do-set-local-variable>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="regex" name="ms-port" op="not-equal">\b^[0-9]*$\b</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="ms-port" scope="policy">
																			<arg-string>
																				<token-text />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-if>
														<do-set-local-variable name="ip-extracted-ind" scope="policy">
															<arg-string>
																<token-text>port-initialized</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable name="ip" op="not-available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">starts-with($ipItem, '//')</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-xpath op="true">contains(substring-after($ipItem,'//'),'/')</if-xpath>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="ip" scope="policy">
																			<arg-node-set>
																				<token-xpath expression="substring-before(substring-after($ipItem,'//'),'/')" />
																			</arg-node-set>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions>
																		<do-set-local-variable name="ip" scope="policy">
																			<arg-node-set>
																				<token-xpath expression="substring-after($ipItem,'//')" />
																			</arg-node-set>
																		</do-set-local-variable>
																	</arg-actions>
																</do-if>
																<do-set-local-variable name="ip-extracted-ind" scope="policy">
																	<arg-string>
																		<token-text>initialized</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-xpath op="true">starts-with($ipItem, '@')</if-xpath>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-xpath op="true">contains($ipItem,'/')</if-xpath>
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-set-local-variable name="ip" scope="policy">
																					<arg-node-set>
																						<token-xpath expression="substring-before(substring-after($ipItem,'@'),'/')" />
																					</arg-node-set>
																				</do-set-local-variable>
																			</arg-actions>
																			<arg-actions>
																				<do-set-local-variable name="ip" scope="policy">
																					<arg-node-set>
																						<token-xpath expression="substring-after($ipItem,'@')" />
																					</arg-node-set>
																				</do-set-local-variable>
																			</arg-actions>
																		</do-if>
																		<do-set-local-variable name="ip-extracted-ind" scope="policy">
																			<arg-string>
																				<token-text>initialized</token-text>
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-if>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="regex" name="ip" op="equal">\b(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="validated-ip" scope="policy">
																	<arg-string>
																		<token-local-variable name="ip" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.auth.ip']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.auth.ip']/value">
											<arg-string>
												<token-local-variable name="validated-ip" />
											</arg-string>
										</do-append-xml-text>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.auth.port']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.auth.port']/value">
											<arg-string>
												<token-local-variable name="ms-port" />
											</arg-string>
										</do-append-xml-text>
										<do-set-local-variable name="authID" scope="policy">
											<arg-string>
												<token-xpath expression="$driver//attr[@attr-name='DirXML-ShimAuthID']/value/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.auth.id']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.auth.id']/value">
											<arg-string>
												<token-local-variable name="authID" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
								