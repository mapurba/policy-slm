<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Delete event to Modify to remove CN, DN, Internet Email Address and Description</description>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
										</and>
									</conditions>
									<actions>
										<do-clear-dest-attr-value name="CN" when="after" />
										<do-clear-dest-attr-value name="DISTINGUISHED_NAME" when="after" />
										<do-clear-dest-attr-value name="Internet EMail Address" when="after" />
										<do-clear-dest-attr-value name="Description" when="after" />
										<do-veto />
									</actions>
								</rule>
								