<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Lower Case CN if configured</description>
									<conditions>
										<and>
											<if-global-variable name="lower-case-cn" op="equal">true</if-global-variable>
											<if-op-attr name="CN" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="CN">
											<arg-value type="string">
												<token-lower-case>
													<token-op-attr name="CN" />
												</token-lower-case>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								