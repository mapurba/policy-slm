<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Required Attributes</description>
									<conditions>
										<or>
											<if-class-name op="equal">User</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:userName" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
									</actions>
								</rule>
								