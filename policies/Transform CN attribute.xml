<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform CN attribute</description>
									<conditions>
										<and>
											<if-operation disabled="true" op="not-equal">query</if-operation>
											<if-class-name op="equal">SPUser</if-class-name>
											<if-op-attr name="LoginName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="LoginName">
											<arg-value type="string">
												<token-text xml:space="preserve">i:0#.f|ldapmember|</token-text>
												<token-op-attr name="LoginName" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							