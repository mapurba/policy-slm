<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>strip "Managed By" from group</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">MSolGroup</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="ManagedBy" />
									</actions>
								</rule>
								