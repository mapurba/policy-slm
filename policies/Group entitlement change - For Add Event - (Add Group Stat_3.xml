<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Group entitlement change - For Add Event - (Add Group Statements).</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Group" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">add</if-operation>
											<if-entitlement name="Group" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="addNodeFlg" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="Group" />
											</arg-node-set>
											<arg-actions>
												<do-set-op-property name="groupAddAction">
													<arg-string>
														<token-text>groupModifyByEntitlementAdd</token-text>
													</arg-string>
												</do-set-op-property>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable name="addNodeFlg" op="equal">false</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-property name="sourceDN">
															<arg-string>
																<token-src-dn />
															</arg-string>
														</do-set-op-property>
														<do-set-op-property name="association">
															<arg-string>
																<token-association />
															</arg-string>
														</do-set-op-property>
														<do-set-op-property name="guid">
															<arg-string>
																<token-src-attr name="GUID" />
															</arg-string>
														</do-set-op-property>
														<do-set-op-property name="objectClass">
															<arg-string>
																<token-text>Group</token-text>
															</arg-string>
														</do-set-op-property>
														<do-set-local-variable name="addNodeFlg" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							