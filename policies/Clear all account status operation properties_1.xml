<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Clear all account status operation properties</description>
									<conditions>
										<or>
											<if-op-property name="NOVLNOTEASTS-denyAccessSearchAttr" op="available" />
											<if-op-property name="NOVLNOTEASTS-handleDenyAccessReadAttr" op="available" />
											<if-op-property name="NOVLNOTEASTS-addToDenyAccessGroup" op="available" />
											<if-op-property name="NOVLNOTEASTS-removeFromDenyAccessGroup" op="available" />
										</or>
									</conditions>
									<actions>
										<do-clear-op-property name="NOVLNOTEASTS-removeFromDenyAccessGroup" />
										<do-clear-op-property name="NOVLNOTEASTS-addToDenyAccessGroup" />
										<do-clear-op-property name="NOVLNOTEASTS-handleDenyAccessReadAttr" />
										<do-clear-op-property name="NOVLNOTEASTS-denyAccessSearchAttr" />
									</actions>
								</rule>
							