<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Mirrored Placement Rules</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.googlePlacementOption" op="equal">mirror</if-global-variable>
											<if-src-dn op="in-subtree">\$dirxml.auto.treename$\$idv.dit.data.users$</if-src-dn>
											<if-xml-attr mode="nocase" name="from-merge" op="equal">true</if-xml-attr>
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="case" op="equal">move</if-operation>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.googlePlacementOption" op="equal">mirror</if-global-variable>
											<if-src-dn op="in-subtree">\$dirxml.auto.treename$\$idv.dit.data.users$</if-src-dn>
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">Organizational Unit</if-class-name>
											<if-operation mode="case" op="equal">move</if-operation>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.googlePlacementOption" op="equal">mirror</if-global-variable>
											<if-xml-attr mode="nocase" name="from-merge" op="not-equal">true</if-xml-attr>
											<if-src-dn op="in-subtree">\$dirxml.auto.treename$\$idv.dit.data.users$</if-src-dn>
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">Organizational Unit</if-class-name>
											<if-operation mode="case" op="equal">move</if-operation>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.googlePlacementOption" op="equal">entitlement</if-global-variable>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.AllowOrgUnitsSyncToGoogle" op="equal">true</if-global-variable>
											<if-xml-attr mode="nocase" name="from-merge" op="not-equal">true</if-xml-attr>
											<if-src-dn op="in-subtree">\$dirxml.auto.treename$\$idv.dit.data.users$</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lv_Class" scope="policy">
											<arg-string>
												<token-class-name />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="lv_DestinationParentDN" scope="policy">
											<arg-string>
												<token-parse-dn length="-2">
													<token-unmatched-src-dn />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="lv_DestinationParentDN" op="equal" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv_DestinationParentDN" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">\</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-move-dest-object class-name="$lv_Class$" when="after">
											<arg-dn>
												<token-local-variable name="lv_DestinationParentDN" />
											</arg-dn>
										</do-move-dest-object>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="case" op="equal">move</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-veto />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-break />
									</actions>
								</rule>
							