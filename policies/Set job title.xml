<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set job title</description>
									<conditions>
										<and>
											<if-local-variable name="title" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="regex" name="title" op="equal">.+</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-src-attr-value name="Title">
													<arg-value type="string">
														<token-local-variable name="title" />
													</arg-value>
												</do-set-src-attr-value>
											</arg-actions>
											<arg-actions>
												<do-clear-src-attr-value name="Title" />
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							