<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Photo Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDPhoto</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="gvPhotoPlacementContainer" op="not-equal">Custom</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="gvPhotoPlacementContainer" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDPhoto:wd-photoID" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-set-local-variable name="LV-PhotoID" scope="policy">
											<arg-string>
												<token-op-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDPhoto:wd-photoID" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="LV-wd-WorkerIDType-short" scope="policy">
											<arg-string>
												<token-xpath expression="substring-after($LV-PhotoID,'-')" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="LV-WorkforceID" scope="policy">
											<arg-string>
												<token-xpath expression="substring-before($LV-PhotoID,'-')" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="LV-wd-WorkerIDType-short" op="equal">E</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="association" scope="policy">
													<arg-string>
														<token-local-variable name="LV-WorkforceID" />
														<token-text xml:space="preserve">-</token-text>
														<token-text xml:space="preserve">Employee_ID</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="association" scope="policy">
													<arg-string>
														<token-local-variable name="LV-WorkforceID" />
														<token-text xml:space="preserve">-</token-text>
														<token-text xml:space="preserve">Contingent_Worker_ID</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-association op="not-available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-association>
													<arg-association>
														<token-local-variable name="association" />
													</arg-association>
												</do-set-op-association>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							