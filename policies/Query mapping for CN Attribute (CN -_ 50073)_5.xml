<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Query mapping for CN Attribute (CN -&gt; 50073)</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">query</if-operation>
											<if-class-name op="available" />
										</and>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="50073" src-name="CN" />
										<do-rename-op-attr dest-name="id" src-name="src-dn" />
									</actions>
								</rule>
								