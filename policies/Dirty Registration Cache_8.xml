<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Dirty Registration Cache</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.registration.msgw.register" op="equal">true</if-global-variable>
											<if-class-name mode="nocase" op="equal">DirXML-Driver</if-class-name>
											<if-src-dn op="equal">$msgw-driver-slash-dn$</if-src-dn>
										</and>
										<and>
											<if-global-variable mode="nocase" name="drv.registration.msgw.register" op="equal">true</if-global-variable>
											<if-class-name mode="nocase" op="equal">DirXML-Driver</if-class-name>
											<if-src-dn op="equal">$dirxml.auto.driverdn$</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="regnCacheInitialized" scope="driver">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">Detected changes that require refreshing the registration cache. Dirtying REGN__CACHE.</token-text>
											</arg-string>
										</do-trace-message>
									</actions>
								</rule>
								