<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Convert Modify username to Rename operation</description>
									<comment xml:space="preserve">Convert Modify username to Rename operation</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-rename-dest-object class-name="User">
											<arg-string>
												<token-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName" />
											</arg-string>
										</do-rename-dest-object>
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName" />
									</actions>
								</rule>
							