<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>VetoDeltaObjects</description>
									<comment xml:space="preserve">Veto unwanted delta object events </comment>
									<conditions>
										<and>
											<if-class-name op="equal">WDDeltaObjectEntry</if-class-name>
											<if-operation op="not-equal">add</if-operation>
										</and>
										<and>
											<if-class-name op="equal">WDDeltaObjectEntry</if-class-name>
											<if-operation op="equal">add</if-operation>
											<if-global-variable name="drv.wd.bp.prefetchdays" op="not-equal">-1</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							