<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check GCV for gidNumber Synchronization</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="sync-gid-group-membership" op="equal">false</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="./add-attr[@attr-name=&quot;gidNumber&quot;]/value/@association-ref" />
										<do-strip-xpath expression="./modify-attr[@attr-name=&quot;gidNumber&quot;]/add-value/value/@association-ref" />
										<do-strip-xpath expression="./modify-attr[@attr-name=&quot;gidNumber&quot;]/remove-value/@association-ref" />
										<do-strip-xpath expression="./attr[@attr-name=&quot;gidNumber&quot;]/value/@association-ref" />
										<do-break />
									</actions>
								</rule>
								