<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Primary connection</description>
									<comment xml:space="preserve">The driver object becomes available for queries only after the publisher channel has started. So only proceed after the driver object is available.</comment>
									<conditions />
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">primConnString=</token-text>
												<token-local-variable name="primConnString" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable name="shimConfigInfo" op="not-available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="shimConfigInfo" scope="driver">
													<arg-node-set>
														<token-document>
															<arg-string>
																<token-text xml:space="preserve">vnd.nds.stream:</token-text>
																<token-text xml:space="preserve">/</token-text>
																<token-parse-dn dest-dn-delims="00,/+=*\" dest-dn-format="custom" src-dn-format="slash">
																	<token-global-variable name="dirxml.auto.driverdn" />
																</token-parse-dn>
																<token-text xml:space="preserve">#</token-text>
																<token-text xml:space="preserve">DirXML-ShimConfigInfo</token-text>
															</arg-string>
														</token-document>
													</arg-node-set>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="primLogonID" scope="policy">
											<arg-string>
												<token-src-attr name="DirXML-ShimAuthID">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-dn>
												</token-src-attr>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">primLogonID=</token-text>
												<token-local-variable name="primLogonID" />
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="primSystemNumber" scope="policy">
											<arg-string>
												<token-xpath expression="$shimConfigInfo/driver-config/driver-options/configuration-values/definitions/definition[@name='nsap-cs-type']/value" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">primSystemNumber=</token-text>
												<token-local-variable name="primSystemNumber" />
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="primClientNumber" scope="policy">
											<arg-string>
												<token-xpath expression="$shimConfigInfo/driver-config/driver-options/configuration-values/definitions/definition[@name='nsap-user-client']/value" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">primClientNumber=</token-text>
												<token-local-variable name="primClientNumber" />
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="primLangCode" scope="policy">
											<arg-string>
												<token-xpath expression="$shimConfigInfo/driver-config/driver-options/configuration-values/definitions/definition[@name='nsap-user-lang']/value" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">primLangCode=</token-text>
												<token-local-variable name="primLangCode" />
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="primAvailableLanguageCodes" scope="policy">
											<arg-node-set>
												<token-xpath expression="$shimConfigInfo/driver-config/driver-options/configuration-values/definitions/definition[@name='nsap-availableLanguageCodes']/value/item" />
											</arg-node-set>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">additional available language codes:</token-text>
											</arg-string>
										</do-trace-message>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$primAvailableLanguageCodes[./text()!=$primLangCode]" />
											</arg-node-set>
											<arg-actions>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">- </token-text>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-trace-message>
											</arg-actions>
										</do-for-each>
										<do-set-local-variable name="primLogicalSystemName" scope="driver">
											<arg-string>
												<token-xpath expression="$shimConfigInfo/driver-config/driver-options/configuration-values/definitions/definition[@name='nsap-ls-name']/value" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">primLogicalSystemName=</token-text>
												<token-local-variable name="primLogicalSystemName" />
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="xml" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;entitlement-configuration driver-type="SAPUM" min-driver-version="3.6.0"&gt;
	&lt;entitlements/&gt;
	&lt;connections/&gt;
&lt;/entitlement-configuration&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-xml-attr expression="$xml/entitlement-configuration" name="modified">
											<arg-string>
												<token-time format="yyyyMMddhhmmss" tz="UTC" />
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="$xml/entitlement-configuration/connections" name="connection" />
										<do-set-xml-attr expression="$xml/entitlement-configuration/connections/connection[last()]" name="name">
											<arg-string>
												<token-local-variable name="primLogicalSystemName" />
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]" name="query-attr" />
										<do-set-xml-attr expression="$xml/entitlement-configuration/connections/connection[last()]/query-attr[last()]" name="name">
											<arg-string>
												<token-text xml:space="preserve">dest-dn</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-text expression="$xml/entitlement-configuration/connections/connection[last()]/query-attr[last()]">
											<arg-string>
												<token-text xml:space="preserve">\</token-text>
												<token-local-variable name="primLogicalSystemName" />
											</arg-string>
										</do-append-xml-text>
										<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]" name="query-instance" />
										<do-set-xml-attr expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]" name="langCode">
											<arg-string>
												<token-local-variable name="primLangCode" />
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]" name="query-xml" />
										<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]/query-xml[last()]" name="search-attr" />
										<do-set-xml-attr expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]/query-xml[last()]/search-attr[last()]" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">LANGCODE</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]/query-xml[last()]/search-attr[last()]" name="value" />
										<do-append-xml-text expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]/query-xml[last()]/search-attr[last()]/value[last()]">
											<arg-string>
												<token-local-variable name="primLangCode" />
											</arg-string>
										</do-append-xml-text>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$primAvailableLanguageCodes[./text()!=$primLangCode]" />
											</arg-node-set>
											<arg-actions>
												<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]" name="query-instance" />
												<do-set-xml-attr expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]" name="langCode">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]" name="query-xml" />
												<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]/query-xml[last()]" name="search-attr" />
												<do-set-xml-attr expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]/query-xml[last()]/search-attr[last()]" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">LANGCODE</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]/query-xml[last()]/search-attr[last()]" name="value" />
												<do-append-xml-text expression="$xml/entitlement-configuration/connections/connection[last()]/query-instance[last()]/query-xml[last()]/search-attr[last()]/value[last()]">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-append-xml-text>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								