<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>If associations are automatic, or application cannot be queried, then do not match</description>
									<conditions>
										<or>
											<if-global-variable name="auto-associate" op="equal">true</if-global-variable>
											<if-global-variable name="app-query" op="equal">false</if-global-variable>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								