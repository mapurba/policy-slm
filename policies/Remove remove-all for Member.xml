<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove remove-all for Member</description>
									<conditions>
										<and>
											<if-operation op="equal">modify</if-operation>
											<if-xpath op="true">modify-attr[@attr-name='Member']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="modify-attr[@attr-name='Member']/remove-all-values" />
									</actions>
								</rule>
								