<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Class - Perform Operations on MS Gateway Queries</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">instance</if-operation>
											<if-class-name mode="regex" op="equal">direct.view_usr|indirect.usr</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="fk_mbr_of" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="./attr[@attr-name='fk_mbr_of']/value" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="var-association" scope="policy">
															<arg-string>
																<token-replace-all regex="," replace-with="|">
																	<token-xpath expression="$current-node/text()" />
																</token-replace-all>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-idg" scope="policy">
															<arg-string>
																<token-xpath expression="es:getParamValue($var-association,'PK_IDG')" />
															</arg-string>
														</do-set-local-variable>
														<do-strip-xpath expression="$current-node/text()" />
														<do-strip-xpath expression="$current-node/@association-ref" />
														<do-set-xml-attr expression="$current-node" name="type">
															<arg-string>
																<token-text>integer</token-text>
															</arg-string>
														</do-set-xml-attr>
														<do-append-xml-text expression="$current-node">
															<arg-string>
																<token-local-variable name="var-idg" />
															</arg-string>
														</do-append-xml-text>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="usr_mbr_of.idg" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="./attr[@attr-name='usr_mbr_of.idg']/value" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="var-association" scope="policy">
															<arg-string>
																<token-replace-all regex="," replace-with="|">
																	<token-xpath expression="$current-node/text()" />
																</token-replace-all>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-idg" scope="policy">
															<arg-string>
																<token-xpath expression="es:getParamValue($var-association,'IDG')" />
															</arg-string>
														</do-set-local-variable>
														<do-strip-xpath expression="$current-node/text()" />
														<do-strip-xpath expression="$current-node/@association-ref" />
														<do-set-xml-attr expression="$current-node" name="type">
															<arg-string>
																<token-text>integer</token-text>
															</arg-string>
														</do-set-xml-attr>
														<do-append-xml-text expression="$current-node">
															<arg-string>
																<token-local-variable name="var-idg" />
															</arg-string>
														</do-append-xml-text>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							