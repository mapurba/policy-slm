<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>match users based on epic id</description>
									<comment xml:space="preserve">Match user on Epic ID attribute set in GCV</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="regex" name="pdsempdcfg.epicid.attr" op="equal">.+</if-global-variable>
											<if-src-attr mode="regex" name="~pdsempdcfg.epicid.attr~" op="equal">.+</if-src-attr>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="~pdsempdcfg.epicid.attr~" />
										</do-find-matching-object>
									</actions>
								</rule>
								