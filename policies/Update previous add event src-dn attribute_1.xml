<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update previous add event src-dn attribute</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="prevAddSrcdn" scope="driver">
											<arg-string>
												<token-src-dn />
											</arg-string>
										</do-set-local-variable>
										<do-break />
									</actions>
								</rule>
								