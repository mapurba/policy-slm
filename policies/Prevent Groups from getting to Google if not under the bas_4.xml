<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Prevent Groups from getting to Google if not under the base container</description>
									<conditions>
										<and>
											<if-src-dn op="not-in-subtree">\$dirxml.auto.treename$\$idv.dit.data.groups$</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								