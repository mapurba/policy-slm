<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Restore operation-data if not available</description>
									<conditions>
										<and>
											<if-xpath op="true">driver-operation-data</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">operation-data</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-clone-xpath dest-expression="." src-expression="driver-operation-data/operation-data" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-strip-xpath expression="driver-operation-data" />
									</actions>
								</rule>
								