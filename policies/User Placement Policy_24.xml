<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="gvUserPlacementContainer" op="not-equal">Custom</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="gvUserPlacementContainer" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="CN" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							