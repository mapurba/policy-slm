<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Do a set on password if necessary. (using entitlements)</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="sapnewpassword" notrace="true">
											<arg-value>
												<token-attr name="nspmDistributionPassword" />
											</arg-value>
										</do-add-dest-attr-value>
										<do-set-xml-attr expression="add-attr[@attr-name='sapnewpassword']" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-set-local-variable name="generatedPassword" notrace="true" scope="driver">
											<arg-string>
												<token-xpath expression="es:createPassword4(8, 4, 4)" />
											</arg-string>
										</do-set-local-variable>
										<do-set-dest-password class-name="User" notrace="true">
											<arg-string>
												<token-local-variable name="generatedPassword" />
											</arg-string>
										</do-set-dest-password>
										<do-add-dest-attr-value name="sapoldpassword" notrace="true">
											<arg-value>
												<token-local-variable name="generatedPassword" />
											</arg-value>
										</do-add-dest-attr-value>
										<do-set-xml-attr expression="add-attr[@attr-name='sapoldpassword']" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-strip-op-attr name="password" notrace="true" />
										<do-strip-op-attr name="nspmDistributionPassword" notrace="true" />
										<do-break />
									</actions>
								</rule>
							