<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform facsimileTelephoneNumber (Facsimile Telephone Number) from structured to string</description>
									<conditions />
									<actions>
										<do-reformat-op-attr name="facsimileTelephoneNumber">
											<arg-value type="string">
												<token-xpath expression="$current-value/component[@name='faxNumber']" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							