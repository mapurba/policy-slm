<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add UserComplexName as Destination Attribute</description>
									<comment xml:space="preserve">Update UserComplexName if the name values are changing</comment>
									<comment name="author" xml:space="preserve">Converge</comment>
									<comment name="version" xml:space="preserve">1.0</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-local-variable mode="nocase" name="lv-updateName" op="equal">true</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$ln-user-attributes//attr" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="lv-current-idv-class-name" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">User</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-current-idv-attr-name" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/@attr-name" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-current-app-attr-name" scope="policy">
													<arg-string>
														<token-xpath expression="$ln-epic-schema-mapping//attr-name-map/attr-name[nds-name/text()=$lv-current-idv-attr-name]/app-name/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-current-attr-value" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/value/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-function-name" scope="policy">
													<arg-string>
														<token-text>PersonName_set</token-text>
														<token-local-variable name="lv-current-app-attr-name" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lo-PersonName" scope="policy">
													<arg-object>
														<token-xpath expression="es:route_function($lv-function-name, $lo-PersonName, $lv-current-attr-value)" />
													</arg-object>
												</do-set-local-variable>
											</arg-actions>
										</do-for-each>
										<do-set-local-variable name="lv-UserComplexName" scope="policy">
											<arg-string>
												<token-xpath expression="es:PersonName_jsonify($lo-PersonName)" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="lv-UserComplexName" op="not-equal">{}</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-dest-attr-value class-name="User" name="UserComplexName">
													<arg-value type="string">
														<token-xpath expression="$lv-UserComplexName" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							