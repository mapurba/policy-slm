<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add User E-Mail: Create User E-Mail Box</description>
									<conditions>
										<and>
											<if-global-variable name="account.email" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="create-mail">
											<arg-string>
												<token-global-variable name="account.email" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								