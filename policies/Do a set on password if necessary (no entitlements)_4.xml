<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Do a set on password if necessary (no entitlements)</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-global-variable name="drv.entitlement.UserAccount" op="not-available" />
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:nspmDistributionPassword" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="generatedPassword" notrace="true" scope="driver">
											<arg-string>
												<token-xpath expression="es:createPassword4(8, 4, 4)" />
											</arg-string>
										</do-set-local-variable>
										<do-set-dest-password class-name="User" notrace="true">
											<arg-string>
												<token-local-variable name="generatedPassword" />
											</arg-string>
										</do-set-dest-password>
										<do-trace-message notrace="true">
											<arg-string>
												<token-password />
											</arg-string>
										</do-trace-message>
										<do-break />
									</actions>
								</rule>
								