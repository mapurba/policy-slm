<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Report on retry status</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
											<if-xml-attr name="return-code" op="available" />
											<if-xpath op="true">contains(@event-id, '#retry-')</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="level" scope="policy">
											<arg-string>
												<token-xpath expression="@level" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="rc" scope="policy">
											<arg-string>
												<token-xpath expression="@return-code" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="eventid" scope="policy">
											<arg-string>
												<token-xpath expression="substring-after(substring-after(@event-id, '#retry-'), '#')" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="retry" scope="policy">
											<arg-string>
												<token-xpath expression="substring-before(substring-after(@event-id, '#retry-'), '#')" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">DCS Ret Code Handler: </token-text>
												<token-text xml:space="preserve">Final status of event '</token-text>
												<token-local-variable name="eventid" />
												<token-text xml:space="preserve">' after </token-text>
												<token-local-variable name="retry" />
												<token-text xml:space="preserve"> retries: '</token-text>
												<token-local-variable name="level" />
												<token-text xml:space="preserve">' with return code: '</token-text>
												<token-local-variable name="rc" />
												<token-text xml:space="preserve">'.</token-text>
											</arg-string>
										</do-trace-message>
										<do-status level="success">
											<arg-string>
												<token-text xml:space="preserve">Final status of event '</token-text>
												<token-local-variable name="eventid" />
												<token-text xml:space="preserve">' after </token-text>
												<token-local-variable name="retry" />
												<token-text xml:space="preserve"> retries: '</token-text>
												<token-local-variable name="level" />
												<token-text xml:space="preserve">' with return code: '</token-text>
												<token-local-variable name="rc" />
												<token-text xml:space="preserve">'.</token-text>
											</arg-string>
										</do-status>
									</actions>
								</rule>
							