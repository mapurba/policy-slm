<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set SER ID</description>
									<comment xml:space="preserve">Rename "SER ID" to be "Identifier" on queries </comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-op-attr name="1" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="1">
											<arg-value type="string">
												<token-global-variable name="pdsepicsdcfg.serid.attribute.name" />
												<token-text xml:space="preserve">|</token-text>
												<token-upper-case>
													<token-op-attr name="1" />
												</token-upper-case>
											</arg-value>
										</do-reformat-op-attr>
										<do-rename-op-attr dest-name="Identifier" src-name="1" />
									</actions>
								</rule>
							