<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add &lt;remove-all-values&gt; before add-value</description>
									<comment xml:space="preserve">Add &lt;remove-all-values&gt; before add-value</comment>
									<conditions>
										<or>
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</or>
									</conditions>
									<actions>
										<do-strip-xpath expression="modify-attr/remove-all-values" />
										<do-append-xml-element before="add-value" expression="modify-attr" name="remove-all-values" />
										<do-strip-xpath expression="modify-attr/add-value/value[.='']" />
										<do-strip-xpath expression="modify-attr/add-value[.='']" />
									</actions>
								</rule>
								