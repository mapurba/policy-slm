<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-MDADAliasName: Reformat</description>
									<conditions />
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-class-name mode="nocase" op="equal">user</if-class-name>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-xpath expression="*[@attr-name='userPrincipleName']//value[component[@name='volume']!='~dirxml.auto.driverdn~']" />
												<do-reformat-op-attr name="userPrincipalName">
													<arg-value type="string">
														<token-xpath expression="$current-value/component[@name=&quot;path&quot;]/text()" />
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-class-name mode="nocase" op="equal">group</if-class-name>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-xpath expression="*[@attr-name='sAMAccountName']//value[component[@name='volume']!='~dirxml.auto.driverdn~']" />
												<do-reformat-op-attr name="sAMAccountName">
													<arg-value type="string">
														<token-xpath expression="$current-value/component[@name=&quot;path&quot;]/text()" />
													</arg-value>
												</do-reformat-op-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							