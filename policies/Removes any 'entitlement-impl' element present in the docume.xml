<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Removes any 'entitlement-impl' element present in the document</description>
									<conditions>
										<and>
											<if-xpath op="true">operation-data/entitlement-impl</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="operation-data/entitlement-impl" />
									</actions>
								</rule>
							