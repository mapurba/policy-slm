<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Destination DN for add-association</description>
									<conditions>
										<or>
											<if-operation op="equal">add-association</if-operation>
										</or>
										<or>
											<if-dest-dn op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-local-variable name="SourceDN" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
								