<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Lookup manager of the organization's workforceID</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-sapO</if-class-name>
											<if-op-attr name="DirXML-sapO-R-B-S-012" op="changing" />
										</and>
										<and>
											<if-class-name op="equal">DirXML-sapO</if-class-name>
											<if-operation op="equal">sync</if-operation>
											<if-attr name="DirXML-sapO-R-B-S-012" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="orgMgrWfID" scope="policy">
											<arg-string>
												<token-src-attr class-name="DirXML-sapS" name="DirXML-sapS-R-A-P-008">
													<arg-dn>
														<token-global-variable name="dvr.saphr.driverdn" />
														<token-text xml:space="preserve">\sap\om\s\</token-text>
														<token-attr name="DirXML-sapO-R-B-S-012" />
													</arg-dn>
												</token-src-attr>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								