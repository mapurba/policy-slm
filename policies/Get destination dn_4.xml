<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Get destination dn</description>
									<comment xml:space="preserve">Get the destination dn of current query</comment>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">query|query-ex</if-operation>
											<if-xml-attr mode="regex" name="event-id" op="equal">^(ENTITLEMENT).*$</if-xml-attr>
										</and>
										<and>
											<if-operation mode="regex" op="equal">query|query-ex</if-operation>
											<if-xml-attr mode="regex" name="event-id" op="equal">^(CPRS).*$</if-xml-attr>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="domain_val" scope="driver">
											<arg-string>
												<token-dest-dn />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								