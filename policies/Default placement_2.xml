<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Default placement</description>
									<comment xml:space="preserve">Fanout of add events is done by setting the @dest-dn to /&lt;lsname&gt;/&lt;username&gt;.</comment>
									<conditions>
										<or>
											<if-global-variable name="drv.entitlement.UserAccount" op="not-equal">true</if-global-variable>
											<if-global-variable name="drv.entitlement.UserAccount" op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-text xml:space="preserve">\</token-text>
												<token-text xml:space="preserve">\</token-text>
												<token-upper-case>
													<token-src-name />
												</token-upper-case>
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							