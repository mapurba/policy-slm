<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Exchange Group Properties</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:Group:DirXML-AADObjectType" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="Group" name="Name">
											<arg-value type="string">
												<token-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" />
											</arg-value>
										</do-add-dest-attr-value>
										<do-add-dest-attr-value class-name="Group" name="Alias">
											<arg-value type="string">
												<token-join>
													<token-split delimiter=" ">
														<token-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" />
													</token-split>
												</token-join>
											</arg-value>
										</do-add-dest-attr-value>
										<do-add-dest-attr-value name="Type">
											<arg-value type="string">
												<token-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:Group:DirXML-AADObjectType" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								