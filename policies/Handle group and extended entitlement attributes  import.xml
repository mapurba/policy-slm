<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Handle group and extended entitlement attributes  import</description>
									<comment xml:space="preserve">This policy decorates all “User” migrate into IDV operation  with &lt;read-attr attr-name=”&lt;assigmentAttribute name&gt;”.
The assignment attributes are as specified under  “Other entitlements to be onboarded” gcv.</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">query-ex</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.entitlement.onboarding" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">$current-op//read-attr</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-xpath expression="$current-op//read-attr" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="permAttrs" scope="policy">
											<arg-node-set>
												<token-xpath expression="$perm-map-xml/mapping-table/row/col[last()]/text()" />
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="permAttrs" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="permAttr" scope="policy">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="case" name="permAttr" op="equal">Group Membership</if-local-variable>
															<if-global-variable mode="nocase" name="drv.entitlement.Group.onboard" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-append-xml-element expression="$current-op" name="read-attr" />
														<do-set-xml-attr expression="$current-op/read-attr[last()]" name="attr-name">
															<arg-string>
																<token-text xml:space="preserve">Group Membership</token-text>
															</arg-string>
														</do-set-xml-attr>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="case" name="permAttr" op="not-equal">Group Membership</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-global-variable mode="case" name="drv.entitlement.onboarding.all" op="equal">true</if-global-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-append-xml-element expression="$current-op" name="read-attr" />
																		<do-set-xml-attr expression="$current-op/read-attr[last()]" name="attr-name">
																			<arg-string>
																				<token-local-variable name="permAttr" />
																			</arg-string>
																		</do-set-xml-attr>
																	</arg-actions>
																	<arg-actions>
																		<do-for-each>
																			<arg-node-set>
																				<token-global-variable name="drv.entitlement.onboardEnt" />
																			</arg-node-set>
																			<arg-actions>
																				<do-set-local-variable name="givenAttr" scope="policy">
																					<arg-string>
																						<token-xpath expression="$current-node/definition[@name=&quot;drv.entitlement.entName&quot;]/value/text()" />
																					</arg-string>
																				</do-set-local-variable>
																				<do-if>
																					<arg-conditions>
																						<and>
																							<if-local-variable mode="nocase" name="permAttr" op="equal">$givenAttr$</if-local-variable>
																						</and>
																					</arg-conditions>
																					<arg-actions>
																						<do-append-xml-element expression="$current-op" name="read-attr" />
																						<do-set-xml-attr expression="$current-op/read-attr[last()]" name="attr-name">
																							<arg-string>
																								<token-local-variable name="permAttr" />
																							</arg-string>
																						</do-set-xml-attr>
																					</arg-actions>
																					<arg-actions />
																				</do-if>
																			</arg-actions>
																		</do-for-each>
																	</arg-actions>
																</do-if>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-if>
												<do-set-xml-attr disabled="true" expression="$current-op/read-attr[last()]" name="attr-name">
													<arg-string>
														<token-local-variable name="permAttr" />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							