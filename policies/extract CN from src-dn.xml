<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>extract CN from src-dn</description>
									<conditions>
										<and>
											<if-class-name mode="regex" op="equal">User|Group</if-class-name>
											<if-operation mode="regex" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="CNValue" scope="policy">
											<arg-string>
												<token-parse-dn dest-dn-format="dest-dn" length="1" start="-1">
													<token-src-dn />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
										<do-strip-op-attr name="CN" />
										<do-add-dest-attr-value name="CN">
											<arg-value type="string">
												<token-local-variable name="CNValue" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							