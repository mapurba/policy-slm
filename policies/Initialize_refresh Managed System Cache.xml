<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initialize/refresh Managed System Cache</description>
									<conditions />
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable name="msysCacheInitialized" op="available" />
													<if-local-variable mode="nocase" name="msysCacheInitialized" op="not-equal">true</if-local-variable>
													<if-xpath op="true">number($msysCacheInitialized)!='NaN'</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="reqID" scope="policy">
													<arg-string>
														<token-local-variable name="msysCacheInitialized" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="query-ms-across-ds" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="ms" scope="policy">
													<arg-node-set>
														<token-query class-name="DirXML-GlobalConfigDef" datastore="dest">
															<arg-match-attr name="CN">
																<arg-value>
																	<token-text xml:space="preserve">MSysInfo</token-text>
																</arg-value>
															</arg-match-attr>
															<arg-string>
																<token-text xml:space="preserve">DirXML-ConfigValues</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="ms" scope="policy">
													<arg-node-set>
														<token-query class-name="DirXML-GlobalConfigDef" datastore="dest">
															<arg-dn>
																<token-parse-dn dest-dn-format="slash" length="-2" src-dn-format="slash">
																	<token-global-variable name="dirxml.auto.driverdn" />
																</token-parse-dn>
															</arg-dn>
															<arg-match-attr name="CN">
																<arg-value>
																	<token-text xml:space="preserve">MSysInfo</token-text>
																</arg-value>
															</arg-match-attr>
															<arg-string>
																<token-text xml:space="preserve">DirXML-ConfigValues</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="MSYS__CACHE" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;cache/&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="ms" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="ms-ldap-dn" scope="policy">
													<arg-node-set>
														<token-lower-case>
															<token-parse-dn dest-dn-format="ldap" length="-2">
																<token-xpath expression="$current-node/@qualified-src-dn" />
															</token-parse-dn>
														</token-lower-case>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="driverDn" scope="policy">
													<arg-string>
														<token-parse-dn dest-dn-format="dest-dn" length="-2" src-dn-format="dest-dn">
															<token-xpath expression="$current-node/@src-dn" />
														</token-parse-dn>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="driver" scope="policy">
													<arg-node-set>
														<token-query scope="entry">
															<arg-dn>
																<token-local-variable name="driverDn" />
															</arg-dn>
															<arg-string>
																<token-text xml:space="preserve">GUID</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">DirXML-ApplicationSchema</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="driverGuid" scope="policy">
													<arg-string>
														<token-xpath expression="es:guid2string($driver/attr[@attr-name='GUID']/value/text())" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">string-length($current-node/attr[@attr-name='DirXML-ConfigValues']/value/text())&gt;0</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="gcvdef" scope="policy">
															<arg-node-set>
																<token-xml-parse>
																	<token-base64-decode>
																		<token-xpath expression="$current-node/attr[@attr-name='DirXML-ConfigValues']/value/text()" />
																	</token-base64-decode>
																</token-xml-parse>
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="msId" scope="policy">
															<arg-string>
																<token-xpath expression="$gcvdef//definition[@name='msysinfo.drv.ms.id']/value/text()" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="msName" scope="policy">
															<arg-string>
																<token-xpath expression="$gcvdef//definition[@name='msysinfo.drv.ms.name']/value/text()" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="regex" name="msId" op="equal">.+</if-local-variable>
																	<if-local-variable mode="regex" name="msName" op="equal">.+</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-trace-message>
																	<arg-string>
																		<token-text xml:space="preserve">MSys Cache: </token-text>
																		<token-text xml:space="preserve">Found Managed System: '</token-text>
																		<token-local-variable name="msName" />
																		<token-text xml:space="preserve">' with ID '</token-text>
																		<token-local-variable name="msId" />
																		<token-text xml:space="preserve">' for driver '</token-text>
																		<token-local-variable name="driverDn" />
																		<token-text xml:space="preserve">' with driver GUID: '</token-text>
																		<token-local-variable name="driverGuid" />
																		<token-text xml:space="preserve">'.</token-text>
																	</arg-string>
																</do-trace-message>
																<do-set-local-variable name="appSchema" notrace="true" scope="policy">
																	<arg-node-set>
																		<token-xml-parse>
																			<token-base64-decode>
																				<token-xpath expression="$driver/attr[@attr-name='DirXML-ApplicationSchema']/value/text()" />
																			</token-base64-decode>
																		</token-xml-parse>
																	</arg-node-set>
																</do-set-local-variable>
																<do-set-local-variable name="hierarchical" scope="policy">
																	<arg-string>
																		<token-xpath expression="$appSchema/schema-def/@hierarchical" />
																	</arg-string>
																</do-set-local-variable>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="regex" name="hierarchical" op="not-equal">true|false</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="hierarchical" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">false</token-text>
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions />
																</do-if>
																<do-set-local-variable name="appSchema" scope="policy">
																	<arg-string />
																</do-set-local-variable>
																<do-append-xml-element expression="$MSYS__CACHE/cache" name="instance" />
																<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]" name="class-name">
																	<arg-string>
																		<token-text xml:space="preserve">MANAGED_SYSTEM_INFORMATION</token-text>
																	</arg-string>
																</do-set-xml-attr>
																<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]" name="src-dn">
																	<arg-string>
																		<token-local-variable name="ms-ldap-dn" />
																	</arg-string>
																</do-set-xml-attr>
																<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]" name="logical-instance">
																	<arg-string>
																		<token-text xml:space="preserve">false</token-text>
																	</arg-string>
																</do-set-xml-attr>
																<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]" name="attr" />
																<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
																	<arg-string>
																		<token-text xml:space="preserve">msysinfo.dyn.ms.driverGuid</token-text>
																	</arg-string>
																</do-set-xml-attr>
																<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="value" />
																<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]" name="type">
																	<arg-string>
																		<token-text xml:space="preserve">string</token-text>
																	</arg-string>
																</do-set-xml-attr>
																<do-append-xml-text expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]">
																	<arg-string>
																		<token-local-variable name="driverGuid" />
																	</arg-string>
																</do-append-xml-text>
																<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]" name="attr" />
																<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
																	<arg-string>
																		<token-text xml:space="preserve">msysinfo.dyn.ms.hierarchical</token-text>
																	</arg-string>
																</do-set-xml-attr>
																<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="value" />
																<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]" name="type">
																	<arg-string>
																		<token-text xml:space="preserve">state</token-text>
																	</arg-string>
																</do-set-xml-attr>
																<do-append-xml-text expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]">
																	<arg-string>
																		<token-local-variable name="hierarchical" />
																	</arg-string>
																</do-append-xml-text>
																<do-for-each>
																	<arg-node-set>
																		<token-xpath expression="$gcvdef//definition[@name!='msysinfo.drv.ms.logicalInstances' and starts-with(@name, 'msysinfo.drv.ms.')]" />
																	</arg-node-set>
																	<arg-actions>
																		<do-trace-message disabled="true">
																			<arg-string>
																				<token-text xml:space="preserve">MSys Cache: </token-text>
																				<token-text xml:space="preserve">   - ms attr: </token-text>
																				<token-xpath expression="$current-node/@name" />
																				<token-text xml:space="preserve">=</token-text>
																				<token-xpath expression="$current-node/value/text()" />
																			</arg-string>
																		</do-trace-message>
																		<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]" name="attr" />
																		<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
																			<arg-string>
																				<token-xpath expression="$current-node/@name" />
																			</arg-string>
																		</do-set-xml-attr>
																		<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="value" />
																		<do-set-local-variable name="type" scope="policy">
																			<arg-string>
																				<token-map default-value="string" dest="IDM_TYPE" src="GCV_TYPE" table="NOVLMSGWMSYS-GCV_TO_IDM_TYPE">
																					<token-xpath expression="$current-node/@type" />
																				</token-map>
																			</arg-string>
																		</do-set-local-variable>
																		<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]" name="type">
																			<arg-string>
																				<token-local-variable name="type" />
																			</arg-string>
																		</do-set-xml-attr>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-local-variable mode="nocase" name="type" op="equal">dn</if-local-variable>
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-append-xml-text expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]">
																					<arg-string>
																						<token-lower-case>
																							<token-xpath expression="$current-node/value/text()" />
																						</token-lower-case>
																					</arg-string>
																				</do-append-xml-text>
																			</arg-actions>
																			<arg-actions>
																				<do-append-xml-text expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]">
																					<arg-string>
																						<token-xpath expression="$current-node/value/text()" />
																					</arg-string>
																				</do-append-xml-text>
																			</arg-actions>
																		</do-if>
																	</arg-actions>
																</do-for-each>
																<do-for-each>
																	<arg-node-set>
																		<token-xpath expression="$gcvdef//definition[@name='msysinfo.drv.ms.logicalInstances']/value/instance" />
																	</arg-node-set>
																	<arg-actions>
																		<do-set-local-variable name="lsId" scope="policy">
																			<arg-string>
																				<token-xpath expression="$current-node//definition[@name='id']/value/text()" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-set-local-variable name="lsName" scope="policy">
																			<arg-string>
																				<token-xpath expression="$current-node//definition[@name='name']/value/text()" />
																			</arg-string>
																		</do-set-local-variable>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-local-variable mode="regex" name="lsId" op="equal">.+</if-local-variable>
																					<if-local-variable mode="regex" name="lsName" op="equal">.+</if-local-variable>
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-trace-message>
																					<arg-string>
																						<token-text xml:space="preserve">MSys Cache: </token-text>
																						<token-text xml:space="preserve">Found Logical System: '</token-text>
																						<token-local-variable name="lsName" />
																						<token-text xml:space="preserve">' with ID '</token-text>
																						<token-local-variable name="lsId" />
																						<token-text xml:space="preserve">' for driver '</token-text>
																						<token-local-variable name="driverDn" />
																						<token-text xml:space="preserve">' with driver GUID: '</token-text>
																						<token-local-variable name="driverGuid" />
																						<token-text xml:space="preserve">'.</token-text>
																					</arg-string>
																				</do-trace-message>
																				<do-append-xml-element expression="$MSYS__CACHE/cache" name="instance" />
																				<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]" name="class-name">
																					<arg-string>
																						<token-text xml:space="preserve">MANAGED_SYSTEM_INFORMATION</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]" name="src-dn">
																					<arg-string>
																						<token-local-variable name="ms-ldap-dn" />
																					</arg-string>
																				</do-set-xml-attr>
																				<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]" name="logical-instance">
																					<arg-string>
																						<token-text xml:space="preserve">true</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]" name="attr" />
																				<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
																					<arg-string>
																						<token-text xml:space="preserve">msysinfo.dyn.ms.driverGuid</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="value" />
																				<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]" name="type">
																					<arg-string>
																						<token-text xml:space="preserve">string</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-append-xml-text expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]">
																					<arg-string>
																						<token-local-variable name="driverGuid" />
																					</arg-string>
																				</do-append-xml-text>
																				<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]" name="attr" />
																				<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
																					<arg-string>
																						<token-text xml:space="preserve">msysinfo.dyn.ms.hierarchical</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="value" />
																				<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]" name="type">
																					<arg-string>
																						<token-text xml:space="preserve">state</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-append-xml-text expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]">
																					<arg-string>
																						<token-local-variable name="hierarchical" />
																					</arg-string>
																				</do-append-xml-text>
																				<do-for-each>
																					<arg-node-set>
																						<token-xpath expression="$current-node//definition" />
																					</arg-node-set>
																					<arg-actions>
																						<do-trace-message disabled="true">
																							<arg-string>
																								<token-text xml:space="preserve">MSys Cache: </token-text>
																								<token-text xml:space="preserve">   - ls attr: </token-text>
																								<token-xpath expression="$current-node/@name" />
																								<token-text xml:space="preserve">=</token-text>
																								<token-xpath expression="$current-node/value/text()" />
																							</arg-string>
																						</do-trace-message>
																						<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]" name="attr" />
																						<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
																							<arg-string>
																								<token-text xml:space="preserve">msysinfo.drv.ms.</token-text>
																								<token-xpath expression="$current-node/@name" />
																							</arg-string>
																						</do-set-xml-attr>
																						<do-append-xml-element expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]" name="value" />
																						<do-set-local-variable name="type" scope="policy">
																							<arg-string>
																								<token-map default-value="string" dest="IDM_TYPE" src="GCV_TYPE" table="NOVLMSGWMSYS-GCV_TO_IDM_TYPE">
																									<token-xpath expression="$current-node/@type" />
																								</token-map>
																							</arg-string>
																						</do-set-local-variable>
																						<do-set-xml-attr expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]" name="type">
																							<arg-string>
																								<token-local-variable name="type" />
																							</arg-string>
																						</do-set-xml-attr>
																						<do-if>
																							<arg-conditions>
																								<and>
																									<if-local-variable mode="nocase" name="type" op="equal">dn</if-local-variable>
																								</and>
																							</arg-conditions>
																							<arg-actions>
																								<do-append-xml-text expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]">
																									<arg-string>
																										<token-lower-case>
																											<token-xpath expression="$current-node/value/text()" />
																										</token-lower-case>
																									</arg-string>
																								</do-append-xml-text>
																							</arg-actions>
																							<arg-actions>
																								<do-append-xml-text expression="$MSYS__CACHE/cache/instance[last()]/attr[last()]/value[last()]">
																									<arg-string>
																										<token-xpath expression="$current-node/value/text()" />
																									</arg-string>
																								</do-append-xml-text>
																							</arg-actions>
																						</do-if>
																					</arg-actions>
																				</do-for-each>
																			</arg-actions>
																			<arg-actions>
																				<do-trace-message>
																					<arg-string>
																						<token-text xml:space="preserve">MSys Cache: </token-text>
																						<token-text xml:space="preserve">Skipped incomplete or corrupt Logical System for driver '</token-text>
																						<token-local-variable name="driverDn" />
																						<token-text xml:space="preserve">' with driver GUID: '</token-text>
																						<token-local-variable name="driverGuid" />
																						<token-text xml:space="preserve">'.</token-text>
																					</arg-string>
																				</do-trace-message>
																			</arg-actions>
																		</do-if>
																	</arg-actions>
