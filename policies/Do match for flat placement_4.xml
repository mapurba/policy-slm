<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Do match for flat placement</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.pubPlacementType" op="equal">flat</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-class-name mode="nocase" op="equal">User</if-class-name>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-find-matching-object scope="subordinates">
													<arg-dn>
														<token-global-variable name="idv.dit.data.users" />
													</arg-dn>
													<arg-match-attr name="Given Name" />
													<arg-match-attr name="Surname" />
												</do-find-matching-object>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-class-name mode="nocase" op="equal">Group</if-class-name>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-find-matching-object scope="entry">
															<arg-dn>
																<token-local-variable name="idmBaseContainer" />
																<token-src-name />
															</arg-dn>
														</do-find-matching-object>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								