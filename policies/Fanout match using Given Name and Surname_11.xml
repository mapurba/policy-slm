<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Fanout match using Given Name and Surname</description>
									<conditions>
										<or>
											<if-class-name op="equal">User</if-class-name>
											<if-op-property name="lsname" op="available" />
										</or>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-dn>
												<token-text xml:space="preserve">\</token-text>
												<token-op-property name="lsname" />
											</arg-dn>
											<arg-match-attr name="Surname" />
											<arg-match-attr name="Given Name" />
										</do-find-matching-object>
									</actions>
								</rule>
							