<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User: Multiple Provider Addresses</description>
									<comment xml:space="preserve">Setup the update when the driver is configured for multiple addresses for providers</comment>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="pdsepicsdcfg.address.type" op="equal">Multiple</if-global-variable>
										</or>
										<or>
											<if-op-attr name="~pdsepicsdcfg.address.multiple.attr~" op="available" />
											<if-xpath op="true">@from-merge='true'</if-xpath>
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="lv-providerAddress" scope="policy">
											<arg-node-set>
												<token-src-attr name="~pdsepicsdcfg.address.multiple.attr~" />
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
								