<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Dirty Driver Cache</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">NCP Server</if-class-name>
											<if-src-dn op="equal">$localserverdn$</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="srvrCacheInitialized" scope="driver">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">Detected changes that require refreshing the server cache. Dirtying SRVR__CACHE.</token-text>
											</arg-string>
										</do-trace-message>
									</actions>
								</rule>
							