<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Email Address Variable to Match Against</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-entitlement name="NOVLGGLEUSER-Account" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-entitlement name="NOVLGGLEUSER-Account" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="lv_EmailAddress" scope="policy">
															<arg-string>
																<token-src-name />
																<token-text xml:space="preserve">@</token-text>
																<token-xpath expression="es:getEntParamField($current-node,'ID')" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-attr name="Internet EMail Address" op="available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lv_EmailAddress" scope="policy">
															<arg-string>
																<token-attr name="Internet EMail Address" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="lv-validDomain" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">false</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="lv-domain" scope="policy">
															<arg-string>
																<token-xpath expression="substring-after($lv_EmailAddress,'@')" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<or>
																	<if-local-variable mode="nocase" name="lv-domain" op="equal">$gcv.NOVLGGLEBCFG.domainName$</if-local-variable>
																</or>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="lv-validDomain" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">true</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-set-local-variable name="lv-subDomains" scope="policy">
																	<arg-node-set>
																		<token-split delimiter="%">
																			<token-global-variable name="gcv.NOVLGGLEBCFG.subDomainNames" />
																		</token-split>
																	</arg-node-set>
																</do-set-local-variable>
																<do-for-each>
																	<arg-node-set>
																		<token-local-variable name="lv-subDomains" />
																	</arg-node-set>
																	<arg-actions>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-local-variable mode="nocase" name="lv-domain" op="equal">$current-node$</if-local-variable>
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-set-local-variable name="lv-validDomain" scope="policy">
																					<arg-string>
																						<token-text xml:space="preserve">true</token-text>
																					</arg-string>
																				</do-set-local-variable>
																			</arg-actions>
																			<arg-actions />
																		</do-if>
																	</arg-actions>
																</do-for-each>
															</arg-actions>
														</do-if>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="lv-validDomain" op="not-equal">true</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-trace-message>
																	<arg-string>
																		<token-text xml:space="preserve">User's email domain </token-text>
																		<token-local-variable name="lv-domain" />
																		<token-text xml:space="preserve"> is not valid for this Google driver. Vetoing user event. </token-text>
																	</arg-string>
																</do-trace-message>
																<do-veto />
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="lv_EmailAddress" scope="policy">
															<arg-string>
																<token-src-name />
																<token-text xml:space="preserve">@</token-text>
																<token-global-variable name="gcv.NOVLGGLEBCFG.domainName" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								