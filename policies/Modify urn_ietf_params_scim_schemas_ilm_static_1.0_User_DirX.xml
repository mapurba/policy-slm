<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Modify urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ebsPersonId and urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID during add-association</description>
									<comment xml:space="preserve">Update attribute urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ebsPersonId and urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID with the value generated in Oracle EBS during employee creation.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:DirXML-ebsPersonId">
											<arg-value type="int">
												<token-xpath expression="." />
											</arg-value>
										</do-set-dest-attr-value>
										<do-set-dest-attr-value class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID">
											<arg-value type="string">
												<token-xpath expression="@emp_no" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							