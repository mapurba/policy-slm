<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation-data element to subscribe modify operations (if needed)</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-operation mode="nocase" op="equal">rename</if-operation>
										</or>
										<or>
											<if-xpath op="not-true">string-length(driver-operation-data/WD-WorkerIDType) &gt; 0</if-xpath>
										</or>
										<or>
											<if-association op="available" />
										</or>
									</conditions>
									<actions>
										
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">driver-operation-data</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-element expression="." name="driver-operation-data" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-association mode="regex" op="equal">.*Employee_ID.*|.*Contingent_Worker_ID.*</if-association>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="LV-Association-user" scope="policy">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="LV-WorkforceID-user" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after($LV-Association-user,'-')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="LV-WorkerIDType-user" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before($LV-Association-user,'-')" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="gvWorkersMergeIDV" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-association>
															<arg-association>
																<token-local-variable name="LV-WorkforceID-user" />
															</arg-association>
														</do-set-op-association>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-association mode="nocase" op="equal">$DV-wd-WorkforceID-user$</if-association>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="LV-Association-user" scope="policy">
															<arg-string>
																<token-local-variable name="DV-wd-Association-user" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-WorkerIDType-user" scope="policy">
															<arg-string>
																<token-local-variable name="DV-wd-WorkerIDType-user" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-WorkforceID-user" scope="policy">
															<arg-string>
																<token-local-variable name="DV-wd-WorkforceID-user" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="LV-Association-user" scope="policy">
															<arg-string>
																<token-src-attr class-name="User" name="wd-WorkerIDType" />
																<token-text xml:space="preserve">-</token-text>
																<token-src-attr class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-WorkerIDType-user" scope="policy">
															<arg-string>
																<token-src-attr class-name="User" name="wd-WorkerIDType" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="LV-WorkforceID-user" scope="policy">
															<arg-string>
																<token-src-attr class-name="User" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">driver-operation-data/WD-WorkforceID</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-element expression="driver-operation-data" name="WD-WorkforceID" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">string-length(driver-operation-data/WD-WorkforceID) &gt; 0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-text expression="driver-operation-data/WD-WorkforceID">
													<arg-string>
														<token-local-variable name="LV-WorkforceID-user" />
													</arg-string>
												</do-append-xml-text>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">driver-operation-data/WD-WorkerIDType</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-element expression="driver-operation-data" name="WD-WorkerIDType" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">string-length(driver-operation-data/WD-WorkerIDType) &gt; 0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-text expression="driver-operation-data/WD-WorkerIDType">
													<arg-string>
														<token-local-variable name="LV-WorkerIDType-user" />
													</arg-string>
												</do-append-xml-text>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">driver-operation-data/WD-effectiveDate</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-element expression="driver-operation-data" name="WD-effectiveDate" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">string-length(driver-operation-data/WD-effectiveDate) &gt; 0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-text expression="driver-operation-data/WD-effectiveDate">
													<arg-string>
														<token-time format="yyyy-MM-dd" />
													</arg-string>
												</do-append-xml-text>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">driver-operation-data/WD-ISOCode</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-element expression="driver-operation-data" name="WD-ISOCode" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="not-true">string-length(driver-operation-data/WD-ISOCode) &gt; 0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-text expression="driver-operation-data/WD-ISOCode">
													<arg-string>
														<token-global-variable name="custom.default.country.ISOCode" />
													</arg-string>
												</do-append-xml-text>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-WorkPrimaryPhone" op="changing" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv-WD-ContactNumber" scope="driver">
													<arg-string>
														<token-op-attr name="wd-WorkPrimaryPhone&#13;&#10;" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:wd-HomePrimaryPhone" op="changing" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv-WD-ContactNumber" scope="driver">
													<arg-string>
														<token-op-attr name="wd-HomePrimaryPhone&#13;&#10;" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="regex" name="lv-WD-ContactNumber" op="equal">.+</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv-WD-ContactNumber-ISOCodeTemp" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after($lv-WD-ContactNumber, '+')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv-WD-ContactNumber-ISOCode" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before($lv-WD-ContactNumber-ISOCodeTemp,' (')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="varISOCodeMap" scope="policy">
													<arg-string>
														<token-map dest="ISOCode" src="CountryPrefix" table="lib-ISO3166_CountryPrefix">
															<token-local-variable name="lv-WD-ContactNumber-ISOCode" />
														</token-map>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">$varISOCodeMap != ''</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-strip-xpath expression="driver-operation-data/WD-ISOCode/text()" />
														<do-append-xml-text expression="driver-operation-data/WD-ISOCode">
															<arg-string>
																<token-local-variable name="varISOCodeMap" />
															</arg-string>
														</do-append-xml-text>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							