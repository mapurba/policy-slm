<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Handle 'Fanout Connection Info' Query</description>
									<comment xml:space="preserve">Handle fanout Connection Query</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">query</if-operation>
											<if-class-name mode="nocase" op="equal">FO_CONNECTION_INFO</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="FO_CONN_QRY_RES">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-op-property>
										<do-set-local-variable name="prefName" scope="policy">
											<arg-string>
												<token-xpath expression="read-attr/@attr-name" />
											</arg-string>
										</do-set-local-variable>
										<do-append-xml-element expression="operation-data" name="instance" />
										<do-set-xml-attr expression="operation-data/instance" name="class-name">
											<arg-string>
												<token-xpath expression="@class-name" />
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="operation-data/instance" name="attr" />
										<do-set-xml-attr expression="operation-data/instance/attr" name="attr-name">
											<arg-string>
												<token-local-variable name="prefName" />
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="operation-data/instance/attr" name="value" />
										<do-set-xml-attr expression="operation-data/instance/attr/value" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-text expression="operation-data/instance/attr/value">
											<arg-string>
												<token-named-password name="$prefName$" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
							