<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if this is not a migrate event </description>
									<conditions>
										<or>
											<if-operation op="not-equal">sync</if-operation>
											<if-class-name mode="nocase" op="not-equal">Group</if-class-name>
											<if-xpath op="true">//add</if-xpath>
											<if-association op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								