<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Password Configurations</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-password op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="regex" op="equal">add</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-add-dest-attr-value name="forceChangePasswordNextSignIn">
													<arg-value type="string">
														<token-global-variable name="ForceChangePassword" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-set-xml-attr expression="password" name="forceChangePasswordNextSignIn">
													<arg-string>
														<token-global-variable name="ForceChangePassword" />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="PasswordNeverExpires" op="equal">true</if-global-variable>
													<if-global-variable mode="nocase" name="StrongPasswordRequired" op="equal">false</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-add-dest-attr-value name="passwordPolicies">
													<arg-value type="state">
														<token-text xml:space="preserve">DisablePasswordExpiration, DisableStrongPassword</token-text>
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="PasswordNeverExpires" op="equal">true</if-global-variable>
															<if-global-variable mode="nocase" name="StrongPasswordRequired" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-add-dest-attr-value name="passwordPolicies">
															<arg-value type="string">
																<token-text xml:space="preserve">DisablePasswordExpiration</token-text>
															</arg-value>
														</do-add-dest-attr-value>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-global-variable mode="nocase" name="PasswordNeverExpires" op="equal">false</if-global-variable>
																	<if-global-variable mode="nocase" name="StrongPasswordRequired" op="equal">false</if-global-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-add-dest-attr-value name="passwordPolicies">
																	<arg-value type="string">
																		<token-text xml:space="preserve">DisableStrongPassword</token-text>
																	</arg-value>
																</do-add-dest-attr-value>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							