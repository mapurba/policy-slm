<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Get assigned resources from user object</description>
									<conditions>
										<and>
											<if-local-variable mode="nocase" name="lv-hasNeededData" op="equal">true</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lv-AssignedResources" scope="policy">
											<arg-node-set>
												<token-src-attr name="nrfAssignedResources" />
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
								