<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set variables if rename operation</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.role.rename.option" op="equal">2</if-global-variable>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-op-property mode="regex" name="renOld" op="equal">.+</if-op-property>
											<if-op-property mode="regex" name="renNew" op="equal">.+</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lv.renOld" scope="policy">
											<arg-string>
												<token-op-property name="renOld" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="lv.renNew" scope="policy">
											<arg-string>
												<token-op-property name="renNew" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="lv.rename" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								