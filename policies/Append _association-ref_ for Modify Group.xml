<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Append &lt;association-ref&gt; for Modify Group</description>
									<conditions>
										<or>
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">urn:ietf:params:scim:schemas:core:2.0:Group</if-class-name>
										</or>
										<or>
											<if-xpath op="true">./modify-attr[@attr-name='members:value']</if-xpath>
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="AddValueNode" scope="policy">
											<arg-node-set>
												<token-xpath expression="./modify-attr[@attr-name='members:value']/add-value/value" />
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="AddValueNode" />
											</arg-node-set>
											<arg-actions>
												<do-set-xml-attr expression="$current-node" name="association-ref">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="$current-node" name="type">
													<arg-string>
														<token-text xml:space="preserve">dn</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
										<do-set-local-variable name="RemoveValueNode" scope="policy">
											<arg-node-set>
												<token-xpath expression="./modify-attr[@attr-name='members:value']/remove-value/value" />
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="RemoveValueNode" />
											</arg-node-set>
											<arg-actions>
												<do-set-xml-attr expression="$current-node" name="association-ref">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="$current-node" name="type">
													<arg-string>
														<token-text xml:space="preserve">dn</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								