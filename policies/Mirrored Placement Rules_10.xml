<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Mirrored Placement Rules</description>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.googlePlacementOption" op="equal">mirror</if-global-variable>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-class-name mode="nocase" op="equal">Organizational Unit</if-class-name>
										</or>
										<or>
											<if-src-dn op="in-subtree">\$dirxml.auto.treename$\$idv.dit.data.users$</if-src-dn>
										</or>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-unmatched-src-dn />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
								