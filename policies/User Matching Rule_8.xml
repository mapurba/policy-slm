<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Matching Rule</description>
									<comment xml:space="preserve">eDirectory User object GUID is matched against the LDAPID (50422) of GroupWise User object.</comment>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="50422">
												<arg-value type="string">
													<token-local-variable name="lvAsciGuid" />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="CN" />
										</do-find-matching-object>
									</actions>
								</rule>
								