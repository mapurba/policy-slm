<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Role Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">sapHanaRole</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="dn" scope="policy">
											<arg-string>
												<token-global-variable name="sapHanaRolePlacementContainer" />
												<token-text>\</token-text>
												<token-attr name="CN" />
											</arg-string>
										</do-set-local-variable>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-local-variable name="dn" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							