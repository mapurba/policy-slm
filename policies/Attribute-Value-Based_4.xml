<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Attribute-Value-Based</description>
									<comment xml:space="preserve">The object will be named by the value of the defined attribute.</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.new.user.naming.option" op="equal">3</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="obj-name" scope="policy">
											<arg-string>
												<token-op-attr name="~drv.new.user.naming.attribute~" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								