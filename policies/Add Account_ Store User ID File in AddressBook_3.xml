<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Store User ID File in AddressBook</description>
									<conditions>
										<and>
											<if-global-variable name="account.cert.idinab" op="available" />
											<if-global-variable mode="nocase" name="account.cert.noidfile" op="not-equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="store-useridfile-in-ab">
											<arg-string>
												<token-global-variable name="account.cert.idinab" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								