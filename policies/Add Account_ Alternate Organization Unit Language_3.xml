<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Alternate Organization Unit Language</description>
									<conditions>
										<and>
											<if-global-variable name="account.altorgunitlang" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="alt-org-unit-lang">
											<arg-string>
												<token-global-variable name="account.altorgunitlang" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								