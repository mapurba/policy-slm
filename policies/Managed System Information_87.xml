<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Managed System Information</description>
									<conditions />
									<actions>
										<do-set-local-variable name="msysinfo" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-GlobalConfigDef" scope="entry">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
														<token-text xml:space="preserve">\MSysInfo</token-text>
													</arg-dn>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ConfigValues</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="xml" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-base64-decode>
														<token-xpath expression="$msysinfo//attr[@attr-name='DirXML-ConfigValues']/value/text()" />
													</token-base64-decode>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="driver" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-Driver" scope="entry">
													<arg-dn>
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-dn>
													<arg-string>
														<token-text xml:space="preserve">GUID</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ShimConfigInfo</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ShimAuthID</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">DirXML-ShimAuthServer</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="driverGuid" scope="policy">
											<arg-string>
												<token-xpath expression="es:guid2string($driver//attr[@attr-name='GUID']/value/text())" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.id']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.id']/value">
											<arg-string>
												<token-local-variable name="driverGuid" />
											</arg-string>
										</do-append-xml-text>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.type']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.type']/value">
											<arg-string>
												<token-text xml:space="preserve">Groupwise</token-text>
											</arg-string>
										</do-append-xml-text>
										<do-set-local-variable name="authServer" scope="policy">
											<arg-string>
												<token-xpath expression="$driver//attr[@attr-name='DirXML-ShimAuthServer']/value/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">string-length($authServer)&gt;0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">starts-with($authServer, 'REMOTE(')</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="authServerIP" scope="policy">
															<arg-string>
																<token-xpath expression="substring-after($authServer, ')')&#10;" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">string-length($authServerIP)&gt;0</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="ip" scope="policy">
																	<arg-string>
																		<token-xpath expression="es:getIPFromURL($authServerIP)" />
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="port" scope="policy">
																	<arg-string>
																		<token-xpath expression="es:getPortFromURL($authServerIP)" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-set-local-variable name="ip" scope="policy">
																	<arg-string>
																		<token-xpath expression="substring-before(substring-after($authServer, 'hostname='), ' port')" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="ip" scope="policy">
															<arg-string>
																<token-xpath expression="es:getIPFromURL($authServer)" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="port" scope="policy">
															<arg-string>
																<token-xpath expression="es:getPortFromURL($authServer)" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="grpwServer" scope="policy">
													<arg-node-set>
														<token-query class-name="GroupWise Domain" scope="entry">
															<arg-dn>
																<token-parse-dn src-dn-format="ldap">
																	<token-global-variable name="dirxml.auto.localserverdn" />
																</token-parse-dn>
															</arg-dn>
															<arg-string>
																<token-text xml:space="preserve">Network Address</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">GUID</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="netAddrs" scope="policy">
													<arg-node-set>
														<token-xpath expression="$grpwServer/attr[@attr-name='Network Address']/value[component[@name='netAddrType']/text()=9]/component[@name='netAddr']/text()" />
													</arg-node-set>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="netAddrs" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="ip" scope="policy">
															<arg-string>
																<token-xpath expression="es:getIPFromHexNetAddr(es:octet2AsciiHex($current-node))" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="port" scope="policy">
															<arg-string>
																<token-xpath expression="es:getPortFromHexNetAddr(es:octet2AsciiHex($current-node))" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="serverGuid" scope="policy">
											<arg-string>
												<token-xpath expression="es:guid2string($grpwServer/attr[@attr-name='GUID']/value/text())" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.auth.ip']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.auth.ip']/value">
											<arg-string>
												<token-local-variable name="ip" />
											</arg-string>
										</do-append-xml-text>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.auth.port']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.auth.port']/value">
											<arg-string>
												<token-local-variable name="port" />
											</arg-string>
										</do-append-xml-text>
										<do-set-local-variable name="authID" scope="policy">
											<arg-string>
												<token-xpath expression="$driver//attr[@attr-name='DirXML-ShimAuthID']/value/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="$xml//definition[@name='msysinfo.drv.ms.auth.id']/value/text()" />
										<do-append-xml-text expression="$xml//definition[@name='msysinfo.drv.ms.auth.id']/value">
											<arg-string>
												<token-local-variable name="authID" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
								