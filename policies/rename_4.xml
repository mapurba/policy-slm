<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>rename</description>
									<conditions>
										<and>
											<if-operation op="equal">rename</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="." name="remove-old-name">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-for-each>
											<arg-node-set>
												<token-src-attr name="DirXML-MDADContext" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">$current-node/component[@name='volume']="~dirxml.auto.driverdn~"</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="cached-object-value" scope="policy">
															<arg-string>
																<token-parse-dn dest-dn-format="ldap" length="-2" src-dn-format="ldap">
																	<token-xpath expression="$current-node/component[@name=&quot;path&quot;]" />
																</token-parse-dn>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-src-attr name="DirXML-MDADContext" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">$current-node/component[@name='volume']="~dirxml.auto.driverdn~"</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-remove-src-attr-value direct="true" name="DirXML-MDADContext">
															<arg-value type="structured">
																<arg-component name="nameSpace">
																	<token-xpath expression="$current-node/component[@name=&quot;nameSpace&quot;]" />
																</arg-component>
																<arg-component name="volume">
																	<token-xpath expression="$current-node/component[@name=&quot;volume&quot;]" />
																</arg-component>
																<arg-component name="path">
																	<token-xpath expression="$current-node/component[@name=&quot;path&quot;]" />
																</arg-component>
															</arg-value>
														</do-remove-src-attr-value>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-add-src-attr-value name="DirXML-MDADContext">
											<arg-value type="structured">
												<arg-component name="nameSpace">
													<token-time format="!CTIME" tz="UTC" />
												</arg-component>
												<arg-component name="volume">
													<token-global-variable name="dirxml.auto.driverdn" />
												</arg-component>
												<arg-component name="path">
													<token-text xml:space="preserve">CN=</token-text>
													<token-xpath expression="$current-op/new-name/text()" />
													<token-text xml:space="preserve">,</token-text>
													<token-local-variable name="cached-object-value" />
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
									</actions>
								</rule>
								