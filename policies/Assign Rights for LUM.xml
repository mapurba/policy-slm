<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Assign Rights for LUM</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable name="AddLUMRights" op="equal">true</if-global-variable>
											<if-global-variable name="ModifyUsers" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-add-src-attr-value name="ACL">
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">uidNumber</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-text xml:space="preserve">\[PUBLIC]</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">2</token-text>
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
										<do-add-src-attr-value name="ACL">
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">gidNumber</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-text xml:space="preserve">\[PUBLIC]</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">2</token-text>
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
										<do-add-src-attr-value name="ACL">
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">loginShell</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-text xml:space="preserve">\[PUBLIC]</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">2</token-text>
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
										<do-add-src-attr-value name="ACL">
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">homeDirectory</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-text xml:space="preserve">\[PUBLIC]</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">2</token-text>
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
										<do-add-src-attr-value name="ACL">
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">gecos</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-text xml:space="preserve">\[PUBLIC]</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">2</token-text>
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
										<do-add-src-attr-value name="ACL">
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">Group Membership</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-text xml:space="preserve">\[PUBLIC]</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">2</token-text>
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
										<do-add-src-attr-value name="ACL">
											<arg-value type="structured">
												<arg-component name="protectedName">
													<token-text xml:space="preserve">cn</token-text>
												</arg-component>
												<arg-component name="trustee">
													<token-text xml:space="preserve">\[PUBLIC]</token-text>
												</arg-component>
												<arg-component name="privileges">
													<token-text xml:space="preserve">1</token-text>
												</arg-component>
											</arg-value>
										</do-add-src-attr-value>
									</actions>
								</rule>
							