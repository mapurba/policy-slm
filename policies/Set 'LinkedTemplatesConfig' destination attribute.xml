<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set 'LinkedTemplatesConfig' destination attribute</description>
									<conditions>
										<and>
											<if-local-variable mode="nocase" name="lv-hasNeededData" op="equal">true</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lv-LinkedTemplatesConfig" scope="policy">
											<arg-string>
												<token-xpath expression="es:LinkedTemplatesConfig_jsonify($lo-LinkedTemplatesConfig)" />
											</arg-string>
										</do-set-local-variable>
										<do-set-dest-attr-value class-name="User" name="LinkedTemplatesConfig">
											<arg-value type="string">
												<token-xpath expression="$lv-LinkedTemplatesConfig" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							