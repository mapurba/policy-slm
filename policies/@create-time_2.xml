<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>@create-time</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="." name="create-time">
											<arg-string>
												<token-xpath expression="add-attr[@attr-name='Object Class']/value[1]/@timestamp" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								