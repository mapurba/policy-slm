<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Placement for Groups</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="idv.dit.data.groups" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							