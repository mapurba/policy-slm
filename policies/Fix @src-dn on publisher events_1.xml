<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Fix @src-dn on publisher events</description>
									<conditions>
										<and>
											<if-local-variable mode="nocase" name="fromNds" op="equal">false</if-local-variable>
											<if-xpath op="true">@src-dn</if-xpath>
											<if-xpath op="not-true">starts-with(@src-dn, '\')</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">Detected publisher event with old-style @src-dn. Fixing @src-dn.</token-text>
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="srcDn" scope="policy">
											<arg-string>
												<token-xpath expression="@src-dn" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="@src-dn" />
										<do-set-xml-attr expression="." name="src-dn">
											<arg-string>
												<token-text xml:space="preserve">\</token-text>
												<token-local-variable name="primLogicalSystemName" />
												<token-text xml:space="preserve">\</token-text>
												<token-local-variable name="srcDn" />
											</arg-string>
										</do-set-xml-attr>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">Legacy @src-dn: $srcDn$. Fixed-up @src-dn: </token-text>
												<token-xpath expression="@src-dn" />
											</arg-string>
										</do-trace-message>
									</actions>
								</rule>
							