<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Policy to add a operation property to Account Entitlement Query</description>
									<comment xml:space="preserve">The Operation Property will be used to tag the Entitlement Account Query and will be used by itp to set required attributes.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-xpath op="true">./read-attr[@attr-name='DBACCOUNT']</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="Entitlement-Account-Query">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							