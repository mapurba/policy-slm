<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update persons managed by this position's new holder</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">DirXML-sapS</if-class-name>
											<if-op-attr name="DirXML-sapS-R-A-P-008" op="changing" />
											<if-attr name="DirXML-sapS-R-B-S-002" op="available" />
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">DirXML-sapS</if-class-name>
											<if-operation mode="case" op="equal">sync</if-operation>
											<if-attr name="DirXML-sapS-R-B-S-002" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Position "</token-text>
												<token-attr name="DirXML-sapSShortName" />
												<token-text xml:space="preserve">" (</token-text>
												<token-src-name />
												<token-text xml:space="preserve">) re-assigned to person "</token-text>
												<token-attr name="DirXML-sapS-R-A-P-008" />
												<token-text xml:space="preserve">".</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Updating managed persons...</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-attr name="DirXML-sapS-R-B-S-002" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="managedPositionID" scope="policy">
													<arg-string>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="managedPosition" scope="policy">
													<arg-node-set>
														<token-query scope="subtree">
															<arg-dn>
																<token-global-variable name="idv.dit.data.users" />
															</arg-dn>
															<arg-match-attr name="DirXML-sapSID">
																<arg-value type="string">
																	<token-local-variable name="managedPositionID" />
																</arg-value>
															</arg-match-attr>
															<arg-string>
																<token-text xml:space="preserve">DirXML-sapSShortName</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="lvTmp" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">- Position: </token-text>
														<token-xpath expression="$managedPosition/attr[@attr-name='DirXML-sapSShortName']/value[1]" />
														<token-text xml:space="preserve"> (</token-text>
														<token-local-variable name="managedPositionID" />
														<token-text xml:space="preserve">)</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="lvTmp" />
													</arg-string>
												</do-trace-message>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvFile" scope="policy">
															<arg-string>
																<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-for-each>
													<arg-node-set>
														<token-src-attr name="DirXML-sapS-R-A-P-008">
															<arg-dn>
																<token-global-variable name="dvr.saphr.driverdn" />
																<token-text xml:space="preserve">\sap\om\s\</token-text>
																<token-local-variable name="managedPositionID" />
															</arg-dn>
														</token-src-attr>
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="managedPersonID" scope="policy">
															<arg-node-set>
																<token-local-variable name="current-node" />
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="managedPerson" scope="policy">
															<arg-node-set>
																<token-query scope="subtree">
																	<arg-dn>
																		<token-global-variable name="idv.dit.data.users" />
																	</arg-dn>
																	<arg-match-attr name="DirXML-sapPID">
																		<arg-value type="string">
																			<token-local-variable name="managedPersonID" />
																		</arg-value>
																	</arg-match-attr>
																	<arg-string>
																		<token-text xml:space="preserve">Full Name</token-text>
																	</arg-string>
																</token-query>
															</arg-node-set>
														</do-set-local-variable>
														<do-set-local-variable name="lvTmp" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">-- </token-text>
																<token-xpath expression="$managedPerson/attr[@attr-name='Full Name']/value[1]" />
																<token-text xml:space="preserve"> (</token-text>
																<token-local-variable name="managedPersonID" />
																<token-text xml:space="preserve">)</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-trace-message>
															<arg-string>
																<token-local-variable name="lvTmp" />
															</arg-string>
														</do-trace-message>
														<do-if>
															<arg-conditions>
																<and>
																	<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="lvFile" scope="policy">
																	<arg-string>
																		<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions />
														</do-if>
														<do-if>
															<arg-conditions>
																<and>
																	<if-attr mode="regex" name="DirXML-sapS-R-A-P-008" op="equal">.+</if-attr>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-src-attr-value name="managerWorkforceID">
																	<arg-dn>
																		<token-xpath expression="$managedPerson/@src-dn" />
																	</arg-dn>
																	<arg-value>
																		<token-attr name="DirXML-sapS-R-A-P-008" />
																	</arg-value>
																</do-set-src-attr-value>
															</arg-actions>
															<arg-actions>
																<do-clear-src-attr-value name="managerWorkforceID">
																	<arg-dn>
																		<token-xpath expression="$managedPerson/@src-dn" />
																	</arg-dn>
																</do-clear-src-attr-value>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							