<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>SetLogicalSystem-EntitlementUnavailable</description>
									<comment xml:space="preserve">Set Logical system name as given in driver configuration to enable sub-pub bidirectional synchronization.</comment>
									<conditions>
										<or>
											<if-global-variable name="drv.entitlement.UserAccount" op="not-equal">true</if-global-variable>
											<if-global-variable name="drv.entitlement.UserAccount" op="not-available" />
										</or>
									</conditions>
									<actions>
										<do-set-op-property name="lsname">
											<arg-string>
												<token-global-variable name="drv.param.driverLSName" />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
								