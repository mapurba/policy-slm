<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto rename and move operations</description>
									<comment xml:space="preserve">Veto rename and move operations since it is not applicable for Oracle EBS HR</comment>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">rename|move</if-operation>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							