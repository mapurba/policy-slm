<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Login Disabled Mapping</description>
									<comment xml:space="preserve">When Login Disabled is changing to true, set isActive to false. Otherwise, set isActive to true.</comment>
									<comment name="author" xml:space="preserve">PDS</comment>
									<comment name="version" xml:space="preserve">1.0</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="Login Disabled" op="changing" />
											<if-global-variable mode="nocase" name="drv.sync.disabled" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr mode="octet" name="Login Disabled" op="changing-to">true</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-op-attr name="Login Disabled" />
												<do-add-dest-attr-value name="IsActive">
													<arg-value type="string">
														<token-global-variable name="drv.sync.disabled.isactive" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-local-variable name="lv-BlockStatus" scope="policy">
													<arg-object>
														<token-xpath expression="es:BlockStatus($drv.sync.disabled.isblocked, &quot;0&quot;, &quot;0&quot;, $drv.sync.disabled.isblocked.comment)" />
													</arg-object>
												</do-set-local-variable>
												<do-set-dest-attr-value name="BlockStatus" when="after">
													<arg-value type="string">
														<token-xpath expression="es:BlockStatus_jsonify($lv-BlockStatus)" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-strip-op-attr name="Login Disabled" />
												<do-add-dest-attr-value name="IsActive">
													<arg-value type="string">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-local-variable name="lv-BlockStatus" scope="policy">
													<arg-object>
														<token-xpath expression="es:BlockStatus(&quot;False&quot;, &quot;0&quot;, &quot;0&quot;, &quot;Cleared by IDM&quot;)" />
													</arg-object>
												</do-set-local-variable>
												<do-set-dest-attr-value name="BlockStatus" when="after">
													<arg-value type="string">
														<token-xpath expression="es:BlockStatus_jsonify($lv-BlockStatus)" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							