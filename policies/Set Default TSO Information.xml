<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Default TSO Information</description>
									<comment xml:space="preserve">When new users are created, this rule will assign a TSO Account number and Logon Procedure with values stored in the global TSO GCV's.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="DirXML-RACF-tso-acctnum" write-back="false">
											<arg-value type="string">
												<token-global-variable name="racf-default-tso-acct" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="DirXML-RACF-tso-proc">
											<arg-value type="string">
												<token-global-variable name="racf-default-tso-proc" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
							