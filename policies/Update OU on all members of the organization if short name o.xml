<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update OU on all members of the organization if short name of the organization is changing</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">DirXML-sapO</if-class-name>
											<if-op-attr name="DirXML-sapOShortName" op="changing" />
										</and>
										<and>
											<if-class-name op="equal">DirXML-sapO</if-class-name>
											<if-operation op="equal">sync</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Organization </token-text>
												<token-src-name />
												<token-text xml:space="preserve"> has name </token-text>
												<token-attr name="DirXML-sapOShortName" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Updating members of the organization...</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-local-variable name="lvTmp" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvFile" scope="policy">
													<arg-string>
														<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="orgMembers" scope="policy">
											<arg-node-set>
												<token-query datastore="src">
													<arg-dn>
														<token-global-variable name="idv.dit.data.users" />
													</arg-dn>
													<arg-match-attr name="DirXML-sapP-A-O">
														<arg-value type="string">
															<token-attr name="DirXML-sapOID" />
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">DirXML-sapPID</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">Full Name</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="orgMembers" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="lvTmp" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">- </token-text>
														<token-xpath expression="$current-node/attr[@attr-name='Full Name']/value[1]" />
														<token-text xml:space="preserve"> (</token-text>
														<token-xpath expression="$current-node/attr[@attr-name='DirXML-sapPID']/value" />
														<token-text xml:space="preserve">)</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="lvTmp" />
													</arg-string>
												</do-trace-message>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.proclog.enabled" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="lvFile" scope="policy">
															<arg-string>
																<token-xpath expression="es:writeLog($lvLogfile,concat(es:fixLength(' ',14),$lvTmp))" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-if>
													<arg-conditions>
														<and>
															<if-attr mode="regex" name="DirXML-sapOShortName" op="equal">.+</if-attr>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-src-attr-value name="OU">
															<arg-dn>
																<token-xpath expression="$current-node/@src-dn" />
															</arg-dn>
															<arg-value>
																<token-attr name="DirXML-sapOShortName" />
															</arg-value>
														</do-set-src-attr-value>
													</arg-actions>
													<arg-actions>
														<do-clear-src-attr-value name="OU">
															<arg-dn>
																<token-xpath expression="$current-node/@src-dn" />
															</arg-dn>
														</do-clear-src-attr-value>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							