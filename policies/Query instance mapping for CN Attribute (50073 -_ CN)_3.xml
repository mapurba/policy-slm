<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Query instance mapping for CN Attribute (50073 -&gt; CN)</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">instance</if-operation>
											<if-class-name op="available" />
										</and>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="CN" src-name="50073" />
										<do-rename-op-attr dest-name="src-dn" src-name="id" />
									</actions>
								</rule>
								