<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add Group Membership for LUM</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable name="ModifyUsers" op="equal">true</if-global-variable>
											<if-global-variable name="SpecifyLUMGroup" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-add-src-attr-value name="Group Membership">
											<arg-value type="dn">
												<token-global-variable name="LUMGroup" />
											</arg-value>
										</do-add-src-attr-value>
									</actions>
								</rule>
							