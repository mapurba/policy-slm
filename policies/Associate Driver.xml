<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Associate Driver</description>
									<comment xml:space="preserve">This allows the driver to retain the new Path syntaxed DirXML-MDADAliasName during merge operations.</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-add-association direct="true">
											<arg-dn>
												<token-global-variable name="dirxml.auto.driverdn" />
											</arg-dn>
											<arg-association>
												<token-text xml:space="preserve">1</token-text>
											</arg-association>
										</do-add-association>
									</actions>
								</rule>
							