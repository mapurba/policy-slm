<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match on GCV attribute</description>
									<comment xml:space="preserve">as part of the banner package there is a GCV named "gcv.NOVLBNNRUSER.pubMatchingAttribute" which has a list of attributes you can select from to change what this rule uses to match with.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subordinates">
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
											</arg-dn>
											<arg-match-attr name="$gcv.NOVLBNNRUSER.pubMatchingAttribute$" />
										</do-find-matching-object>
									</actions>
								</rule>
							