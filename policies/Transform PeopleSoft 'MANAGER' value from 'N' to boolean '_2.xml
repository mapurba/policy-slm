<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform PeopleSoft 'MANAGER' value from 'N' to boolean 'false'</description>
									<conditions>
										<and>
											<if-op-attr name="MANAGER" op="equal">N</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="MANAGER">
											<arg-value type="int">
												<token-text xml:space="preserve">false</token-text>
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							