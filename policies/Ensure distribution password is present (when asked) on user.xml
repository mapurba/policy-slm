<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Ensure distribution password is present (when asked) on user creation</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="drv.password.forcepresence" op="equal">true</if-global-variable>
											<if-op-attr name="nspmDistributionPassword" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							