<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Move event to Modify of DN</description>
									<conditions>
										<and>
											<if-operation op="equal">move</if-operation>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="DISTINGUISHED_NAME" when="after">
											<arg-value type="string">
												<token-src-dn />
											</arg-value>
										</do-add-dest-attr-value>
										<do-veto />
									</actions>
								</rule>
							