<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add '__BROADCAST__' for group add Operation</description>
									<conditions>
										<and>
											<if-class-name mode="regex" op="equal">indirect.grp|direct.view_grp</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="." name="connection-dn">
											<arg-string>
												<token-text xml:space="preserve">__BROADCAST__</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								