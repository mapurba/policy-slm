<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initiate MSGW driver DN in slash format</description>
									<comment xml:space="preserve">To compare source DNs coming from the engine to other DN's, the other DN's need to be in slash format as well.</comment>
									<conditions>
										<and>
											<if-local-variable name="msgw-driver-slash-dn" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="msgw-driver-slash-dn" scope="driver">
											<arg-string>
												<token-parse-dn dest-dn-format="slash" src-dn-format="ldap">
													<token-global-variable name="drv.registration.msgw.driverdn" />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								