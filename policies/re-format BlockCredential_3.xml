<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>re-format BlockCredential</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">modify</if-operation>
											<if-op-attr name="BlockCredential" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="removevalue" scope="policy">
											<arg-string>
												<token-xpath expression="./modify-attr[@attr-name=&quot;BlockCredential&quot;]/remove-value/value/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="addvalue" scope="policy">
											<arg-string>
												<token-xpath expression="./modify-attr[@attr-name=&quot;BlockCredential&quot;]/add-value/value/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="removevalue" op="equal">$addvalue$</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-xpath expression="./modify-attr[@attr-name=&quot;BlockCredential&quot;]" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">count(./modify-attr)=0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-veto />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							