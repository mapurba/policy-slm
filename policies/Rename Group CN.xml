<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Rename Group CN</description>
									<comment xml:space="preserve">Rename Group CN</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-op-attr name="CN" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="NewCN" scope="policy">
											<arg-node-set>
												<token-xpath expression="modify-attr/add-value/value[last()]/text()" />
											</arg-node-set>
										</do-set-local-variable>
										<do-rename-dest-object>
											<arg-string>
												<token-local-variable name="NewCN" />
											</arg-string>
										</do-rename-dest-object>
									</actions>
								</rule>
							