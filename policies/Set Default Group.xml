<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Default Group</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="DirXML-TSS-DFLTGRP">
											<arg-value type="string">
												<token-global-variable name="topsecret-default-group" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
								