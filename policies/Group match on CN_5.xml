<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Group match on CN</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="drv.coex.mode" op="equal">false</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-find-matching-object scope="subtree">
													<arg-dn>
														<token-global-variable name="idv.dit.data.groups" />
													</arg-dn>
													<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" />
												</do-find-matching-object>
											</arg-actions>
											<arg-actions>
												<do-find-matching-object scope="subtree">
													<arg-dn>
														<token-global-variable name="idv.dit.data.users" />
													</arg-dn>
													<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName" />
												</do-find-matching-object>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							