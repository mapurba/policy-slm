<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>placement for all objects</description>
									<comment xml:space="preserve">Construct a destination DN for all object types assuming simple object name mapping.</comment>
									<conditions>
										<or />
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-op-property name="drv.domain.container.name" />
												<token-text xml:space="preserve">\</token-text>
												<token-op-property name="unmatched-src-dn" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-property mode="nocase" name="drv.pubPlacementType" op="equal">flat</if-op-property>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-dest-dn>
													<arg-dn>
														<token-op-property name="drv.domain.container.name" />
														<token-text xml:space="preserve">\</token-text>
														<token-src-name />
													</arg-dn>
												</do-set-op-dest-dn>
											</arg-actions>
											<arg-actions>
												<do-set-op-dest-dn>
													<arg-dn>
														<token-op-property name="drv.domain.container.name" />
														<token-text xml:space="preserve">\</token-text>
														<token-op-property name="unmatched-src-dn" />
													</arg-dn>
												</do-set-op-dest-dn>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								