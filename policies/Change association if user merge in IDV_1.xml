<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Change association if user merge in IDV</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="gvWorkersMergeIDV" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="LV-wd-Association-user" scope="policy">
											<arg-string>
												<token-association />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="LV-wd-WorkforceID-user" scope="policy">
											<arg-string>
												<token-xpath expression="substring-after($LV-wd-Association-user,'-')" />
											</arg-string>
										</do-set-local-variable>
										<do-set-op-association>
											<arg-association>
												<token-local-variable name="LV-wd-WorkforceID-user" />
											</arg-association>
										</do-set-op-association>
									</actions>
								</rule>
								