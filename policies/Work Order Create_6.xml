<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Work Order Create</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">DirXMLWorkOrder</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLnwoSendToPublisher" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLnwoStatus" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLnwoDoItNowFlag" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLnwoContent" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLwoType" />
										<do-break />
									</actions>
								</rule>
							