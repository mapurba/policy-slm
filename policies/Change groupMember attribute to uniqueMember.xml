<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Change groupMember attribute to uniqueMember</description>
									<comment xml:space="preserve">Change groupMember attribute to uniqueMember </comment>
									<conditions>
										<and>
											<if-op-property mode="nocase" name="data-collection-query" op="equal">true</if-op-property>
											<if-xpath op="true">attr/@attr-name='groupMember'</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="uniqueMember" src-name="groupMember" />
									</actions>
								</rule>
							