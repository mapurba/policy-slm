<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Rename GroupWise External Entity Login Expiration Time Attribute</description>
									<conditions>
										<and>
											<if-op-attr name="Login Expiration Time" op="available" />
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="NGW: Mailbox Expiration Time" src-name="Login Expiration Time" />
										<do-break />
									</actions>
								</rule>
							