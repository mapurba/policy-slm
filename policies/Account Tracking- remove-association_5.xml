<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account Tracking- remove-association</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">remove-association</if-operation>
											<if-global-variable mode="nocase" name="driver.gw.ent.account.remove" op="equal">delete</if-global-variable>
											<if-attr name="NGW: Account ID" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">findthisintrace</token-text>
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="ObjectDN" scope="policy">
											<arg-node-set>
												<token-query datastore="dest" scope="entry">
													<arg-association>
														<token-xpath expression="." />
													</arg-association>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">string-length($ObjectDN) &gt; 0</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="AccountTracking-ObjectDN">
													<arg-string>
														<token-xpath expression="$ObjectDN/@src-dn" />
													</arg-string>
												</do-set-op-property>
												<do-set-op-property name="accountAction">
													<arg-string>
														<token-text xml:space="preserve">accountDeleteByEntitlementRevoke</token-text>
													</arg-string>
												</do-set-op-property>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							