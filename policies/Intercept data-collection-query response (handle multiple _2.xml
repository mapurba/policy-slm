<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Intercept data-collection-query response (handle multiple identifiers) </description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">instance</if-operation>
											<if-class-name mode="nocase" op="equal">Person</if-class-name>
											<if-op-property name="data-collection-query" op="available" />
											<if-op-property mode="nocase" name="data-collection-query" op="equal">true</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="./attr[@attr-name=&quot;FullName&quot;]/value" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-xpath op="true">starts-with($current-node, 'CN=')</if-xpath>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-strip-xpath expression="$current-node" />
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								