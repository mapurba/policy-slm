<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform STATUS from true to *DISABLED</description>
									<conditions>
										<and>
											<if-op-attr name="STATUS" op="changing-to">true</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="STATUS" />
										<do-set-dest-attr-value name="STATUS">
											<arg-value type="string">
												<token-text xml:space="preserve">*DISABLED</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								