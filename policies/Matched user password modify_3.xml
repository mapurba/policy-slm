<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Matched user password modify </description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">modify</if-operation>
											<if-xpath op="true">modify-attr[@attr-name='password']</if-xpath>
											<if-association op="associated" />
										</and>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">RESET password for matched user</token-text>
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="oldpassword" notrace="true" scope="policy">
											<arg-string>
												<token-xpath expression="*[@attr-name='password']/remove-value/value" />
											</arg-string>
										</do-set-local-variable>
										<do-if notrace="true">
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="oldpassword" op="equal" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="oldpassword" scope="policy">
													<arg-string>
														<token-local-variable name="generatedPassword" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="oldpassword" notrace="true" scope="policy">
											<arg-string>
												<token-local-variable name="generatedPassword" />
											</arg-string>
										</do-set-local-variable>
										<do-trace-message notrace="true">
											<arg-string>
												<token-text xml:space="preserve">resetpass </token-text>
												<token-local-variable name="oldpassword" />
											</arg-string>
										</do-trace-message>
										<do-set-dest-password notrace="true" when="before">
											<arg-string>
												<token-local-variable name="oldpassword" />
											</arg-string>
										</do-set-dest-password>
										<do-break />
									</actions>
								</rule>
							