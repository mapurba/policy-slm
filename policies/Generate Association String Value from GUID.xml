<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Generate Association String Value from GUID</description>
									<conditions>
										<and>
											<if-global-variable name="auto-associate" op="equal">true</if-global-variable>
											<if-association op="not-associated" />
											<if-global-variable name="auto-associate-sub-value" op="equal">GUID</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="assocStringValue">
											<arg-string>
												<token-src-attr name="GUID" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								