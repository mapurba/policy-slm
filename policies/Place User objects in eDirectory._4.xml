<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Place User objects in eDirectory.</description>
									<comment xml:space="preserve">Generates the target DN for new Users by concatenating the User Base Container GCV with the lowercase value of the CN attribute.</comment>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
												<token-text xml:space="preserve">\</token-text>
												<token-lower-case>
													<token-attr name="CN" />
												</token-lower-case>
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							