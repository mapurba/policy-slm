<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add class-name for query-ex</description>
									<conditions>
										<or>
											<if-operation op="equal">query-ex</if-operation>
										</or>
										<or>
											<if-xpath op="not-true">descendant::query-token</if-xpath>
										</or>
										<or>
											<if-class-name op="not-available" />
											<if-class-name mode="nocase" op="equal" />
										</or>
									</conditions>
									<actions>
										<do-set-xml-attr expression="." name="class-name">
											<arg-string>
												<token-text xml:space="preserve">team</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							