<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Change Group Value as per FanOut Standards</description>
									<conditions>
										<and>
											<if-class-name mode="regex" op="equal">direct.view_grp|indirect.grp</if-class-name>
											<if-op-property mode="nocase" name="data-collection-query" op="equal">true</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">attr[@attr-name='pk_idg']</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-text before="node()" expression="attr[@attr-name='pk_idg']/value">
													<arg-string>
														<token-xpath expression="substring-before(association/text(),'$')" />
														<token-text xml:space="preserve">-</token-text>
													</arg-string>
												</do-append-xml-text>
												<do-set-xml-attr expression="attr[@attr-name='pk_idg']/value" name="type">
													<arg-string>
														<token-text xml:space="preserve">string</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">attr[@attr-name='idg']</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-append-xml-text before="node()" expression="attr[@attr-name='idg']/value">
													<arg-string>
														<token-xpath expression="substring-before(association/text(),'$')" />
														<token-text xml:space="preserve">-</token-text>
													</arg-string>
												</do-append-xml-text>
												<do-set-xml-attr expression="attr[@attr-name='idg']/value" name="type">
													<arg-string>
														<token-text xml:space="preserve">string</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								