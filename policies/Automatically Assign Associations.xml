<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Automatically Assign Associations</description>
									<conditions>
										<and>
											<if-global-variable name="auto-associate" op="equal">true</if-global-variable>
											<if-association op="not-associated" />
										</and>
									</conditions>
									<actions>
										<do-add-association>
											<arg-association>
												<token-local-variable name="assocStringValue" />
											</arg-association>
										</do-add-association>
										<do-append-xml-element expression="." name="association" />
										<do-append-xml-text expression="./association">
											<arg-string>
												<token-local-variable name="assocStringValue" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
								