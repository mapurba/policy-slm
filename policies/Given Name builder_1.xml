<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Given Name builder</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-local-variable name="given-name-exists" op="not-equal">-1</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="User" name="Given Name">
											<arg-value type="string">
												<token-xpath expression="jstring:substring($full-name,0,jstring:indexOf($full-name,' '))" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
								