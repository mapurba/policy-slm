<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check User modify for group membership being granted or revoked</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Group" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="Group" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="Group" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="userId">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.SAPCloud" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="display-name" scope="policy">
															<arg-string>
																<token-dest-attr class-name="User" name="urn:ietf:params:scim:schemas:core:2.0:User:displayName">
																	<arg-association>
																		<token-local-variable name="userId" />
																	</arg-association>
																</token-dest-attr>
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable name="display-name" op="equal" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="firstname">
																	<arg-string>
																		<token-dest-attr class-name="User" name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName">
																			<arg-association>
																				<token-local-variable name="userId" />
																			</arg-association>
																		</token-dest-attr>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="surname">
																	<arg-string>
																		<token-dest-attr class-name="User" name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName">
																			<arg-association>
																				<token-local-variable name="userId" />
																			</arg-association>
																		</token-dest-attr>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="seperator">
																	<arg-string>
																		<token-text xml:space="preserve"> </token-text>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="display-name">
																	<arg-string>
																		<token-local-variable name="firstname" />
																		<token-local-variable name="seperator" />
																		<token-local-variable name="surname" />
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
														</do-if>
														<do-remove-dest-attr-value class-name="Group" name="members">
															<arg-association>
																<token-local-variable name="assoc" />
															</arg-association>
															<arg-value type="string">
																<token-json-object>
																	<arg-string name="value">
																		<token-text xml:space="preserve">"</token-text>
																		<token-association />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																	<arg-string name="$ref">
																		<token-text xml:space="preserve">"</token-text>
																		<token-global-variable name="driverHttpScimBaseUrlGCV" />
																		<token-text xml:space="preserve">/Users/</token-text>
																		<token-association />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																	<arg-string name="display">
																		<token-text xml:space="preserve">"</token-text>
																		<token-local-variable name="display-name" />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																</token-json-object>
															</arg-value>
														</do-remove-dest-attr-value>
													</arg-actions>
													<arg-actions>
														<do-remove-dest-attr-value class-name="Group" name="members">
															<arg-association>
																<token-local-variable name="assoc" />
															</arg-association>
															<arg-value type="string">
																<token-json-object>
																	<arg-string name="value">
																		<token-text xml:space="preserve">"</token-text>
																		<token-association />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																	<arg-string name="$ref">
																		<token-text xml:space="preserve">"</token-text>
																		<token-global-variable name="driverHttpScimBaseUrlGCV" />
																		<token-text xml:space="preserve">/Users/</token-text>
																		<token-association />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																</token-json-object>
															</arg-value>
														</do-remove-dest-attr-value>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="Group" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="userId">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-global-variable mode="nocase" name="drv.SAPCloud" op="equal">true</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="display-name" scope="policy">
															<arg-string>
																<token-dest-attr class-name="User" name="urn:ietf:params:scim:schemas:core:2.0:User:displayName">
																	<arg-association>
																		<token-local-variable name="userId" />
																	</arg-association>
																</token-dest-attr>
															</arg-string>
														</do-set-local-variable>
														<do-add-dest-attr-value class-name="Group" name="members">
															<arg-association>
																<token-local-variable name="assoc" />
															</arg-association>
															<arg-value type="string">
																<token-json-object>
																	<arg-string name="value">
																		<token-text xml:space="preserve">"</token-text>
																		<token-association />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																	<arg-string name="$ref">
																		<token-text xml:space="preserve">"</token-text>
																		<token-global-variable name="driverHttpScimBaseUrlGCV" />
																		<token-text xml:space="preserve">/Users/</token-text>
																		<token-association />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																	<arg-string name="display">
																		<token-text xml:space="preserve">"</token-text>
																		<token-local-variable name="display-name" />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																</token-json-object>
															</arg-value>
														</do-add-dest-attr-value>
													</arg-actions>
													<arg-actions>
														<do-add-dest-attr-value class-name="Group" name="members">
															<arg-association>
																<token-local-variable name="assoc" />
															</arg-association>
															<arg-value type="string">
																<token-json-object>
																	<arg-string name="value">
																		<token-text xml:space="preserve">"</token-text>
																		<token-association />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																	<arg-string name="$ref">
																		<token-text xml:space="preserve">"</token-text>
																		<token-global-variable name="driverHttpScimBaseUrlGCV" />
																		<token-text xml:space="preserve">/Users/</token-text>
																		<token-association />
																		<token-text xml:space="preserve">"</token-text>
																	</arg-string>
																</token-json-object>
															</arg-value>
														</do-add-dest-attr-value>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							