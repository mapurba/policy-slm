<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Password Expiration Time</description>
									<comment xml:space="preserve">Transforms the Password Expiration Time into a boolean expired/noexpired value and includes the information on the password field.</comment>
									<conditions>
										<and>
											<if-op-attr name="Password Expiration Time" op="changing" />
											<if-attr name="nspmDistributionPassword" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="passwordExpirationTime" scope="policy">
											<arg-string>
												<token-op-attr name="Password Expiration Time" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="timeNow" scope="policy">
											<arg-string>
												<token-xpath expression="int:new(date:getTime(date:new()) div 1000)" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="expirationLapse" scope="policy">
											<arg-string>
												<token-xpath expression="int:new($timeNow -$passwordExpirationTime)" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="expirationLapse" op="gt">0</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-add-dest-attr-value name="nspmDistributionPassword">
													<arg-value type="string">
														<token-attr name="nspmDistributionPassword" />
														<token-text xml:space="preserve">;expired</token-text>
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-add-dest-attr-value name="nspmDistributionPassword">
													<arg-value type="string">
														<token-attr name="nspmDistributionPassword" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								