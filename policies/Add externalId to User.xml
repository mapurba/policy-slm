<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add externalId to User</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:id" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-add-dest-attr-value class-name="User" name="externalId">
													<arg-value type="string">
														<token-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:id" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-strip-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:id" />
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								