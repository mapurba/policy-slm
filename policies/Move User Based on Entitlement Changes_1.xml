<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Move User Based on Entitlement Changes</description>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEORGU.googlePlacementOption" op="equal">entitlement</if-global-variable>
										</or>
										<or>
											<if-entitlement name="NOVLGGLEORGU-UserPlacementEntitlement" op="changing" />
											<if-xml-attr mode="nocase" name="from-merge" op="equal">true</if-xml-attr>
										</or>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-entitlement name="NOVLGGLEORGU-UserPlacementEntitlement" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-entitlement name="NOVLGGLEORGU-UserPlacementEntitlement" />
													</arg-node-set>
													<arg-actions>
														<do-move-dest-object when="after">
															<arg-dn>
																<token-xpath expression="es:getEntParamField($current-node,'ID')" />
															</arg-dn>
														</do-move-dest-object>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions>
												<do-move-dest-object>
													<arg-dn>
														<token-text xml:space="preserve">\</token-text>
													</arg-dn>
												</do-move-dest-object>
											</arg-actions>
										</do-if>
										<do-break />
									</actions>
								</rule>
							