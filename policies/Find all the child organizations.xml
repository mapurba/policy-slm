<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Find all the child organizations</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">sync</if-operation>
											<if-class-name mode="nocase" op="equal">DirXML-sapO</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="childOrgs" scope="policy">
											<arg-node-set>
												<token-query class-name="DirXML-sapO" datastore="src" scope="subtree">
													<arg-dn>
														<token-global-variable name="dvr.saphr.driverdn" />
														<token-text xml:space="preserve">\sap\om\o</token-text>
													</arg-dn>
													<arg-match-attr name="DirXML-sapO-R-A-O-002">
														<arg-value type="string">
															<token-src-name />
														</arg-value>
													</arg-match-attr>
													<arg-string>
														<token-text xml:space="preserve">GUID</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
									</actions>
								</rule>
								