<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform authPassword to Login Disabled</description>
									<comment xml:space="preserve">This rule transforms authPassword locks/unlocks into the Login Disabled attribute.</comment>
									<conditions>
										<or>
											<if-op-attr mode="regex" name="authPassword" op="equal">!.*</if-op-attr>
											<if-op-attr mode="case" name="authPassword" op="equal">*LK*</if-op-attr>
										</or>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="Login Disabled">
											<arg-value>
												<token-text xml:space="preserve">true</token-text>
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								