<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Convert password add to Top Secret pass phrase change</description>
									<conditions>
										<and>
											<if-global-variable name="sub-pass-to-phrase" op="equal">true</if-global-variable>
											<if-password op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="DirXML-TSS-phrase">
											<arg-value type="string">
												<token-password />
											</arg-value>
										</do-set-dest-attr-value>
										<do-strip-xpath expression="password" />
										<do-set-xml-attr expression="add-attr[@attr-name='DirXML-TSS-phrase']/value" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-set-xml-attr expression="modify-attr[@attr-name='DirXML-TSS-phrase']/add-value/value" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							