<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform Delete into Modify to remove sapAddOnUM auxiliary class</description>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
										</and>
									</conditions>
									<actions>
										<do-remove-dest-attr-value name="Object Class" when="before">
											<arg-value type="string">
												<token-text xml:space="preserve">sapAddOnUM</token-text>
											</arg-value>
										</do-remove-dest-attr-value>
										<do-veto />
									</actions>
								</rule>
							