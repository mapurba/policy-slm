<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Prepare localserverdn variable</description>
									<comment xml:space="preserve">Only run once</comment>
									<conditions>
										<and>
											<if-local-variable name="localserverdn" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="localserverdn" scope="driver">
											<arg-string>
												<token-text xml:space="preserve">\</token-text>
												<token-global-variable name="dirxml.auto.treename" />
												<token-text xml:space="preserve">\</token-text>
												<token-parse-dn dest-dn-format="slash" src-dn-format="ldap">
													<token-global-variable name="dirxml.auto.localserverdn" />
												</token-parse-dn>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								