<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Get the RDN of destination DN for query operations.</description>
									<comment xml:space="preserve">The RDN of the entry is used for searching of PUM server, so extract the object name from the Destination DN.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">query</if-operation>
										</and>
									</conditions>
									<actions>
										<do-trace-message level="5">
											<arg-string>
												<token-text xml:space="preserve">Destination DN is </token-text>
												<token-dest-dn />
											</arg-string>
										</do-trace-message>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-dest-dn start="-1" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							