<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-WorkOrder (Future Events): veto if urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLOther1 or urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLDueDate is missing or empty</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">DirXMLWorkOrder</if-class-name>
										</or>
										<or>
											<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLOther1" op="not-equal">.+</if-op-attr>
											<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLWorkOrder:DirXMLDueDate" op="not-equal">.+</if-op-attr>
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							