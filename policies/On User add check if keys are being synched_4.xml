<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>On User add check if keys are being synched</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="Public Key" op="available" />
													<if-op-attr name="Private Key" op="available" />
												</and>
												<and>
													<if-global-variable mode="nocase" name="drv.edir.passwd.sync.ver" op="equal">1</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-xpath expression="password" />
												<do-strip-op-attr name="nspmDistributionPassword" />
												<do-break />
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-password op="not-available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-dest-password>
															<arg-string>
																<token-text xml:space="preserve">~drv.password.defaultValue~</token-text>
															</arg-string>
														</do-set-dest-password>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="nspmDistributionPassword" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-dest-password class-name="User">
													<arg-string>
														<token-xpath expression="add-attr[@attr-name=&quot;nspmDistributionPassword&quot;]/value/text()" />
													</arg-string>
												</do-set-dest-password>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
							