<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User</description>
									<conditions>
										<or>
											<if-class-name op="equal">User</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="Full Name" />
										<do-set-default-attr-value name="creatorsName" write-back="false">
											<arg-value type="string">
												<token-global-variable name="ARSObjectCreator" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="arsStatus" write-back="false">
											<arg-value type="string">
												<token-global-variable name="ARSUserStatus" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="arsLicenseType" write-back="false">
											<arg-value type="string">
												<token-global-variable name="ARSLicenseType" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="arsFullTextLicenseType" write-back="false">
											<arg-value type="string">
												<token-global-variable name="ARSLicenseFullText" />
											</arg-value>
										</do-set-default-attr-value>
										<do-set-default-attr-value name="arsDefaultNotifyMechanism" write-back="false">
											<arg-value type="string">
												<token-global-variable name="ARSDefaultNotifyMechanism" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
								