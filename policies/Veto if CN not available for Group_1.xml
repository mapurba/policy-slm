<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto if CN not available for Group</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-class-name mode="case" op="equal">Group</if-class-name>
											<if-op-attr name="CN" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							