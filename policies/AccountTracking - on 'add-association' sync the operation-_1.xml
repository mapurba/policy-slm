<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - on 'add-association' sync the operation-properties to 'status' operations</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">$current-op/operation-data/logindisabledattrvalue</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv-IdvAccountStatus" scope="policy">
													<arg-string>
														<token-xpath expression="$current-op/operation-data/logindisabledattrvalue/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="lv-IdvAccountStatus" op="equal">true</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-property name="AccountTracking-IdvAccountStatus">
															<arg-string>
																<token-text xml:space="preserve">I</token-text>
															</arg-string>
														</do-set-op-property>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-property name="AccountTracking-association" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-xpath expression="operation-data/@AccountTracking-association" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-property mode="nocase" name="AccountTracking-ObjectClass" op="equal">~jfoactrk.ObjectClass~</if-op-property>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="association" scope="policy">
													<arg-string>
														<token-xpath expression="text()" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-property name="AccountTracking-ObjectDN" op="not-available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-property name="AccountTracking-ObjectDN">
															<arg-string>
																<token-xpath expression="@dest-dn" />
															</arg-string>
														</do-set-op-property>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-for-each>
													<arg-node-set>
														<token-global-variable name="jfoactrk.AccIdentifiers" />
													</arg-node-set>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-op-property name="AccountTracking-$current-node$" op="not-available" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="current-node" op="equal">association</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-op-property name="AccountTracking-association">
																			<arg-string>
																				<token-local-variable name="association" />
																			</arg-string>
																		</do-set-op-property>
																	</arg-actions>
																	<arg-actions>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-local-variable mode="regex" name="current-node" op="equal">LDAPDN|DESTNAME</if-local-variable>
																				</and>
																			</arg-conditions>
																			<arg-actions />
																			<arg-actions>
																				<do-if>
																					<arg-conditions>
																						<and>
																							<if-local-variable mode="regex" name="current-node" op="equal">idu|pk_idu</if-local-variable>
																						</and>
																					</arg-conditions>
																					<arg-actions>
																						<do-set-local-variable name="lcase_assoc" scope="policy">
																							<arg-string>
																								<token-lower-case>
																									<token-local-variable name="association" />
																								</token-lower-case>
																							</arg-string>
																						</do-set-local-variable>
																						<do-set-local-variable name="identifier" scope="policy">
																							<arg-string>
																								<token-join>
																									<token-lower-case>
																										<token-local-variable name="current-node" />
																									</token-lower-case>
																									<token-text xml:space="preserve">=</token-text>
																								</token-join>
																							</arg-string>
																						</do-set-local-variable>
																						<do-set-op-property name="AccountTracking-$current-node$">
																							<arg-string>
																								<token-xpath expression="substring-before(substring-after($lcase_assoc,$identifier),&quot;,&quot;)" />
																							</arg-string>
																						</do-set-op-property>
																					</arg-actions>
																					<arg-actions>
																						<do-set-local-variable name="appObjectQuery" scope="policy">
																							<arg-node-set>
																								<token-query class-name="~jfoactrk.ObjectClass~" datastore="src" scope="entry">
																									<arg-association>
																										<token-local-variable name="association" />
																									</arg-association>
																									<arg-string>
																										<token-local-variable name="current-node" />
																									</arg-string>
																								</token-query>
																							</arg-node-set>
																						</do-set-local-variable>
																						<do-set-local-variable name="value" scope="policy">
																							<arg-string>
																								<token-xpath expression="$appObjectQuery/attr[last()]/value/text()" />
																							</arg-string>
																						</do-set-local-variable>
																						<do-if>
																							<arg-conditions>
																								<and>
																									<if-xpath op="true">string-length($value)!=0</if-xpath>
																								</and>
																							</arg-conditions>
																							<arg-actions>
																								<do-set-op-property name="AccountTracking-$current-node$">
																									<arg-string>
																										<token-local-variable name="value" />
																									</arg-string>
																								</do-set-op-property>
																							</arg-actions>
																							<arg-actions />
																						</do-if>
																					</arg-actions>
																				</do-if>
																			</arg-actions>
																		</do-if>
																	</arg-actions>
																</do-if>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
												<do-set-local-variable name="eventID" scope="policy">
													<arg-string>
														<token-xpath expression="@event-id" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="connDN" scope="policy">
													<arg-string>
														<token-xpath expression="@connection-dn" />
													</arg-string>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="operation-data/@*[starts-with(name(),&quot;AccountTracking&quot;)]" />
													</arg-node-set>
													<arg-actions>
														<do-clone-xpath dest-expression="//status[@event-id=$eventID and @connection-dn=$connDN]/operation-data" src-expression="$current-node" />
														<do-strip-xpath expression="$current-node" />
													</arg-actions>
												</do-for-each>
												<do-set-xml-attr expression="//status[@event-id=$eventID and @connection-dn=$connDN]" name="processed">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions>
												<do-set-xml-attr expression="//status[@event-id=$eventID and @connection-dn=$connDN]" name="processed">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-break />
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								