<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Generate Random Password if no Distribution Password available and GCV is set to random</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEPSWD.InitialPassword" op="equal">random</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="nspmDistributionPassword" write-back="false">
											<arg-value type="string">
												<token-xpath expression="es:createPassword4(($gcv.NOVLGGLEPSWD.RandomPasswordNumberOfLetters + $gcv.NOVLGGLEPSWD.RandomPasswordNumberOfNumbers), $gcv.NOVLGGLEPSWD.RandomPasswordNumberOfLetters, $gcv.NOVLGGLEPSWD.RandomPasswordNumberOfNumbers)" />
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
								