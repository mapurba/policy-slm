<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check for match found</description>
									<comment xml:space="preserve">If we found a single matching Sentinel Account, object, generate a modify for that object.

Note that this is doing what the engine would do if the Sentinel-Account object were a real object (rather than a figment of
our fevered imagination).

However, we allow the add operation to propagate (but mark the operation for later stripping), because if we strip it here then the engine in its wisdom displays an alarming yellow status message indicating that the operation was vetoed by the matching rule (and that's not what really happened).
</comment>
									<conditions>
										<and>
											<if-association op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-association direct="true">
											<arg-dn>
												<token-op-property name="src-dn" />
											</arg-dn>
											<arg-association>
												<token-op-property name="association-prefix" />
												<token-text xml:space="preserve">@</token-text>
												<token-association />
											</arg-association>
										</do-add-association>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="add-attr[not(@attr-name='Identity-GUID')]" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="attr-name" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/@attr-name" />
													</arg-string>
												</do-set-local-variable>
												<do-set-dest-attr-value class-name="Sentinel-Account" name="$attr-name$" when="direct">
													<arg-association>
														<token-xpath expression="association" />
													</arg-association>
													<arg-value type="string">
														<token-xpath expression="$current-node/value" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-strip-xpath expression="child::*" />
										<do-set-op-property name="strip-this">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							