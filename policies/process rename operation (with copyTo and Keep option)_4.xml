<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>process rename operation (with copyTo and Keep option)</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.role.rename.option" op="equal">2</if-global-variable>
											<if-global-variable mode="nocase" name="drv.role.copyto.option" op="equal">3</if-global-variable>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-op-property mode="regex" name="renOld" op="equal">.+</if-op-property>
											<if-op-property mode="regex" name="renNew" op="equal">.+</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Keep SAP object </token-text>
												<token-local-variable name="lvDestDN" />
											</arg-string>
										</do-set-local-variable>
										<do-break />
									</actions>
								</rule>
							