<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip dynamicDN from nested group member</description>
									<comment xml:space="preserve">Strip dynamicDN from nested group member</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="$current-op/add-attr[@attr-name=&quot;Member&quot; and contains(value/text(),&quot;[DynamicDN]&quot;)]" />
									</actions>
								</rule>
								