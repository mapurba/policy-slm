<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Block publishing passwords to the ILM Vault when adding a object</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="enable-password-publish" op="equal">false</if-global-variable>
											<if-operation op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										
										<do-strip-xpath expression="password" />
									</actions>
								</rule>
								