<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>add: Add MSSP Customer ID if necessary</description>
									<comment xml:space="preserve">Add the MSSP Customer ID value to the add command's attributes if the customer ID is set.</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-global-variable mode="numeric" name="drv.sentinel.customer.id" op="not-equal">0</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="account" name="cid">
											<arg-value type="string">
												<token-global-variable name="drv.sentinel.customer.id" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								