<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add fanout association</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
											<if-op-property name="lsname" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-association direct="true">
											<arg-dn>
												<token-src-dn />
											</arg-dn>
											<arg-association>
												<token-text xml:space="preserve">fanout1-</token-text>
												<token-attr name="GUID" />
											</arg-association>
										</do-add-association>
										<do-add-association direct="true">
											<arg-dn>
												<token-src-dn />
											</arg-dn>
											<arg-association>
												<token-text xml:space="preserve">fanout2-</token-text>
												<token-attr name="GUID" />
											</arg-association>
										</do-add-association>
									</actions>
								</rule>
							