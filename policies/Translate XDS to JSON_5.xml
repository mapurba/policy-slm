																					<arg-string>
																						<token-src-dn />
																					</arg-string>
																				</do-set-xml-attr>
																				<do-set-xml-attr expression="../scim-driver-operation-data[last()]" name="is-sensitive">
																					<arg-string>
																						<token-text xml:space="preserve">true</token-text>
																					</arg-string>
																				</do-set-xml-attr>
																				<do-set-xml-attr expression="../scim-driver-operation-data[last()]" name="class-name">
																					<arg-string>
																						<token-class-name />
																					</arg-string>
																				</do-set-xml-attr>
																				<do-set-xml-attr expression="../scim-driver-operation-data[last()]" name="event-id">
																					<arg-string>
