<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Translate XDS to JSON</description>
									<conditions>
										<and>
											<if-operation mode="regex" op="not-equal">instance</if-operation>
											<if-operation mode="nocase" op="not-equal">driver-operation-data</if-operation>
											<if-operation mode="nocase" op="not-equal">scim-driver-operation-data</if-operation>
											<if-operation mode="nocase" op="not-equal">delete</if-operation>
											<if-operation mode="nocase" op="not-equal">query</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="regex" op="equal">status</if-operation>
													<if-xpath op="true">count(//nds//instance)&gt;0</if-xpath>
													<if-xpath op="not-true">//instance[@class-name="DirXML-Driver"]</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="status" scope="policy">
													<arg-node-set>
														<token-xml-parse>
															<token-text xml:space="preserve">&lt;status&gt;&lt;/status&gt;</token-text>
														</token-xml-parse>
													</arg-node-set>
												</do-set-local-variable>
												<do-clone-xpath dest-expression="$status/status" src-expression="/nds/*/instance" />
												<do-set-local-variable name="xmlInput" scope="policy">
													<arg-string>
														<token-base64-encode charset="UTF-8">
															<token-replace-all regex="&amp;lt;" replace-with="&lt;">
																<token-xml-serialize>
																	<token-xpath expression="$status" />
																</token-xml-serialize>
															</token-replace-all>
														</token-base64-encode>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="applicationContent">
													<arg-node-set>
														<token-query class-name="convertXDSToJSON">
															<arg-match-attr name="xdsDocument">
																<arg-value>
																	<token-local-variable name="xmlInput" />
																</arg-value>
															</arg-match-attr>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-append-xml-element expression="$current-op" name="scim-driver-operation-data" />
												<do-append-xml-element expression="$current-op/scim-driver-operation-data[last()]" name="header" />
												<do-set-xml-attr expression="$current-op/scim-driver-operation-data[last()]/header" name="Accept">
													<arg-string>
														<token-text xml:space="preserve">application/scim+json</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$current-op/scim-driver-operation-data[last()]" name="response" />
												<do-append-xml-element expression="$current-op/scim-driver-operation-data[last()]/response" name="value" />
												<do-append-xml-text expression="$current-op/scim-driver-operation-data[last()]/response/value" notrace="true">
													<arg-string>
														<token-local-variable name="applicationContent" />
													</arg-string>
												</do-append-xml-text>
												<do-strip-xpath expression="/nds/*/instance" />
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-class-name op="available" />
															<if-class-name mode="nocase" op="not-equal">DirXML-Driver</if-class-name>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="operations" scope="policy">
															<arg-node-set>
																<token-xpath expression="." />
															</arg-node-set>
														</do-set-local-variable>
														<do-for-each>
															<arg-node-set>
																<token-local-variable name="operations" />
															</arg-node-set>
															<arg-actions>
																<do-set-local-variable name="xmlInput" notrace="true" scope="policy">
																	<arg-string>
																		<token-base64-encode charset="UTF-8">
																			<token-replace-all regex="&amp;lt;" replace-with="&lt;">
																				<token-xml-serialize>
																					<token-xpath expression="$current-op" />
																				</token-xml-serialize>
																			</token-replace-all>
																		</token-base64-encode>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="applicationContent" notrace="true" scope="policy">
																	<arg-node-set>
																		<token-query class-name="convertXDSToJSON" scope="entry">
																			<arg-match-attr name="xdsDocument">
																				<arg-value>
																					<token-local-variable name="xmlInput" />
																				</arg-value>
																			</arg-match-attr>
																		</token-query>
																	</arg-node-set>
																</do-set-local-variable>
																<do-if notrace="true">
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="applicationContent" op="not-equal" />
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-operation mode="regex" op="not-equal">query</if-operation>
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-append-xml-element expression=".." name="scim-driver-operation-data" />
