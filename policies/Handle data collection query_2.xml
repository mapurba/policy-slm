<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Handle data collection query</description>
									<comment xml:space="preserve">Convert the data collection query to fetch "User" specific attributes for a query on "Profile" class</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">query</if-operation>
											<if-op-property mode="nocase" name="data-collection-query" op="equal">true</if-op-property>
											<if-class-name mode="nocase" op="equal">Profile</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-op-class-name>
											<arg-string>
												<token-text xml:space="preserve">User</token-text>
											</arg-string>
										</do-set-op-class-name>
										<do-append-xml-element expression="." name="search-class" />
										<do-set-xml-attr expression="./search-class" name="class-name">
											<arg-string>
												<token-text xml:space="preserve">User</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-strip-xpath expression="./search-class[@class-name='Profile']" />
										<do-strip-xpath expression="./read-attr[@attr-name='UserLicenseId']" />
									</actions>
								</rule>
							