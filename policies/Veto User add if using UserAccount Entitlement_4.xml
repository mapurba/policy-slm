<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto User add if using UserAccount Entitlement</description>
									<comment xml:space="preserve">Veto User add if using UserAccount Entitlement</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							