<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add connection-dn as operation property for Entitlement Queries</description>
									<conditions>
										<or>
											<if-op-property mode="nocase" name="Entitlement-Account-Query" op="equal">true</if-op-property>
											<if-op-property mode="nocase" name="Entitlement-Group-Query" op="equal">true</if-op-property>
										</or>
									</conditions>
									<actions>
										<do-set-op-property name="connection-dn">
											<arg-string>
												<token-xpath expression="@connection-dn" />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							