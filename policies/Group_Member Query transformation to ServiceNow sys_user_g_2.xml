<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Group:Member Query transformation to ServiceNow sys_user_grmember</description>
									<comment xml:space="preserve">Group attributes in ServiceNow is distributed across two classes namely sys_user_group(name, desc) and sys_user_grmember (group, user).  The class sys_user_group contains group related attributes and class sys_user_grmember contains group-user membership attributes. This rule </comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-class-name mode="nocase" op="equal">sys_user_group</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">./read-attr[@attr-name='Member']</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="query-grp-members">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-op-property>
												<do-strip-op-attr name="Member" />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							