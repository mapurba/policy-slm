<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto add event if association starts with connection-dn</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Account" op="equal">true</if-global-variable>
											<if-association op="available" />
											<if-op-property name="connection-dn" op="available" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">starts-with(association/text(),operation-data/@connection-dn)</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-veto />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							