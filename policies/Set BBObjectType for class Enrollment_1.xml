<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set BBObjectType for class Enrollment</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">DirXML-BB-Enrollment</if-class-name>
											<if-op-attr name="BBObjectType" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="BBObjectType">
											<arg-string>
												<token-text xml:space="preserve">DirXML-BB-Enrollment</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
								