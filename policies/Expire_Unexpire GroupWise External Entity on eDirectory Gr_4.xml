<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Expire/Unexpire GroupWise External Entity on eDirectory GroupWise External Entity Expire</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="driver.gw.GWExternalEntityExpire" op="equal">expire</if-global-variable>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
											<if-local-variable mode="nocase" name="combinationdone" op="not-equal">true</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">./modify-attr[@attr-name='Login Expiration Time']/remove-value/value</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-clear-dest-attr-value class-name="User" name="NGW: Mailbox Expiration Time" />
												<do-set-local-variable name="entriedexpirationtime" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">./modify-attr[@attr-name='Login Expiration Time']/add-value/value</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-dest-attr-value name="NGW: Mailbox Expiration Time">
													<arg-value type="string">
														
														<token-xpath expression="int:new(date:getTime(date:new()))" />
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-local-variable name="entriedexpirationtime" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								