<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Set Account Status Operation Property</description>
									<comment xml:space="preserve">The rule will set Account Status Operation Property based on disabled value set on the event and also sets Object DN for modify event.</comment>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">add|modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">modify</if-operation>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-query class-name="User" datastore="dest" scope="entry">
															<arg-association>
																<token-association />
															</arg-association>
															<arg-string>
																<token-text xml:space="preserve">dn</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="var-ObjectDN">
															<arg-string>
																<token-xpath expression="$current-node/@src-dn" />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-for-each>
												<do-set-op-property name="AccountTracking-ObjectDN">
													<arg-string>
														<token-local-variable name="var-ObjectDN" />
													</arg-string>
												</do-set-op-property>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="var-AccountStatusChanged" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="disabled" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="var-AccountStatusChanged" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-attr mode="regex" name="~drv.acctTrk.statusAttr~" op="equal">~drv.acctTrk.inactiveStatus~</if-op-attr>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="var-appAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">I</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-idvAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">I</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="var-appAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">A</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-idvAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">A</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-operation mode="nocase" op="equal">add</if-operation>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="var-appAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">~drv.acctTrk.appDefaultStatus~</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-idvAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">~drv.acctTrk.idvDefaultStatus~</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-AccountStatusChanged" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable name="var-AccountStatusChanged" op="equal">true</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-operation mode="nocase" op="equal">modify</if-operation>
															<if-global-variable name="drv.entitlement.remove" op="available" />
															<if-global-variable name="drv.entitlement.remove" op="equal">disable</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="var-idvAccountStatus" scope="policy">
															<arg-string>
																<token-dest-attr name="Login Disabled">
																	<arg-dn>
																		<token-local-variable name="var-ObjectDN" />
																	</arg-dn>
																</token-dest-attr>
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">string-length($var-idvAccountStatus)=0</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="var-idvAccountStatus" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">~drv.acctTrk.idvDefaultStatus~</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="var-idvAccountStatus" op="equal">~drv.acctTrk.idvInactiveStatus~</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="var-idvAccountStatus" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">I</token-text>
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions>
																		<do-set-local-variable name="var-idvAccountStatus" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">A</token-text>
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
												<do-set-op-property name="AccountTracking-AccountStatusChanged">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-op-property>
												<do-set-op-property name="AccountTracking-IdvAccountStatus">
													<arg-string>
														<token-local-variable name="var-idvAccountStatus" />
													</arg-string>
												</do-set-op-property>
												<do-set-op-property name="AccountTracking-AppAccountStatus">
													<arg-string>
														<token-local-variable name="var-appAccountStatus" />
													</arg-string>
												</do-set-op-property>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								