<?xml version="1.0" encoding="UTF-8"?>
<rule disabled="true">
									<description>Break if query for user</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="case" op="equal">query</if-operation>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								