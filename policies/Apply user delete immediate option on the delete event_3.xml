<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Apply user delete immediate option on the delete event</description>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="account.remove" op="equal">delete</if-global-variable>
											<if-global-variable name="account.deleteImmediate" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../delete[@class-name='User']" name="immediate">
											<arg-string>
												<token-global-variable name="account.deleteImmediate" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								