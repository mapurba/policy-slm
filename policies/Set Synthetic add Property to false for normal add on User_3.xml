<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Synthetic add Property to false for normal add on User</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="operation-data" />
										<do-set-xml-attr expression="operation-data" name="synthetic-add">
											<arg-string>
												<token-text xml:space="preserve">false</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								