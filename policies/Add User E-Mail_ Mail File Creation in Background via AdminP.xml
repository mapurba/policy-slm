<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add User E-Mail: Mail File Creation in Background via AdminP</description>
									<conditions>
										<and>
											<if-global-variable name="account.email.createinbackground" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="mailfile-adminp-create">
											<arg-string>
												<token-global-variable name="account.email.createinbackground" />
											</arg-string>
										</do-set-xml-attr>
										<do-set-xml-attr expression="../add[@class-name='User']" name="allow-adminp-support">
											<arg-string>
												<token-text>true</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								