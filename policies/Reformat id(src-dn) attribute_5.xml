<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat id(src-dn) attribute</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">instance</if-operation>
											<if-class-name op="available" />
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="id" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="varSrcDN" scope="policy">
											<arg-string>
												<token-xpath expression="./*[@attr-name=&quot;id&quot;]/value/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="varSrcDN" scope="policy">
											<arg-string>
												<token-replace-first regex="USER." replace-with="">
													<token-local-variable name="varSrcDN" />
												</token-replace-first>
											</arg-string>
										</do-set-local-variable>
										<do-reformat-op-attr name="id">
											<arg-value type="string">
												<token-local-variable name="varSrcDN" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								