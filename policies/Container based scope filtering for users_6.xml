<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Container based scope filtering for users</description>
									<conditions>
										<and>
											<if-src-dn op="available" />
											<if-class-name op="equal">User</if-class-name>
											<if-src-dn op="not-in-subtree">~idv.dit.data.users~</if-src-dn>
											<if-association op="not-associated" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								