<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>process rename operation (with copyTo and Disable option)</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.role.rename.option" op="equal">2</if-global-variable>
											<if-global-variable mode="nocase" name="drv.role.copyto.option" op="equal">1</if-global-variable>
											<if-local-variable mode="nocase" name="lvCopyTo" op="equal">0</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value class-name="US" name="LOCKUSER" when="after">
											<arg-association>
												<token-local-variable name="lvAss" />
											</arg-association>
											<arg-value>
												<token-text xml:space="preserve">1</token-text>
											</arg-value>
										</do-set-dest-attr-value>
										<do-set-local-variable name="lvTmp" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">Disable SAP object </token-text>
												<token-local-variable name="lvDestDN" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								