<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Placement Policy</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-local-variable name="dn" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-set-op-association notrace="true">
											<arg-association>
												<token-local-variable name="association" />
											</arg-association>
										</do-set-op-association>
										<do-append-xml-element expression="operation-data/return-to-me" name="association" />
										<do-append-xml-text expression="operation-data/return-to-me/association">
											<arg-string>
												<token-local-variable name="association" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
							