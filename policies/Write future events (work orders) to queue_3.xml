<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Write future events (work orders) to queue</description>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="drv.futurevent.enable" op="equal">true</if-global-variable>
										</or>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="./modify-attr/add-value/future-event" />
											</arg-node-set>
											<arg-actions>
												<do-trace-message color="brgreen">
													<arg-string>
														<token-text xml:space="preserve">future event: </token-text>
														<token-local-variable name="current-node" />
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="target">
													<arg-string>
														<token-xpath expression="query:readObject($destQueryProcessor, substring-before(substring-after($current-node, 'TARGET='), '#'), '', substring-before(substring-after($current-node, 'CLASS='), '#'), '')/@src-dn" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="target" op="not-equal">.+</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="target" scope="policy">
															<arg-string>
																<token-src-name />
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
												<do-set-local-variable name="validfrom">
													<arg-string>
														<token-xpath expression="substring-before(substring-after($current-node, '#FROM='), '#')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="attrName" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before(substring-after($current-node, '#NAME='), '#')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-local-variable name="validfrom" />
														<token-text xml:space="preserve">#</token-text>
														<token-association />
														<token-text xml:space="preserve">#</token-text>
														<token-local-variable name="attrName" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="dn" scope="policy">
													<arg-string>
														<token-global-variable name="dirxml.auto.driverdn" />
														<token-text xml:space="preserve">\</token-text>
														<token-local-variable name="assoc" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-object class-name="DirXMLWorkOrder" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
												</do-add-dest-object>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-woType" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="string">
														<token-text xml:space="preserve">SAPFEN</token-text>
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-nwoCreationDate" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="time">
														<token-time format="!CTIME" tz="UTC" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-CreatorName" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="string">
														<token-global-variable name="dirxml.auto.driverdn" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-Other1" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="target" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-DueDate" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="validfrom" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-nwoDeleteDueDate" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="validfrom" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-nwoDeleteOnError" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="state">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLsapDMRoot:DirXML-sapDMRootName" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="assoc" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-nwoContent" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="current-node" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-add-dest-attr-value class-name="DirXMLWorkOrder" name="DirXML-nwoStatus" when="before">
													<arg-dn>
														<token-local-variable name="dn" />
													</arg-dn>
													<arg-value type="string">
														<token-text xml:space="preserve">pending</token-text>
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							