<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto Group events</description>
									<conditions>
										<and>
											<if-class-name mode="case" op="equal">Group</if-class-name>
											<if-operation mode="regex" op="equal">add|modify|delete|rename|sync</if-operation>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							