<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Default User Placement</description>
									<conditions>
										<or>
											<if-op-attr name="CN" op="available" />
										</or>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
												<token-text xml:space="preserve">\</token-text>
												<token-escape-for-dest-dn>
													<token-op-attr name="CN" />
												</token-escape-for-dest-dn>
											</arg-dn>
										</do-set-op-dest-dn>
										<do-break />
									</actions>
								</rule>
							