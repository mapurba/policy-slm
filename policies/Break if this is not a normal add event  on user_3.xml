<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if this is not a normal add event  on user</description>
									<conditions>
										<or>
											<if-operation mode="nocase" op="not-equal">add</if-operation>
											<if-class-name mode="nocase" op="not-equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.entitlement.Account" op="equal">true</if-global-variable>
											<if-op-property name="synthetic-add" op="not-available" />
											<if-op-property name="synthetic-add" op="equal">true</if-op-property>
										</or>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								