<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add src-dn to migrate request</description>
									<conditions>
										<and>
											<if-op-attr name="migrate" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-src-dn>
											<arg-dn>
												<token-op-attr name="migrate" />
											</arg-dn>
										</do-set-op-src-dn>
									</actions>
								</rule>
							