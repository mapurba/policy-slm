<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check User For Employee Status State</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr mode="nocase" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:employeeStatus" op="equal">I</if-op-attr>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								