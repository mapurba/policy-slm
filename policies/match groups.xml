<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>match groups</description>
									<comment xml:space="preserve">Match groups in Active Directory based on the object name and relative position in the hierarchy.</comment>
									<conditions>
										<and>
											<if-class-name mode="case" op="equal">Group</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="entry">
											<arg-dn>
												<token-text xml:space="preserve">cn=</token-text>
												<token-op-property name="unmatched-src-dn" />
												<token-text xml:space="preserve">,</token-text>
												<token-global-variable name="ad-base" />
											</arg-dn>
										</do-find-matching-object>
									</actions>
								</rule>
							