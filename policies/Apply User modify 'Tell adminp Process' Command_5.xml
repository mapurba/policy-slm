<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Apply User modify 'Tell adminp Process' Command</description>
									<conditions>
										<and>
											<if-operation op="equal">modify</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable name="account.ModifyAdminPCmd" op="available" />
											<if-global-variable name="account.ModifyAdminPCmd" op="not-equal">default</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../modify[@class-name='User']" name="tell-adminp-process">
											<arg-string>
												<token-global-variable name="account.ModifyAdminPCmd" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							