<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add operation-data and match element for Add User operations</description>
									<comment xml:space="preserve">Add operation-data for Add, Modify, and Delete operations</comment>
									<conditions>
										<or>
											<if-operation mode="case" op="equal">add</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-xpath op="not-true">operation-data</if-xpath>
										</or>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="operation-data" />
										<do-append-xml-element expression="operation-data" name="match" />
									</actions>
								</rule>
							