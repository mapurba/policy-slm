<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>OMVS UID Assignments</description>
									<comment xml:space="preserve">When RACF is configured to assign UID's for new users, the autouid field is set to true.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="racf-uidgid-management" op="equal">RACF</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-default-attr-value name="DirXML-RACF-omvs-autouid">
											<arg-value type="string">
												<token-text xml:space="preserve">true</token-text>
											</arg-value>
										</do-set-default-attr-value>
									</actions>
								</rule>
								