<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Default User Placement</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable name="account.cert.DefaultTypedName" op="available" />
											<if-global-variable name="account.cert.DefaultTypedName" op="not-equal" />
											<if-src-dn op="in-subtree">\~dirxml.auto.treename~\~idv.dit.data.users~</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-text xml:space="preserve">CN=</token-text>
												<token-src-name />
												<token-global-variable name="account.cert.DefaultTypedName" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-break />
									</actions>
								</rule>
								