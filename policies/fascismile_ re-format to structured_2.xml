<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>fascismile: re-format to structured</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="facsimileTelephoneNumber" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="facsimileTelephoneNumber" notrace="true">
											<arg-value type="structured">
												<arg-component name="faxNumber">
													<token-op-attr name="facsimileTelephoneNumber" />
												</arg-component>
												<arg-component name="faxBitCount">
													<token-text xml:space="preserve">0</token-text>
												</arg-component>
												<arg-component name="faxParameters" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								