<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat Telephone number for Google consumption</description>
									<conditions>
										<and>
											<if-op-attr name="WorkPhoneNumber" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lv_WorkPhoneNumber" scope="policy">
											<arg-string>
												<token-xpath expression=".//*[@attr-name='WorkPhoneNumber' and last()]//value[last()]/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-op-attr name="WorkPhoneNumber" />
										<do-set-dest-attr-value name="WorkPhoneNumber">
											<arg-value type="string">
												<token-local-variable name="lv_WorkPhoneNumber" />
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							