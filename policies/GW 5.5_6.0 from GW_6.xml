<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GW 5.5/6.0 from GW</description>
									<conditions>
										<or>
											<if-global-variable name="driver.gw.domainVersion" op="equal">600</if-global-variable>
											<if-global-variable name="driver.gw.domainVersion" op="equal">550</if-global-variable>
										</or>
										<or>
											<if-local-variable name="fromNds" op="equal">false</if-local-variable>
										</or>
										<or>
											<if-class-name op="equal">User</if-class-name>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="company" src-name="55022" />
										<do-rename-op-attr dest-name="Generational Qualifier" src-name="55020" />
										<do-rename-op-attr dest-name="Initials" src-name="55019" />
										<do-rename-op-attr dest-name="personalTitle" src-name="55021" />
										<do-break />
									</actions>
								</rule>
							