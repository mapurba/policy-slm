<?xml version="1.0" encoding="UTF-8"?>
<rule notrace="true">
									<description>Employee-Name-Based (Fixed Length)</description>
									<comment xml:space="preserve">First character of urn:ietf:params:scim:schemas:core:2.0:User:name.givenName + up to (length-1) characters of urn:ietf:params:scim:schemas:core:2.0:User:name.familyName First character of urn:ietf:params:scim:schemas:core:2.0:User:name.givenName + first character of urn:ietf:params:scim:schemas:core:2.0:User:name.honorificPrefix + up to (length-2) characters of urn:ietf:params:scim:schemas:core:2.0:User:name.familyName First two characters of urn:ietf:params:scim:schemas:core:2.0:User:name.givenName + up to (length-2) characters of urn:ietf:params:scim:schemas:core:2.0:User:name.familyName First three characters of urn:ietf:params:scim:schemas:core:2.0:User:name.givenName + up to (length-3) characters of urn:ietf:params:scim:schemas:core:2.0:User:name.familyName First character of urn:ietf:params:scim:schemas:core:2.0:User:name.givenName + up to (length-4) characters of urn:ietf:params:scim:schemas:core:2.0:User:name.familyName + three digits padded with zeros if necessary starting with 001 and incremented until name is unique within ILM </comment>
									<conditions>
										<and>
											<if-global-variable name="drv.new.user.naming.option" op="equal">2</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="surname" scope="policy">
											<arg-string>
												<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="obj-name" scope="policy">
											<arg-string>
												<token-unique-name counter-digits="3" counter-pad="true" name="urn:ietf:params:scim:schemas:ilm:core:1.0:DirXMLsapDMRoot:DirXML-sapDMRootName" scope="subtree">
													<arg-string>
														<token-lower-case>
															<token-substring length="1">
																<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-1)" />
														</token-lower-case>
													</arg-string>
													<arg-string>
														<token-lower-case>
															<token-substring length="1">
																<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
															</token-substring>
															<token-substring length="1">
																<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.honorificPrefix" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-2)" />
														</token-lower-case>
													</arg-string>
													<arg-string>
														<token-lower-case>
															<token-substring length="2">
																<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-2)" />
														</token-lower-case>
													</arg-string>
													<arg-string>
														<token-lower-case>
															<token-substring length="3">
																<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-3)" />
														</token-lower-case>
													</arg-string>
													<arg-string>
														<token-lower-case>
															<token-substring length="1">
																<token-attr name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
															</token-substring>
															<token-xpath expression="substring($surname,1,number(~drv.new.user.naming.2.length~)-4)" />
														</token-lower-case>
													</arg-string>
												</token-unique-name>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								