<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add association if necessary</description>
									<conditions>
										<and>
											<if-association op="not-available" />
											<if-operation mode="nocase" op="not-equal">trigger</if-operation>
										</and>
									</conditions>
									<actions>
										<do-add-association direct="true">
											<arg-dn>
												<token-src-dn />
											</arg-dn>
											<arg-association>
												<token-attr name="GUID" />
											</arg-association>
										</do-add-association>
									</actions>
								</rule>
							