<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reset user status for future hire</description>
									<comment xml:space="preserve">In case of future hire, we are polling records as on hire date but chnaging the user status wd-E-active or wd-C-active as 0</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-local-variable mode="regex" name="LV-wd-FutureHire" op="equal">True</if-local-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="wd-E-Active" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-op-attr name="wd-E-Active" />
												<do-set-dest-attr-value class-name="User" name="wd-E-Active">
													<arg-value type="string">
														<token-text xml:space="preserve">0</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="wd-C-Active" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-op-attr name="wd-C-Active" />
												<do-set-dest-attr-value class-name="User" name="wd-C-Active">
													<arg-value type="string">
														<token-text xml:space="preserve">0</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							