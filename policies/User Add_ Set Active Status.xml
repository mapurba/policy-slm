<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Add: Set Active Status</description>
									<comment xml:space="preserve">If Login Disabled is present and true, set the newly created account as inactive.  Otherwise set the newly created account as active.</comment>
									<comment name="author" xml:space="preserve">Converge</comment>
									<comment name="version" xml:space="preserve">1.0</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="Login Disabled" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-dest-attr-value name="Login Disabled">
											<arg-value type="string">
												<token-text xml:space="preserve">false</token-text>
											</arg-value>
										</do-set-dest-attr-value>
									</actions>
								</rule>
							