<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match on Interenet Email Address</description>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">DirXML-GAContact</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="Internet EMail Address" />
										</do-find-matching-object>
									</actions>
								</rule>
							