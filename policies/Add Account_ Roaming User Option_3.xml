<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description> Add Account: Roaming User Option</description>
									<conditions>
										<and>
											<if-global-variable name="account.roam" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../add[@class-name='User']" name="roaming-user">
											<arg-string>
												<token-global-variable name="account.roam" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								