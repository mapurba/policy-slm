<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User account entitlement: Veto if User not entitled to an account</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
											<if-entitlement name="UserAccount" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">NOVLSFENT: Veto User matching: UserAccount entitlements required</token-text>
											</arg-string>
										</do-trace-message>
										<do-veto />
									</actions>
								</rule>
							