<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Generate Random Password if no Distribution Password available and GCV is set to random</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLBNNRPSWD.InitialPassword" op="equal">random</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-dest-password>
											<arg-string>
												<token-xpath expression="es:createPassword4(($gcv.NOVLBNNRPSWD.RandomPasswordNumberOfLetters + $gcv.NOVLBNNRPSWD.RandomPasswordNumberOfNumbers), $gcv.NOVLBNNRPSWD.RandomPasswordNumberOfLetters, $gcv.NOVLBNNRPSWD.RandomPasswordNumberOfNumbers)" />
											</arg-string>
										</do-set-dest-password>
									</actions>
								</rule>
								