<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Store the target container</description>
									<conditions>
										<and>
											<if-global-variable name="idv.dit.data.groups" op="not-equal" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="idmGroupsBaseContainer">
											<arg-string>
												<token-global-variable name="idv.dit.data.groups" />
												<token-text xml:space="preserve">\</token-text>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								