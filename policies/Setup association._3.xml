<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Setup association.</description>
									<conditions>
										<and>
											<if-operation op="equal">instance</if-operation>
											<if-xpath op="true">.[position() = 1]</if-xpath>
											<if-op-property name="op-type" op="equal">query</if-op-property>
											<if-op-property name="association" op="available" />
											<if-op-property name="association" op="not-equal" />
											<if-xpath op="true">association/text() = ''</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-append-xml-text expression="association">
											<arg-string>
												<token-op-property name="association" />
											</arg-string>
										</do-append-xml-text>
										<do-strip-xpath expression="operation-data" />
									</actions>
								</rule>
							