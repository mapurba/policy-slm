<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Account Entitlement change (Block Option)</description>
									<comment xml:space="preserve">The User Account Entitlement grants the user an enabled account EMP in Epic. Revoking the entitlement will disable, block, or delete the EMP depending on the value you select for the 'When account entitlement revoked' global variable. This rule executes when the entitlement is changing and you have selected the block option.</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.entitlement.remove" op="equal">block</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="UserAccount" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="UserAccount" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="lv-BlockStatus" scope="policy">
													<arg-object>
														<token-xpath expression="es:BlockStatus(&quot;True&quot;, &quot;0&quot;, &quot;0&quot;, $pdsempentl.block.comment)" />
													</arg-object>
												</do-set-local-variable>
												<do-set-dest-attr-value name="BlockStatus">
													<arg-value type="string">
														<token-xpath expression="es:BlockStatus_jsonify($lv-BlockStatus)" />
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-dest-attr-value name="IsActive">
													<arg-value type="string">
														<token-global-variable name="drv.entitlement.remove.block.inactivate" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="UserAccount" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="lv-BlockStatus" scope="policy">
													<arg-object>
														<token-xpath expression="es:BlockStatus(&quot;False&quot;, &quot;0&quot;, &quot;0&quot;, &quot;Cleared by IDM&quot;)" />
													</arg-object>
												</do-set-local-variable>
												<do-set-dest-attr-value name="BlockStatus">
													<arg-value type="string">
														<token-xpath expression="es:BlockStatus_jsonify($lv-BlockStatus)" />
													</arg-value>
												</do-set-dest-attr-value>
												<do-set-dest-attr-value name="IsActive">
													<arg-value type="string">
														<token-text xml:space="preserve">true</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								