<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto Publisher Add Events</description>
									<comment xml:space="preserve">Veto Add Events from publisher</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">In Limited Entitlement Mode, veto publisher add event</token-text>
											</arg-string>
										</do-trace-message>
										<do-veto />
									</actions>
								</rule>
								