<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto rename operation on user</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">rename</if-operation>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								