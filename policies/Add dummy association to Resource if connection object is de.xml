<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add dummy association to Resource if connection object is deleted</description>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
											<if-class-name op="equal">Resource</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="association" />
										<do-append-xml-text expression="association">
											<arg-string>
												<token-text xml:space="preserve">__FO_CONNECTION__</token-text>
											</arg-string>
										</do-append-xml-text>
										<do-set-xml-attr expression="association" name="state">
											<arg-string>
												<token-text xml:space="preserve">dummyAssociation</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								