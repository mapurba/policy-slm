<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match on username</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="urn:ietf:params:scim:schemas:core:2.0:User:userName">
												<arg-value type="string">
													<token-src-name />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
									</actions>
								</rule>
								