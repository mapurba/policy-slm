<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Job Profile: Create CN for Job Profile</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">wd-Jobprofile</if-class-name>
											<if-attr name="wd-JobCode" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="wd-Jobprofile" name="CN">
											<arg-value type="string">
												<token-attr name="wd-JobCode" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
							