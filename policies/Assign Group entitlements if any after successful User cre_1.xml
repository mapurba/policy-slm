<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Assign Group entitlements if any after successful User creation</description>
									<comment xml:space="preserve">Group entitlements assigned to User being created in ServiceNow cannot be processed until the User is successfully created. The add-association signals that an object has been created by the driver in ServiceNow. If the object is also tagged for Group entitlement processing, assign the Group entitlements now.</comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Group" op="equal">true</if-global-variable>
											<if-operation op="equal">add-association</if-operation>
											<if-op-property mode="nocase" name="check-group-entitlements" op="equal">true</if-op-property>
											<if-entitlement name="Group" op="available" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-entitlement name="Group" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="userId" scope="policy">
													<arg-string>
														<token-xpath expression="./text()" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="groupId" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="dest-dn" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">/</token-text>
														<token-local-variable name="groupId" />
														<token-text xml:space="preserve">$</token-text>
														<token-local-variable name="userId" />
														<token-text xml:space="preserve">/RELATION</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-add-src-object class-name="sys_user_grmember">
													<arg-dn>
														<token-local-variable name="dest-dn" />
													</arg-dn>
												</do-add-src-object>
												<do-add-src-attr-value class-name="sys_user_grmember" name="group">
													<arg-dn>
														<token-local-variable name="dest-dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="groupId" />
													</arg-value>
												</do-add-src-attr-value>
												<do-add-src-attr-value class-name="sys_user_grmember" name="user">
													<arg-dn>
														<token-local-variable name="dest-dn" />
													</arg-dn>
													<arg-value type="string">
														<token-local-variable name="userId" />
													</arg-value>
												</do-add-src-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							