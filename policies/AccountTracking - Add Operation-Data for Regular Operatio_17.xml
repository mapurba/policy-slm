<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Add Operation-Data for Regular Operations</description>
									<comment xml:space="preserve">The rule will add IDV and APP login disabled attribute values and other identifiers value to be reported in accounts.</comment>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">add|modify|delete|rename|move</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="AccountTracking-Operation">
											<arg-string>
												<token-operation />
											</arg-string>
										</do-set-op-property>
										<do-if>
											<arg-conditions>
												<and>
													<if-association op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="AccountTracking-association">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-op-property>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="var-idvAccountStatus" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="var-appAccountStatus" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="~drv.acctTrk.statusAttr~" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-attr mode="nocase" name="~drv.acctTrk.statusAttr~" op="equal">~drv.acctTrk.idvActiveStatus~</if-op-attr>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="var-appAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">A</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-idvAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">A</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions>
														<do-set-local-variable name="var-appAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">I</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-idvAccountStatus" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">I</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-if>
												<do-set-local-variable name="var-accountStatusChanged" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-operation mode="nocase" op="equal">modify</if-operation>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="var-idvLoginDisabled" scope="policy">
															<arg-string>
																<token-src-attr name="Login Disabled" />
															</arg-string>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="var-idvLoginDisabled" op="equal">~drv.acctTrk.idvActiveStatus~</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="var-idvAccountStatus" scope="policy">
																	<arg-string>
																		<token-text xml:space="preserve">A</token-text>
																	</arg-string>
																</do-set-local-variable>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="var-idvLoginDisabled" op="equal">~drv.acctTrk.idvInactiveStatus~</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="var-idvAccountStatus" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">I</token-text>
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions>
																		<do-set-local-variable name="var-idvAccountStatus" scope="policy">
																			<arg-string>
																				<token-global-variable name="drv.acctTrk.idvDefaultStatus" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-operation mode="nocase" op="equal">add</if-operation>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="var-idvAccountStatus" scope="policy">
															<arg-string>
																<token-global-variable name="drv.acctTrk.idvDefaultStatus" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="var-accountStatusChanged" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">true</token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="drv.acctTrk.identifiers" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-attr name="$current-node$" op="available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-property name="AccountTracking-$current-node$">
															<arg-string>
																<token-op-attr name="$current-node$" />
															</arg-string>
														</do-set-op-property>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-set-op-property name="AccountTracking-ObjectDN">
											<arg-string>
												<token-src-dn />
											</arg-string>
										</do-set-op-property>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="var-accountStatusChanged" op="equal">true</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-property name="AccountTracking-AccountStatusChanged">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-op-property>
												<do-set-op-property name="AccountTracking-IdvAccountStatus">
													<arg-string>
														<token-local-variable name="var-idvAccountStatus" />
													</arg-string>
												</do-set-op-property>
												<do-set-op-property name="AccountTracking-AppAccountStatus">
													<arg-string>
														<token-local-variable name="var-appAccountStatus" />
													</arg-string>
												</do-set-op-property>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							