<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update check-object-password status for modify-password operation </description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
											<if-xpath op="true">$current-op[@event-id="check-password-for-modify-password"]</if-xpath>
											<if-xpath op="not-true">$current-op[@level="success"]</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="$current-op" name="level">
											<arg-string>
												<token-text xml:space="preserve">warning</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							