<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - on add-association sync the operation-properties to status operations</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="isLoginDisabled" scope="policy">
											<arg-string>
												<token-dest-attr name="Login Disabled">
													<arg-dn>
														<token-dest-dn />
													</arg-dn>
												</token-dest-attr>
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="isLoginDisabled" op="equal">true</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="var-idvAccountStatus" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">I</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="var-idvAccountStatus" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">A</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="var-appAccountStatus" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-set-op-property name="AccountTracking-ObjectDN">
											<arg-string>
												<token-dest-dn />
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="AccountTracking-IdvAccountStatus">
											<arg-string>
												<token-local-variable name="var-idvAccountStatus" />
											</arg-string>
										</do-set-op-property>
										<do-set-op-property name="AccountTracking-AppAccountStatus">
											<arg-string>
												<token-local-variable name="var-appAccountStatus" />
											</arg-string>
										</do-set-op-property>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="drv.acctTrk.identifiers" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="current-node" op="equal">LDAPDN</if-local-variable>
															<if-op-property name="AccountTracking-$current-node$" op="not-available" />
															<if-src-dn op="available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-op-property name="AccountTracking-$current-node$">
															<arg-string>
																<token-src-dn />
															</arg-string>
														</do-set-op-property>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="current-node" op="equal">association</if-local-variable>
																	<if-op-property name="AccountTracking-$current-node$" op="not-available" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-op-property name="AccountTracking-association">
																	<arg-string>
																		<token-xpath expression="text()" />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-op-property name="AccountTracking-$current-node$" op="not-available" />
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-op-property name="AccountTracking-$current-node$">
																			<arg-string>
																				<token-src-attr class-name="user" name="$current-node$">
																					<arg-association>
																						<token-xpath expression="text()" />
																					</arg-association>
																				</token-src-attr>
																			</arg-string>
																		</do-set-op-property>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								