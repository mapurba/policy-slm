<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Block add operation if connected system is authoritative source</description>
									<comment xml:space="preserve">Block add operation if Oracle EBS HR is the  authoritative source of data.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="drv.publisher.auth" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								