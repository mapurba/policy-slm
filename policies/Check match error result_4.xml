<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check match error result</description>
									<comment xml:space="preserve">Issue an error if we found multiple matching objects (mimic engine behavior).</comment>
									<conditions>
										<and>
											<if-xpath op="true">count(association) &gt; 1</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-status level="error">
											<arg-string>
												<token-text xml:space="preserve">Multiple matching account objects found.</token-text>
											</arg-string>
										</do-status>
										<do-veto />
									</actions>
								</rule>
								