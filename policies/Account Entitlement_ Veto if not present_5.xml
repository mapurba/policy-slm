<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account Entitlement: Veto if not present</description>
									
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.entitlement.GWAccount" op="equal">true</if-global-variable>
											<if-entitlement name="gwAccount" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							