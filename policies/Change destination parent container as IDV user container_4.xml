<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Change destination parent container as IDV user container</description>
									<conditions>
										<and>
											<if-operation op="equal">move</if-operation>
											<if-xpath op="true">./parent/@src-dn=$drv.edir.base.container</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-move-dest-object>
											<arg-dn>
												<token-global-variable name="idv.dit.data.users" />
											</arg-dn>
										</do-move-dest-object>
										<do-strip-xpath expression="." />
									</actions>
								</rule>
							