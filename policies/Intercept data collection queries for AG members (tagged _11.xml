<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Intercept data collection queries for AG members (tagged identity query) response</description>
									<conditions>
										<and>
											<if-xpath op="true">//status[@event-id='query-driver-ident']/operation-data/@ActivityGroupEntitlementMemberAssignmentQuery</if-xpath>
											<if-operation mode="case" op="equal">instance</if-operation>
											<if-class-name mode="nocase" op="equal">__driver_identification_class__</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">ILMSAPUFENT: Data collection query for activity group member assignment intercepted from OTP. Processing query.</token-text>
											</arg-string>
										</do-trace-message>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">ILMSAPUFENT: Retrieving all activity groups.</token-text>
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="activityGroups" scope="policy">
											<arg-node-set>
												<token-xpath expression="query:query($srcQueryProcessor, $ILMSAPUFENT.ActivityGroupEntitlementMemberAssignmentQuery)" />
											</arg-node-set>
										</do-set-local-variable>
										<do-strip-xpath expression="$activityGroups/nds/output/instance/attr[@attr-name='AG:MEMBERS']/value[string-length(./text())=0]" />
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">ILMSAPUFENT: Retrieved </token-text>
												<token-xpath expression="count($activityGroups/nds/output/instance)" />
												<token-text xml:space="preserve"> activity groups.</token-text>
											</arg-string>
										</do-trace-message>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">ILMSAPUFENT: Retrieving all users and activity group assignments.</token-text>
											</arg-string>
										</do-trace-message>
										<do-set-local-variable name="users" scope="policy">
											<arg-node-set>
												<token-query class-name="US" datastore="src">
													<arg-dn>
														<token-xpath expression="$ILMSAPUFENT.ActivityGroupEntitlementMemberAssignmentQuery/nds/input/query/@dest-dn" />
													</arg-dn>
													<arg-string>
														<token-text xml:space="preserve">ACTIVITYGROUPS:AGR_NAME</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">USERNAME:BAPIBNAME</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">ILMSAPUFENT: Retrieved </token-text>
												<token-xpath expression="count($users)" />
												<token-text xml:space="preserve"> users. Optimizing result set.</token-text>
											</arg-string>
										</do-trace-message>
										<do-strip-xpath expression="$users[count(attr[@attr-name='ACTIVITYGROUPS:AGR_NAME'])=0]" />
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">ILMSAPUFENT: Result set optimized: </token-text>
												<token-xpath expression="count($users)" />
												<token-text xml:space="preserve"> users.</token-text>
											</arg-string>
										</do-trace-message>
										<do-strip-xpath expression="attr" />
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">ILMSAPUFENT: Merging results.</token-text>
											</arg-string>
										</do-trace-message>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$activityGroups/nds/output/instance" />
											</arg-node-set>
											<arg-actions>
												<do-clone-xpath dest-expression=".." src-expression="$current-node" />
												<do-append-xml-element expression="../instance[last()]" name="attr" />
												<do-set-xml-attr expression="../instance[last()]/attr[last()]" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">AG:MEMBERS</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="$users[attr[@attr-name='ACTIVITYGROUPS:AGR_NAME']/value/text()=$current-node/attr[@attr-name='OBJECTS:EXT_OBJ_ID']/value/text()]" />
													</arg-node-set>
													<arg-actions>
														<do-append-xml-element expression="../instance[last()]/attr[@attr-name='AG:MEMBERS']" name="value" />
														<do-append-xml-text expression="../instance[last()]/attr[@attr-name='AG:MEMBERS']/value[last()]">
															<arg-string>
																<token-xpath expression="$current-node/@src-dn" />
															</arg-string>
														</do-append-xml-text>
														<do-set-xml-attr expression="../instance[last()]/attr[@attr-name='AG:MEMBERS']/value[last()]" name="association">
															<arg-string>
																<token-xpath expression="$current-node/association/text()" />
															</arg-string>
														</do-set-xml-attr>
														<do-set-xml-attr expression="../instance[last()]/attr[@attr-name='AG:MEMBERS']/value[last()]" name="type">
															<arg-string>
																<token-text xml:space="preserve">{dn}</token-text>
															</arg-string>
														</do-set-xml-attr>
													</arg-actions>
												</do-for-each>
												<do-strip-xpath expression="../instance[last()]/attr[@attr-name='AG:MEMBERS'][count(value)=0]" />
											</arg-actions>
										</do-for-each>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">ILMSAPUFENT: Results merged.</token-text>
											</arg-string>
										</do-trace-message>
										<do-strip-xpath expression=".[count(attr)=0]" />
										<do-set-local-variable name="activityGroups" scope="policy">
											<arg-string />
										</do-set-local-variable>
										<do-set-local-variable name="users" scope="policy">
											<arg-string />
										</do-set-local-variable>
									</actions>
								</rule>
								