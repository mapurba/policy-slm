<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User: Required Attributes</description>
									<comment xml:space="preserve">Veto the event if all required attributes are not present</comment>
									<comment name="author" xml:space="preserve">Converge</comment>
									<comment name="version" xml:space="preserve">1.0</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="~pdsepicsdcfg.serid.attribute.map~" />
									</actions>
								</rule>
								