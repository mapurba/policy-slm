<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set the domain name for query operations of Credential objects.</description>
									<comment xml:space="preserve">The parent container is the domain name of the Credential objects.</comment>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-class-name mode="nocase" op="equal">DirXML-PUMCredential</if-class-name>
											<if-xpath op="not-true">./search-attr</if-xpath>
											<if-dest-dn op="available" />
										</and>
									</conditions>
									<actions>
										<do-trace-message level="5">
											<arg-string>
												<token-text xml:space="preserve">Setting the domain name of the credential object  </token-text>
												<token-dest-dn />
											</arg-string>
										</do-trace-message>
										<do-append-xml-element expression="." name="search-attr" />
										<do-set-xml-attr expression="./search-attr" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">DirXML-pumAccDomName</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="./search-attr" name="value" />
										<do-append-xml-text expression="./search-attr/value">
											<arg-string>
												<token-attr name="DirXML-pumAccDomName" />
												<token-dest-dn length="1" start="-2" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
								