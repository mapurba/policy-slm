<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strip operation attribute 'NOVLNOTEASTS-denyAccess'</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.account.status.DenyAccessGroup.use" op="equal">true</if-global-variable>
											<if-op-attr name="NOVLNOTEASTS-denyAccess" op="available" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="NOVLNOTEASTS-denyAccess" />
									</actions>
								</rule>
							