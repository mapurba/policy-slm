<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Add interested properties to current doc for future use [Regular Operations].</description>
									<comment xml:space="preserve">Will be looked in future</comment>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">add|modify|delete|rename|move</if-operation>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="jfoactrk.AccIdentifiers" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="current-node" op="equal">idu|pk_idu</if-local-variable>
															<if-op-property name="AccountTracking-$current-node$" op="not-available" />
															<if-association op="available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="idu" scope="policy">
															<arg-node-set>
																<token-query class-name="~jfoactrk.ObjectClass~" datastore="src" scope="entry">
																	<arg-association>
																		<token-src-dn />
																	</arg-association>
																	<arg-string>
																		<token-text xml:space="preserve">$current-node$</token-text>
																	</arg-string>
																</token-query>
															</arg-node-set>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">string-length($idu) &gt; 0</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-op-property name="AccountTracking-$current-node$">
																	<arg-string>
																		<token-xpath expression="$idu/attr[last()]/value/text()" />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="current-node" op="equal">association</if-local-variable>
																	<if-op-property name="AccountTracking-$current-node$" op="not-available" />
																	<if-association op="available" />
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-op-property name="AccountTracking-$current-node$">
																	<arg-string>
																		<token-association />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-op-property name="AccountTracking-$current-node$" op="not-available" />
																			<if-op-attr name="$current-node$" op="available" />
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-op-property name="AccountTracking-$current-node$">
																			<arg-string>
																				<token-op-attr name="$current-node$" />
																			</arg-string>
																		</do-set-op-property>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
												</do-if>
												<do-trace-message>
													<arg-string>
														<token-local-variable name="idu" />
													</arg-string>
												</do-trace-message>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								