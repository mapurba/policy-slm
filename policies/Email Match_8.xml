<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Email Match</description>
									<comment xml:space="preserve">On an add operation, if Internet Email Address is part of the add, this rule will try to match the object being added to an existing Salesforce.com object.</comment>
									<conditions>
										<and>
											<if-op-attr name="Internet EMail Address" op="available" />
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="Internet EMail Address" />
										</do-find-matching-object>
									</actions>
								</rule>
							