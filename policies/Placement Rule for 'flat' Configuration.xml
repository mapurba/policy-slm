<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Placement Rule for 'flat' Configuration</description>
									<conditions>
										<or>
											<if-global-variable mode="nocase" name="drv.subPlacementType" op="equal">flat</if-global-variable>
										</or>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-src-dn convert="true" length="1" start="-1" />
												<token-text xml:space="preserve">,</token-text>
												<token-global-variable name="drv.edir.base.container" />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
								