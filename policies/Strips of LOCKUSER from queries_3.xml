<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Strips of LOCKUSER from queries</description>
									<conditions>
										<and>
											<if-operation mode="nocase" op="equal">query</if-operation>
											<if-attr name="LOCKUSER" op="available" />
										</and>
									</conditions>
									<actions>
										
										
										<do-strip-op-attr name="LOCKUSER" />
										<do-set-op-property name="lockuser">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							