<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initialize Registration Cache</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="regex" name="drv.registration.msgw.driverdn" op="equal">.+</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="dvr" scope="policy">
													<arg-node-set>
														<token-query class-name="DirXML-Driver">
															<arg-dn>
																<token-parse-dn dest-dn-format="slash" src-dn-format="ldap">
																	<token-global-variable name="drv.registration.msgw.driverdn" />
																</token-parse-dn>
															</arg-dn>
															<arg-string>
																<token-text xml:space="preserve">GUID</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">DirXML-ShimConfigInfo</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">DirXML-ShimAuthServer</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">DirXML-JavaModule</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">MSGW Drv Reg: </token-text>
														<token-text xml:space="preserve">Invalid Managed System Gateway Driver DN specified in driver parameters.</token-text>
													</arg-string>
												</do-trace-message>
												<do-status level="error">
													<arg-string>
														<token-text xml:space="preserve">Invalid Managed System Gateway Driver DN specified in driver parameters.</token-text>
													</arg-string>
												</do-status>
												<do-set-local-variable name="dvr" scope="policy">
													<arg-node-set />
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="REGN__CACHE" scope="driver">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;cache/&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="$dvr" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="driverGuid" scope="policy">
													<arg-string>
														<token-xpath expression="es:guid2string($current-node/attr[@attr-name='GUID']/value/text())" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="driverParams" scope="policy">
													<arg-node-set>
														<token-xml-parse>
															<token-base64-decode>
																<token-xpath expression="$current-node/attr[@attr-name='DirXML-ShimConfigInfo']/value/text()" />
															</token-base64-decode>
														</token-xml-parse>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="driverAuthSrv" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/attr[@attr-name='DirXML-ShimAuthServer']/value/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="driverJavaModule" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/attr[@attr-name='DirXML-JavaModule']/value/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-trace-message>
													<arg-string>
														<token-text xml:space="preserve">MSGW Drv Reg: Found driver: </token-text>
														<token-xpath expression="$current-node/@src-dn" />
														<token-text xml:space="preserve"> with GUID: </token-text>
														<token-local-variable name="driverGuid" />
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="address" scope="policy">
													<arg-string>
														<token-global-variable name="drv.registration.msgw.override.address" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="address" op="not-equal">.+</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="values" scope="policy">
															<arg-node-set>
																<token-split delimiter=",">
																	<token-xpath expression="$driverParams//definition[@name='ip-address']/value" />
																</token-split>
															</arg-node-set>
														</do-set-local-variable>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">string-length($values[1])&gt;0</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="address" scope="policy">
																	<arg-string>
																		<token-xpath expression="$values[1]" />
																	</arg-string>
																</do-set-local-variable>
																<do-trace-message>
																	<arg-string>
																		<token-text xml:space="preserve">MSGW Drv Reg: Address(es)[ip-address]=$address$ (from shim params)</token-text>
																	</arg-string>
																</do-trace-message>
															</arg-actions>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="case" name="driverJavaModule" op="equal">com.novell.nds.dirxml.remote.driver.DriverShimImpl</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-if>
																			<arg-conditions>
																				<and>
																					<if-xpath op="true">starts-with($driverAuthSrv,'REMOTE(')</if-xpath>
																				</and>
																			</arg-conditions>
																			<arg-actions>
																				<do-set-local-variable name="address" scope="policy">
																					<arg-string>
																						<token-xpath expression="substring-before(substring-after($driverAuthSrv, 'hostname='), ' ')" />
																					</arg-string>
																				</do-set-local-variable>
																				<do-if>
																					<arg-conditions>
																						<and>
																							<if-local-variable mode="regex" name="address" op="equal">.+</if-local-variable>
																						</and>
																					</arg-conditions>
																					<arg-actions>
																						<do-trace-message>
																							<arg-string>
																								<token-text xml:space="preserve">MSGW Drv Reg: Address(es)[ip-address]=$address$ (from remote loader connection params)</token-text>
																							</arg-string>
																						</do-trace-message>
																					</arg-actions>
																					<arg-actions>
																						<do-trace-message>
																							<arg-string>
																								<token-text xml:space="preserve">MSGW Drv Reg: Unable to obtain Address(es)[ip-address] from remote loader connection params</token-text>
																							</arg-string>
																						</do-trace-message>
																					</arg-actions>
																				</do-if>
																			</arg-actions>
																			<arg-actions>
																				<do-trace-message>
																					<arg-string>
																						<token-text xml:space="preserve">MSGW Drv Reg: Unable to obtain Address(es)[ip-address] from remote loader connection params</token-text>
																					</arg-string>
																				</do-trace-message>
																			</arg-actions>
																		</do-if>
																	</arg-actions>
																	<arg-actions>
																		<do-set-local-variable name="ncpServer" scope="policy">
																			<arg-node-set>
																				<token-query class-name="NCP Server" scope="entry">
																					<arg-dn>
																						<token-parse-dn src-dn-format="ldap">
																							<token-global-variable name="dirxml.auto.localserverdn" />
																						</token-parse-dn>
																					</arg-dn>
																					<arg-string>
																						<token-text xml:space="preserve">Network Address</token-text>
																					</arg-string>
																				</token-query>
																			</arg-node-set>
																		</do-set-local-variable>
																		<do-set-local-variable name="netAddrs" scope="policy">
																			<arg-node-set>
																				<token-xpath expression="$ncpServer/attr[@attr-name='Network Address']/value[component[@name='netAddrType']/text()=9]/component[@name='netAddr']/text()" />
																			</arg-node-set>
																		</do-set-local-variable>
																		<do-for-each>
																			<arg-node-set>
																				<token-local-variable name="netAddrs" />
																			</arg-node-set>
																			<arg-actions>
																				<do-set-local-variable name="value" scope="policy">
																					<arg-string>
																						<token-xpath expression="es:getIPFromHexNetAddr(es:octet2AsciiHex($current-node))" />
																					</arg-string>
																				</do-set-local-variable>
																				<do-if>
																					<arg-conditions>
																						<and>
																							<if-local-variable mode="regex" name="value" op="not-equal">127.+</if-local-variable>
																							<if-local-variable mode="regex" name="address" op="not-equal">.+</if-local-variable>
																						</and>
																					</arg-conditions>
																					<arg-actions>
																						<do-set-local-variable name="address" scope="policy">
																							<arg-string>
																								<token-local-variable name="value" />
																							</arg-string>
																						</do-set-local-variable>
																						<do-trace-message>
																							<arg-string>
																								<token-text xml:space="preserve">MSGW Drv Reg: Address(es)[ip-address]=$address$ (from NCP server object [$dirxml.auto.localserverdn$])</token-text>
																							</arg-string>
																						</do-trace-message>
																					</arg-actions>
																					<arg-actions />
																				</do-if>
																			</arg-actions>
																		</do-for-each>
																	</arg-actions>
																</do-if>
															</arg-actions>
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">MSGW Drv Reg Parameter Override: Address(es)[ip-address]=$address$</token-text>
															</arg-string>
														</do-trace-message>
													</arg-actions>
												</do-if>
												<do-set-local-variable name="port" scope="policy">
													<arg-string>
														<token-global-variable name="drv.registration.msgw.override.port" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="port" op="not-equal">.+</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="port" scope="policy">
															<arg-string>
																<token-xpath expression="$driverParams//definition[@name='https-port']/value" />
															</arg-string>
														</do-set-local-variable>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">MSGW Drv Reg: Port[https-port]=$port$ (from shim params)</token-text>
															</arg-string>
														</do-trace-message>
													</arg-actions>
													<arg-actions>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">MSGW Drv Reg Parameter Override: Port[https-port]=$port$</token-text>
															</arg-string>
														</do-trace-message>
													</arg-actions>
												</do-if>
												<do-set-local-variable name="context" scope="policy">
													<arg-string>
														<token-global-variable name="drv.registration.msgw.override.context" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="context" op="not-equal">.+</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="context" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">idvdata</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">MSGW Drv Reg: Context=$context$ (hard-coded default)</token-text>
															</arg-string>
														</do-trace-message>
													</arg-actions>
													<arg-actions>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">MSGW Drv Reg Parameter Override: Context=$context$</token-text>
															</arg-string>
														</do-trace-message>
													</arg-actions>
												</do-if>
												<do-set-local-variable name="cert" scope="policy">
													<arg-string>
														<token-global-variable name="drv.registration.msgw.override.cert" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="regex" name="cert" op="not-equal">.+</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-global-variable mode="nocase" name="drv.registration.msgw.driver-config-mode" op="equal">local</if-global-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-set-local-variable name="container" scope="policy">
																	<arg-string>
																		<token-parse-dn length="-2" src-dn-format="ldap">
																			<token-global-variable name="dirxml.auto.localserverdn" />
																		</token-parse-dn>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="kmo" scope="policy">
																	<arg-string>
																		<token-xpath expression="$driverParams//definition[@name='kmo-name']/value" />
																		<token-text xml:space="preserve"> - </token-text>
																		<token-parse-dn dest-dn-format="slash" length="1" src-dn-format="ldap" start="-1">
																			<token-global-variable name="dirxml.auto.localserverdn" />
																		</token-parse-dn>
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="cert-dn" scope="policy">
																	<arg-string>
																		<token-local-variable name="container" />
																		<token-text xml:space="preserve">\</token-text>
																		<token-local-variable name="kmo" />
																	</arg-string>
																</do-set-local-variable>
																<do-set-local-variable name="cert" scope="policy">
																	<arg-string>
																		<token-dest-attr class-name="NDSPKI:Key Material" name="NDSPKI:Public Key Certificate">
																			<arg-dn>
																				<token-local-variable name="cert-dn" />
																			</arg-dn>
																		</token-dest-attr>
																	</arg-string>
																</do-set-local-variable>
																<do-trace-message>
																	<arg-string>
																		<token-text xml:space="preserve">MSGW Drv Reg: Certificate=&lt;Base64-encoded data [</token-text>
																		<token-xpath expression="string-length($cert)" />
																		<token-text xml:space="preserve"> characters]&gt; (from lookup based on shim params [$cert-dn$])</token-text>
																	</arg-string>
																</do-trace-message>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
													<arg-actions>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">MSGW Drv Reg Parameter Override: Certificate=&lt;Base64-encoded data [</token-text>
																<token-xpath expression="string-length($cert)" />
																<token-text xml:space="preserve"> characters]&gt;</token-text>
															</arg-string>
														</do-trace-message>
													</arg-actions>
												</do-if>
												<do-set-local-variable name="ssl" scope="policy">
													<arg-string>
														<token-global-variable name="drv.registration.msgw.override.ssl" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<or>
															<if-local-variable mode="regex" name="ssl" op="not-equal">.+</if-local-variable>
															<if-local-variable mode="nocase" name="ssl" op="equal">_</if-local-variable>
														</or>
													</arg-conditions>
													<arg-actions>
														<do-set-local-variable name="ssl" scope="policy">
															<arg-string>
																<token-xpath expression="string($driverParams//definition[@name='allow-http']/value/text()='false')" />
															</arg-string>
														</do-set-local-variable>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">MSGW Drv Reg: SSL=</token-text>
																<token-local-variable name="ssl" />
																<token-text xml:space="preserve"> (from shim params)</token-text>
															</arg-string>
														</do-trace-message>
													</arg-actions>
													<arg-actions>
														<do-trace-message>
															<arg-string>
																<token-text xml:space="preserve">MSGW Drv Reg Parameter Override: SSL=</token-text>
																<token-local-variable name="ssl" />
															</arg-string>
														</do-trace-message>
													</arg-actions>
												</do-if>
												<do-append-xml-element expression="$REGN__CACHE/cache" name="instance" />
												<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]" name="class-name">
													<arg-string>
														<token-text xml:space="preserve">__DCS_REGISTRATION__</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]" name="src-dn">
													<arg-string>
														<token-lower-case>
															<token-global-variable name="drv.registration.msgw.driverdn" />
														</token-lower-case>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$REGN__CACHE/cache/instance[last()]" name="association" />
												<do-append-xml-text expression="$REGN__CACHE/cache/instance[last()]/association">
													<arg-string>
														<token-local-variable name="driverGuid" />
													</arg-string>
												</do-append-xml-text>
												<do-append-xml-element expression="$REGN__CACHE/cache/instance[last()]" name="attr" />
												<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">msgw-drv-address</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$REGN__CACHE/cache/instance[last()]/attr[last()]" name="value" />
												<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]/attr[last()]/value" name="type">
													<arg-string>
														<token-text xml:space="preserve">string</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-text expression="$REGN__CACHE/cache/instance[last()]/attr[last()]/value">
													<arg-string>
														<token-local-variable name="address" />
													</arg-string>
												</do-append-xml-text>
												<do-append-xml-element expression="$REGN__CACHE/cache/instance[last()]" name="attr" />
												<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">msgw-drv-port</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$REGN__CACHE/cache/instance[last()]/attr[last()]" name="value" />
												<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]/attr[last()]/value" name="type">
													<arg-string>
														<token-text xml:space="preserve">string</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-text expression="$REGN__CACHE/cache/instance[last()]/attr[last()]/value">
													<arg-string>
														<token-local-variable name="port" />
													</arg-string>
												</do-append-xml-text>
												<do-append-xml-element expression="$REGN__CACHE/cache/instance[last()]" name="attr" />
												<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
													<arg-string>
														<token-text xml:space="preserve">msgw-drv-context</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-element expression="$REGN__CACHE/cache/instance[last()]/attr[last()]" name="value" />
												<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]/attr[last()]/value" name="type">
													<arg-string>
														<token-text xml:space="preserve">string</token-text>
													</arg-string>
												</do-set-xml-attr>
												<do-append-xml-text expression="$REGN__CACHE/cache/instance[last()]/attr[last()]/value">
													<arg-string>
														<token-local-variable name="context" />
													</arg-string>
												</do-append-xml-text>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="ssl" op="equal">true</if-local-variable>
															<if-global-variable mode="nocase" name="drv.registration.msgw.driver-config-mode" op="equal">local</if-global-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-append-xml-element expression="$REGN__CACHE/cache/instance[last()]" name="attr" />
														<do-set-xml-attr expression="$REGN__CACHE/cache/instance[last()]/attr[last()]" name="attr-name">
															<arg-string>
																<token-text xml:space="preserve">msgw-drv-cert</token-text>
															</arg-string>
														</do-set-xml-attr>
