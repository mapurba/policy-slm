<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>GW 5.5/6.0 from eDir</description>
									<conditions>
										<or>
											<if-global-variable name="driver.gw.domainVersion" op="equal">600</if-global-variable>
											<if-global-variable name="driver.gw.domainVersion" op="equal">550</if-global-variable>
										</or>
										<or>
											<if-local-variable name="fromNds" op="equal">true</if-local-variable>
										</or>
										<or>
											<if-class-name op="equal">User</if-class-name>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="55022" src-name="company" />
										<do-rename-op-attr dest-name="55020" src-name="Generational Qualifier" />
										<do-rename-op-attr dest-name="55019" src-name="Initials" />
										<do-rename-op-attr dest-name="55021" src-name="personalTitle" />
										<do-break />
									</actions>
								</rule>
								