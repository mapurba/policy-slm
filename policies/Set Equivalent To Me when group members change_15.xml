<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Equivalent To Me when group members change</description>
									<comment xml:space="preserve">The ILM Vault gives group members the rights of the group by adding the object to the "Equivalent to Me" attribute. </comment>
									<conditions>
										<and>
											<if-class-name mode="case" op="equal">Group</if-class-name>
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:members.value" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-clone-op-attr dest-name="Equivalent To Me" src-name="urn:ietf:params:scim:schemas:core:2.0:Group:members.value" />
									</actions>
								</rule>
								