<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat Group Entitlements as per FanOut Standards</description>
									<conditions>
										<and>
											<if-op-property mode="nocase" name="Entitlement-Group-Query" op="equal">true</if-op-property>
											<if-operation mode="nocase" op="equal">instance</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="connDN" scope="policy">
											<arg-string>
												<token-xpath expression="operation-data/@connection-dn" />
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-rename-op-attr dest-name="idg" src-name="IDG" />
										<do-rename-op-attr dest-name="idg" src-name="PK_IDG" />
										<do-append-xml-text before="node()" expression="attr[@attr-name=&quot;idg&quot;]/value">
											<arg-string>
												<token-local-variable name="connDN" />
											</arg-string>
										</do-append-xml-text>
									</actions>
								</rule>
								