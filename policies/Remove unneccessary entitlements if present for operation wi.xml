<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove unneccessary entitlements if present for operation with association</description>
									<conditions>
										<and>
											<if-association op="available" />
											<if-xpath op="true">modify-attr/@attr-name='DirXML-EntitlementRef'</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="assocDN" scope="policy">
											<arg-string>
												<token-substring>
													<token-split delimiter="\$">
														<token-association />
													</token-split>
												</token-substring>
											</arg-string>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="modify-attr[@attr-name='DirXML-EntitlementRef']//value" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="ent-LIID" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamFieldBackwardsCompatible($current-node//param/text(), 'LIID', 'LSNAME')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="connDN" scope="policy">
													<arg-string>
														<token-xpath expression="$entConfig//connection[@name=$ent-LIID]/query-attr[@name='connection-dn']/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="connDN" op="not-equal">$assocDN$</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-strip-xpath expression="$current-node" />
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								