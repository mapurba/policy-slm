<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match Sentinel Account</description>
									<comment xml:space="preserve">Query Sentinel to find an existing Account object that matches the data in the add operation.</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-match-attr name="Identity-GUID" />
											<arg-match-attr name="Identifier" />
											<arg-match-attr name="App-Name" />
										</do-find-matching-object>
									</actions>
								</rule>
								