<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User/Group Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="dn">
											<arg-string>
												<token-global-variable name="idv.dit.data.users" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="CN" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="association">
											<arg-string>
												<token-association />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								