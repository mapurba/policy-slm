<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform modify-password to modify</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">user</if-class-name>
											<if-operation mode="regex" op="equal">modify-password</if-operation>
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="Password">
											<arg-value type="string" />
										</do-add-dest-attr-value>
										<do-set-xml-attr expression="../modify/modify-attr[@attr-name=&quot;Password&quot;]/add-value" name="type">
											<arg-string>
												<token-text xml:space="preserve">password-ref</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-set-xml-attr expression="../modify/modify-attr[@attr-name=&quot;Password&quot;]/add-value" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-text expression="../modify/modify-attr[@attr-name=&quot;Password&quot;]/add-value/value" notrace="true">
											<arg-string>
												<token-xpath expression="./password/text()" />
											</arg-string>
										</do-append-xml-text>
										<do-strip-xpath expression="." />
									</actions>
								</rule>
							