<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>transform-dn</description>
									<comment xml:space="preserve">Transform uniqueID to uid</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">inetOrgPerson</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="tempQsrcdn" scope="policy">
											<arg-string>
												<token-xpath expression="@qualified-src-dn" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">contains($tempQsrcdn,'uniqueID')</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="srcdn_before" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before($tempQsrcdn,&quot;uniqueID&quot;)" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="srcdn_after" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after($tempQsrcdn,'uniqueID')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="newdn" scope="policy">
													<arg-string>
														<token-local-variable name="srcdn_before" />
														<token-text xml:space="preserve">uid</token-text>
														<token-local-variable name="srcdn_after" />
													</arg-string>
												</do-set-local-variable>
												<do-set-xml-attr expression="." name="qualified-src-dn">
													<arg-string>
														<token-local-variable name="newdn" />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="tempDestdn" scope="policy">
											<arg-string>
												<token-xpath expression="@dest-dn" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">contains($tempDestdn,'uniqueid')</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="destdn_before" scope="policy">
													<arg-string>
														<token-xpath expression="substring-before($tempDestdn,&quot;uniqueid&quot;)" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="destdn_after" scope="policy">
													<arg-string>
														<token-xpath expression="substring-after($tempDestdn,'uniqueid')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="newddn" scope="policy">
													<arg-string>
														<token-local-variable name="destdn_before" />
														<token-text xml:space="preserve">uid</token-text>
														<token-local-variable name="destdn_after" />
													</arg-string>
												</do-set-local-variable>
												<do-set-xml-attr expression="." name="dest-dn">
													<arg-string>
														<token-local-variable name="newddn" />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							