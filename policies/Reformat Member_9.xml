<?xml version="1.0" encoding="UTF-8"?>
<rule disabled="true">
									<description>Reformat Member</description>
									<conditions>
										<and>
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:members.$ref" op="available" />
										</and>
									</conditions>
									<actions>
										<do-reformat-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:members.$ref">
											<arg-value type="dn">
												<token-local-variable name="current-value" />
											</arg-value>
										</do-reformat-op-attr>
										<do-for-each>
											<arg-node-set>
												<token-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:members.$ref" />
												<token-removed-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:members.$ref" />
											</arg-node-set>
											<arg-actions>
												<do-set-xml-attr expression="$current-node" name="association-ref">
													<arg-string>
														<token-op-attr name="urn:ietf:params:scim:schemas:core:2.0:Group:members.$ref" />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							