<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto any change in DirXML-Driver class if it is not on this Driver</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-Driver</if-class-name>
											<if-op-attr name="DirXML-NamedPasswords" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">modify-attr/remove-value</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-veto />
											</arg-actions>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-src-dn op="not-equal">~dirxml.auto.driverdn~</if-src-dn>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-veto />
													</arg-actions>
													<arg-actions>
														<do-set-op-property name="changedNamedPassword">
															<arg-string>
																<token-base64-decode charset="UTF-8">
																	<token-xpath expression="modify-attr/add-value/value/component[1]/text()" />
																</token-base64-decode>
															</arg-string>
														</do-set-op-property>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-if>
									</actions>
								</rule>
								