<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Move User add Password</description>
									<comment xml:space="preserve">Move  User add Password</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-op-attr name="Password" op="not-available" />
											<if-xpath op="true">password</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="add-attr" />
										<do-set-xml-attr expression="add-attr[last()]" name="attr-name">
											<arg-string>
												<token-text xml:space="preserve">Password</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-set-xml-attr expression="add-attr[@attr-name=&quot;Password&quot;]" name="type">
											<arg-string>
												<token-text xml:space="preserve">password-ref</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-element expression="add-attr[@attr-name=&quot;Password&quot;]" name="value" />
										<do-set-xml-attr expression="add-attr[@attr-name=&quot;Password&quot;]/value" name="is-sensitive">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
										<do-append-xml-text expression="add-attr[@attr-name='Password']/value" notrace="true">
											<arg-string>
												<token-xpath expression="password/text()" />
											</arg-string>
										</do-append-xml-text>
										<do-strip-xpath expression="password" />
									</actions>
								</rule>
								