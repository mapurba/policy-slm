<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Mirror Matching Policy</description>
									<conditions>
										<and>
											<if-src-dn op="in-subtree">\~dirxml.auto.treename~</if-src-dn>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="entry">
											<arg-dn>
												<token-unmatched-src-dn convert="true" />
											</arg-dn>
										</do-find-matching-object>
									</actions>
								</rule>
								