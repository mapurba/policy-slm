<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Prevent Groups without a Google Create Group Entitlement</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEGRPS.RequireCreateGroupEntitlement" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEGRPS.MatchGroupsWithoutGroupCreateEntitlement" op="not-equal">true</if-global-variable>
											<if-entitlement name="NOVLGGLEGRPS-GroupProvisioning" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								