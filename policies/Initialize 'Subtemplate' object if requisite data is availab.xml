<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Initialize 'Subtemplate' object if requisite data is available</description>
									<conditions>
										<and>
											<if-class-name op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.entitlement.Subtemplate" op="equal">true</if-global-variable>
											<if-entitlement name="Subtemplate" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="lo-Subtemplates" scope="policy">
											<arg-object>
												<token-xpath expression="es:Subtemplates()" />
											</arg-object>
										</do-set-local-variable>
										<do-set-local-variable name="lv-hasNeededData" scope="policy">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								