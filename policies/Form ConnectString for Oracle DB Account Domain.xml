<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Form ConnectString for Oracle DB Account Domain</description>
									<comment xml:space="preserve">Form the ConnectString for Oracle DB using the host, port, secure and baseDN attributes. The baseDN attribute is used for specific identifier, for OracleDB it could be the SID or Service.</comment>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">DirXML-PUMAccountDomain</if-class-name>
										</or>
										<or>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</or>
										<or>
											<if-attr mode="nocase" name="DirXML-pumAccDomType" op="equal">db</if-attr>
										</or>
										<or>
											<if-attr mode="nocase" name="DirXML-pumAccDomProfile" op="equal">1001</if-attr>
										</or>
										<or>
											<if-op-attr name="DirXML-pumHost" op="changing" />
											<if-op-attr name="DirXML-pumPort" op="changing" />
											<if-op-attr name="DirXML-pumAccDomSecure" op="changing" />
											<if-op-attr name="DirXML-pumAccDomBaseDN" op="changing" />
										</or>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-attr name="DirXML-pumHost" op="available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="dbHost" scope="policy">
													<arg-string>
														<token-attr name="DirXML-pumHost" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable name="dbHost" op="not-available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-remove-dest-attr-value direct="true" name="DirXML-pumHost">
													<arg-value type="string">
														<token-text xml:space="preserve" />
													</arg-value>
												</do-remove-dest-attr-value>
												<do-veto />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-set-local-variable name="dbConn" scope="policy">
											<arg-string>
												<token-attr name="DirXML-pumAccDomSecure" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<or>
													<if-local-variable mode="nocase" name="dbConn" op="equal">false</if-local-variable>
													<if-local-variable mode="nocase" name="dbConn" op="equal" />
												</or>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="dbConn" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">TCP</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="dbConn" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">TCPS</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="dbPort" scope="policy">
											<arg-string>
												<token-attr name="DirXML-pumPort" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="dbPort" op="equal" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="dbPort" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">1521</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="dbPort" scope="policy">
													<arg-string>
														<token-local-variable name="dbPort" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-set-local-variable name="dbIdentifier" scope="policy">
											<arg-string>
												<token-attr name="DirXML-pumAccDomBaseDN" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="dbIdentifier" op="equal" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="dbIdentifier" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">ORCL</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="dbIdentifier" scope="policy">
													<arg-string>
														<token-local-variable name="dbIdentifier" />
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-strip-op-attr name="DirXML-pumHost" />
										<do-strip-op-attr name="DirXML-pumPort" />
										<do-strip-op-attr name="DirXML-pumAccDomSecure" />
										<do-strip-op-attr name="DirXML-pumAccDomBaseDN" />
										<do-add-dest-attr-value name="DirXML-pumHost">
											<arg-value type="string">
												<token-text xml:space="preserve">(DESCRIPTION=(ADDRESS=(PROTOCOL=$dbConn$)(Host=$dbHost$)(Port=$dbPort$))(CONNECT_DATA=(SID=$dbIdentifier$)))</token-text>
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								