<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform UCLASSSYS from Structured to String</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-reformat-op-attr name="UCLASSSYS">
											<arg-value type="string">
												<token-xpath expression="$current-value/component[@name='RCVSYSTEM']" />
												<token-text xml:space="preserve">:</token-text>
												<token-xpath expression="$current-value/component[@name='LIC_TYPE']" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
							