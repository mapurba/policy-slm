<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>strip  Telephone Number, Fax and urn:ietf:params:scim:schemas:ilm:static:1.0:User:mobile  - if it is blank</description>
									<comment xml:space="preserve">Strip modification with blank value</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="regex" op="equal">modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:phoneNumbers.value" op="changing" />
													<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:core:2.0:User:phoneNumbers.value" op="not-equal">.+</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:phoneNumbers.value" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:FacsimileTelephoneNumber" op="changing" />
													<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:FacsimileTelephoneNumber" op="not-equal">.+</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:FacsimileTelephoneNumber" />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:mobile" op="changing" />
													<if-op-attr mode="regex" name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:mobile" op="not-equal">.+</if-op-attr>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-strip-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:mobile" />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								