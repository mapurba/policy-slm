<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Set Source DN for status</description>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">status</if-operation>
											<if-src-dn op="not-available" />
											<if-op-property name="unmatched-src-dn" op="available" />
											<if-op-property name="drv.user.container" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-src-dn>
											<arg-dn>
												<token-op-property name="unmatched-src-dn" />
												<token-text xml:space="preserve">,</token-text>
												<token-op-property name="drv.user.container" />
											</arg-dn>
										</do-set-op-src-dn>
									</actions>
								</rule>
								