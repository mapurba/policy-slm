<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Break on Modify Event If Disabled Attribute not Available</description>
									<comment xml:space="preserve">The rule will break if modify event does not contain disabled attribute.</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">~drv.acctTrk.objectClass~</if-class-name>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-op-attr name="disabled" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								