<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set connection-dn as '__BROADCAST__' if no connection-dn is available</description>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">add|query</if-operation>
											<if-op-property name="connection-dn" op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="connection-dn">
											<arg-string>
												<token-text xml:space="preserve">__BROADCAST__</token-text>
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
								