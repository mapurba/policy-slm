<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>veto out-of-scope events</description>
									<comment xml:space="preserve">If entitlement is enabled veto the add events in the publisher channel.</comment>
									<conditions>
										<or>
											<if-op-property mode="nocase" name="attempt-to-match" op="equal">false</if-op-property>
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								