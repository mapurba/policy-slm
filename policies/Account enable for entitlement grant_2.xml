<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account enable for entitlement grant</description>
									<comment xml:space="preserve">The eDirectory Account Entitlement grants the user an enabled account in eDirectory. </comment>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Account" op="equal">true</if-global-variable>
											<if-class-name mode="regex" op="equal">user|inetorgperson</if-class-name>
											<if-operation op="equal">add</if-operation>
											<if-entitlement name="Account" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="Account" />
											</arg-node-set>
											<arg-actions>
												<do-set-dest-attr-value name="Login Disabled">
													<arg-value type="state">
														<token-text>false</token-text>
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							