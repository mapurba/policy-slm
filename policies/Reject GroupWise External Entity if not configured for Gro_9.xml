<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reject GroupWise External Entity if not configured for GroupWise External Entity synchronization</description>
									<conditions>
										<and>
											<if-class-name op="equal">GroupWise External Entity</if-class-name>
											<if-global-variable name="driver.gw.syncExternalEntity" op="equal">false</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
								