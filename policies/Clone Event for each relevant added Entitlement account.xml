<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Clone Event for each relevant added Entitlement account</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Account" op="equal">true</if-global-variable>
											<if-entitlement name="Account" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="modifiedEvent" scope="policy">
											<arg-node-set>
												<token-xml-parse>
													<token-text xml:space="preserve">&lt;event&gt;&lt;/event&gt;</token-text>
												</token-xml-parse>
											</arg-node-set>
										</do-set-local-variable>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="Account" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="stripEvent" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="ent-LIID" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamFieldBackwardsCompatible($current-node/text(), 'LIID','LSNAME')" />
													</arg-string>
												</do-set-local-variable>
												<do-clone-xpath dest-expression="$modifiedEvent/event" src-expression="." />
												<do-set-local-variable name="entValues" scope="policy">
													<arg-node-set>
														<token-xpath expression="$modifiedEvent/event/modify[last()]/modify-attr[@attr-name='DirXML-EntitlementRef']/node()" />
													</arg-node-set>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-local-variable name="entValues" />
													</arg-node-set>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="not-true">es:getEntParamFieldBackwardsCompatible($current-node//param/text(), 'LIID', 'LSNAME')=$ent-LIID</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-strip-xpath expression="$current-node" />
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
										</do-for-each>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="stripEvent" op="equal">true</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-clone-xpath dest-expression=".." src-expression="$modifiedEvent/event/node()" />
												<do-strip-xpath expression="." />
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							