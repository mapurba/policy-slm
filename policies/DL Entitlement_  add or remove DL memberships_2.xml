<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DL Entitlement:  add or remove DL memberships</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.gwDistLists" op="equal">true</if-global-variable>
											<if-entitlement name="gwDistLists" op="changing" />
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="gwDistLists" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="dlDn" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID2')&#13;&#10;" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="varGrpObj" scope="policy">
													<arg-node-set>
														<token-query class-name="Group" datastore="dest" scope="entry">
															<arg-dn>
																<token-local-variable name="dlDn" />
															</arg-dn>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="varGrpAssoc" scope="policy">
													<arg-string>
														<token-xpath expression="$varGrpObj/association/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value class-name="Group" name="Member">
													<arg-association>
														<token-local-variable name="varGrpAssoc" />
													</arg-association>
													<arg-value type="string">
														<token-src-dn />
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/add-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="gwDistLists" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="dlDn" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID2')&#13;&#10;" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="varGrpObj" scope="policy">
													<arg-node-set>
														<token-query class-name="Group" datastore="dest" scope="entry">
															<arg-dn>
																<token-local-variable name="dlDn" />
															</arg-dn>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="varGrpAssoc" scope="policy">
													<arg-string>
														<token-xpath expression="$varGrpObj/association/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-remove-dest-attr-value class-name="Group" name="Member">
													<arg-association>
														<token-local-variable name="varGrpAssoc" />
													</arg-association>
													<arg-value type="string">
														<token-src-dn />
													</arg-value>
												</do-remove-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/remove-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								