<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>MatchUserRule1-Search User on workforceID</description>
									<comment xml:space="preserve">This rule will match user on workforceID</comment>
									<conditions>
										<and>
											<if-global-variable mode="regex" name="gvUserMatchAttr" op="equal">worker-pub-match-workforceID|worker-pub-match-all</if-global-variable>
											<if-local-variable mode="nocase" name="lvUserStopSearch" op="equal">false</if-local-variable>
											<if-class-name op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-global-variable mode="nocase" name="gvWorkersMergeIDV" op="equal">true</if-global-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvUserNodeSetMatchOnWorkforceID" scope="policy">
													<arg-node-set>
														<token-query class-name="User" max-result-count="100">
															<arg-dn>
																<token-global-variable name="gvUserContainer" />
															</arg-dn>
															<arg-match-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID" />
															<arg-string>
																<token-text xml:space="preserve">CN</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">workforceID</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">wd-WorkerIDType</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="lvUserNodeSetMatchOnWorkforceID" scope="policy">
													<arg-node-set>
														<token-query class-name="User" max-result-count="100">
															<arg-dn>
																<token-global-variable name="gvUserContainer" />
															</arg-dn>
															<arg-match-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID" />
															<arg-match-attr name="wd-WorkerIDType" />
															<arg-string>
																<token-text xml:space="preserve">CN</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">workforceID</token-text>
															</arg-string>
															<arg-string>
																<token-text xml:space="preserve">wd-WorkerIDType</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-trace-message level="1">
											<arg-string>
												<token-text xml:space="preserve">User Count Match On WorkforceID: </token-text>
												<token-xpath expression="count($lvUserNodeSetMatchOnWorkforceID)" />
											</arg-string>
										</do-trace-message>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">count($lvUserNodeSetMatchOnWorkforceID) = 1</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lvUserCN" scope="driver">
													<arg-string>
														<token-xpath expression="$lvUserNodeSetMatchOnWorkforceID//attr[@attr-name='CN']/value/." />
													</arg-string>
												</do-set-local-variable>
												<do-trace-message level="1">
													<arg-string>
														<token-text xml:space="preserve">lvUserCN: </token-text>
														<token-local-variable name="lvUserCN" />
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="lvUserStopSearch" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-find-matching-object scope="subtree">
													<arg-dn>
														<token-global-variable name="gvUserContainer" />
													</arg-dn>
													<arg-match-attr name="CN">
														<arg-value type="string">
															<token-local-variable name="lvUserCN" />
														</arg-value>
													</arg-match-attr>
												</do-find-matching-object>
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-xpath op="true">count($lvUserNodeSetMatchOnWorkforceID) &gt; 1</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-trace-message level="1">
													<arg-string>
														<token-text xml:space="preserve">User Count Match On WorkforceID: </token-text>
														<token-xpath expression="count($lvUserNodeSetMatchOnWorkforceID)" />
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="lvIDVUserIDListWithMultipleMatch" scope="policy">
													<arg-string />
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="$lvUserNodeSetMatchOnWorkforceID//attr[@attr-name='CN']/value/." />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="lvIDVUserIDListWithMultipleMatch" scope="policy">
															<arg-string>
																<token-local-variable name="lvIDVUserIDListWithMultipleMatch" />
																<token-local-variable name="current-node" />
																<token-text xml:space="preserve">; </token-text>
															</arg-string>
														</do-set-local-variable>
													</arg-actions>
												</do-for-each>
												<do-trace-message level="1">
													<arg-string>
														<token-text xml:space="preserve">lvIDVUserIDListWithMultipleMatch: </token-text>
														<token-local-variable name="lvIDVUserIDListWithMultipleMatch" />
													</arg-string>
												</do-trace-message>
												<do-set-local-variable name="lvMultipleUserSearchCountOnWorkforceID" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lvUserStopSearch" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								