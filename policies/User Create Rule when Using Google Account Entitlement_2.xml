<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>User Create Rule when Using Google Account Entitlement</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="gcv.NOVLGGLEUSER.RequireUserAccountEntitlement" op="equal">true</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-entitlement name="NOVLGGLEUSER-Account" op="not-available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-veto />
											</arg-actions>
											<arg-actions />
										</do-if>
										<do-for-each>
											<arg-node-set>
												<token-entitlement name="NOVLGGLEUSER-Account" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="lv_entValue" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-set-default-attr-value name="CN" write-back="false">
													<arg-value type="string">
														<token-src-name />
														<token-text xml:space="preserve">@</token-text>
														<token-local-variable name="lv_entValue" />
													</arg-value>
												</do-set-default-attr-value>
												<do-set-src-attr-value name="Internet EMail Address">
													<arg-value type="string">
														<token-src-name />
														<token-text xml:space="preserve">@</token-text>
														<token-local-variable name="lv_entValue" />
													</arg-value>
												</do-set-src-attr-value>
											</arg-actions>
										</do-for-each>
										<do-veto-if-op-attr-not-available name="Surname" />
										<do-veto-if-op-attr-not-available name="Given Name" />
										<do-break />
									</actions>
								</rule>
								