<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Match by CN for Group Objects using Association</description>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
											<if-class-name op="equal">Group</if-class-name>
											<if-association op="available" />
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subordinates">
											<arg-dn>
												<token-global-variable name="idv.dit.data.groups" />
											</arg-dn>
											<arg-match-attr name="CN">
												<arg-value type="string">
													<token-association />
												</arg-value>
											</arg-match-attr>
										</do-find-matching-object>
										<do-break />
									</actions>
								</rule>
							