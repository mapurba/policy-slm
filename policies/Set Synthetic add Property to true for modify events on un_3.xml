<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set Synthetic add Property to true for modify events on unassociated users</description>
									<conditions>
										<and>
											<if-operation op="equal">modify</if-operation>
											<if-class-name op="equal">User</if-class-name>
											<if-association op="not-available" />
										</and>
									</conditions>
									<actions>
										<do-append-xml-element expression="." name="operation-data" />
										<do-set-xml-attr expression="operation-data" name="synthetic-add">
											<arg-string>
												<token-text xml:space="preserve">true</token-text>
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
							