<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove urn:ietf:params:scim:schemas:core:2.0:User:id for subscriber events</description>
									<conditions>
										<and>
											<if-operation op="not-equal">add</if-operation>
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:id" op="available" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:id" />
									</actions>
								</rule>
								