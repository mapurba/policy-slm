<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>strip "Login Disabled" if expire-account available</description>
									<conditions>
										<and>
											<if-op-property name="expire-account" op="available" />
										</and>
									</conditions>
									<actions>
										<do-strip-op-attr name="50058" />
										<do-clear-op-property name="expire-account" />
										<do-break />
									</actions>
								</rule>
								