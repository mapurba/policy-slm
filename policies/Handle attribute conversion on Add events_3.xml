<?xml version="1.0" encoding="UTF-8"?>
<rule notrace="true">
									<description>Handle attribute conversion on Add events</description>
									<comment xml:space="preserve">Due to schema differences between eDirectory and salesforce, this rule will get only the 1st value of any attribute being synchronized from eDirectory when sending it to salesforce.

This rule uses the mapping table StructuredAttributes to flag which attributes have the structured format in eDirectory, and which component from those attributes we should send to salesforce.</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="event-attr-list" scope="policy">
											<arg-node-set>
												<token-xpath expression="add-attr" />
											</arg-node-set>
										</do-set-local-variable>
										<do-strip-xpath expression="add-attr" />
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="event-attr-list" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="attribute-name" scope="policy">
													<arg-string>
														<token-xpath expression="$current-node/@attr-name" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="attr-lookup" scope="policy">
													<arg-string>
														<token-map default-value="attribute-is-not-structured" dest="ComponentToGet" src="Attribute Name" table="..\NOVLSFBASE-StructuredAttributes">
															<token-local-variable name="attribute-name" />
														</token-map>
													</arg-string>
												</do-set-local-variable>
												<do-if>
													<arg-conditions>
														<and>
															<if-local-variable mode="nocase" name="attr-lookup" op="equal">attribute-is-not-structured</if-local-variable>
														</and>
													</arg-conditions>
													<arg-actions>
														<do-add-dest-attr-value class-name="User" name="$attribute-name$">
															<arg-value type="string">
																<token-xpath expression="$current-node/value[1]/text()" />
															</arg-value>
														</do-add-dest-attr-value>
													</arg-actions>
													<arg-actions>
														<do-add-dest-attr-value class-name="User" name="$attribute-name$">
															<arg-value type="string">
																<token-xpath expression="$current-node/value[1]/component[@name = $attr-lookup]/text()" />
															</arg-value>
														</do-add-dest-attr-value>
													</arg-actions>
												</do-if>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
								