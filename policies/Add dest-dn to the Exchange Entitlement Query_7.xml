<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add dest-dn to the Exchange Entitlement Query</description>
									<conditions>
										<and>
											<if-operation mode="regex" op="equal">query|query-ex</if-operation>
											<if-class-name mode="case" op="equal">msExchPrivateMDB</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-text xml:space="preserve">CN=Configuration,</token-text>
												<token-dest-dn />
											</arg-dn>
										</do-set-op-dest-dn>
									</actions>
								</rule>
							