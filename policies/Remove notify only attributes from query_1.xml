<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Remove notify only attributes from query</description>
									<comment xml:space="preserve">MSGateway driver does not obey the filter settings. Salesforce throws error if it fails to recognize an attribute.  
		The following notify-only attributes should be removed for a successful query</comment>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">query</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-strip-xpath expression="./read-attr[@attr-name='DirXML-EntitlementRef']" />
										<do-strip-xpath expression="./read-attr[@attr-name='CN']" />
										<do-strip-xpath expression="./read-attr[@attr-name='nspmDistributionPassword']" />
									</actions>
								</rule>
								