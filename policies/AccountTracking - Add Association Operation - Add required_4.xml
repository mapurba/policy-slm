<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>AccountTracking - Add Association Operation - Add required properties to current doc for future use</description>
									<conditions>
										<and>
											<if-op-property mode="nocase" name="AccountTracking-ClassName" op="equal">User</if-op-property>
											<if-operation mode="nocase" op="equal">add-association</if-operation>
										</and>
									</conditions>
									<actions>
										<do-clear-op-property name="AccountTracking-Operation" />
										<do-set-local-variable name="var-association" scope="policy">
											<arg-string>
												<token-xpath expression="./text()" />
											</arg-string>
										</do-set-local-variable>
										<do-set-op-property name="AccountTracking-ObjectDN">
											<arg-string>
												<token-dest-dn />
											</arg-string>
										</do-set-op-property>
										<do-for-each>
											<arg-node-set>
												<token-global-variable name="drv.acctTrk.identifiers" />
											</arg-node-set>
											<arg-actions>
												<do-if>
													<arg-conditions>
														<and>
															<if-op-property name="AccountTracking-$current-node$" op="not-available" />
														</and>
													</arg-conditions>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="not-true">$current-node = 'association'</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-for-each>
																	<arg-node-set>
																		<token-query class-name="~drv.acctTrk.objectClass~" datastore="src" scope="entry">
																			<arg-association>
																				<token-local-variable name="var-association" />
																			</arg-association>
																			<arg-string>
																				<token-text xml:space="preserve">$current-node$</token-text>
																			</arg-string>
																		</token-query>
																	</arg-node-set>
																	<arg-actions>
																		<do-set-local-variable name="var-acctIdentifierValue" scope="policy">
																			<arg-string>
																				<token-xpath expression="$current-node/attr[last()]/value/text()" />
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																</do-for-each>
																<do-set-op-property name="AccountTracking-$current-node$">
																	<arg-string>
																		<token-local-variable name="var-acctIdentifierValue" />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
															<arg-actions>
																<do-set-op-property name="AccountTracking-$current-node$">
																	<arg-string>
																		<token-local-variable name="var-association" />
																	</arg-string>
																</do-set-op-property>
															</arg-actions>
														</do-if>
													</arg-actions>
													<arg-actions />
												</do-if>
											</arg-actions>
										</do-for-each>
										<do-break />
									</actions>
								</rule>
								