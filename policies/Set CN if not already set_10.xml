<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Set CN if not already set</description>
									<conditions>
										<and>
											<if-op-attr name="CN" op="not-available" />
											<if-op-attr name="Full Name" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value name="CN">
											<arg-value type="string">
												<token-op-attr name="Full Name" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								