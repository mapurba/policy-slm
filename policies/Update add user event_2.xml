<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Update add user event </description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">MSolUser</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-op-attr name="UserPrincipalName" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="domainName" scope="policy">
											<arg-string>
												<token-xpath expression="./add-attr[@attr-name=&quot;UserPrincipalName&quot;]/value/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-strip-xpath expression="./add-attr[@attr-name=&quot;UserPrincipalName&quot;]/value/text()" />
										<do-append-xml-text expression="./add-attr[@attr-name=&quot;UserPrincipalName&quot;]/value">
											<arg-string>
												<token-local-variable name="domainName" />
												<token-text xml:space="preserve">@</token-text>
												<token-global-variable name="drv.domain.name" />
											</arg-string>
										</do-append-xml-text>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="BlockCredential" op="not-available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-add-dest-attr-value name="BlockCredential">
													<arg-value type="string">
														<token-text xml:space="preserve">false</token-text>
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="blockCred" scope="policy">
													<arg-string>
														<token-xpath expression="add-attr[@attr-name=&quot;BlockCredential&quot;]/value/text()" />
													</arg-string>
												</do-set-local-variable>
												<do-strip-xpath expression="./add-attr[@attr-name=&quot;BlockCredential&quot;]" />
												<do-add-dest-attr-value name="BlockCredential">
													<arg-value type="string">
														<token-local-variable name="blockCred" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-if>
										<do-if>
											<arg-conditions>
												<and>
													<if-op-attr name="ImmutableID" op="not-available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="query-back" scope="policy">
													<arg-node-set>
														<token-query class-name="User" datastore="src" scope="entry">
															<arg-dn>
																<token-src-dn />
															</arg-dn>
															<arg-string>
																<token-text xml:space="preserve">GUID</token-text>
															</arg-string>
														</token-query>
													</arg-node-set>
												</do-set-local-variable>
												<do-add-dest-attr-value name="ImmutableId">
													<arg-value type="string">
														<token-xpath expression="$query-back//attr[@attr-name=&quot;GUID&quot;]/value[1]/text()" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								