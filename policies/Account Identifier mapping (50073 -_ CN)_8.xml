<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Account Identifier mapping (50073 -&gt; CN)</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">instance</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-property name="data-collection-query" op="available" />
										</and>
									</conditions>
									<actions>
										<do-rename-op-attr dest-name="CN" src-name="50073" />
									</actions>
								</rule>
							