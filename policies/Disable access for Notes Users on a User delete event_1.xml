<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Disable access for Notes Users on a User delete event</description>
									<comment xml:space="preserve">Because user deletion does not happen instantaneously in Notes, this option adds more security because users pending deletion cannot login even though their accounts are still available in Notes.</comment>
									<conditions>
										<and>
											<if-operation op="equal">delete</if-operation>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.account.status.DenyAccessGroup.use" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.account.status.DenyAccessGroup.addOnDelete" op="equal">true</if-global-variable>
											<if-global-variable mode="regex" name="drv.account.status.DenyAccessGroup.name" op="equal">.+</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-xml-attr expression="../delete[@class-name='User']" name="deny-access-group-name">
											<arg-string>
												<token-global-variable name="drv.account.status.DenyAccessGroup.name" />
											</arg-string>
										</do-set-xml-attr>
									</actions>
								</rule>
								