<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Group match on CN</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">sapHanaUserGroup</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subtree">
											<arg-dn>
												<token-global-variable name="sapHanaGroupPlacementContainer" />
											</arg-dn>
											<arg-match-attr name="CN" />
										</do-find-matching-object>
									</actions>
								</rule>
								