<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Convert from LDAP format to Slash</description>
									<conditions>
										<and>
											<if-operation op="not-equal">query</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-src-dn>
											<arg-dn>
												<token-parse-dn dest-dn-format="slash" src-dn-format="ldap">
													<token-xpath expression="@src-dn" />
												</token-parse-dn>
											</arg-dn>
										</do-set-op-src-dn>
									</actions>
								</rule>
								