<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Transform ISLOCK from Structured to String and copy the value to LOCKUSER</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-reformat-op-attr name="ISLOCKED">
											<arg-value type="string">
												<token-xpath expression="$current-value/component[@name='LOCAL_LOCK']" />
											</arg-value>
										</do-reformat-op-attr>
										<do-rename-op-attr dest-name="LOCKUSER" src-name="ISLOCKED" />
									</actions>
								</rule>
								