<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Split Group Membership into gidNumber on Modify Events</description>
									<conditions>
										<and>
											<if-operation op="equal">modify</if-operation>
											<if-class-name op="equal">User</if-class-name>
											<if-op-attr name="Group Membership" op="available" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="./modify-attr[@attr-name=&quot;Group Membership&quot;]/add-value" />
											</arg-node-set>
											<arg-actions>
												<do-add-dest-attr-value name="gidNumber">
													<arg-value type="string">
														<token-xpath expression="$current-node/@nxdrv:gidNumber" />
													</arg-value>
												</do-add-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-xpath expression="./modify-attr[@attr-name=&quot;Group Membership&quot;]/remove-value" />
											</arg-node-set>
											<arg-actions>
												<do-remove-dest-attr-value name="gidNumber">
													<arg-value type="string">
														<token-xpath expression="$current-node/@nxdrv:gidNumber" />
													</arg-value>
												</do-remove-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-break />
									</actions>
								</rule>
								