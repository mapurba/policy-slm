<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Assign GUID value of the object to local variable</description>
									<comment xml:space="preserve">Matching rule uses eDirectory GUID, which is matched against the LDAPID of GroupWise object.</comment>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-set-local-variable name="lvGuid" scope="policy">
											<arg-string>
												<token-src-attr name="GUID" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="lvAsciGuid" scope="policy">
											<arg-string>
												<token-xpath expression="es:guid2str($lvGuid)" />
											</arg-string>
										</do-set-local-variable>
									</actions>
								</rule>
								