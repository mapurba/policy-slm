<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>restore operation data </description>
									<conditions>
										<and>
											<if-operation mode="regex" op="not-equal">query|instance</if-operation>
											<if-xpath op="true">$current-op/driver-operation-data</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-clone-xpath dest-expression="$current-op" src-expression="$current-op/driver-operation-data/operation-data" />
										<do-strip-xpath expression="$current-op/driver-operation-data" />
									</actions>
								</rule>
							