<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add association for new CUA child client accounts</description>
									<conditions>
										<and>
											<if-operation mode="case" op="equal">status</if-operation>
											<if-xpath op="true">string-length(./operation-data/fanout-add-association/@assoc) &gt; 0</if-xpath>
										</and>
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and notrace="true">
													<if-operation mode="case" notrace="true" op="equal">status</if-operation>
													<if-xpath notrace="true" op="true">@level='success' or @level='warning'</if-xpath>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="./operation-data/fanout-add-association" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="lvTmp" scope="policy">
															<arg-string>
																<token-text notrace="true" xml:space="preserve">Executing scheduled add association </token-text>
																<token-xpath expression="$current-node/@assoc" notrace="true" />
																<token-text notrace="true" xml:space="preserve"> request for </token-text>
																<token-xpath expression="$current-node/@dn" notrace="true" />
															</arg-string>
														</do-set-local-variable>
														<do-add-association>
															<arg-dn>
																<token-xpath expression="$current-node/@dn" notrace="true" />
															</arg-dn>
															<arg-association>
																<token-xpath expression="$current-node/@assoc" />
															</arg-association>
														</do-add-association>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions>
												<do-set-local-variable name="lvTmp" scope="policy">
													<arg-string>
														<token-text notrace="true" xml:space="preserve">Not executing scheduled add association </token-text>
														<token-xpath expression="es:getParamValue(operation-data/@fanout-add-association, 'assoc')" notrace="true" />
														<token-text notrace="true" xml:space="preserve"> request for </token-text>
														<token-xpath expression="es:getParamValue(operation-data/@fanout-add-association, 'dn')" notrace="true" />
														<token-text notrace="true" xml:space="preserve"> because status is </token-text>
														<token-xpath expression="@level" notrace="true" />
														<token-text notrace="true" xml:space="preserve"> (expected: success or warning)</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
										</do-if>
										<do-strip-xpath expression="./operation-data/fanout-add-association" />
									</actions>
								</rule>
								