<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Relation: Create CN for photo</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDPhoto</if-class-name>
											<if-global-variable mode="nocase" name="gvPhotoNameMappingAttr" op="not-equal">Custom</if-global-variable>
											<if-attr name="~gvPhotoNameMappingAttr~" op="available" />
										</and>
									</conditions>
									<actions>
										<do-add-dest-attr-value class-name="WDPhoto" name="CN">
											<arg-value type="string">
												<token-attr name="~gvPhotoNameMappingAttr~" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								