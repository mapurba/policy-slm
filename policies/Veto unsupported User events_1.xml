<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto unsupported User events</description>
									<comment xml:space="preserve">Ignore add or move events on User class.</comment>
									<conditions>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-operation mode="nocase" op="equal">move</if-operation>
										</or>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-operation />
												<token-text xml:space="preserve"> operation is not supported on User class.</token-text>
											</arg-string>
										</do-trace-message>
										<do-status level="warning">
											<arg-string>
												<token-operation />
												<token-text xml:space="preserve"> operation is not supported on User class.</token-text>
											</arg-string>
										</do-status>
										<do-veto />
									</actions>
								</rule>
								