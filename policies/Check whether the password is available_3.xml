<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check whether the password is available</description>
									<conditions>
										<or>
											<if-operation mode="case" op="equal">add</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
										</or>
										<or>
											<if-op-attr name="nspmDistributionPassword" op="not-available" />
											<if-op-attr mode="nocase" name="nspmDistributionPassword" op="equal" />
										</or>
										<or>
											<if-op-attr name="Private Key" op="not-available" />
											<if-op-attr mode="nocase" name="Private Key" op="equal" />
										</or>
										<or>
											<if-op-attr name="Public Key" op="not-available" />
											<if-op-attr mode="nocase" name="Public Key" op="equal" />
										</or>
									</conditions>
									<actions>
										<do-veto />
									</actions>
								</rule>
							