<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto 'group' creation if 'disallowed'</description>
									<comment xml:space="preserve">Veto Group Creation</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">Group</if-class-name>
											<if-operation mode="case" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="jfocomon.Group.Add" op="equal">disable</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-trace-message>
											<arg-string>
												<token-text xml:space="preserve">Vetoing group creation</token-text>
											</arg-string>
										</do-trace-message>
										<do-veto />
									</actions>
								</rule>
							