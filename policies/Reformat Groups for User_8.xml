<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat Groups for User</description>
									<conditions>
										<or>
											<if-class-name op="equal">User</if-class-name>
										</or>
										<or>
											<if-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:groups.$ref" op="changing" />
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="addedGroups">
											<arg-node-set>
												<token-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:groups.$ref" />
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="removedGroups">
											<arg-node-set>
												<token-removed-attr name="urn:ietf:params:scim:schemas:core:2.0:User:groups.$ref" />
											</arg-node-set>
										</do-set-local-variable>
										<do-strip-op-attr name="urn:ietf:params:scim:schemas:core:2.0:User:groups.$ref" />
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="addedGroups" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="groupId">
													<arg-string>
														<token-resolve datastore="src">
															<arg-dn>
																<token-local-variable name="current-node" />
															</arg-dn>
														</token-resolve>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="groupName">
													<arg-string>
														<token-dest-attr class-name="Group" name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName">
															<arg-association>
																<token-local-variable name="groupId" />
															</arg-association>
														</token-dest-attr>
													</arg-string>
												</do-set-local-variable>
												<do-set-dest-attr-value class-name="User" name="urn:ietf:params:scim:schemas:core:2.0:User:groups.$ref">
													<arg-value type="string">
														<token-local-variable name="groupName" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-local-variable name="removedGroups" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="groupId">
													<arg-string>
														<token-resolve datastore="src">
															<arg-dn>
																<token-local-variable name="current-node" />
															</arg-dn>
														</token-resolve>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="groupName">
													<arg-string>
														<token-dest-attr class-name="Group" name="urn:ietf:params:scim:schemas:core:2.0:Group:displayName">
															<arg-association>
																<token-local-variable name="groupId" />
															</arg-association>
														</token-dest-attr>
													</arg-string>
												</do-set-local-variable>
												<do-set-dest-attr-value class-name="User" name="urn:ietf:params:scim:schemas:core:2.0:User:groups.$ref">
													<arg-value type="string">
														<token-local-variable name="groupName" />
													</arg-value>
												</do-set-dest-attr-value>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							