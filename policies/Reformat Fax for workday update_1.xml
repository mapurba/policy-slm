<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat Fax for workday update</description>
									<comment xml:space="preserve">Reformat Phone, Fax and Mobile data</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">modify</if-operation>
											<if-op-attr name="Facsimile Telephone Number" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="LV-FaxNo" scope="policy">
											<arg-string>
												<token-xpath expression="modify-attr[@attr-name=&quot;Facsimile Telephone Number&quot;]/add-value/value/component[@name=&quot;faxNumber&quot;]/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-reformat-op-attr name="Facsimile Telephone Number">
											<arg-value type="string">
												<token-local-variable name="LV-FaxNo" />
											</arg-value>
										</do-reformat-op-attr>
									</actions>
								</rule>
								