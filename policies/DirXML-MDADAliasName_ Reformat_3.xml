<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-MDADAliasName: Reformat</description>
									<conditions />
									<actions>
										<do-reformat-op-attr name="DirXML-MDADAliasName">
											<arg-value type="structured">
												<arg-component name="nameSpace">
													<token-time format="!CTIME" tz="UTC" />
												</arg-component>
												<arg-component name="volume">
													<token-global-variable name="dirxml.auto.driverdn" />
												</arg-component>
												<arg-component name="path">
													<token-local-variable name="current-value" />
												</arg-component>
											</arg-value>
										</do-reformat-op-attr>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="nocase" op="equal">modify</if-operation>
													<if-op-attr name="DirXML-MDADAliasName" op="changing" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-for-each>
													<arg-node-set>
														<token-dest-attr name="DirXML-MDADAliasName" />
													</arg-node-set>
													<arg-actions>
														<do-if>
															<arg-conditions>
																<and>
																	<if-xpath op="true">$current-node/component[@name='volume']="~dirxml.auto.driverdn~"</if-xpath>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-remove-dest-attr-value direct="true" name="DirXML-MDADAliasName">
																	<arg-value type="structured">
																		<arg-component name="nameSpace">
																			<token-xpath expression="$current-node/component[@name=&quot;nameSpace&quot;]" />
																		</arg-component>
																		<arg-component name="volume">
																			<token-xpath expression="$current-node/component[@name=&quot;volume&quot;]" />
																		</arg-component>
																		<arg-component name="path">
																			<token-xpath expression="$current-node/component[@name=&quot;path&quot;]" />
																		</arg-component>
																	</arg-value>
																</do-remove-dest-attr-value>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							