<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Veto if event not relevant</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="not-equal">User</if-class-name>
										</and>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="not-equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.entitlement.Group" op="not-equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.entitlement.Role" op="not-equal">true</if-global-variable>
										</and>
										<and>
											<if-op-attr name="DirXML-EntitlementRef" op="not-changing" />
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								