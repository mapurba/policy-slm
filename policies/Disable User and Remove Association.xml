<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Disable User and Remove Association</description>
									<comment xml:space="preserve">Set loginDisabled = true and remove AR Driver association from User being deleted</comment>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-operation mode="nocase" op="equal">delete</if-operation>
											<if-global-variable mode="nocase" name="drv.pub.user.delete" op="equal">1</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-remove-dest-attr-value class-name="User" name="DirXML-Accounts" when="after">
											<arg-value type="string">
												<token-association />
											</arg-value>
										</do-remove-dest-attr-value>
										<do-set-dest-attr-value class-name="User" name="Login Disabled" when="after">
											<arg-value type="state">
												<token-text xml:space="preserve">true</token-text>
											</arg-value>
										</do-set-dest-attr-value>
										<do-remove-association when="after">
											<arg-association>
												<token-association />
											</arg-association>
										</do-remove-association>
										<do-veto />
									</actions>
								</rule>
							