<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Get Surname from Full Name if necessary</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-op-attr name="Surname" op="not-available" />
											<if-op-attr name="Full Name" op="available" />
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="fullNameNodeSet" scope="policy">
											<arg-node-set>
												<token-split delimiter=" ">
													<token-attr name="Full Name" />
												</token-split>
											</arg-node-set>
										</do-set-local-variable>
										<do-add-dest-attr-value name="Surname">
											<arg-value>
												<token-xpath expression="$fullNameNodeSet[last()]" />
											</arg-value>
										</do-add-dest-attr-value>
									</actions>
								</rule>
								