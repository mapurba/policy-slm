<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-sapC</description>
									<conditions>
										<or>
											<if-class-name op="equal">DirXML-sapC</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="dirxml.auto.driverdn" />
												<token-text xml:space="preserve">\sap\om\c\</token-text>
												<token-op-attr name="DirXML-sapCID" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-break />
									</actions>
								</rule>
								