<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Break if rename operation</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">User</if-class-name>
											<if-global-variable mode="nocase" name="drv.entitlement.UserAccount" op="equal">true</if-global-variable>
											<if-global-variable mode="nocase" name="drv.role.rename.option" op="equal">2</if-global-variable>
											<if-op-property mode="regex" name="renOld" op="equal">.+</if-op-property>
											<if-op-property mode="regex" name="renNew" op="equal">.+</if-op-property>
										</and>
									</conditions>
									<actions>
										<do-break />
									</actions>
								</rule>
								