<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Check Required Attributes for User Creation</description>
									<conditions>
										<or>
											<if-class-name op="equal">User</if-class-name>
										</or>
									</conditions>
									<actions>
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:name.familyName" />
										<do-veto-if-op-attr-not-available name="urn:ietf:params:scim:schemas:core:2.0:User:name.givenName" />
									</actions>
								</rule>
								