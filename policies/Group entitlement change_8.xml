<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Group entitlement change</description>
									<conditions>
										<and>
											<if-global-variable mode="nocase" name="drv.entitlement.Group" op="equal">true</if-global-variable>
											<if-class-name op="equal">User</if-class-name>
											<if-operation op="equal">modify</if-operation>
											<if-entitlement name="Group" op="changing" />
										</and>
									</conditions>
									<actions>
										<do-for-each>
											<arg-node-set>
												<token-removed-entitlement name="Group" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')&#10;" />
													</arg-string>
												</do-set-local-variable>
												<do-remove-dest-attr-value class-name="Group" name="Member">
													<arg-association>
														<token-local-variable name="assoc" />
													</arg-association>
													<arg-value type="dn">
														<token-src-dn />
													</arg-value>
												</do-remove-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/remove-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')&#10;" />
													</arg-string>
												</do-set-local-variable>
												<do-remove-dest-attr-value class-name="Group" name="equivalentToMe">
													<arg-association>
														<token-local-variable name="assoc" />
													</arg-association>
													<arg-value type="dn">
														<token-src-dn />
													</arg-value>
												</do-remove-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/remove-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="lv_groupDN" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node, 'ID2')" />
													</arg-string>
												</do-set-local-variable>
												<do-remove-dest-attr-value class-name="User" name="Group Membership">
													<arg-association>
														<token-association />
													</arg-association>
													<arg-value type="string">
														<token-text xml:space="preserve">$lv_groupDN$</token-text>
													</arg-value>
												</do-remove-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/remove-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-local-variable name="assoc" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="lv_groupDN" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node, 'ID2')" />
													</arg-string>
												</do-set-local-variable>
												<do-remove-dest-attr-value class-name="User" name="Security Equals">
													<arg-association>
														<token-association />
													</arg-association>
													<arg-value type="string">
														<token-text xml:space="preserve">$lv_groupDN$</token-text>
													</arg-value>
												</do-remove-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/remove-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-local-variable name="assoc" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="lv_groupDN" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node, 'ID2')" />
													</arg-string>
												</do-set-local-variable>
												<do-remove-dest-attr-value class-name="User" name="Equivalent To Me">
													<arg-association>
														<token-association />
													</arg-association>
													<arg-value type="string">
														<token-text xml:space="preserve">$lv_groupDN$</token-text>
													</arg-value>
												</do-remove-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/remove-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-local-variable name="assoc" />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
										<do-for-each>
											<arg-node-set>
												<token-added-entitlement name="Group" />
											</arg-node-set>
											<arg-actions>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value class-name="Group" name="Member">
													<arg-association>
														<token-local-variable name="assoc" />
													</arg-association>
													<arg-value type="dn">
														<token-src-dn convert="true" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/add-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="assoc" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node,'ID')" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value class-name="Group" name="equivalentToMe">
													<arg-association>
														<token-local-variable name="assoc" />
													</arg-association>
													<arg-value type="dn">
														<token-src-dn convert="true" />
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/add-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-association />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="lv_groupDN" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node, 'ID2')" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value class-name="User" name="Group Membership">
													<arg-value type="string">
														<token-text xml:space="preserve">$lv_groupDN$</token-text>
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/add-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-local-variable name="assoc" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="lv_groupDN" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node, 'ID2')" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value class-name="User" name="Security Equals">
													<arg-value type="string">
														<token-text xml:space="preserve">$lv_groupDN$</token-text>
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/add-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-local-variable name="assoc" />
													</arg-string>
												</do-set-xml-attr>
												<do-set-local-variable name="lv_groupDN" scope="policy">
													<arg-string>
														<token-xpath expression="es:getEntParamField($current-node, 'ID2')" />
													</arg-string>
												</do-set-local-variable>
												<do-add-dest-attr-value class-name="User" name="Equivalent To Me">
													<arg-value type="string">
														<token-text xml:space="preserve">$lv_groupDN$</token-text>
													</arg-value>
												</do-add-dest-attr-value>
												<do-set-xml-attr expression="../modify[last()]/modify-attr[last()]/add-value[last()]/value[last()]" name="association-ref">
													<arg-string>
														<token-local-variable name="assoc" />
													</arg-string>
												</do-set-xml-attr>
											</arg-actions>
										</do-for-each>
									</actions>
								</rule>
							