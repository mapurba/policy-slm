<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Relation Placement Policy</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">WDRelation</if-class-name>
											<if-operation mode="nocase" op="equal">add</if-operation>
											<if-global-variable mode="nocase" name="gvRelationPlacementContainer" op="not-equal">Custom</if-global-variable>
										</and>
									</conditions>
									<actions>
										<do-set-op-dest-dn>
											<arg-dn>
												<token-global-variable name="gvRelationPlacementContainer" />
												<token-text xml:space="preserve">\</token-text>
												<token-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDRelation:wd-RelationID" />
											</arg-dn>
										</do-set-op-dest-dn>
										<do-set-local-variable name="association" scope="policy">
											<arg-string>
												<token-op-attr name="urn:ietf:params:scim:schemas:ilm:static:1.0:User:workforceID" />
												<token-text xml:space="preserve">-</token-text>
												<token-op-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDRelation:wd-WorkerIDType" />
												<token-text xml:space="preserve">:</token-text>
												<token-attr name="urn:ietf:params:scim:schemas:ilm:core:1.0:WDRelation:wd-PositionID" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-association op="not-available" />
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-op-association>
													<arg-association>
														<token-local-variable name="association" />
													</arg-association>
												</do-set-op-association>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							