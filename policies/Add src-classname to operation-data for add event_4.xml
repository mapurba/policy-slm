<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Add src-classname to operation-data for add event</description>
									<conditions>
										<and>
											<if-operation op="equal">add</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-op-property name="src-classname">
											<arg-string>
												<token-class-name />
											</arg-string>
										</do-set-op-property>
									</actions>
								</rule>
							