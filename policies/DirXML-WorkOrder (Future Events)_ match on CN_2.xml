<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-WorkOrder (Future Events): match on CN</description>
									<conditions>
										<and>
											<if-class-name mode="nocase" op="equal">DirXML-WorkOrder</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subordinates">
											<arg-dn>
												<token-global-variable name="dvr.sapbul.driverdn" />
											</arg-dn>
											<arg-match-attr name="CN" />
										</do-find-matching-object>
									</actions>
								</rule>
							