<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Reformat  Account Entitlement Value as per FanOut standards</description>
									<conditions>
										<and>
											<if-op-property mode="nocase" name="Entitlement-Account-Query" op="equal">true</if-op-property>
											<if-operation mode="nocase" op="equal">status</if-operation>
										</and>
									</conditions>
									<actions>
										<do-set-local-variable name="connDN" scope="policy">
											<arg-string>
												<token-xpath expression="operation-data/@connection-dn" />
												<token-text xml:space="preserve">-</token-text>
											</arg-string>
										</do-set-local-variable>
										<do-append-xml-element expression="operation-data" name="entiAccValue" />
										<do-append-xml-text expression="operation-data/entiAccValue">
											<arg-string>
												<token-local-variable name="connDN" />
											</arg-string>
										</do-append-xml-text>
										<do-clone-xpath before="node()" dest-expression="//instance/attr[@attr-name=&quot;idu&quot;]/value" src-expression="operation-data/entiAccValue/text()" />
										<do-strip-xpath expression="operation-data/entiAccValue" />
									</actions>
								</rule>
								