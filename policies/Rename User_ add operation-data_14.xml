<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Rename User: add operation-data</description>
									<conditions>
										<and />
									</conditions>
									<actions>
										<do-if>
											<arg-conditions>
												<and>
													<if-operation mode="case" op="equal">rename</if-operation>
													<if-class-name mode="nocase" op="equal">User</if-class-name>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="lv.renOld" scope="policy">
													<arg-string>
														<token-parse-dn length="1" start="-1">
															<token-xpath expression="@ old-src-dn" />
														</token-parse-dn>
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv.renNew" scope="policy">
													<arg-string>
														<token-xpath expression="new-name" />
													</arg-string>
												</do-set-local-variable>
												<do-set-local-variable name="lv.rename" scope="policy">
													<arg-string>
														<token-text xml:space="preserve">true</token-text>
													</arg-string>
												</do-set-local-variable>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
								