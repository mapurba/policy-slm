<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>DirXML-sapS: match on DirXML-sapSID</description>
									<conditions>
										<and>
											<if-class-name op="equal">DirXML-sapS</if-class-name>
										</and>
									</conditions>
									<actions>
										<do-find-matching-object scope="subordinates">
											<arg-dn>
												<token-global-variable name="dirxml.auto.driverdn" />
												<token-text xml:space="preserve">\sap\om\s</token-text>
											</arg-dn>
											<arg-match-attr name="DirXML-sapSID" />
										</do-find-matching-object>
									</actions>
								</rule>
								