<?xml version="1.0" encoding="UTF-8"?>
<rule>
									<description>Unified Groups Owner addition and Member deletion operations</description>
									<comment xml:space="preserve">This rule would check whether the modification is hapenning on Owner/Member of a group. Then, it checks if the group in consideration is a Office 365 (Unified) group. It then decides and performs the extra operations that need to be done.</comment>
									<conditions>
										<or>
											<if-operation mode="nocase" op="equal">modify</if-operation>
										</or>
										<or>
											<if-class-name mode="nocase" op="equal">group</if-class-name>
										</or>
										<or>
											<if-op-attr name="Owner" op="changing" />
											<if-op-attr name="Member" op="changing" />
										</or>
									</conditions>
									<actions>
										<do-set-local-variable name="queryResponse" scope="policy">
											<arg-node-set>
												<token-query class-name="group" scope="entry">
													<arg-association>
														<token-association />
													</arg-association>
													<arg-string>
														<token-text xml:space="preserve">DirXML-AADObjectType</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">RecipientTypeDetails</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">Member</token-text>
													</arg-string>
													<arg-string>
														<token-text xml:space="preserve">Owner</token-text>
													</arg-string>
												</token-query>
											</arg-node-set>
										</do-set-local-variable>
										<do-set-local-variable name="GroupType" scope="policy">
											<arg-string>
												<token-xpath expression="$queryResponse//attr[@attr-name=&quot;DirXML-AADObjectType&quot;]/value[1]/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-set-local-variable name="GroupRecipientTypeDetails" scope="policy">
											<arg-string>
												<token-xpath expression="$queryResponse//attr[@attr-name=&quot;RecipientTypeDetails&quot;]/value[1]/text()" />
											</arg-string>
										</do-set-local-variable>
										<do-if>
											<arg-conditions>
												<and>
													<if-local-variable mode="nocase" name="GroupType" op="equal">Universal</if-local-variable>
													<if-local-variable mode="nocase" name="GroupRecipientTypeDetails" op="equal">GroupMailbox</if-local-variable>
												</and>
											</arg-conditions>
											<arg-actions>
												<do-set-local-variable name="GroupMembers" scope="policy">
													<arg-node-set>
														<token-xpath expression="$queryResponse//attr[@attr-name=&quot;Member&quot;]/value" />
													</arg-node-set>
												</do-set-local-variable>
												<do-set-local-variable name="GroupOwners" scope="policy">
													<arg-node-set>
														<token-xpath expression="$queryResponse//attr[@attr-name=&quot;Owner&quot;]/value" />
													</arg-node-set>
												</do-set-local-variable>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="modify-attr[@attr-name='Owner']/add-value/value" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="AddedOwnerDN" scope="policy">
															<arg-string>
																<token-local-variable name="current-node" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="OwnerIsMember" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">FALSE</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-for-each>
															<arg-node-set>
																<token-local-variable name="GroupMembers" />
															</arg-node-set>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="AddedOwnerDN" op="equal">$current-node$</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="OwnerIsMember" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">TRUE</token-text>
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
														</do-for-each>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="OwnerIsMember" op="equal">FALSE</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-add-src-attr-value class-name="Group" name="Member">
																	<arg-value type="string">
																		<token-local-variable name="AddedOwnerDN" />
																	</arg-value>
																</do-add-src-attr-value>
																<do-add-dest-attr-value class-name="Group" name="Member" when="before">
																	<arg-value type="dn">
																		<token-local-variable name="AddedOwnerDN" />
																	</arg-value>
																</do-add-dest-attr-value>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
												<do-for-each>
													<arg-node-set>
														<token-xpath expression="modify-attr[@attr-name='Member']/remove-value/value" />
													</arg-node-set>
													<arg-actions>
														<do-set-local-variable name="RemovedMemberDN" scope="policy">
															<arg-string>
																<token-local-variable name="current-node" />
															</arg-string>
														</do-set-local-variable>
														<do-set-local-variable name="MemberIsOwner" scope="policy">
															<arg-string>
																<token-text xml:space="preserve">FALSE</token-text>
															</arg-string>
														</do-set-local-variable>
														<do-for-each>
															<arg-node-set>
																<token-local-variable name="GroupOwners" />
															</arg-node-set>
															<arg-actions>
																<do-if>
																	<arg-conditions>
																		<and>
																			<if-local-variable mode="nocase" name="RemovedMemberDN" op="equal">$current-node$</if-local-variable>
																		</and>
																	</arg-conditions>
																	<arg-actions>
																		<do-set-local-variable name="MemberIsOwner" scope="policy">
																			<arg-string>
																				<token-text xml:space="preserve">TRUE</token-text>
																			</arg-string>
																		</do-set-local-variable>
																	</arg-actions>
																	<arg-actions />
																</do-if>
															</arg-actions>
														</do-for-each>
														<do-if>
															<arg-conditions>
																<and>
																	<if-local-variable mode="nocase" name="MemberIsOwner" op="equal">TRUE</if-local-variable>
																</and>
															</arg-conditions>
															<arg-actions>
																<do-remove-src-attr-value class-name="Group" name="Owner">
																	<arg-value type="string">
																		<token-local-variable name="RemovedMemberDN" />
																	</arg-value>
																</do-remove-src-attr-value>
																<do-remove-dest-attr-value class-name="Group" name="Owner" when="before">
																	<arg-value type="dn">
																		<token-local-variable name="RemovedMemberDN" />
																	</arg-value>
																</do-remove-dest-attr-value>
															</arg-actions>
															<arg-actions />
														</do-if>
													</arg-actions>
												</do-for-each>
											</arg-actions>
											<arg-actions />
										</do-if>
									</actions>
								</rule>
							